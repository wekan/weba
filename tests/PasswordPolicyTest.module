' Fresh disposable database; test all password entry points and admin-only policy.
Public Sub Main()
  Dim denied As Boolean
  If WebDatabase.PasswordLengthEnforced() Then Error.Raise("Fresh policy must be disabled")
  WebDatabase.Register("admin", "x")
  If Not WebDatabase.Login("admin", "x") Then Error.Raise("Short first password failed")
  Session["username"] = "admin"
  If Not WebDatabase.GetIsAdmin("admin") Then Error.Raise("First short-password user must be Admin")
  WebDatabase.NewUser("worker", "a", False)
  If Not WebDatabase.SetPassword("worker", "a", "b") Then Error.Raise("Short password change rejected while disabled")
  If Not WebDatabase.ForceResetPassword("admin", "worker", "c") Then Error.Raise("Short reset rejected while disabled")
  WebDatabase.SetPasswordPolicy(True, 8)
  If Not WebDatabase.PasswordLengthEnforced() Or WebDatabase.PasswordMinLength() <> 8 Then Error.Raise("Policy did not persist")
  Try WebDatabase.Register("short-registration", "x")
  denied = Error
  If Not denied Then Error.Raise("Enforced short registration accepted")
  If InStr(WebDatabase.RegistrationError, "8") = 0 Then Error.Raise("Registration must explain configured minimum")
  Try WebDatabase.NewUser("short-created-user", "x", False)
  denied = Error
  If Not denied Then Error.Raise("Enforced short new user accepted")
  Try WebDatabase.SetPassword("worker", "c", "x")
  denied = Error
  If Not denied Then Error.Raise("Enforced short change accepted")
  Try WebDatabase.ForceResetPassword("admin", "worker", "x")
  denied = Error
  If Not denied Then Error.Raise("Enforced short reset accepted")
  WebDatabase.Register("long-user", "12345678")
  Session["username"] = "worker"
  Try WebDatabase.SetPasswordPolicy(False, 1)
  denied = Error
  If Not denied Then Error.Raise("Normal user disabled policy")
  Session["username"] = "admin"
  WebDatabase.SetPasswordPolicy(True, 2)
  Try WebDatabase.Register("unicode-short", "ä")
  denied = Error
  If Not denied Then Error.Raise("UTF-8 bytes counted as password characters")
  WebDatabase.Register("unicode-valid", "äö")
  Try WebDatabase.SetPasswordPolicy(True, 0)
  denied = Error
  If Not denied Then Error.Raise("Invalid minimum accepted")
  WebDatabase.SetPasswordPolicy(False, 8)
  WebDatabase.Register("short-again", "z")
  If Not WebDatabase.Login("short-again", "z") Then Error.Raise("Disabling policy did not allow short passwords")
  Try WebDatabase.Register("empty-password", "")
  denied = Error
  If Not denied Then Error.Raise("Empty password accepted")
  Print "Optional password policy, short passwords, all entry points, Unicode and admin-only settings passed"
End
