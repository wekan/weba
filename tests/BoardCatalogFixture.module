' Only copied into disposable HTTP projects.
Public Sub Main()
  Dim data As New Collection
  Dim index As Integer
  Dim r As Result
  Dim containers As Result
  Dim ids As New Integer[]
  Dim boardId As Integer
  Dim title As String
  Dim raw As New Variant[]
  Dim row As Collection
  Dim pageParams As New Collection
  If Env["WEBA_TEST_FIXTURE"] <> "1" Then Error.Raise("Disposable fixture required")
  Session["username"] = If(Env["WEBA_TEST_USER"], Env["WEBA_TEST_USER"], "rest-other")
  Session["auth_generation"] = WebDatabase.SessionGeneration(Session["username"])
  If Env["WEBA_CATALOG_MODE"] = "seed-purge" Then
    For Each title In ["Purge UI Alpha <literal>", "Purge UI Bravo", "Purge UI Active"]
      boardId = KanbanStore.AddBoard(title)
      BoardAccess.SetMember(boardId, "rest-owner", "board-admin")
      BoardAccess.SetMember(boardId, "rest-member", "read-only")
      ids.Add(boardId)
      If ids.Count < 3 Then KanbanStore.ArchiveBoard(boardId, True)
    Next
    data["ids"] = ids
  Endif
  If Env["WEBA_CATALOG_MODE"] = "purge-enable" Then RecoveryStore.SetEnabled(True)
  If Env["WEBA_CATALOG_MODE"] = "purge-disable" Then RecoveryStore.SetEnabled(False)
  If Env["WEBA_CATALOG_MODE"] = "purge-demote" Then WebDatabase.OpenConnection().Exec("UPDATE users SET admin=&1 WHERE username=&2", False, "rest-owner")
  If Env["WEBA_CATALOG_MODE"] = "purge-promote" Then WebDatabase.OpenConnection().Exec("UPDATE users SET admin=&1 WHERE username=&2", True, "rest-owner")
  RecoveryStore.OpenStore()
  data["purgeEnabled"] = RecoveryStore.Enabled()
  r = WebDatabase.OpenConnection().Find("recovery_events", "id>0 ORDER BY id")
  For Each r
    row = New Collection
    row["event"] = r!event
    row["actor"] = r!actor
    row["done"] = r!done
    row["deletedData"] = r!deleted_data
    row["detail"] = r!detail
    row["boardsJson"] = r!boards_json
    raw.Add(row)
  Next
  data["recoveryEvents"] = raw
  raw = New Variant[]
  If Env["WEBA_CATALOG_MODE"] = "seed-home-presentation" Then
    For index = 0 To 26
      boardId = KanbanStore.AddBoard("Home projection " & If(index = 0, "mark", Format(index, "00")))
      BoardAccess.SetMember(boardId, "rest-member", "read-only")
      ids.Add(boardId)
    Next
    Session["username"] = "rest-member"
    Session["auth_generation"] = WebDatabase.SessionGeneration("rest-member")
    For index = 1 To 26
      WorkspaceStore.SetSetting(ids[index], "board", ids[index], "star", "1")
    Next
    HomeBoard.SetBoard(ids[0])
    data["ids"] = ids
  Endif
  If Env["WEBA_CATALOG_MODE"] = "seed-order" Then
    For Each title In ["Order Alpha", "Order Bravo", "Order Charlie"]
      boardId = KanbanStore.AddBoard(title)
      BoardAccess.SetMember(boardId, "rest-member", "read-only")
      ids.Add(boardId)
    Next
    data["ids"] = ids
    Session["username"] = "rest-owner"
    Session["auth_generation"] = WebDatabase.SessionGeneration(Session["username"])
    data["privateId"] = KanbanStore.AddBoard("Order private")
    Session["username"] = "rest-member"
    Session["auth_generation"] = WebDatabase.SessionGeneration(Session["username"])
    BoardCatalog.SetSortBy("custom")
  Endif
  If Env["WEBA_CATALOG_MODE"] = "seed-selection-basic" Then
    For Each title In ["Selection Alpha", "Selection Bravo", "Selection Charlie"]
      boardId = KanbanStore.AddBoard(title)
      BoardAccess.SetMember(boardId, "rest-member", "read-only")
      ids.Add(boardId)
    Next
    data["ids"] = ids
  Endif
  If Env["WEBA_CATALOG_MODE"] = "selection-containers" Or Env["WEBA_CATALOG_MODE"] = "initialize-selection-containers" Then
    raw = New Variant[]
    r = KanbanStore.Boards(False)
    For Each r
      If r!title <> "Selection Alpha" And r!title <> "Selection Bravo" Then Continue
      boardId = r!id
      If Env["WEBA_CATALOG_MODE"] = "initialize-selection-containers" Then containers = KanbanStore.Lanes(boardId)
      row = New Collection
      row["id"] = boardId
      row["lanes"] = WebDatabase.OpenConnection().Exec("SELECT COUNT(*) AS total FROM kb_lanes WHERE board_id=&1", boardId)!total
      row["lists"] = WebDatabase.OpenConnection().Exec("SELECT COUNT(*) AS total FROM kb_lists WHERE board_id=&1", boardId)!total
      raw.Add(row)
    Next
    data["selectionContainers"] = raw
  Endif
  If Env["WEBA_CATALOG_MODE"] = "seed-selection" Then
    For index = 1 To 30
      boardId = KanbanStore.AddBoard("Selection Paging " & Format(index, "00"))
      BoardAccess.SetMember(boardId, "rest-member", "read-only")
      ids.Add(boardId)
    Next
    data["ids"] = ids
  Endif
  If Env["WEBA_CATALOG_MODE"] = "seed" Then
    For index = 1 To 30
      KanbanStore.AddBoard("Catalog Board " & Format(index, "00"))
    Next
    KanbanStore.AddBoard("Ångström catalog")
  Endif
  If Env["WEBA_CATALOG_MODE"] = "set-asc" Then BoardCatalog.SetSortBy("title-asc")
  If Env["WEBA_CATALOG_MODE"] = "archive-last" Or Env["WEBA_CATALOG_MODE"] = "restore-last" Then
    r = KanbanStore.Boards(Env["WEBA_CATALOG_MODE"] = "restore-last")
    For Each r
      If Left(r!title, 14) <> "Catalog Board " Then Continue
      If Val(Right(r!title, 2)) <= 25 Then Continue
      WorkspaceStore.SetArchived(r!id, "board", r!id, Env["WEBA_CATALOG_MODE"] = "archive-last")
    Next
  Endif
  If Env["WEBA_CATALOG_MODE"] = "order-pair" Then
    r = KanbanStore.Boards()
    For Each r
      If r!title = "Order Alpha" Or r!title = "Order Bravo" Then ids.Add(r!id)
    Next
    BoardOrder.Save(ids)
  Endif
  If Env["WEBA_CATALOG_MODE"] = "private-drop-board" Then data["privateDropBoard"] = KanbanStore.AddBoard("Drop Private Unreadable")
  If Env["WEBA_CATALOG_MODE"] = "seed-board-drops" Then
    data["dropBoard"] = KanbanStore.AddBoard("Drop Board Alpha")
    BoardAccess.SetMember(CInt(data["dropBoard"]), "rest-member", "read-only")
    data["ownerSpace"] = BoardSpaces.Add("Drop Owner Workspace")
  Endif
  If Env["WEBA_CATALOG_MODE"] = "grant-drop-manager" Then BoardAccess.SetMember(CInt(Env["WEBA_SPACE_BOARD"]), "rest-member", "board-admin")
  If Env["WEBA_CATALOG_MODE"] = "seed-workspace-order" Then
    row = New Collection
    row["a"] = BoardSpaces.Add("Drag Alpha")
    row["child"] = BoardSpaces.Add("Drag Child", CInt(row["a"]))
    row["b"] = BoardSpaces.Add("Drag Bravo")
    row["c"] = BoardSpaces.Add("Drag Charlie")
    data["spaceIds"] = row
  Endif
  If Env["WEBA_CATALOG_MODE"] = "seed-spaces" Then
    For Each title In ["Workspace Alpha", "Workspace Bravo"]
      boardId = KanbanStore.AddBoard(title)
      BoardAccess.SetMember(boardId, "rest-member", "read-only")
      ids.Add(boardId)
    Next
    data["ids"] = ids
  Endif
  If Env["WEBA_CATALOG_MODE"] = "create-space" Then data["spaceId"] = BoardSpaces.Add(Env["WEBA_SPACE_NAME"])
  If Env["WEBA_CATALOG_MODE"] = "menu-manager" Then BoardAccess.SetMember(CInt(Env["WEBA_SPACE_BOARD"]), "rest-owner", Env["WEBA_MENU_ROLE"])
  If Env["WEBA_CATALOG_MODE"] = "menu-failure" Then
    If Env["WEBA_MENU_FAILURE"] = "on" Then
      WebDatabase.OpenConnection().Exec("CREATE TRIGGER fail_menu_activity BEFORE INSERT ON kb_activity WHEN NEW.board_id=" & CStr(CInt(Env["WEBA_SPACE_BOARD"])) & " BEGIN SELECT RAISE(ABORT,'menu transition failed'); END")
    Else
      WebDatabase.OpenConnection().Exec("DROP TRIGGER IF EXISTS fail_menu_activity")
    Endif
  Endif
  If Env["WEBA_CATALOG_MODE"] = "rename-route-board" Then WorkspaceStore.Rename(CInt(Env["WEBA_SPACE_BOARD"]), "board", CInt(Env["WEBA_SPACE_BOARD"]), Env["WEBA_ROUTE_TITLE"])
  If Env["WEBA_CATALOG_MODE"] = "rename-space" Then BoardSpaces.Edit(CInt(Env["WEBA_SPACE_ID"]), Env["WEBA_SPACE_NAME"])
  If Env["WEBA_CATALOG_MODE"] = "delete-space" Then BoardSpaces.Remove(CInt(Env["WEBA_SPACE_ID"]))
  If Env["WEBA_CATALOG_MODE"] = "star-space-board" Then WorkspaceStore.SetSetting(CInt(Env["WEBA_SPACE_BOARD"]), "board", CInt(Env["WEBA_SPACE_BOARD"]), "star", "1")
  If Env["WEBA_CATALOG_MODE"] = "assign-space" Then BoardSpaces.Assign(CInt(Env["WEBA_SPACE_BOARD"]), CInt(Env["WEBA_SPACE_ID"]))
  If Env["WEBA_CATALOG_MODE"] = "revoke-space-board" Then BoardAccess.RemoveMember(CInt(Env["WEBA_SPACE_BOARD"]), "rest-member")
  If Env["WEBA_CATALOG_MODE"] = "grant-space-board" Then BoardAccess.SetMember(CInt(Env["WEBA_SPACE_BOARD"]), "rest-member", "read-only")
  If Env["WEBA_CATALOG_MODE"] = "collapse-space" Then BoardSpaces.SetCollapsed(CInt(Env["WEBA_SPACE_ID"]), True)
  If Env["WEBA_CATALOG_MODE"] = "expand-space" Then BoardSpaces.SetCollapsed(CInt(Env["WEBA_SPACE_ID"]), False)
  If Env["WEBA_CATALOG_MODE"] = "archive-space-board" Then WorkspaceStore.SetArchived(CInt(Env["WEBA_SPACE_BOARD"]), "board", CInt(Env["WEBA_SPACE_BOARD"]), True)
  If Env["WEBA_CATALOG_MODE"] = "restore-space-board" Then WorkspaceStore.SetArchived(CInt(Env["WEBA_SPACE_BOARD"]), "board", CInt(Env["WEBA_SPACE_BOARD"]), False)
  data["collapsed"] = BoardSpaces.Collapsed()
  data["counts"] = BoardSpaces.Counts()
  data["tree"] = BoardSpaces.Tree()
  data["assignments"] = BoardSpaces.Assignments()
  r = WebDatabase.OpenConnection().Find("kb_board_spaces", "username=&1 ORDER BY id", Session["username"])
  For Each r
    row = New Collection
    row["id"] = r!id
    row["parentId"] = r!parent_id
    row.Add(CStr(r!name), "name")
    row.Add(CStr(r!icon), "icon")
    raw.Add(row)
  Next
  data["rawSpaces"] = raw
  row = New Collection
  r = WebDatabase.OpenConnection().Find("kb_boards", "id>0 ORDER BY id")
  For Each r
    row[CStr(r!id)] = CBool(r!archived)
  Next
  data["rawArchived"] = row
  row = New Collection
  r = WebDatabase.OpenConnection().Find("kb_user_meta", "username=&1 AND kind=&2 AND setting=&3 ORDER BY board_id", Session["username"], "board", "star")
  For Each r
    row.Add(CStr(r!value), CStr(r!board_id))
  Next
  data["rawStars"] = row
  row = New Collection
  r = WebDatabase.OpenConnection().Find("kb_board_space_assignments", "username=&1 ORDER BY board_id", Session["username"])
  For Each r
    row.Add(CStr(r!space_id), CStr(r!board_id))
  Next
  data["rawAssignments"] = row
  If Env["WEBA_CATALOG_MODE"] = "cleanup-home-presentation" Then
    CleanupHomeFixture(True)
    BoardCatalog.SetSortBy(Env["WEBA_HOME_SORT"])
  Endif
  If Env["WEBA_CATALOG_MODE"] = "cleanup-home" Then
    CleanupHomeFixture()
    BoardCatalog.SetSortBy(Env["WEBA_HOME_SORT"])
  Endif
  If Env["WEBA_CATALOG_MODE"] = "set-home" Then HomeBoard.SetBoard(CInt(Env["WEBA_SPACE_BOARD"]))
  If Env["WEBA_CATALOG_MODE"] = "clear-home" Then
    If HomeBoard.Saved() Then HomeBoard.Clear(HomeBoard.Saved())
  Endif
  data["home"] = HomeBoard.Saved()
  data["homeVisible"] = HomeBoard.Visible()
  pageParams["menu"] = "starred"
  data["starredTotal"] = BoardCatalog.Page(pageParams)["total"]
  data["positions"] = BoardOrder.Positions()
  data["sortBy"] = BoardCatalog.SortBy()
  Print JSON.Encode(data)
End


Private Sub CleanupHomeFixture(Optional presentation As Boolean)
  Dim db As Connection = WebDatabase.OpenConnection()
  Dim ids As Integer[] = New Integer[]
  Dim rawId As Variant
  Dim id As Integer
  Dim r As Result
  Dim t As Table
  For Each rawId In JSON.Decode(Env["WEBA_HOME_IDS"])
    id = CInt(rawId)
    r = db.Find("kb_boards", "id=&1", id)
    If Not r.Available Then Error.Raise("Missing Home fixture board")
    If presentation Then
      If Left(CStr(r!title), Len("Home projection ")) <> "Home projection " Or r!owner <> "rest-other" Then Error.Raise("Not a Home presentation fixture board")
    Else
      If ["Order Alpha", "Order Bravo", "Order Charlie", "Order private"].Find(CStr(r!title)) < 0 Then Error.Raise("Not a Home fixture board")
      If r!owner <> "rest-other" And r!owner <> "rest-owner" Then Error.Raise("Not a Home fixture owner")
    Endif
    ids.Add(id)
  Next
  If ids.Count <> If(presentation, 27, 4) Then Error.Raise("Invalid Home fixture cleanup")
  For Each id In ids
    For Each t In db.Tables
      If t.Fields.Exist("board_id") Then db.Delete(t.Name, "board_id=&1", id)
    Next
    db.Delete("kb_boards", "id=&1", id)
  Next
End
