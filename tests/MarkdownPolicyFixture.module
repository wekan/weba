Public Sub Main()
  Dim mode As String = Env["WEBA_MARKDOWN_MODE"]
  Dim data As New Collection
  Dim db As Connection
  Dim r As Result
  Dim node As Collection
  Dim payload As Collection
  Dim field As String
  If Env["WEBA_TEST_FIXTURE"] <> "1" Then Error.Raise("Disposable fixture required")
  Session["username"] = "rest-owner"
  Session["auth_generation"] = WebDatabase.SessionGeneration("rest-owner")
  db = WebDatabase.OpenConnection()
  MarkdownPolicy.OpenStore()
  If mode = "demote" Or mode = "promote" Then db.Exec("UPDATE users SET admin=&1 WHERE username='rest-owner'", mode = "promote")
  If mode = "color" Then
    Session["username"] = "rest-member"
    Session["auth_generation"] = WebDatabase.SessionGeneration("rest-member")
    node = BoardSpaces.Record(CInt(Env["WEBA_MARKDOWN_SPACE"]))
    BoardSpaces.Edit(CInt(Env["WEBA_MARKDOWN_SPACE"]), node["name"], node["icon"], Env["WEBA_MARKDOWN_COLOR"])
  Endif
  If mode = "icon" Then
    Session["username"] = "rest-member"
    Session["auth_generation"] = WebDatabase.SessionGeneration("rest-member")
    BoardSpaces.Edit(CInt(Env["WEBA_MARKDOWN_SPACE"]), "Markdown policy workspace", Env["WEBA_MARKDOWN_ICON"])
  Endif
  If mode = "external" Then
    payload = JSON.Decode(Env["WEBA_MARKDOWN_EXTERNAL"])
    node = New Collection
    For Each field In ["externalLinkPatternPrefix", "externalLinkPatternUrl", "externalLinkRules", "externalLinkIdentifierAliases"]
      node.Add(CStr(payload[field]), field)
    Next
    ExternalLinkPolicy.Save(node)
  Endif
  If mode = "schemes" Then MarkdownPolicy.SaveUrlSchemes(Env["WEBA_MARKDOWN_SCHEMES"])
  If mode = "save" Then MarkdownPolicy.Save(Env["WEBA_MARKDOWN_RAW"] = "1")
  If mode = "cleanup" Then
    Session["username"] = "rest-member"
    Session["auth_generation"] = WebDatabase.SessionGeneration("rest-member")
    BoardSpaces.Remove(CInt(Env["WEBA_MARKDOWN_SPACE"]))
  Endif
  If mode = "seed" Then
    Session["username"] = "rest-member"
    Session["auth_generation"] = WebDatabase.SessionGeneration("rest-member")
    data["id"] = BoardSpaces.Add("Markdown policy workspace")
    BoardSpaces.Edit(data["id"], "Markdown policy workspace", "**Policy bold**")
  Endif
  r = db.Find("markdown_settings", "id=1")
  data.Add(r!always_raw, "raw")
  data.Add(r!actor, "actor")
  data.Add(r!changed_ms, "changed")
  data.Add(MarkdownPolicy.UrlSchemes(), "schemes")
  data["external"] = ExternalLinkPolicy.Snapshot()
  node = ExternalLinkPolicy.Snapshot()
  r = db.Find("markdown_external_settings", "id=1")
  node.Add(r!actor, "actor")
  node.Add(r!changed_ms, "changedMs")
  data["externalAudit"] = node
  Print JSON.Encode(data)
End
