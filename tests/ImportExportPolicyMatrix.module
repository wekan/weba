Public Sub Main()
  Dim test As Collection
  Dim row As Collection
  Dim rows As New Variant[]
  Dim db As Connection
  Dim settings As Result
  Dim denied As Boolean
  Dim failure As String
  WebDatabase.Register("exchange-matrix", "x")
  Session["username"] = "exchange-matrix"
  Session["auth_generation"] = WebDatabase.SessionGeneration("exchange-matrix")
  ImportExportPolicy.OpenStore()
  db = WebDatabase.OpenConnection()
  For Each test In JSON.Decode(File.Load(".public/exchange-policy-cases.json"))
    settings = db.Edit("import_export_settings", "id=1")
    settings["disable_import"] = test["disableAllImport"]
    settings["disable_export"] = test["disableAllExport"]
    settings.Update()
    row = New Collection
    row["settings"] = test
    row["importAllowed"] = ImportExportPolicy.ImportAllowed()
    row["exportAllowed"] = ImportExportPolicy.ExportAllowed()
    Try ImportExportPolicy.RequireImport()
    denied = Error
    failure = Error.Text
    If denied Then row["importError"] = failure
    Try ImportExportPolicy.RequireExport()
    denied = Error
    failure = Error.Text
    If denied Then row["exportError"] = failure
    rows.Add(row)
  Next
  Print JSON.Encode(rows)
End
