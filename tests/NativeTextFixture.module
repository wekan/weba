Public Sub Main()
  Dim boardId As Integer
  Dim cardId As Integer
  Dim conn As Connection
  Dim row As Result
  Dim lane As String
  Dim title As String
  Dim suffix As String
  Dim result As New Collection
  Dim items As New Variant[]
  Dim item As Collection
  If Env["WEBA_TEST_FIXTURE"] <> "1" Then Error.Raise("Disposable fixture required")
  Session["username"] = "rest-other"
  Session["auth_generation"] = WebDatabase.SessionGeneration("rest-other")
  If Env["WEBA_NATIVE_MODE"] = "containers" Then
    conn = WebDatabase.OpenConnection()
    boardId = CInt(Env["WEBA_NATIVE_BOARD"])
    row = conn.Exec(ExportText.SelectRows(conn, "kb_lanes") & " WHERE board_id=&1 ORDER BY id", boardId)
    For Each row
      item = New Collection
      item["id"] = row!id
      item["title"] = ExportText.ReadValue(row, "title")
      items.Add(item)
    Next
    result["lanes"] = items
    items = New Variant[]
    row = conn.Exec(ExportText.SelectRows(conn, "kb_lists") & " WHERE board_id=&1 ORDER BY id", boardId)
    For Each row
      item = New Collection
      item["id"] = row!id
      item["lane"] = ExportText.ReadValue(row, "lane")
      item["title"] = ExportText.ReadValue(row, "title")
      items.Add(item)
    Next
    result["lists"] = items
    row = conn.Exec(ExportText.SelectRows(conn, "kb_boards") & " WHERE id=&1", boardId)
    result["boardTitle"] = ExportText.ReadValue(row, "title")
    Print JsonText.Encode(result)
    Return
  Endif
  If Env["WEBA_NATIVE_MODE"] = "read" Then
    conn = WebDatabase.OpenConnection()
    boardId = CInt(Env["WEBA_NATIVE_BOARD"])
    cardId = CInt(Env["WEBA_NATIVE_CARD"])
    row = conn.Exec(ExportText.SelectRows(conn, "kb_cards") & " WHERE board_id=&1 AND id=&2", boardId, cardId)
    For Each suffix In ["title", "description", "lane", "status"]
      result[suffix] = ExportText.ReadValue(row, suffix)
    Next
    result["list"] = conn.Exec("SELECT list_id FROM kb_card_lists WHERE board_id=&1 AND card_id=&2", boardId, cardId)!list_id
    result["history"] = conn.Exec("SELECT COUNT(*) AS total FROM kb_history WHERE board_id=&1", boardId)!total
    result["cards"] = conn.Exec("SELECT COUNT(*) AS total FROM kb_cards WHERE board_id=&1", boardId)!total
    Print JsonText.Encode(result)
    Return
  Endif
  If Env["WEBA_NATIVE_MODE"] = "revoke" Then
    conn = WebDatabase.OpenConnection()
    boardId = CInt(Env["WEBA_NATIVE_BOARD"])
    conn.Exec("UPDATE kb_boards SET owner='rest-owner' WHERE id=&1", boardId)
    Session["username"] = "rest-owner"
    Session["auth_generation"] = WebDatabase.SessionGeneration("rest-owner")
    BoardAccess.SetMember(boardId, "rest-other", "read-only")
    Print "{}"
    Return
  Endif
  WebDatabase.Register("rest-native-reader", Env["WEBA_TEST_PASSWORD"])
  WebDatabase.Register("rest-native-assigned", Env["WEBA_TEST_PASSWORD"])
  boardId = KanbanStore.AddBoard("Complete native lane/list text")
  BoardAccess.SetMember(boardId, "rest-native-reader", "read-only")
  BoardAccess.SetMember(boardId, "rest-native-assigned", "read-assigned-only")
  conn = WebDatabase.OpenConnection()
  For Each suffix In ["A", "B"]
    lane = "Lane" & Chr(0) & "Ω😀'<tag>" & suffix
    title = "List" & Chr(0) & "Ω😀'<tag>" & suffix
    cardId = KanbanStore.SaveCard(boardId, 0, "Card " & suffix, "", lane, "Todo", "", "", "")
    row = conn.Edit("kb_lists", "board_id=&1 AND id=&2", boardId, KanbanStore.CardListId(boardId, cardId))
    row["title"] = title
    DatabaseText.Save(conn, row, "kb_lists", ["title"], False)
    cardId = KanbanStore.SaveCard(boardId, cardId, "Card " & suffix, "", lane, title, "", "", "")
    item = New Collection
    item["lane"] = lane
    item["title"] = title
    item["card"] = cardId
    item["list"] = KanbanStore.CardListId(boardId, cardId)
    If suffix = "A" Then BoardAccess.SetAssignees(boardId, cardId, ["rest-native-assigned"])
    items.Add(item)
  Next
  result["board"] = boardId
  result["items"] = items
  Print JsonText.Encode(result)
End
