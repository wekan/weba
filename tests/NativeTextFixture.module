Public Sub Main()
  Dim boardId As Integer
  Dim cardId As Integer
  Dim conn As Connection
  Dim row As Result
  Dim lane As String
  Dim title As String
  Dim suffix As String
  Dim result As New Collection
  Dim items As New Variant[]
  Dim item As Collection
  Dim kind As String
  Dim entryId As Integer
  Dim fileId As Integer
  Dim parents As Result
  Dim suffixText As String = Chr(0) & "Ω😀'copy"
  If Env["WEBA_TEST_FIXTURE"] <> "1" Then Error.Raise("Disposable fixture required")
  Session["username"] = "rest-other"
  Session["auth_generation"] = WebDatabase.SessionGeneration("rest-other")
  If Env["WEBA_NATIVE_MODE"] = "audit-seed" Then
    boardId = CInt(Env["WEBA_NATIVE_BOARD"])
    cardId = CInt(Env["WEBA_NATIVE_CARD"])
    result.Add("Activity" & suffixText, "message")
    result.Add("Audit actor" & suffixText, "actor")
    result.Add("Recovery detail" & suffixText, "detail")
    KanbanStore.Activity(boardId, result["message"], "card", cardId)
    RecoveryStore.Record("Browser audit", result["actor"], True, False, result["detail"])
    Print JsonText.Encode(result)
    Return
  Endif
  If ["guest-public", "guest-private", "guest-hide-lane", "guest-show-lane"].Find(Env["WEBA_NATIVE_MODE"]) >= 0 Then
    boardId = CInt(Env["WEBA_NATIVE_BOARD"])
    Select Env["WEBA_NATIVE_MODE"]
      Case "guest-public"
        BoardVisibility.SaveBoard(boardId, "public", False)
        WorkspaceStore.SetSetting(boardId, "board", boardId, "description", "Discovery description" & suffixText)
      Case "guest-private"
        BoardVisibility.SaveBoard(boardId, "private", False)
      Case Else
        row = KanbanStore.Lanes(boardId)
        WorkspaceStore.SetArchived(boardId, "lane", row!id, Env["WEBA_NATIVE_MODE"] = "guest-hide-lane")
    End Select
    Print "{}"
    Return
  Endif
  If Env["WEBA_NATIVE_MODE"] = "profile-seed" Or Env["WEBA_NATIVE_MODE"] = "profile-read" Then
    If Env["WEBA_NATIVE_MODE"] = "profile-seed" Then WebDatabase.SetFullname("rest-other", "Profile" & Chr(0) & "Ω😀'<tag>suffixA")
    result.Add(WebDatabase.GetFullname("rest-other"), "fullname")
    Print JsonText.Encode(result)
    Return
  Endif
  If Env["WEBA_NATIVE_MODE"] = "detail-update" Then
    boardId = CInt(Env["WEBA_NATIVE_BOARD"])
    cardId = CInt(Env["WEBA_NATIVE_CARD"])
    row = CardContent.Entries(boardId, cardId, "custom", True)
    If Not row.Available Then Error.Raise("Missing custom fixture")
    CardContent.Save(boardId, cardId, row!id, "custom", ExportText.ReadValue(row, "title"), "Browser value" & suffixText & Env["WEBA_NATIVE_SUFFIX"], 0, False, 0, "text")
    Print "{}"
    Return
  Endif
  If Env["WEBA_NATIVE_MODE"] = "live" Then
    boardId = CInt(Env["WEBA_NATIVE_BOARD"])
    cardId = CInt(Env["WEBA_NATIVE_CARD"])
    suffix = Chr(0) & "Ω😀'<tag>suffix" & Env["WEBA_NATIVE_SUFFIX"]
    WorkspaceStore.Rename(boardId, "board", boardId, "Live board" & suffix)
    WorkspaceStore.Rename(boardId, "card", cardId, "Live card" & suffix)
    result["boardTitle"] = "Live board" & suffix
    result["cardTitle"] = "Live card" & suffix
    Print JsonText.Encode(result)
    Return
  Endif
  If Env["WEBA_NATIVE_MODE"] = "boards" Then
    conn = WebDatabase.OpenConnection()
    row = conn.Exec(ExportText.SelectRows(conn, "kb_boards") & " WHERE owner=&1 ORDER BY id", "rest-other")
    For Each row
      item = New Collection
      item["id"] = row!id
      item["title"] = ExportText.ReadValue(row, "title")
      items.Add(item)
    Next
    result["boards"] = items
    Print JsonText.Encode(result)
    Return
  Endif
  If Env["WEBA_NATIVE_MODE"] = "copy-seed" Then
    boardId = CInt(Env["WEBA_NATIVE_BOARD"])
    cardId = CInt(Env["WEBA_NATIVE_CARD"])
    row = WorkspaceStore.Record(boardId, "card", cardId)
    KanbanStore.SaveCard(boardId, cardId, ExportText.ReadValue(row, "title"), ExportText.ReadValue(row, "description"), ExportText.ReadValue(row, "lane"), ExportText.ReadValue(row, "status"), ExportText.ReadValue(row, "assignee"), "Labels" & suffixText, ExportText.ReadValue(row, "due_day"), KanbanStore.CardListId(boardId, cardId))
    entryId = CardContent.Save(boardId, cardId, 0, "checklist", "Browser checks" & suffixText, "", 0, False, 0)
    CardContent.Save(boardId, cardId, 0, "checkitem", "Browser item" & suffixText, "Item body" & suffixText, entryId, True, 0)
    entryId = CardContent.Save(boardId, cardId, 0, "comment", "", "Browser comment" & suffixText, 0, False, 0)
    CardContent.RetainAuthorName(boardId, cardId, "entry", entryId, "Browser retired author" & suffixText)
    CardContent.Save(boardId, cardId, 0, "custom", "Browser field" & suffixText, "Browser value" & suffixText, 0, False, 0, "text")
    fileId = CardContent.UploadFile(boardId, cardId, "browser" & suffixText & ".bin", "B" & Chr(0) & Chr(255) & "Z")
    CardContent.RetainAuthorName(boardId, cardId, "file", fileId, "Browser retired uploader" & suffixText)
    AttachmentLifecycle.SetCover(boardId, cardId, fileId)
    WorkspaceStore.SetSetting(boardId, "card", cardId, "description", "Browser metadata" & suffixText)
    Print "{}"
    Return
  Endif
  If Env["WEBA_NATIVE_MODE"] = "copy-read" Then
    boardId = CInt(Env["WEBA_NATIVE_BOARD"])
    cardId = CInt(Env["WEBA_NATIVE_CARD"])
    row = WorkspaceStore.Record(boardId, "card", cardId)
    For Each kind In ["title", "description", "labels", "lane", "status", "due_day"]
      result[kind] = ExportText.ReadValue(row, kind)
    Next
    result["metadata"] = WorkspaceStore.Setting(boardId, "card", cardId, "description")
    conn = WebDatabase.OpenConnection()
    For Each kind In ["checklist", "checkitem", "comment", "custom", "time"]
      row = CardContent.Entries(boardId, cardId, kind, True)
      For Each row
        item = New Collection
        item["kind"] = kind
        item["title"] = ExportText.ReadValue(row, "title")
        item["body"] = ExportText.ReadValue(row, "body")
        item["done"] = row!done
        item["author"] = CardContent.AuthorName(boardId, cardId, "entry", row!id)
        If kind = "checkitem" Then
          parents = conn.Exec(ExportText.SelectRows(conn, "kb_entries") & " WHERE id=&1 AND board_id=&2 AND card_id=&3", row!parent_id, boardId, cardId)
          item["parent"] = If(parents.Available, ExportText.ReadValue(parents, "title"), "missing")
        Endif
        items.Add(item)
      Next
    Next
    result["entries"] = items
    items = New Variant[]
    row = CardContent.Files(boardId, cardId, True)
    For Each row
      item = New Collection
      item["filename"] = ExportText.ReadValue(row, "filename")
      item["data"] = Base64(row!content.Data)
      item["author"] = CardContent.AuthorName(boardId, cardId, "file", row!id)
      item["cover"] = AttachmentLifecycle.CoverId(boardId, cardId) = row!id
      items.Add(item)
    Next
    result["files"] = items
    Print JsonText.Encode(result)
    Return
  Endif
  If Env["WEBA_NATIVE_MODE"] = "containers" Then
    conn = WebDatabase.OpenConnection()
    boardId = CInt(Env["WEBA_NATIVE_BOARD"])
    row = conn.Exec(ExportText.SelectRows(conn, "kb_lanes") & " WHERE board_id=&1 ORDER BY id", boardId)
    For Each row
      item = New Collection
      item["id"] = row!id
      item["title"] = ExportText.ReadValue(row, "title")
      items.Add(item)
    Next
    result["lanes"] = items
    items = New Variant[]
    row = conn.Exec(ExportText.SelectRows(conn, "kb_lists") & " WHERE board_id=&1 ORDER BY id", boardId)
    For Each row
      item = New Collection
      item["id"] = row!id
      item["lane"] = ExportText.ReadValue(row, "lane")
      item["title"] = ExportText.ReadValue(row, "title")
      items.Add(item)
    Next
    result["lists"] = items
    items = New Variant[]
    row = conn.Exec(ExportText.SelectRows(conn, "kb_cards") & " WHERE board_id=&1 AND archived=&2 ORDER BY id", boardId, False)
    For Each row
      item = New Collection
      item["id"] = row!id
      item["title"] = ExportText.ReadValue(row, "title")
      item["lane"] = ExportText.ReadValue(row, "lane")
      item["status"] = ExportText.ReadValue(row, "status")
      item["list"] = KanbanStore.ReadCardListId(boardId, row!id)
      items.Add(item)
    Next
    result["cards"] = items
    row = conn.Exec(ExportText.SelectRows(conn, "kb_boards") & " WHERE id=&1", boardId)
    result["boardTitle"] = ExportText.ReadValue(row, "title")
    Print JsonText.Encode(result)
    Return
  Endif
  If Env["WEBA_NATIVE_MODE"] = "read" Then
    conn = WebDatabase.OpenConnection()
    boardId = CInt(Env["WEBA_NATIVE_BOARD"])
    cardId = CInt(Env["WEBA_NATIVE_CARD"])
    row = conn.Exec(ExportText.SelectRows(conn, "kb_cards") & " WHERE board_id=&1 AND id=&2", boardId, cardId)
    For Each suffix In ["title", "description", "lane", "status"]
      result[suffix] = ExportText.ReadValue(row, suffix)
    Next
    result["list"] = conn.Exec("SELECT list_id FROM kb_card_lists WHERE board_id=&1 AND card_id=&2", boardId, cardId)!list_id
    result["history"] = conn.Exec("SELECT COUNT(*) AS total FROM kb_history WHERE board_id=&1", boardId)!total
    result["cards"] = conn.Exec("SELECT COUNT(*) AS total FROM kb_cards WHERE board_id=&1", boardId)!total
    Print JsonText.Encode(result)
    Return
  Endif
  If Env["WEBA_NATIVE_MODE"] = "revoke" Then
    conn = WebDatabase.OpenConnection()
    boardId = CInt(Env["WEBA_NATIVE_BOARD"])
    conn.Exec("UPDATE kb_boards SET owner='rest-owner' WHERE id=&1", boardId)
    Session["username"] = "rest-owner"
    Session["auth_generation"] = WebDatabase.SessionGeneration("rest-owner")
    BoardAccess.SetMember(boardId, "rest-other", "read-only")
    Print "{}"
    Return
  Endif
  If Not WebDatabase.UserExists("rest-native-reader") Then WebDatabase.Register("rest-native-reader", Env["WEBA_TEST_PASSWORD"])
  If Not WebDatabase.UserExists("rest-native-assigned") Then WebDatabase.Register("rest-native-assigned", Env["WEBA_TEST_PASSWORD"])
  boardId = KanbanStore.AddBoard("Complete native lane/list text")
  BoardAccess.SetMember(boardId, "rest-native-reader", "read-only")
  BoardAccess.SetMember(boardId, "rest-native-assigned", "read-assigned-only")
  conn = WebDatabase.OpenConnection()
  For Each suffix In ["A", "B"]
    lane = "Lane" & Chr(0) & "Ω😀'<tag>" & suffix
    title = "List" & Chr(0) & "Ω😀'<tag>" & suffix
    cardId = KanbanStore.SaveCard(boardId, 0, "Card " & suffix, "", lane, "Todo", "", "", "")
    row = conn.Edit("kb_lists", "board_id=&1 AND id=&2", boardId, KanbanStore.CardListId(boardId, cardId))
    row["title"] = title
    DatabaseText.Save(conn, row, "kb_lists", ["title"], False)
    cardId = KanbanStore.SaveCard(boardId, cardId, "Card " & suffix, "", lane, title, "", "", "")
    item = New Collection
    item["lane"] = lane
    item["title"] = title
    item["card"] = cardId
    item["list"] = KanbanStore.CardListId(boardId, cardId)
    If suffix = "A" Then BoardAccess.SetAssignees(boardId, cardId, ["rest-native-assigned"])
    items.Add(item)
  Next
  result["board"] = boardId
  result["items"] = items
  Print JsonText.Encode(result)
End
