' Disposable HTTP-project data only; never a production endpoint.
Public Sub Main()
  Dim mode As String = Env["WEBA_PUBLIC_MODE"]
  Dim id As Integer = Val(Env["WEBA_PUBLIC_ID"])
  Dim ids As New Integer[]
  Dim data As New Collection
  Dim commentId As Integer
  Dim checklistId As Integer
  Dim itemId As Integer
  Dim targetId As Integer
  Dim fieldId As Integer
  Dim cardId As Integer
  Dim i As Integer
  Dim r As Result
  Dim db As Connection
  If Env["WEBA_TEST_FIXTURE"] <> "1" Then Error.Raise("Disposable fixture required")
  Session["username"] = "rest-other"
  Session["auth_generation"] = WebDatabase.SessionGeneration("rest-other")
  db = WebDatabase.OpenConnection()
  If mode = "view-api-seed" Then
    data["boardId"] = KanbanStore.AddBoard("View API isolated board")
  Else If mode = "seed" Then
    For i = 1 To 24
      id = KanbanStore.AddBoard("Discover UI " & Format(i, "00"))
      ids.Add(id)
      BoardVisibility.SaveBoard(id, If(i = 24, "private", If(i = 21, "instance", "public")), False)
      WorkspaceStore.SetSetting(id, "board", id, "description", "Literal <details> public description " & CStr(i))
      WorkspaceStore.SetSetting(id, "board", id, "color", "#315579")
      cardId = KanbanStore.SaveCard(id, 0, "DISCOVERY-CARD-PRIVATE-CANARY", "NEVER-ON-PUBLIC-TABLE", "Default", "Todo", "", "", "")
      If i = 1 Then data["cardId"] = cardId
      If i = 22 Then db.Exec("UPDATE kb_boards SET title='^Discover UI helper^' WHERE id=&1", id)
      If i = 23 Then KanbanStore.ArchiveBoard(id, True)
    Next
    data["ids"] = ids
  Else If mode = "guest-children" Then
    cardId = Val(Env["WEBA_PUBLIC_CARD"])
    commentId = CardContent.Save(id, cardId, 0, "comment", "", "Comment <script>literal</script>", 0, False, 0)
    checklistId = CardContent.Save(id, cardId, 0, "checklist", "Comments", "", 0, False, 0)
    itemId = CardContent.Save(id, cardId, 0, "checkitem", "Task <literal>", "Notes", checklistId, True, 0)
    data["commentId"] = commentId
    data["checklistId"] = checklistId
    data["itemId"] = itemId
  Else If mode = "view-policy" Then
    BoardViewPolicy.Save(id, JSON.Decode(Env["WEBA_PUBLIC_VIEW_POLICY"], True))
  Else If mode = "guest-views" Then
    cardId = Val(Env["WEBA_PUBLIC_CARD"])
    db.Exec("UPDATE kb_cards SET title='Calendar',description='Literal <script>canary</script>',due_day=&1 WHERE board_id=&2 AND id=&3", Env["WEBA_PUBLIC_DUE"], id, cardId)
    data["undatedId"] = KanbanStore.SaveCard(id, 0, "Undated <literal>", "", "Default", "Todo", "", "", "")
  Else If mode = "guest-attachments" Then
    cardId = Val(Env["WEBA_PUBLIC_CARD"])
    data["fileId"] = CardContent.AddFile(id, cardId, "Attachments <literal>.txt", "<script>window.publicAttachmentExecuted=true</script>" & Chr(0) & "retained")
  Else If mode = "attachments-policy" Then
    TransferPolicy.OpenStore()
    db.Exec("UPDATE attachment_transfer_settings SET attachmentsDownloadBlocked=&1,attachmentsDownloadMaxBytes=&2,apiDownloadBlocked=&3,apiDownloadMaxBytes=&4 WHERE id=1", Env["WEBA_PUBLIC_BLOCK"] = "1", Val(Env["WEBA_PUBLIC_LIMIT"]), Env["WEBA_PUBLIC_API_BLOCK"] = "1", Val(Env["WEBA_PUBLIC_API_LIMIT"]))
  Else If mode = "attachments-frame" Then
    cardId = Val(Env["WEBA_PUBLIC_CARD"])
    db.Exec("DELETE FROM kb_members WHERE board_id=&1 AND username='rest-member'", id)
    db.Exec("DELETE FROM kb_removed_members WHERE board_id=&1 AND username='rest-member'", id)
    db.Exec("DELETE FROM kb_member_flags WHERE board_id=&1 AND username='rest-member'", id)
    db.Exec("INSERT INTO kb_members (board_id,username,role) VALUES (&1,'rest-member',&2)", id, Env["WEBA_PUBLIC_ROLE"])
    If Env["WEBA_PUBLIC_RAW"] = "1" Then db.Exec("INSERT INTO kb_member_flags (board_id,username,flag) VALUES (&1,'rest-member','isReadAssignedOnly')", id)
    If Env["WEBA_PUBLIC_REMOVED"] = "1" Then db.Exec("INSERT INTO kb_removed_members (board_id,username,role) VALUES (&1,'rest-member',&2)", id, Env["WEBA_PUBLIC_ROLE"])
    db.Exec("UPDATE kb_cards SET assignee=&1 WHERE board_id=&2 AND id=&3", If(Env["WEBA_PUBLIC_ASSIGNED"] = "1", "rest-member", ""), id, cardId)
  Else If mode = "attachments-assigned" Then
    cardId = Val(Env["WEBA_PUBLIC_CARD"])
    BoardAccess.SetMember(id, "rest-member", "read-assigned-only")
    db.Exec("UPDATE kb_cards SET assignee=&1 WHERE board_id=&2 AND id=&3", If(Env["WEBA_PUBLIC_ASSIGNED"] = "1", "rest-member", ""), id, cardId)
  Else If mode = "attachments-delete" Then
    AttachmentLifecycle.Delete(id, Val(Env["WEBA_PUBLIC_CARD"]), Val(Env["WEBA_PUBLIC_FILE"]))
  Else If mode = "guest-details" Then
    cardId = Val(Env["WEBA_PUBLIC_CARD"])
    data["fieldId"] = CardContent.Save(id, cardId, 0, "custom", "Time tracking", "Value <script>literal</script>", 0, False, 0, "text")
    data["checkboxId"] = CardContent.Save(id, cardId, 0, "custom", "Checkbox <literal>", "", 0, True, 0, "checkbox")
    data["timeId"] = CardContent.Save(id, cardId, 0, "time", "Stored minutes", "Timer note", 0, True, 12.5)
    CardContent.StartTimer(id, cardId)
    targetId = KanbanStore.SaveCard(id, 0, "Related <literal>", "Related body", "Default", "Todo", "", "", "")
    KanbanStore.ArchiveCard(id, targetId, True)
    data["targetId"] = targetId
    CardContent.Save(id, cardId, 0, "subtask", "", "", 0, False, targetId)
    CardContent.Save(id, cardId, 0, "dependency", "", "", 0, False, targetId)
    db.Exec("UPDATE kb_entries SET title='PRIVATE-STORED-CANARY',body='PRIVATE-STORED-BODY' WHERE card_id=&1 AND kind IN ('subtask','dependency')", cardId)
  Else If mode = "details-update" Then
    cardId = Val(Env["WEBA_PUBLIC_CARD"])
    CardContent.Save(id, cardId, Val(Env["WEBA_PUBLIC_FIELD"]), "custom", "Time tracking", "Updated field", 0, False, 0, "text")
    db.Exec("UPDATE kb_cards SET title='Renamed <related>' WHERE id=&1", Val(Env["WEBA_PUBLIC_TARGET"]))
  Else If mode = "details-hide" Then
    db.Exec("UPDATE kb_cards SET board_id=&1,title='PRIVATE-TARGET-CANARY' WHERE id=&2", Val(Env["WEBA_PUBLIC_FOREIGN_BOARD"]), Val(Env["WEBA_PUBLIC_TARGET"]))
  Else If mode = "children-update" Then
    cardId = Val(Env["WEBA_PUBLIC_CARD"])
    CardContent.Save(id, cardId, Val(Env["WEBA_PUBLIC_COMMENT"]), "comment", "", "Updated guest comment", 0, False, 0)
    CardContent.Save(id, cardId, Val(Env["WEBA_PUBLIC_ITEM"]), "checkitem", "Updated task", "", Val(Env["WEBA_PUBLIC_CHECKLIST"]), False, 0)
  Else If mode = "children-delete" Then
    cardId = Val(Env["WEBA_PUBLIC_CARD"])
    CardContent.DeleteEntry(id, cardId, Val(Env["WEBA_PUBLIC_COMMENT"]))
    CardContent.DeleteEntry(id, cardId, Val(Env["WEBA_PUBLIC_CHECKLIST"]))
  Else If mode = "private" Or mode = "public" Or mode = "instance" Then
    BoardVisibility.SavePermission(id, mode)
  Else If mode = "rename" Then
    db.Exec("UPDATE kb_boards SET title=&1 WHERE id=&2", Env["WEBA_PUBLIC_TITLE"], id)
  Else If mode = "archive" Then
    KanbanStore.ArchiveBoard(id, True)
  Endif
  data["boardCount"] = db.Find("kb_boards").Count
  data["cardCount"] = db.Find("kb_cards").Count
  data["visibilityCount"] = 0
  If db.Tables.Exist("kb_board_visibility") Then data["visibilityCount"] = db.Find("kb_board_visibility").Count
  data["memberCount"] = db.Find("kb_members").Count
  Print JSON.Encode(data)
End
