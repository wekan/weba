' Shared fixture dispatch only; production exports do not read test flags.
Public Function FormatName() As String
  Dim value As String = Env["WEBA_TEST_ISSUE_FORMAT"]
  If Not value Then Return "github"
  If value <> "github" And value <> "gitea" And value <> "forgejo" And value <> "gitlab" Then Error.Raise("Unknown issue fixture format")
  Return value
End

Public Function Build(boardId As Integer) As String
  If FormatName() = "gitlab" Then Return BoardTransfer.ExportActiveBoardGitlab(boardId)
  If FormatName() = "forgejo" Then Return BoardTransfer.ExportActiveBoardForgejo(boardId)
  If FormatName() = "gitea" Then Return BoardTransfer.ExportActiveBoardGitea(boardId)
  Return BoardTransfer.ExportActiveBoardGithub(boardId)
End
