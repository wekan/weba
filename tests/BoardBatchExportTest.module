  taigaData = JSON.Decode(files[0]["content"])
  If taigaData["format"] <> "taiga" Or taigaData["board"]["title"] <> "Export Alpha" Then Error.Raise("Taiga snapshot metadata drifted")
  If InStr(files[0]["content"], "Ignored archived card") Or InStr(files[0]["content"], "Planner archived canary") Then Error.Raise("Taiga exported archived content")
