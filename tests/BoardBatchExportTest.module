  If kanriData["id"] <> CStr(a) Or kanriData["title"] <> "Export Alpha" Or kanriData["columns"].Count <> 4 Or kanriData["columns"][3]["cards"].Count Then Error.Raise("Kanri board or empty duplicate column drifted")
