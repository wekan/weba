  data = CardDates.Parse(kanriData["createdAt"])
  If kanriData["lastEdited"] <> kanriData["createdAt"] Or Not data["valid"] Then Error.Raise("Kanri timestamp fallback drifted")
  For Each kanriColumn In kanriData["columns"]
