Public Sub Main()
  Dim a As Integer
  Dim b As Integer
  Dim cardId As Integer
  Dim formulaCard As Integer
  Dim selection As Collection
  Dim batch As Collection
  Dim csvBatch As Collection
  Dim scsvBatch As Collection
  Dim tsvBatch As Collection
  Dim excelBatch As Collection
  Dim files As Variant[]
  Dim data As Collection
  Dim settings As Collection
  Dim before As String
  Dim csv As String
  Dim excelRow As Variant[]
  Dim denied As Boolean
  WebDatabase.Register("batch-export-global", "x")
  WebDatabase.Register("batch-export-owner", "x")
  WebDatabase.Register("batch-export-other", "x")
  SignIn("batch-export-owner")
  a = KanbanStore.AddBoard("Export Alpha")
  cardId = KanbanStore.SaveCard(a, 0, "Alpha card", "Alpha body", "Default", "Todo", "", "", "")
  CardContent.UploadFile(a, cardId, "alpha.bin", "A")
  formulaCard = KanbanStore.SaveCard(a, 0, "=SUM(1,2)", "Comma, quote " & Chr(34) & " and" & Chr(10) & "line", "Default", "Todo", "batch-export-owner", "red, urgent", "")
  BoardAccess.SetAssignees(a, formulaCard, ["batch-export-owner"])
  BoardAccess.RestoreCardMembers(a, formulaCard, ["batch-export-owner"])
  data = New Collection
  data["startAt"] = CardDates.Parse("2026-11-10T01:02:03.004Z")
  data["dueAt"] = CardDates.Parse("2026-11-12T05:06:07.008Z")
  CardDates.Apply(a, formulaCard, data)
  b = KanbanStore.AddBoard("Export Bravo")
  cardId = KanbanStore.SaveCard(b, 0, "Bravo card", "Bravo body", "Default", "Todo", "", "", "")
  CardContent.UploadFile(b, cardId, "bravo.bin", "BBB")
  selection = BoardSelection.NewState()
  BoardSelection.SetActive(selection, True)
  BoardSelection.AddVisible(selection, [a, b])
  batch = BoardBatchExport.NewBatch(selection)
  SignIn("batch-export-global")
  settings = TransferPolicy.Settings()
  settings["attachmentsDownloadMaxBytes"] = 2
  TransferPolicy.Save(settings)
  SignIn("batch-export-owner")
  before = Frame()
  Try BoardBatchExport.Run(batch, selection)
  denied = Error
  If Not denied Or BoardBatchExport.Completed(batch) <> 1 Or BoardBatchExport.Remaining(batch) <> 1 Or batch["busy"] Then Error.Raise("Failed batch export lost its pending-only queue")
  If Frame() <> before Then Error.Raise("Batch export wrote application data")
  files = BoardBatchExport.Files(batch)
  If files.Count <> 1 Or files[0]["name"] <> "board-" & CStr(a) & ".json" Then Error.Raise("Completed export lost caller order or safe name")
  data = JSON.Decode(files[0]["content"])
  If data["format"] <> "weba-2" Or data["title"] <> "Export Alpha" Or data["files"][0]["base64"] <> Base64("A") Then Error.Raise("Completed export lost exact data")
  files[0]["content"] = "tampered"
  If BoardBatchExport.Files(batch)[0]["content"] = "tampered" Then Error.Raise("Export getter exposed private queue state")
  SignIn("batch-export-global")
  settings["attachmentsDownloadMaxBytes"] = 0
  TransferPolicy.Save(settings)
  SignIn("batch-export-owner")
  BoardBatchExport.Run(batch, selection)
  If BoardBatchExport.Completed(batch) <> 2 Or BoardBatchExport.Remaining(batch) Then Error.Raise("Retry did not export only the pending board")
  files = BoardBatchExport.Files(batch)
  data = JSON.Decode(files[1]["content"])
  If data["title"] <> "Export Bravo" Or data["files"][0]["base64"] <> Base64("BBB") Then Error.Raise("Pending retry lost exact second board")
  before = Frame()
  BoardBatchExport.Run(batch, selection)
  If BoardBatchExport.Completed(batch) <> 2 Or Frame() <> before Then Error.Raise("Completed export replay changed state")
  csvBatch = BoardBatchExport.NewBatch(selection, "csv")
  BoardBatchExport.Run(csvBatch, selection)
  files = BoardBatchExport.Files(csvBatch)
  If files.Count <> 2 Or files[0]["name"] <> "board-" & CStr(a) & ".csv" Or BoardBatchExport.Format(csvBatch) <> "csv" Then Error.Raise("CSV batch lost format, order or extension")
  csv = files[0]["content"]
  If Left(csv, Len(BoardCsvExport.Line(BoardCsvExport.Headers(), ","))) <> BoardCsvExport.Line(BoardCsvExport.Headers(), ",") Then Error.Raise("CSV header drifted from the source fixed-column order")
  If InStr(csv, Chr(13) & Chr(10)) = 0 Or InStr(csv, Chr(34) & "'=SUM(1,2)" & Chr(34)) = 0 Then Error.Raise("CSV lost CRLF rows or spreadsheet-formula guard")
  If InStr(csv, Chr(34) & "Comma, quote " & Chr(34) & Chr(34) & " and" & Chr(10) & "line" & Chr(34)) = 0 Then Error.Raise("CSV quote/newline escaping failed")
  If InStr(csv, "2026-11-10T01:02:03.004Z") = 0 Or InStr(csv, "2026-11-12T05:06:07.008Z") = 0 Or InStr(csv, Chr(34) & "batch-export-owner" & Chr(34)) = 0 Then Error.Raise("CSV lost native dates or assignee")
  scsvBatch = BoardBatchExport.NewBatch(selection, "scsv")
  BoardBatchExport.Run(scsvBatch, selection)
  files = BoardBatchExport.Files(scsvBatch)
  If files.Count <> 2 Or files[0]["name"] <> "board-" & CStr(a) & ".csv" Or BoardBatchExport.Format(scsvBatch) <> "scsv" Then Error.Raise("Semicolon-CSV batch lost format, order or extension")
  csv = files[0]["content"]
  If Left(csv, Len(BoardCsvExport.Line(BoardCsvExport.Headers(), ";"))) <> BoardCsvExport.Line(BoardCsvExport.Headers(), ";") Then Error.Raise("Semicolon-CSV header lost the source delimiter")
  If InStr(csv, Chr(34) & ";" & Chr(34)) = 0 Or InStr(csv, Chr(34) & "Comma, quote " & Chr(34) & Chr(34) & " and" & Chr(10) & "line" & Chr(34)) = 0 Then Error.Raise("Semicolon-CSV delimiter or quoted data drifted")
  tsvBatch = BoardBatchExport.NewBatch(selection, "tsv")
  BoardBatchExport.Run(tsvBatch, selection)
  files = BoardBatchExport.Files(tsvBatch)
  If files.Count <> 2 Or files[0]["name"] <> "board-" & CStr(a) & ".tsv" Or BoardBatchExport.Format(tsvBatch) <> "tsv" Then Error.Raise("TSV batch lost format, order or extension")
  csv = files[0]["content"]
  If Left(csv, Len(BoardCsvExport.Line(BoardCsvExport.Headers(), Chr(9)))) <> BoardCsvExport.Line(BoardCsvExport.Headers(), Chr(9)) Then Error.Raise("TSV header lost the source delimiter")
  If InStr(csv, Chr(34) & Chr(9) & Chr(34)) = 0 Or InStr(csv, Chr(34) & "Comma, quote " & Chr(34) & Chr(34) & " and" & Chr(10) & "line" & Chr(34)) = 0 Then Error.Raise("TSV delimiter or quoted data drifted")
  excelBatch = BoardBatchExport.NewBatch(selection, "excel")
  BoardBatchExport.Run(excelBatch, selection)
  files = BoardBatchExport.Files(excelBatch)
  If files.Count <> 2 Or files[0]["name"] <> "board-" & CStr(a) & ".xlsx" Or BoardBatchExport.Format(excelBatch) <> "excel" Then Error.Raise("Excel batch lost format, order or descriptor extension")
  data = JSON.Decode(files[0]["content"])
  If data["title"] <> "Export Alpha" Or data["description"] <> "" Or data["createdAt"] <> "" Or data["modifiedAt"] <> "" Then Error.Raise("Excel descriptor lost board metadata or source-only blanks")
  If JSON.Encode(data["headerKeys"]) <> JSON.Encode(BoardExcelExport.HeaderKeys()) Or data["headerKeys"].Count <> 20 Then Error.Raise("Excel descriptor header order drifted from the source workbook")
  If data["rows"].Count <> 2 Then Error.Raise("Excel descriptor lost active cards")
  excelRow = data["rows"][1]
  If excelRow.Count <> 20 Or excelRow[0] <> "2" Or excelRow[1] <> "=SUM(1,2)" Or excelRow[2] <> "Comma, quote " & Chr(34) & " and" & Chr(10) & "line" Then Error.Raise("Excel descriptor lost fixed columns or exact text")
  If excelRow[8] <> "2026-11-10T01:02:03.004Z" Or excelRow[9] <> "2026-11-12T05:06:07.008Z" Or excelRow[11] <> "Todo" Or excelRow[12] <> "Default" Or excelRow[13] <> "batch-export-owner" Or excelRow[14] <> "batch-export-owner" Or excelRow[17] <> "red, urgent" Or excelRow[18] <> "false" Then Error.Raise("Excel descriptor lost native dates, containers, people, labels or overtime default")
  batch = BoardBatchExport.NewBatch(selection)
  batch["busy"] = True
  Try BoardBatchExport.Run(batch, selection)
  denied = Error
  If Not denied Or Not batch["busy"] Or BoardBatchExport.Completed(batch) Then Error.Raise("Reentrant export unlocked or advanced its queue")
  batch["busy"] = False
  BoardSelection.Toggle(selection, b, [a, b])
  BoardSelection.Toggle(selection, b, [a, b])
  Try BoardBatchExport.Run(batch, selection)
  denied = Error
  If Not denied Or BoardBatchExport.Completed(batch) Then Error.Raise("Stale selection revision exported")
  batch = BoardBatchExport.NewBatch(selection)
  SignIn("batch-export-other")
  Try BoardBatchExport.Run(batch, selection)
  denied = Error
  If Not denied Or BoardBatchExport.Completed(batch) Then Error.Raise("Foreign actor reused an export queue")
  SignIn("batch-export-owner")
  batch = BoardBatchExport.NewBatch(selection)
  WorkspaceStore.SetArchived(a, "board", a, True)
  Try BoardBatchExport.Run(batch, selection)
  denied = Error
  If Not denied Or Error.Text <> "Select active boards first" Or BoardBatchExport.Completed(batch) Or BoardBatchExport.Remaining(batch) <> 2 Then Error.Raise("Archived selected board leaked or consumed its queue entry")
  WorkspaceStore.SetArchived(a, "board", a, False)
  SignIn("batch-export-global")
  ImportExportPolicy.Save(False, True)
  SignIn("batch-export-owner")
  Try BoardBatchExport.Run(batch, selection)
  denied = Error
  If Not denied Or Error.Text <> "Export is disabled by the administrator." Or BoardBatchExport.Completed(batch) Then Error.Raise("Disabled export leaked or advanced its queue")
  Print "Selected JSON/comma/semicolon-CSV/TSV/Excel batch export: exact ordered files, fixed quoted rows/CRLF/formula/date/people cells and 20-column workbook descriptors, no-write failure, private snapshots, pending-only retry, repeat/reentrant/revision/actor/archive/policy guards passed"
End

Private Function Frame() As String
  Dim db As Connection = WebDatabase.OpenConnection()
  Dim tables As String[] = ["users", "kb_boards", "kb_lanes", "kb_lists", "kb_cards", "kb_files", "kb_entries", "kb_activity", "kb_members", "kb_meta", "attachment_transfer_settings"]
  Dim tableName As String
  Dim r As Result
  Dim row As Collection
  Dim rows As Variant[]
  Dim data As New Variant[]
  Dim field As ResultField
  For Each tableName In tables
    rows = New Variant[]
    r = db.Find(tableName)
    For Each r
      row = New Collection
      For Each field In r.Fields
        If field.Name = "content" Then
          row.Add(Base64(r!content.Data), field.Name)
        Else
          row.Add(r[field.Name], field.Name)
        Endif
      Next
      rows.Add(row)
    Next
    data.Add(rows)
  Next
  Return JSON.Encode(data)
End

Private Sub SignIn(username As String)
  Session["username"] = username
  Session["auth_generation"] = WebDatabase.SessionGeneration(username)
End
