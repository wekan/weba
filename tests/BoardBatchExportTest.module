  wrikeData = JSON.Decode(files[1]["content"])
  If wrikeData["board"]["title"] <> "Export Bravo" Or wrikeData["items"].Count <> 1 Or wrikeData["items"][0]["title"] <> "Bravo card" Then Error.Raise("Wrike workbook board isolation drifted")
  teamworkBatch = BoardBatchExport.NewBatch(selection, "teamwork")
  BoardBatchExport.Run(teamworkBatch, selection)
  files = BoardBatchExport.Files(teamworkBatch)
  If files.Count <> 2 Or files[0]["name"] <> "board-" & CStr(a) & ".xlsx" Or BoardBatchExport.Format(teamworkBatch) <> "teamwork" Then Error.Raise("Teamwork format or batch order drifted")
  teamworkData = JSON.Decode(files[0]["content"])
  If teamworkData["format"] <> "teamwork" Or teamworkData["board"]["title"] <> "Export Alpha" Then Error.Raise("Teamwork snapshot metadata drifted")
  If InStr(files[0]["content"], "Ignored archived card") Or InStr(files[0]["content"], "Planner archived canary") Then Error.Raise("Teamwork exported archived content")
  teamworkData = JSON.Decode(files[1]["content"])
  If teamworkData["board"]["title"] <> "Export Bravo" Or teamworkData["items"].Count <> 1 Or teamworkData["items"][0]["title"] <> "Bravo card" Then Error.Raise("Teamwork board isolation drifted")
  quireBatch = BoardBatchExport.NewBatch(selection, "quire")
  BoardBatchExport.Run(quireBatch, selection)
  files = BoardBatchExport.Files(quireBatch)
  If files.Count <> 2 Or files[0]["name"] <> "board-" & CStr(a) & ".csv" Or BoardBatchExport.Format(quireBatch) <> "quire" Then Error.Raise("Quire format or batch order drifted")
  If Left(files[0]["content"], 8) <> "ID,Paren" Or InStr(files[0]["content"], "Alpha card") = 0 Then Error.Raise("Quire CSV header/content drifted")
  If InStr(files[0]["content"], "Ignored archived card") Or InStr(files[0]["content"], "Planner archived canary") Then Error.Raise("Quire exported archived content")
  If InStr(files[1]["content"], "Bravo card") = 0 Or InStr(files[1]["content"], "Alpha card") Then Error.Raise("Quire board isolation drifted")
  notionBatch = BoardBatchExport.NewBatch(selection, "notion")
  BoardBatchExport.Run(notionBatch, selection)
  files = BoardBatchExport.Files(notionBatch)
  If files.Count <> 2 Or files[0]["name"] <> "board-" & CStr(a) & ".csv" Or files[0]["format"] <> "notion" Or BoardBatchExport.Format(notionBatch) <> "notion" Then Error.Raise("Notion format or batch order drifted")
