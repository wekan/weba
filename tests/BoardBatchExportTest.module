  files = BoardBatchExport.Files(tasksOrgBatch)
  If files.Count <> 2 Or files[0]["name"] <> "board-" & CStr(a) & ".json" Or BoardBatchExport.Format(tasksOrgBatch) <> "tasksorg" Then Error.Raise("Tasks.org format or batch order drifted")
  tasksOrgData = JSON.Decode(files[0]["content"])
  If tasksOrgData["version"] <> 151300 Or tasksOrgData["timestamp"] <= 0 Or tasksOrgData["data"]["caldavAccounts"][0]["name"] <> "Export Alpha" Then Error.Raise("Tasks.org backup header/account drifted")
  If InStr(files[0]["content"], "Ignored archived card") Or InStr(files[0]["content"], "Private archived canary") Then Error.Raise("Tasks.org leaked archived content")
