  vikunjaBatch = BoardBatchExport.NewBatch(selection, "vikunja")
  BoardBatchExport.Run(vikunjaBatch, selection)
  files = BoardBatchExport.Files(vikunjaBatch)
  If files.Count <> 2 Or files[0]["name"] <> "board-" & CStr(a) & ".zip" Or files[0]["format"] <> "vikunja" Or BoardBatchExport.Format(vikunjaBatch) <> "vikunja" Then Error.Raise("Vikunja format or batch order drifted")
  vikunjaData = JSON.Decode(files[0]["content"])
  If vikunjaData["format"] <> "vikunja" Or vikunjaData["board"]["title"] <> "Export Alpha" Then Error.Raise("Vikunja snapshot metadata drifted")
