      If nullboardList["title"] <> "Todo" Or nullboardNote["text"] <> "Heading line" & Chr(10) & "Body line" & Chr(10) & Chr(10) & "NB steps" & Chr(10) & "[x] Quote" & Chr(10) & "[ ] Pay" Or CBool(nullboardNote["min"]) Then Error.Raise("Nullboard note title, description, checklist, raw or min mapping drifted")
    Next
  Next
  If Not nullboardFound Or InStr(nullboard, "dropme") Or InStr(nullboard, "2026-11-12") Then Error.Raise("Nullboard raw label or unsupported metadata filtering drifted")
  nullboardData = JSON.Decode(files[1]["content"])
  If nullboardData["title"] <> "Export Bravo" Or nullboardData["lists"].Count <> 3 Or nullboardData["lists"][0]["notes"].Count <> 1 Or nullboardData["lists"][0]["notes"][0]["text"] <> "Bravo card" & Chr(10) & "Bravo body" Then Error.Raise("Nullboard second-board lists or note drifted")
  WorkspaceStore.SetSetting(a, "card", nullboardCard, "color", "#ABCDEF")
  kanriDue = ItemChanges.UtcNow()
