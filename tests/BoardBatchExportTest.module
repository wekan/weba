Public Sub Main()
  Dim a As Integer
  Dim b As Integer
  Dim cardId As Integer
  Dim formulaCard As Integer
  Dim selection As Collection
  Dim batch As Collection
  Dim csvBatch As Collection
  Dim scsvBatch As Collection
  Dim tsvBatch As Collection
  Dim excelBatch As Collection
  Dim kanboardBatch As Collection
  Dim markdownBatch As Collection
  Dim leoBatch As Collection
  Dim opmlBatch As Collection
  Dim orgModeBatch As Collection
  Dim todoTxtBatch As Collection
  Dim taskwarriorBatch As Collection
  Dim focalboardBatch As Collection
  Dim todoistBatch As Collection
  Dim plannerArchived As Integer
  Dim plannerRetained As Result
  Dim plannerBatch As Collection
  Dim meisterTaskBatch As Collection
  Dim obsidianBatch As Collection
  Dim linearBatch As Collection
  Dim tickTickBatch As Collection
  Dim clickUpBatch As Collection
  Dim notionBatch As Collection
  Dim notionData As Collection
  Dim quireBatch As Collection
  Dim teamworkBatch As Collection
  Dim teamworkData As Collection
  Dim wrikeBatch As Collection
  Dim wrikeData As Collection
  Dim workflowBatch As Collection
  Dim workflowData As Collection
  Dim vikunjaBatch As Collection
  Dim vikunjaData As Collection
  Dim taigaBatch As Collection
  Dim taigaData As Collection
  Dim spBatch As Collection
  Dim spData As Collection
  Dim businessmapBatch As Collection
  Dim businessmapData As Collection
  Dim mondayBatch As Collection
  Dim mondayData As Collection
  Dim tasksOrgBatch As Collection
  Dim tasksOrgData As Collection
  Dim redmineBatch As Collection
  Dim redmine As String
  Dim pivotalBatch As Collection
  Dim pivotalCard As Integer
  Dim pivotalArchived As Integer
  Dim pivotal As String
  Dim kanriBatch As Collection
  Dim kanriData As Collection
  Dim kanriColumn As Collection
  Dim kanriCard As Collection
  Dim kanriFound As Boolean
  Dim kanriDue As Long
  Dim nullboardBatch As Collection
  Dim files As Variant[]
  Dim data As Collection
  Dim settings As Collection
  Dim before As String
  Dim csv As String
  Dim excelRow As Variant[]
  Dim kanboardTask As Collection
  Dim markdown As String
  Dim leo As String
  Dim opml As String
  Dim orgMode As String
  Dim orgCard As Integer
  Dim todoTxt As String
  Dim todoCard As Integer
  Dim taskwarrior As String
  Dim taskCard As Integer
  Dim tickTickCard As Integer
  Dim nullboardCard As Integer
  Dim taskwarriorData As Variant[]
  Dim taskwarriorTask As Collection
  Dim focalboard As String
  Dim focalLines As String[]
  Dim focalRow As Collection
  Dim focalBoardData As Collection
  Dim focalStatus As Collection
  Dim focalCard As Collection
  Dim focalRange As Collection
  Dim focalStatusId As String
  Dim focalFoundCard As Boolean
  Dim focalFoundDescription As Boolean
  Dim focalFoundCheckbox As Boolean
  Dim focalFoundComment As Boolean
  Dim todoist As String
  Dim todoistCard As Integer
  Dim plannerRows As Variant[]
  Dim plannerRow As Variant[]
  Dim plannerFound As Boolean
  Dim meisterTask As String
  Dim obsidian As String
  Dim linear As String
  Dim tickTick As String
  Dim clickUp As String
  Dim nullboard As String
  Dim nullboardData As Collection
  Dim nullboardList As Collection
  Dim nullboardNote As Collection
  Dim nullboardFound As Boolean
  Dim i As Integer
  Dim checklist As Integer
  Dim denied As Boolean
  WebDatabase.Register("batch-export-global", "x")
  WebDatabase.Register("batch-export-owner", "x")
  WebDatabase.Register("batch-export-other", "x")
  SignIn("batch-export-owner")
  a = KanbanStore.AddBoard("Export Alpha")
  cardId = KanbanStore.SaveCard(a, 0, "Alpha card", "Alpha body", "Default", "Todo", "", "", "")
  CardContent.UploadFile(a, cardId, "alpha.bin", "A")
  formulaCard = KanbanStore.SaveCard(a, 0, "=SUM(1,2)", "Comma, quote " & Chr(34) & " and" & Chr(10) & "line", "Default", "Todo", "batch-export-owner", "red, urgent", "")
  BoardAccess.SetAssignees(a, formulaCard, ["batch-export-owner"])
  BoardAccess.RestoreCardMembers(a, formulaCard, ["batch-export-owner"])
  data = New Collection
  data["startAt"] = CardDates.Parse("2026-11-10T01:02:03.004Z")
  data["dueAt"] = CardDates.Parse("2026-11-12T05:06:07.008Z")
  CardDates.Apply(a, formulaCard, data)
  checklist = CardContent.Save(a, formulaCard, 0, "checklist", "Checks", "", 0, False, 0)
  CardContent.Save(a, formulaCard, 0, "checkitem", "Checked", "", checklist, True, 0)
  CardContent.Save(a, formulaCard, 0, "comment", "", "Kanboard comment", 0, False, 0)
  CardContent.Save(a, formulaCard, 0, "dependency", "", "", 0, False, cardId)
  b = KanbanStore.AddBoard("Export Bravo")
  cardId = KanbanStore.SaveCard(b, 0, "Bravo card", "Bravo body", "Default", "Todo", "", "", "")
  CardContent.UploadFile(b, cardId, "bravo.bin", "BBB")
  selection = BoardSelection.NewState()
  BoardSelection.SetActive(selection, True)
  BoardSelection.AddVisible(selection, [a, b])
  batch = BoardBatchExport.NewBatch(selection)
  SignIn("batch-export-global")
  settings = TransferPolicy.Settings()
  settings["attachmentsDownloadMaxBytes"] = 2
  TransferPolicy.Save(settings)
  SignIn("batch-export-owner")
  before = Frame()
  Try BoardBatchExport.Run(batch, selection)
  denied = Error
  If Not denied Or BoardBatchExport.Completed(batch) <> 1 Or BoardBatchExport.Remaining(batch) <> 1 Or batch["busy"] Then Error.Raise("Failed batch export lost its pending-only queue")
  If Frame() <> before Then Error.Raise("Batch export wrote application data")
  files = BoardBatchExport.Files(batch)
  If files.Count <> 1 Or files[0]["name"] <> "board-" & CStr(a) & ".json" Then Error.Raise("Completed export lost caller order or safe name")
  data = JSON.Decode(files[0]["content"])
  If data["format"] <> "weba-2" Or data["title"] <> "Export Alpha" Or data["files"][0]["base64"] <> Base64("A") Then Error.Raise("Completed export lost exact data")
  files[0]["content"] = "tampered"
  If BoardBatchExport.Files(batch)[0]["content"] = "tampered" Then Error.Raise("Export getter exposed private queue state")
  SignIn("batch-export-global")
  settings["attachmentsDownloadMaxBytes"] = 0
  TransferPolicy.Save(settings)
  SignIn("batch-export-owner")
  BoardBatchExport.Run(batch, selection)
  If BoardBatchExport.Completed(batch) <> 2 Or BoardBatchExport.Remaining(batch) Then Error.Raise("Retry did not export only the pending board")
  files = BoardBatchExport.Files(batch)
  data = JSON.Decode(files[1]["content"])
  If data["title"] <> "Export Bravo" Or data["files"][0]["base64"] <> Base64("BBB") Then Error.Raise("Pending retry lost exact second board")
  before = Frame()
  BoardBatchExport.Run(batch, selection)
  If BoardBatchExport.Completed(batch) <> 2 Or Frame() <> before Then Error.Raise("Completed export replay changed state")
  csvBatch = BoardBatchExport.NewBatch(selection, "csv")
  BoardBatchExport.Run(csvBatch, selection)
  files = BoardBatchExport.Files(csvBatch)
  If files.Count <> 2 Or files[0]["name"] <> "board-" & CStr(a) & ".csv" Or BoardBatchExport.Format(csvBatch) <> "csv" Then Error.Raise("CSV batch lost format, order or extension")
  csv = files[0]["content"]
  If Left(csv, Len(BoardCsvExport.Line(BoardCsvExport.Headers(), ","))) <> BoardCsvExport.Line(BoardCsvExport.Headers(), ",") Then Error.Raise("CSV header drifted from the source fixed-column order")
  If InStr(csv, Chr(13) & Chr(10)) = 0 Or InStr(csv, Chr(34) & "'=SUM(1,2)" & Chr(34)) = 0 Then Error.Raise("CSV lost CRLF rows or spreadsheet-formula guard")
  If InStr(csv, Chr(34) & "Comma, quote " & Chr(34) & Chr(34) & " and" & Chr(10) & "line" & Chr(34)) = 0 Then Error.Raise("CSV quote/newline escaping failed")
  If InStr(csv, "2026-11-10T01:02:03.004Z") = 0 Or InStr(csv, "2026-11-12T05:06:07.008Z") = 0 Or InStr(csv, Chr(34) & "batch-export-owner" & Chr(34)) = 0 Then Error.Raise("CSV lost native dates or assignee")
  scsvBatch = BoardBatchExport.NewBatch(selection, "scsv")
  BoardBatchExport.Run(scsvBatch, selection)
  files = BoardBatchExport.Files(scsvBatch)
  If files.Count <> 2 Or files[0]["name"] <> "board-" & CStr(a) & ".csv" Or BoardBatchExport.Format(scsvBatch) <> "scsv" Then Error.Raise("Semicolon-CSV batch lost format, order or extension")
  csv = files[0]["content"]
  If Left(csv, Len(BoardCsvExport.Line(BoardCsvExport.Headers(), ";"))) <> BoardCsvExport.Line(BoardCsvExport.Headers(), ";") Then Error.Raise("Semicolon-CSV header lost the source delimiter")
  If InStr(csv, Chr(34) & ";" & Chr(34)) = 0 Or InStr(csv, Chr(34) & "Comma, quote " & Chr(34) & Chr(34) & " and" & Chr(10) & "line" & Chr(34)) = 0 Then Error.Raise("Semicolon-CSV delimiter or quoted data drifted")
  tsvBatch = BoardBatchExport.NewBatch(selection, "tsv")
  BoardBatchExport.Run(tsvBatch, selection)
  files = BoardBatchExport.Files(tsvBatch)
  If files.Count <> 2 Or files[0]["name"] <> "board-" & CStr(a) & ".tsv" Or BoardBatchExport.Format(tsvBatch) <> "tsv" Then Error.Raise("TSV batch lost format, order or extension")
  csv = files[0]["content"]
  If Left(csv, Len(BoardCsvExport.Line(BoardCsvExport.Headers(), Chr(9)))) <> BoardCsvExport.Line(BoardCsvExport.Headers(), Chr(9)) Then Error.Raise("TSV header lost the source delimiter")
  If InStr(csv, Chr(34) & Chr(9) & Chr(34)) = 0 Or InStr(csv, Chr(34) & "Comma, quote " & Chr(34) & Chr(34) & " and" & Chr(10) & "line" & Chr(34)) = 0 Then Error.Raise("TSV delimiter or quoted data drifted")
  excelBatch = BoardBatchExport.NewBatch(selection, "excel")
  BoardBatchExport.Run(excelBatch, selection)
  files = BoardBatchExport.Files(excelBatch)
  If files.Count <> 2 Or files[0]["name"] <> "board-" & CStr(a) & ".xlsx" Or BoardBatchExport.Format(excelBatch) <> "excel" Then Error.Raise("Excel batch lost format, order or descriptor extension")
  data = JSON.Decode(files[0]["content"])
  If data["title"] <> "Export Alpha" Or data["description"] <> "" Or data["createdAt"] <> "" Or data["modifiedAt"] <> "" Then Error.Raise("Excel descriptor lost board metadata or source-only blanks")
  If JSON.Encode(data["headerKeys"]) <> JSON.Encode(BoardExcelExport.HeaderKeys()) Or data["headerKeys"].Count <> 20 Then Error.Raise("Excel descriptor header order drifted from the source workbook")
  If data["rows"].Count <> 2 Then Error.Raise("Excel descriptor lost active cards")
  excelRow = data["rows"][1]
  If excelRow.Count <> 20 Or excelRow[0] <> "2" Or excelRow[1] <> "=SUM(1,2)" Or excelRow[2] <> "Comma, quote " & Chr(34) & " and" & Chr(10) & "line" Then Error.Raise("Excel descriptor lost fixed columns or exact text")
  If excelRow[8] <> "2026-11-10T01:02:03.004Z" Or excelRow[9] <> "2026-11-12T05:06:07.008Z" Or excelRow[11] <> "Todo" Or excelRow[12] <> "Default" Or excelRow[13] <> "batch-export-owner" Or excelRow[14] <> "batch-export-owner" Or excelRow[17] <> "red, urgent" Or excelRow[18] <> "false" Then Error.Raise("Excel descriptor lost native dates, containers, people, labels or overtime default")
  kanboardBatch = BoardBatchExport.NewBatch(selection, "kanboard")
  BoardBatchExport.Run(kanboardBatch, selection)
  files = BoardBatchExport.Files(kanboardBatch)
  If files.Count <> 2 Or files[0]["name"] <> "board-" & CStr(a) & ".json" Or BoardBatchExport.Format(kanboardBatch) <> "kanboard" Then Error.Raise("Kanboard batch lost format, order or extension")
  data = JSON.Decode(files[0]["content"])
  If data["board"]["name"] <> "Export Alpha" Or data["columns"][0]["title"] <> "Todo" Or data["swimlanes"][0]["name"] <> "Default" Or data["tasks"].Count <> 2 Then Error.Raise("Kanboard export lost board containers or active tasks")
  kanboardTask = data["tasks"][1]
  If kanboardTask["id"] <> 2 Or kanboardTask["title"] <> "=SUM(1,2)" Or kanboardTask["description"] <> "Comma, quote " & Chr(34) & " and" & Chr(10) & "line" Or kanboardTask["column_name"] <> "Todo" Or kanboardTask["swimlane_name"] <> "Default" Then Error.Raise("Kanboard task identity or exact text drifted")
  If kanboardTask["date_started"] <> "2026-11-10T01:02:03.004Z" Or kanboardTask["date_due"] <> "2026-11-12T05:06:07.008Z" Or kanboardTask["tags"].Count <> 2 Or kanboardTask["tags"][0] <> "red" Or kanboardTask["tags"][1] <> "urgent" Then Error.Raise("Kanboard task dates or tags were lost")
  If kanboardTask["subtasks"].Count <> 1 Or kanboardTask["subtasks"][0]["title"] <> "Checked" Or kanboardTask["subtasks"][0]["status"] <> 2 Then Error.Raise("Kanboard checklist mapping drifted")
  If kanboardTask["comments"].Count <> 1 Or kanboardTask["comments"][0]["comment"] <> "Kanboard comment" Or kanboardTask["comments"][0]["username"] <> "batch-export-owner" Then Error.Raise("Kanboard comment mapping drifted")
  If kanboardTask["links"].Count <> 1 Or kanboardTask["links"][0]["task_id"] <> 1 Or kanboardTask["links"][0]["label"] <> "relates to" Or data["tasks"][0]["links"][0]["task_id"] <> 2 Then Error.Raise("Kanboard reciprocal task links drifted")
  KanbanStore.SaveCard(a, 0, "Finished card", "First" & Chr(10) & Chr(10) & "Second", "Default", "Done", "", "", "")
  markdownBatch = BoardBatchExport.NewBatch(selection, "markdown")
  BoardBatchExport.Run(markdownBatch, selection)
  files = BoardBatchExport.Files(markdownBatch)
  If files.Count <> 2 Or files[0]["name"] <> "board-" & CStr(a) & ".md" Or BoardBatchExport.Format(markdownBatch) <> "markdown" Then Error.Raise("Markdown batch lost format, order or extension")
  markdown = files[0]["content"]
  If Left(markdown, Len("# Export Alpha" & Chr(10) & Chr(10) & "## Todo" & Chr(10) & Chr(10))) <> "# Export Alpha" & Chr(10) & Chr(10) & "## Todo" & Chr(10) & Chr(10) Then Error.Raise("Markdown board or non-empty list headings drifted")
  If InStr(markdown, "- [ ] Alpha card" & Chr(10) & "  Alpha body") = 0 Or InStr(markdown, "- [ ] =SUM(1,2)" & Chr(10) & "  Comma, quote " & Chr(34) & " and" & Chr(10) & "  line") = 0 Then Error.Raise("Markdown cards or description continuation lines drifted")
  If InStr(markdown, "## Doing") Or InStr(markdown, "## Done" & Chr(10) & Chr(10) & "- [x] Finished card" & Chr(10) & "  First" & Chr(10) & "  Second") = 0 Or Right(markdown, 1) <> Chr(10) Then Error.Raise("Markdown empty-list, terminal-list, blank-description-line or trailing-newline contract drifted")
  KanbanStore.SaveCard(a, 0, "Check <valve>", "a < b && c > d", "Default", "Done", "", "", "")
  leoBatch = BoardBatchExport.NewBatch(selection, "leo")
  BoardBatchExport.Run(leoBatch, selection)
  files = BoardBatchExport.Files(leoBatch)
  If files.Count <> 2 Or files[0]["name"] <> "board-" & CStr(a) & ".leo" Or BoardBatchExport.Format(leoBatch) <> "leo" Then Error.Raise("Leo batch lost format, order or extension")
  leo = files[0]["content"]
  If Left(leo, Len("<?xml version=" & Chr(34) & "1.0" & Chr(34) & " encoding=" & Chr(34) & "utf-8" & Chr(34) & "?>")) <> "<?xml version=" & Chr(34) & "1.0" & Chr(34) & " encoding=" & Chr(34) & "utf-8" & Chr(34) & "?>" Or InStr(leo, "wekan_board=" & Chr(34) & "Export Alpha" & Chr(34)) = 0 Then Error.Raise("Leo declaration or board header drifted")
  If InStr(leo, "<vh>Todo</vh>") = 0 Or InStr(leo, "<vh>Doing</vh>") = 0 Or InStr(leo, "<vh>Done</vh>") = 0 Or InStr(leo, " a=" & Chr(34) & "M" & Chr(34) & "><vh>Finished card</vh>") = 0 Then Error.Raise("Leo lists or terminal-card mark drifted")
  If InStr(leo, "<vh>Checks</vh>") = 0 Or InStr(leo, " a=" & Chr(34) & "M" & Chr(34) & "><vh>Checked</vh>") = 0 Or InStr(leo, "<t tx=") = 0 Or InStr(leo, "Comma, quote &quot; and" & Chr(10) & "line") = 0 Or InStr(leo, "Check &lt;valve&gt;") = 0 Or InStr(leo, "a &lt; b &amp;&amp; c &gt; d") = 0 Then Error.Raise("Leo checklist, body node or XML escaping drifted")
  If InStr(leo, "</vnodes>" & Chr(10) & "<tnodes>") = 0 Or Right(leo, 1) <> Chr(10) Then Error.Raise("Leo vnodes/tnodes ordering or trailing newline drifted")
  opmlBatch = BoardBatchExport.NewBatch(selection, "opml")
  BoardBatchExport.Run(opmlBatch, selection)
  files = BoardBatchExport.Files(opmlBatch)
  If files.Count <> 2 Or files[0]["name"] <> "board-" & CStr(a) & ".opml" Or BoardBatchExport.Format(opmlBatch) <> "opml" Then Error.Raise("OPML batch lost format, order or extension")
  opml = files[0]["content"]
  If Left(opml, Len("<?xml version=" & Chr(34) & "1.0" & Chr(34) & " encoding=" & Chr(34) & "UTF-8" & Chr(34) & "?>")) <> "<?xml version=" & Chr(34) & "1.0" & Chr(34) & " encoding=" & Chr(34) & "UTF-8" & Chr(34) & "?>" Or InStr(opml, "<title>Export Alpha</title>") = 0 Then Error.Raise("OPML declaration or board title drifted")
  If InStr(opml, "    <outline text=" & Chr(34) & "Todo" & Chr(34)) = 0 Or InStr(opml, "    <outline text=" & Chr(34) & "Doing" & Chr(34) & "/>") = 0 Or InStr(opml, "    <outline text=" & Chr(34) & "Done" & Chr(34)) = 0 Then Error.Raise("OPML list outlines or indentation drifted")
  If InStr(opml, "text=" & Chr(34) & "Finished card" & Chr(34) & " _note=" & Chr(34) & "First&#10;&#10;Second" & Chr(34) & " _complete=" & Chr(34) & "true" & Chr(34)) = 0 Or InStr(opml, "Check &lt;valve&gt;") = 0 Or InStr(opml, "a &lt; b &amp;&amp; c &gt; d") = 0 Then Error.Raise("OPML note, completion or XML attribute escaping drifted")
  If InStr(opml, "<outline text=" & Chr(34) & "Checks" & Chr(34) & ">") = 0 Or InStr(opml, "<outline text=" & Chr(34) & "Checked" & Chr(34) & " _complete=" & Chr(34) & "true" & Chr(34) & "/>") = 0 Or Right(opml, 1) <> Chr(10) Then Error.Raise("OPML checklist nesting, completed item or trailing newline drifted")
  orgCard = KanbanStore.SaveCard(a, 0, "Planned" & String.Chr(160) & String.Chr(160) & "card", "Line one" & Chr(13) & Chr(10) & Chr(13) & "Line three", "Default", "Todo", "", "priority:A, tag value, done, Mötley Crüe", "")
  data = New Collection
  data["startAt"] = CardDates.Parse("2026-11-10T00:00:00.000Z")
  data["dueAt"] = CardDates.Parse("2026-11-12T05:06:07.008Z")
  data["endAt"] = CardDates.Parse("2026-11-13T00:00:00.000Z")
  CardDates.Apply(a, orgCard, data)
  checklist = CardContent.Save(a, orgCard, 0, "checklist", "Release checks", "", 0, False, 0)
  CardContent.Save(a, orgCard, 0, "checkitem", "Open item", "", checklist, False, 0)
  CardContent.Save(a, orgCard, 0, "checkitem", "Closed item", "", checklist, True, 0)
  orgModeBatch = BoardBatchExport.NewBatch(selection, "orgmode")
  BoardBatchExport.Run(orgModeBatch, selection)
  files = BoardBatchExport.Files(orgModeBatch)
  If files.Count <> 2 Or files[0]["name"] <> "board-" & CStr(a) & ".org" Or BoardBatchExport.Format(orgModeBatch) <> "orgmode" Then Error.Raise("Org mode batch lost format, order or extension")
  orgMode = files[0]["content"]
  If Left(orgMode, Len("#+TITLE: Export Alpha" & Chr(10) & "#+TODO: TODO | DONE" & Chr(10) & Chr(10) & "* Todo" & Chr(10))) <> "#+TITLE: Export Alpha" & Chr(10) & "#+TODO: TODO | DONE" & Chr(10) & Chr(10) & "* Todo" & Chr(10) Then Error.Raise("Org mode header or first list drifted")
  If InStr(orgMode, "** TODO =SUM(1,2) :red:urgent:" & Chr(10) & "   SCHEDULED: <2026-11-10 Tue 01:02> DEADLINE: <2026-11-12 Thu 05:06>") = 0 Then Error.Raise("Org mode open-card tags or UTC planning stamps drifted")
  If InStr(orgMode, "   Comma, quote " & Chr(34) & " and" & Chr(10) & "   line" & Chr(10) & "*** Checks" & Chr(10) & "**** DONE Checked") = 0 Then Error.Raise("Org mode description or checklist hierarchy drifted")
  If InStr(orgMode, "** DONE [#A] Planned card :tag_value:Mötley_Crüe:" & Chr(10) & "   SCHEDULED: <2026-11-10 Tue> DEADLINE: <2026-11-12 Thu 05:06> CLOSED: [2026-11-13 Fri]" & Chr(10) & "   Line one" & Chr(10) & Chr(10) & "   Line three" & Chr(10) & "*** Release checks" & Chr(10) & "**** TODO Open item" & Chr(10) & "**** DONE Closed item") = 0 Then Error.Raise("Org mode priority, done label, Unicode tags, normalized description, closed stamp or checklist states drifted")
  If InStr(orgMode, "* Doing" & Chr(10) & "* Done" & Chr(10) & "** DONE Finished card") = 0 Or Right(orgMode, 1) <> Chr(10) Then Error.Raise("Org mode empty list, terminal card or trailing newline drifted")
  todoCard = KanbanStore.SaveCard(a, 0, "Ship" & Chr(10) & "valve", "Ignored description", "Default", "Done", "", "priority:B, project name, @work shop", "")
  data = New Collection
  data["startAt"] = CardDates.Parse("2026-11-10T01:02:03.004Z")
  data["dueAt"] = CardDates.Parse("2026-11-12T05:06:07.008Z")
  data["endAt"] = CardDates.Parse("2026-11-13T09:10:11.012Z")
  CardDates.Apply(a, todoCard, data)
  todoTxtBatch = BoardBatchExport.NewBatch(selection, "todotxt")
  BoardBatchExport.Run(todoTxtBatch, selection)
  files = BoardBatchExport.Files(todoTxtBatch)
  If files.Count <> 2 Or files[0]["name"] <> "board-" & CStr(a) & ".txt" Or BoardBatchExport.Format(todoTxtBatch) <> "todotxt" Then Error.Raise("todo.txt batch lost format, order or extension")
  todoTxt = files[0]["content"]
  If Left(todoTxt, Len("Alpha card list:Todo" & Chr(10) & "=SUM(1,2) +red +urgent due:2026-11-12 t:2026-11-10 list:Todo" & Chr(10))) <> "Alpha card list:Todo" & Chr(10) & "=SUM(1,2) +red +urgent due:2026-11-12 t:2026-11-10 list:Todo" & Chr(10) Then Error.Raise("todo.txt open task, project tags, dates or source order drifted")
  If InStr(todoTxt, "x Finished card list:Done" & Chr(10)) = 0 Or InStr(todoTxt, "(A) Planned card +tag_value +done +Mötley_Crüe due:2026-11-12 t:2026-11-10 list:Todo" & Chr(10)) = 0 Then Error.Raise("todo.txt terminal state, open priority, Unicode projects or metadata drifted")
  If InStr(todoTxt, "x Ship valve +project_name @work_shop pri:B due:2026-11-12 t:2026-11-10 list:Done" & Chr(10)) = 0 Or InStr(todoTxt, "2026-11-13") Or Right(todoTxt, 1) <> Chr(10) Then Error.Raise("todo.txt completed priority/context, whitespace, unsupported completion date or trailing newline drifted")
  taskCard = KanbanStore.SaveCard(a, 0, "Repair" & Chr(9) & "pump", "Task details" & Chr(10) & "second line", "Default", "Done", "", "priority:H, project:Plant.Pumps, shop floor", "")
  data = New Collection
  data["startAt"] = CardDates.Parse("2026-11-10T01:02:03.004Z")
  data["dueAt"] = CardDates.Parse("2026-11-12T05:06:07.008Z")
  data["endAt"] = CardDates.Parse("2026-11-13T09:10:11.012Z")
  CardDates.Apply(a, taskCard, data)
  CardContent.Save(a, taskCard, 0, "comment", "", "Call " & Chr(34) & "vendor" & Chr(10) & "today", 0, False, 0)
  taskwarriorBatch = BoardBatchExport.NewBatch(selection, "taskwarrior")
  BoardBatchExport.Run(taskwarriorBatch, selection)
  files = BoardBatchExport.Files(taskwarriorBatch)
  If files.Count <> 2 Or files[0]["name"] <> "board-" & CStr(a) & ".json" Or BoardBatchExport.Format(taskwarriorBatch) <> "taskwarrior" Then Error.Raise("Taskwarrior batch lost format, order or extension")
  taskwarrior = files[0]["content"]
  If Left(taskwarrior, 5) <> "[" & Chr(10) & "  {" Or Right(taskwarrior, 2) <> "]" & Chr(10) Then Error.Raise("Taskwarrior pretty array or trailing newline drifted")
  If BoardTaskwarriorExport.Uuid(1) <> "340ca71c-350c-48af-b60c-aa42370cabd5" Or BoardTaskwarriorExport.Uuid(2) <> "370cabd5-360c-4a42-b50c-a8af340ca71c" Or BoardTaskwarriorExport.Uuid(3) <> "360caa42-370c-4bd5-b40c-a71c350ca8af" Or BoardTaskwarriorExport.Uuid(6) <> "330ca589-320c-43f6-b10c-a263300ca0d0" Then Error.Raise("Taskwarrior deterministic UUID drifted")
  taskwarriorData = JSON.Decode(taskwarrior)
  taskwarriorTask = taskwarriorData[taskwarriorData.Count - 1]
