' Only copied into disposable integration-test projects, never installed.
Public Sub Main()
  Dim boardId As Integer
  Dim otherId As Integer
  Dim cardId As Integer
  Dim r As Result
  Dim db As Connection
  Dim deadline As Float
  Dim memberAction As String
  Dim memberPayload As Collection
  Dim memberOperation As String
  Dim personField As String
  Dim nativePeople As Boolean
  Dim data As New Collection
  If Env["WEBA_TEST_FIXTURE"] <> "1" Then Error.Raise("Disposable fixture required")
  If Env["WEBA_TEST_MODE"] = "delete-content" Then
    Session["username"] = Env["WEBA_TEST_USER"]
    Session["auth_generation"] = WebDatabase.SessionGeneration(Session["username"])
    boardId = KanbanStore.AddBoard("REST deletion retained board")
    cardId = KanbanStore.SaveCard(boardId, 0, "REST retained card", "REST retained body", "Default", "Todo", Session["username"], "", "")
    BoardAccess.SetMember(boardId, "rest-other", "board-admin")
    BoardAccess.SetAssignees(boardId, cardId, [Session["username"], "rest-other"])
    BoardAccess.RestoreCardMembers(boardId, cardId, [Session["username"], "rest-other"])
    CardContent.Save(boardId, cardId, 0, "comment", "", "REST retained comment", 0, False, 0)
    CardContent.AddFile(boardId, cardId, "retained.bin", "retained" & Chr(0) & "bytes")
    CardContent.StartTimer(boardId, cardId)
    WorkspaceStore.SetSetting(boardId, "board", boardId, "star", "1")
    data["boardId"] = boardId
    data["cardId"] = cardId
    Print JSON.Encode(data)
    Return
  Endif
  If Env["WEBA_TEST_MODE"] = "seed-user" Then
    Session["username"] = "rest-owner"
    Session["auth_generation"] = WebDatabase.SessionGeneration(Session["username"])
    WebDatabase.NewUser(Env["WEBA_TEST_USER"], Env["WEBA_TEST_PASSWORD"], Env["WEBA_TEST_ADMIN"] = "1")
    data["id"] = Env["WEBA_TEST_USER"]
    Print JSON.Encode(data)
    Return
  Endif
  If Env["WEBA_TEST_MODE"] = "reset" Then
    Session["username"] = "rest-owner"
    Session["auth_generation"] = WebDatabase.SessionGeneration(Session["username"])
    WebDatabase.ForceResetPassword("rest-owner", "rest-owner", Env["WEBA_TEST_PASSWORD"] & "-changed")
    Return
  Endif
  If Env["WEBA_TEST_MODE"] = "recreate-other" Then
    Session["username"] = "rest-owner"
    Session["auth_generation"] = WebDatabase.SessionGeneration(Session["username"])
    WebDatabase.DeleteUser("rest-other")
    WebDatabase.NewUser("rest-other", Env["WEBA_TEST_PASSWORD"], False)
    Return
  Endif
  If Env["WEBA_TEST_MODE"] = "card-people-commit" Then
    data = JSON.Decode(Env["WEBA_TEST_BOARDS"])
    boardId = data["otherBoardId"]
    cardId = data["otherCardId"]
    otherId = data["otherListId"]
    personField = Env["WEBA_TEST_PERSON_FIELD"]
    memberAction = Env["WEBA_TEST_PERSON_ACTION"]
    If personField = "replace" Then
      memberPayload = New Collection
      If memberAction = "add" Then
        memberPayload["members"] = ["rest-member", "rest-other", "rest-member"]
        memberPayload["assignees"] = ["rest-other", "rest-member", "rest-other"]
      Else
        memberPayload["members"] = New String[]
        memberPayload["assignees"] = New String[]
      Endif
    Else If personField = "dates" Then
      memberPayload = New Collection
      If memberAction = "add" Then
        memberPayload["members"] = ["rest-member", "rest-other"]
        memberPayload["dueAt"] = "2026-06-20T12:34:56.123Z"
        memberPayload["startAt"] = 0
        memberPayload["description"] = "Date and description commit"
      Else
        memberPayload["members"] = New String[]
        memberPayload["dueAt"] = JSON.Null
        memberPayload["startAt"] = JSON.Null
        memberPayload["description"] = JSON.Null
      Endif
    Endif
    db = WebDatabase.OpenConnection()
    db.Timeout = 1
    nativePeople = Env["WEBA_TEST_NATIVE_CARD_PEOPLE"] = "1"
    If nativePeople Then
      Session["username"] = "rest-other"
      Session["auth_generation"] = WebDatabase.SessionGeneration(Session["username"])
      If personField = "assignees" Then
        Try BoardAccess.ChangeCardAssignee(boardId, cardId, "rest-member", memberAction = "add")
      Else
        Try BoardAccess.ChangeCardMember(boardId, cardId, "rest-member", memberAction = "add")
      Endif
      If Not Error Then Error.Raise("Expected rejected native member commit")
    Else
      WebIdentity.AuthenticateApi("rest-owner")
      If personField = "replace" Or personField = "dates" Then
        data = BoardAccess.UpdateApiCardPeople(boardId, otherId, cardId, memberPayload)
      Else
        data = BoardAccess.MutateApiCardPerson(boardId, otherId, cardId, personField, "rest-member", memberAction = "add")
      Endif
      If data["status"] <> 500 Then Error.Raise("Expected rejected card people commit")
      If data["data"]["error"] <> "Card membership update failed" Then Error.Raise("Card people failure was not sanitized")
      If BoardAccess.Can(boardId, "manageBoard") Then Error.Raise("Card authority leaked after commit failure")
    Endif
    File.Save(Application.Path &/ "card-people-commit-failed", "ready")
    deadline = Timer + 10
    While Not Exist(Application.Path &/ "card-people-reader-released")
      If Timer > deadline Then Error.Raise("Card people reader release timed out")
      Sleep 0.01
    Wend
    If nativePeople Then
      If personField = "assignees" Then
        BoardAccess.ChangeCardAssignee(boardId, cardId, "rest-member", memberAction = "add")
      Else
        BoardAccess.ChangeCardMember(boardId, cardId, "rest-member", memberAction = "add")
      Endif
    Else
      If personField = "replace" Or personField = "dates" Then
        data = BoardAccess.UpdateApiCardPeople(boardId, otherId, cardId, memberPayload)
      Else
        data = BoardAccess.MutateApiCardPerson(boardId, otherId, cardId, personField, "rest-member", memberAction = "add")
      Endif
      If data["status"] <> 200 Then Error.Raise("Card people retry failed")
      If BoardAccess.Can(boardId, "manageBoard") Then Error.Raise("Card authority leaked after retry")
    Endif
    Print "Card people failed COMMIT rolled back data/history and recovered without authority leakage"
    Return
  Endif
  If Env["WEBA_TEST_MODE"] = "member-commit" Then
    data = JSON.Decode(Env["WEBA_TEST_BOARDS"])
    boardId = data["otherBoardId"]
    db = WebDatabase.OpenConnection()
    db.Timeout = 1
    memberAction = Env["WEBA_TEST_MEMBER_ACTION"]
    If Not memberAction Then memberAction = "set"
    memberOperation = memberAction
    memberPayload = New Collection
    If memberAction = "inactive-set" Then
      memberOperation = "set"
      memberPayload["role"] = "admin"
    Else If memberAction = "set" Then
      memberPayload["role"] = "readonly"
    Else
      memberPayload["action"] = memberAction
      memberPayload["role"] = "normal"
    Endif
    WebIdentity.AuthenticateApi("rest-owner")
    data = BoardAccess.MutateApiMember(boardId, "rest-member", memberOperation, memberPayload)
    If data["status"] <> 500 Then Error.Raise("Expected rejected membership commit")
    If data["data"]["error"] <> "Membership update failed" Then Error.Raise("Membership error was not sanitized")
    If BoardAccess.Can(boardId, "manageBoard") Then Error.Raise("Member authority leaked after commit failure")
    File.Save(Application.Path &/ ("member-commit-failed-" & memberAction), "ready")
    deadline = Timer + 10
    While Not Exist(Application.Path &/ ("member-reader-released-" & memberAction))
      If Timer > deadline Then Error.Raise("Member commit reader release timed out")
      Sleep 0.01
    Wend
    data = BoardAccess.MutateApiMember(boardId, "rest-member", memberOperation, memberPayload)
    If data["status"] <> 200 Then Error.Raise("Membership retry failed")
    If BoardAccess.Can(boardId, "manageBoard") Then Error.Raise("Member authority leaked after retry")
    Print "Member commit rollback retained roles/flags/history and recovered without authority leakage"
    Return
  Endif
  If Env["WEBA_TEST_MODE"] = "list-clock-failure" Then
    data = JSON.Decode(Env["WEBA_TEST_BOARDS"])
    boardId = data["otherBoardId"]
    otherId = data["otherListId"]
    cardId = data["otherCardId"]
    Session["username"] = "rest-other"
    Session["auth_generation"] = WebDatabase.SessionGeneration(Session["username"])
    Select Env["WEBA_TEST_CLOCK_ACTION"]
      Case "comment"
        Try CardContent.Save(boardId, cardId, 0, "comment", "", "Discarded comment", 0, False, 0)
      Case "delete-entry"
        Try CardContent.DeleteEntry(boardId, cardId, CInt(Env["WEBA_TEST_CLOCK_ENTRY_ID"]))
      Case "start"
        Try CardContent.StartTimer(boardId, cardId)
      Case "stop"
        Try CardContent.StopTimer(boardId, cardId)
      Case "file"
        Try CardContent.AddFile(boardId, cardId, "clock.txt", "Discarded attachment")
      Case "delete-file"
        Try CardContent.DeleteFile(boardId, cardId, CInt(Env["WEBA_TEST_CLOCK_FILE_ID"]))
      Case "archive"
        Try KanbanStore.ArchiveCard(boardId, cardId, True)
      Case "setting"
        Try WorkspaceStore.SetSetting(boardId, "list", otherId, "color", "#112233")
      Case Else
        Error.Raise("Unknown clock fixture action")
    End Select
    If Not Error Then Error.Raise("Expected clock write failure")
    ' Gambas 3.20's SQLite Result.Update reports the constraint category,
    ' while newer drivers may retain the trigger message. No other failing
    ' constraints/triggers are installed in this disposable phase.
    If InStr(Error.Text, "private clock failure") = 0 And InStr(Error.Text, "Abort due to constraint violation") = 0 Then Error.Raise("Unexpected clock failure (" & Env["WEBA_TEST_CLOCK_ACTION"] & "): " & Error.Text)
    Print "Native change rejected at clock write"
    Return
  Endif
  If Env["WEBA_TEST_MODE"] = "list-clock-native" Then
    data = JSON.Decode(Env["WEBA_TEST_BOARDS"])
    boardId = data["otherBoardId"]
    otherId = data["otherListId"]
    cardId = data["otherCardId"]
    Session["username"] = "rest-other"
    Session["auth_generation"] = WebDatabase.SessionGeneration(Session["username"])
    Select Env["WEBA_TEST_CLOCK_ACTION"]
      Case "prepare"
        CardContent.OpenStore()
      Case "archive"
        KanbanStore.ArchiveCard(boardId, cardId, True)
      Case "restore"
        KanbanStore.ArchiveCard(boardId, cardId, False)
      Case "rename"
        WorkspaceStore.Rename(boardId, "list", otherId, "Timed list")
      Case "watch"
        WorkspaceStore.SetSetting(boardId, "list", otherId, "watch", "1")
      Case Else
        Error.Raise("Unknown clock fixture action")
    End Select
    Return
  Endif
  If Env["WEBA_TEST_MODE"] = "board-read-scope" Then
    data = JSON.Decode(Env["WEBA_TEST_BOARDS"])
    boardId = data["otherBoardId"]
    otherId = data["otherListId"]
    WebIdentity.AuthenticateApi("rest-owner")
    data = BoardAccess.ReadApiBoard(boardId, "lists")
    If data["status"] <> 200 Then Error.Raise("Global administrator read denied")
    If BoardAccess.Can(boardId, "manageBoard") Then Error.Raise("Read authority leaked after success")
    db = WebDatabase.OpenConnection()
    ' SQLite-only fault injection in this disposable fixture, never production.
    db.Exec("ALTER TABLE kb_order RENAME TO kb_order_read_failure")
    data = BoardAccess.ReadApiBoard(boardId, "cards", otherId)
    db.Exec("ALTER TABLE kb_order_read_failure RENAME TO kb_order")
    If data["status"] <> 500 Then Error.Raise("Expected sanitized read failure")
    If data["data"]["error"] <> "Board read failed" Then Error.Raise("Read failure exposed internals")
    If BoardAccess.Can(boardId, "manageBoard") Then Error.Raise("Read authority leaked after failure")
    data = BoardAccess.ReadApiBoard(boardId, "board")
    If data["status"] <> 200 Then Error.Raise("Read retry failed")
    If BoardAccess.Can(boardId, "manageBoard") Then Error.Raise("Read authority leaked after retry")
    Print "REST read authority reset after success/failure/retry without changing native board permissions"
    Return
  Endif
  If Env["WEBA_TEST_MODE"] = "member-scope" Then
    data = JSON.Decode(Env["WEBA_TEST_BOARDS"])
    WebIdentity.AuthenticateApi("rest-owner")
    r = Null
    data = BoardAccess.MutateApiMember(data["otherBoardId"], "rest-member", "set", JSON.Decode("{\"role\":\"normal\"}"))
    If data["status"] <> 400 Then Error.Raise("Expected last-admin rejection")
    data = JSON.Decode(Env["WEBA_TEST_BOARDS"])
    If BoardAccess.Can(data["otherBoardId"], "manageBoard") Then Error.Raise("API member override leaked after rejection")
    data = BoardAccess.MutateApiMember(data["otherBoardId"], "rest-member", "add", JSON.Decode("{\"action\":\"add\",\"role\":\"normal\"}"))
    If data["status"] <> 200 Then Error.Raise("Expected idempotent member add")
    data = JSON.Decode(Env["WEBA_TEST_BOARDS"])
    If BoardAccess.Can(data["otherBoardId"], "manageBoard") Then Error.Raise("API member override leaked after success")
    If BoardAccess.Can(0, "manageBoard") Then Error.Raise("API member override accepted its unset sentinel")
    Print "API member authority remains scoped after failure and success"
    Return
  Endif
  WebDatabase.Register("rest-owner", Env["WEBA_TEST_PASSWORD"])
  WebDatabase.Register("rest-other", Env["WEBA_TEST_PASSWORD"])
  Session["username"] = "rest-owner"
  Session["auth_generation"] = WebDatabase.SessionGeneration(Session["username"])
  boardId = KanbanStore.AddBoard("Private owner board")
  r = KanbanStore.Lanes(boardId)
  r = KanbanStore.Lists(boardId, "Default")
  KanbanStore.SaveCard(boardId, 0, "Private card", "Private body", "Default", "Todo", "rest-owner", "", "", r!id)
  Session["username"] = "rest-other"
  Session["auth_generation"] = WebDatabase.SessionGeneration(Session["username"])
  otherId = KanbanStore.AddBoard("Other user's private board")
  data["boardId"] = boardId
  data["otherBoardId"] = otherId
  If Env["WEBA_TEST_MEMBERS"] = "1" Then
    r = KanbanStore.Lanes(otherId)
    r = KanbanStore.Lists(otherId, "Default")
    data["otherListId"] = r!id
    data["otherCardId"] = KanbanStore.SaveCard(otherId, 0, "Other member card", "Member fixture body", "Default", "Todo", "rest-other", "", "", r!id)
    r = WebDatabase.OpenConnection().Create("kb_meta")
    r["board_id"] = otherId
    r["kind"] = "board"
    r["item_id"] = otherId
    r["setting"] = "star"
    r["value"] = "1"
    r.Update()
    WebDatabase.Register("rest-member", Env["WEBA_TEST_PASSWORD"])
    WebDatabase.Register("rest-deleted", Env["WEBA_TEST_PASSWORD"])
    Session["username"] = "rest-deleted"
    Session["auth_generation"] = WebDatabase.SessionGeneration(Session["username"])
    data["orphanBoardId"] = KanbanStore.AddBoard("Orphan API board")
    Session["username"] = "rest-owner"
    Session["auth_generation"] = WebDatabase.SessionGeneration(Session["username"])
    WebDatabase.DeleteUser("rest-deleted")
  Endif
  Print JSON.Encode(data)
End
