' Filename policy stages; upload workflows choose their entry points explicitly.
Export

Private Function RunPolicy(filename As String, mode As String, Optional mime As String) As Variant
  Dim request As New Collection
  If Len(filename) > 4096 Then Error.Raise("Filename normalization failed")
  request.Add(Base64(filename), "filename")
  request.Add(mode, "mode")
  If mode = "correct" Then
    If Len(mime) > 1024 Then Error.Raise("Filename normalization failed")
    request.Add(Base64(mime), "mime")
  Endif
  Return Exchange(JsonText.Encode(request))
End

Private Sub RequireAck(worker As Process, state As Collection, expected As Integer, deadline As Float)
  While state["acks"] < expected
    If state["invalid"] Or worker.State <> Process.Running Or Timer >= deadline Then Error.Raise("Filename normalization failed")
    worker.Wait(Max(0.001, deadline - Timer))
  Wend
  If state["invalid"] Then Error.Raise("Filename normalization failed")
End

Private Function Exchange(payload As String, Optional responseLimit As Integer = 4096) As Variant
  Dim worker As Process
  Dim state As New Collection
  Dim value As Variant
  Dim deadline As Float
  Dim offset As Integer
  Dim expected As Integer = 2
  Dim piece As String
  If Not payload Or Len(payload) > 98304 Then Error.Raise("Filename normalization failed")
  If responseLimit <> 4096 And responseLimit <> 8192 Then Error.Raise("Filename normalization failed")
  state.Add(responseLimit, "responseLimit")
  state.Add("", "text")
  state.Add(False, "invalid")
  state.Add(0, "acks")
  state.Add(1, "ackLimit")
  deadline = Timer + 3
  worker = Exec ["python3", "-I", "-S", "-c", File.Load(".public/native-filename-policy.py"), File.Load(".public/native-filename-data.b64"), File.Load(".public/native-mime-data.b64")] For Read Write As "PolicyWorker"
  worker.Tag = state
  RequireAck(worker, state, 1, deadline)
  Print #worker, Str(Len(payload))
  For offset = 1 To Len(payload) Step 2048
    piece = Mid(payload, offset, 2048)
    state["ackLimit"] = expected
    Write #worker, piece, Len(piece)
    RequireAck(worker, state, expected, deadline)
    Inc expected
  Next
  worker.CloseInput()
  While worker.State = Process.Running And Timer < deadline
    worker.Wait(Max(0.001, deadline - Timer))
  Wend
  If worker.State <> Process.Stopped Or worker.Value <> 0 Or state["invalid"] Then Error.Raise("Filename normalization failed")
  value = JsonText.Decode(state["text"], responseLimit)
  worker.Tag = Null
  Return value
Catch
  If worker Then
    If worker.State = Process.Running Then
      Try worker.Kill()
      deadline = Timer + 1
      While worker.State = Process.Running And Timer < deadline
        Try worker.Wait(Max(0.001, deadline - Timer))
      Wend
    Endif
  Endif
  Error.Raise("Filename normalization failed")
End

Public Sub PolicyWorker_Read()
  Dim worker As Process = Last
  Dim state As Collection = worker.Tag
  Dim chunk As String = Read #worker, -4096
  Dim plain As String
  If Not state Then Return
  plain = Replace(chunk, Chr(30), "")
  state["acks"] = state["acks"] + Len(chunk) - Len(plain)
  If state["acks"] > state["ackLimit"] Or Len(state["text"]) + Len(plain) > state["responseLimit"] Then
    state["invalid"] = True
    Try worker.Kill()
  Else
    state["text"] = state["text"] & plain
  Endif
End

Public Sub PolicyWorker_Error(discarded As String)
  Dim worker As Process = Last
  Dim state As Collection = worker.Tag
  If state Then state["invalid"] = True
  Try worker.Kill()
End

Private Function CheckedName(value As Variant) As String
  If TypeOf(value) <> gb.String Then Error.Raise("Filename normalization failed")
  If ExportText.Length(value) > 30 Then Error.Raise("Filename normalization failed")
  Return value
End

Public Function BeforeUpload(filename As String) As String
  Return CheckedName(RunPolicy(filename, "before"))
End

Public Function InteractiveName(filename As String) As String
  Dim value As Variant = RunPolicy(filename, "interactive")
  Dim verdict As Collection
  If Not (value Is Collection) Then Error.Raise("Filename normalization failed")
  verdict = value
  If Not verdict.Exist("exploit") Or TypeOf(verdict["exploit"]) <> gb.Boolean Or Not verdict.Exist("name") Then Error.Raise("Filename normalization failed")
  If verdict["exploit"] Then Error.Raise("Invalid attachment name")
  Return CheckedName(verdict["name"])
End

Public Function CorrectUploadName(filename As String, mime As String) As String
  Return CheckedName(RunPolicy(filename, "correct", mime))
End

Public Function DetectMimeHeader(header As String) As Variant
  Dim request As New Collection
  Dim value As Variant
  Dim mime As String
  Dim slash As Integer
  Dim i As Integer
  request.Add("detect", "mode")
  request.Add(Base64(Left(header, 65536)), "header")
  value = Exchange(JsonText.Encode(request), 8192)
  If IsNull(value) Then Return Null
  If TypeOf(value) <> gb.String Then Error.Raise("Filename normalization failed")
  mime = value
  slash = InStr(mime, "/")
  If slash <= 1 Or slash >= Len(mime) Or InStr(Mid(mime, slash + 1), "/") Then Error.Raise("Filename normalization failed")
  For i = 1 To Len(mime)
    If i = slash Then Continue
    If Not InStr("abcdefghijklmnopqrstuvwxyz0123456789!#$&^_.+-", Mid(mime, i, 1)) Then Error.Raise("Filename normalization failed")
  Next
  Return mime
End
