' Interactive filename stages; REST/import workflows have separate entry points.
Export

Private Function RunPolicy(filename As String, mode As String) As Variant
  Dim worker As Process
  Dim request As New Collection
  Dim state As New Collection
  Dim value As Variant
  Dim deadline As Float
  If Len(filename) > 4096 Then Error.Raise("Filename input exceeds policy limit")
  request.Add(Base64(filename), "filename")
  request.Add(mode, "mode")
  state.Add("", "text")
  state.Add(False, "invalid")
  worker = Exec ["python3", "-I", "-S", "-c", File.Load(".public/native-filename-policy.py"), File.Load(".public/native-filename-data.b64")] For Read Write As "PolicyWorker"
  worker.Tag = state
  Print #worker, JsonText.Encode(request)
  worker.CloseInput()
  deadline = Timer + 3
  While worker.State = Process.Running And Timer < deadline
    worker.Wait(Max(0.001, deadline - Timer))
  Wend
  If worker.State <> Process.Stopped Or worker.Value <> 0 Or state["invalid"] Then Error.Raise("Filename normalization failed")
  value = JsonText.Decode(state["text"], 4096)
  worker.Tag = Null
  Return value
Catch
  If worker Then
    If worker.State = Process.Running Then
      Try worker.Kill()
      Try worker.Wait(1)
    Endif
  Endif
  Error.Raise("Filename normalization failed")
End

Public Sub PolicyWorker_Read()
  Dim worker As Process = Last
  Dim state As Collection = worker.Tag
  Dim chunk As String = Read #worker, -4096
  If Not state Then Return
  If Len(state["text"]) + Len(chunk) > 4096 Then
    state["invalid"] = True
    Try worker.Kill()
  Else
    state["text"] = state["text"] & chunk
  Endif
End

Public Sub PolicyWorker_Error(discarded As String)
  Dim worker As Process = Last
  Dim state As Collection = worker.Tag
  If state Then state["invalid"] = True
  Try worker.Kill()
End

Private Function CheckedName(value As Variant) As String
  If TypeOf(value) <> gb.String Then Error.Raise("Filename normalization failed")
  If ExportText.Length(value) > 30 Then Error.Raise("Filename normalization failed")
  Return value
End

Public Function BeforeUpload(filename As String) As String
  Return CheckedName(RunPolicy(filename, "before"))
End

Public Function InteractiveName(filename As String) As String
  Dim value As Variant = RunPolicy(filename, "interactive")
  Dim verdict As Collection
  If Not (value Is Collection) Then Error.Raise("Filename normalization failed")
  verdict = value
  If Not verdict.Exist("exploit") Or TypeOf(verdict["exploit"]) <> gb.Boolean Or Not verdict.Exist("name") Then Error.Raise("Filename normalization failed")
  If verdict["exploit"] Then Error.Raise("Invalid attachment name")
  Return CheckedName(verdict["name"])
End
