' Dedicated single-attachment source JSON export; ordinary reads stay separate.
Export

Public Function BoardId(reference As String) As Integer
  Dim id As Integer = ParseId(reference)
  If id = 0 Then Return 0
  KanbanStore.OpenDatabase()
  If Not WebDatabase.OpenConnection().Find("kb_boards", "id=&1", id).Available Then Return 0
  Return id
End

Private Function ParseId(reference As String) As Integer
  Dim id As Integer
  Dim index As Integer
  If Not reference Or Len(reference) > 10 Then Return 0
  For index = 1 To Len(reference)
    If InStr("0123456789", Mid(reference, index, 1)) = 0 Then Return 0
  Next
  id = CInt(reference)
  If id <= 0 Or CStr(id) <> reference Then Return 0
  Return id
Catch
  Return 0
End

Private Function Result(status As Integer, message As String) As Collection
  Dim outcome As New Collection
  Dim data As New Collection
  data["error"] = message
  outcome["status"] = status
  outcome["data"] = data
  Return outcome
End

Public Function Read(boardId As Integer, reference As String) As Collection
  If Env["WEBA_API_REQUEST"] <> "1" Then Return Result(403, "Forbidden")
  Return Build(boardId, reference, True, 0)
End

Public Function ReadNative(boardId As Integer, cardId As Integer, reference As String) As Collection
  Dim outcome As Collection
  If Env["WEBA_API_REQUEST"] = "1" Then Return Result(403, "Forbidden")
  If cardId <= 0 Then Return Result(404, "Attachment not accessible")
  outcome = Build(boardId, reference, False, cardId)
  If outcome["status"] = 200 Then
    If Not outcome["data"].Exist("_id") Then Return Result(404, "Attachment not accessible")
  Endif
  Return outcome
End

Private Function IdentityValid(actor As String, generation As Long, apiContext As Boolean) As Boolean
  If WebIdentity.Username <> actor Then Return False
  If apiContext Then Return ApiTokens.Authenticate() = actor
  Return WebDatabase.SessionGeneration(actor) = generation
End

Private Function Build(boardId As Integer, reference As String, apiContext As Boolean, expectedCard As Integer) As Collection
  Dim actor As String = WebIdentity.Username
  Dim generation As Long
  Dim transfer As String = If(apiContext, "apiDownload", "attachmentsDownload")
  Dim db As Connection
  Dim r As Result
  Dim metadata As Result
  Dim fileId As Integer = ParseId(reference)
  Dim cardId As Integer
  Dim bytes As String
  Dim mime As String = "application/octet-stream"
  Dim data As New Collection
  Dim outcome As New Collection
  Dim transaction As Boolean
  Dim failure As String
  If apiContext <> (Env["WEBA_API_REQUEST"] = "1") Then Return Result(403, "Forbidden")
  ImportExportPolicy.RequireExport()
  If Not actor Then Return Result(401, If(apiContext, "Invalid token", "Sign in required"))
  generation = WebDatabase.SessionGeneration(actor)
  If Not BoardAccess.Can(boardId, "seesAllCards") Then Return Result(403, "Forbidden")
  If expectedCard > 0 Then BoardAccess.RequireCard(boardId, expectedCard)
  CardContent.OpenStore()
  TransferPolicy.Limit(transfer)
  db = WebDatabase.OpenConnection()
  DatabaseTransactions.Begin(db)
  transaction = True
  db.Exec("UPDATE users SET username=username WHERE username=&1", actor)
  If apiContext Then db.Exec("UPDATE api_tokens SET digest=digest WHERE digest=&1 AND username=&2", Env["WEBA_API_TOKEN_DIGEST"], actor)
  ImportExportPolicy.Lock()
  ImportExportPolicy.RequireExport()
  TransferPolicy.Lock()
  db.Exec("UPDATE kb_boards SET title=title WHERE id=&1", boardId)
  If Not IdentityValid(actor, generation, apiContext) Then Error.Raise(If(apiContext, "Invalid token", "Sign in required"))
  BoardAccess.RequireContainer(boardId, "board", boardId)
  If expectedCard > 0 Then BoardAccess.RequireCard(boardId, expectedCard)
  r = db.Exec("SELECT id,card_id,filename,COALESCE(LENGTH(content),0) AS size FROM kb_files WHERE board_id=&1 AND id=&2 AND (&3=0 OR card_id=&3) AND " & AttachmentLifecycle.LiveSql("kb_files"), boardId, fileId, expectedCard)
  If r.Available Then
    TransferPolicy.RequireTransfer(transfer, r!size)
    cardId = r!card_id
    data["_id"] = CStr(r!id)
    data["cardId"] = CStr(cardId)
    data.Add(CStr(r!filename), "name")
    metadata = db.Find("kb_attachment_data", "board_id=&1 AND card_id=&2 AND file_id=&3", boardId, cardId, fileId)
    If metadata.Available Then
      If Not IsNull(metadata!mime) Then mime = metadata!mime
    Endif
    data.Add(mime, "type")
    r = db.Find("kb_files", "board_id=&1 AND card_id=&2 AND id=&3", boardId, cardId, fileId)
    If Not r.Available Then Error.Raise("Attachment export failed")
    bytes = r!content.Data
    TransferPolicy.RequireTransfer(transfer, Len(bytes))
    data.Add(Base64(bytes), "file")
  Endif
  If Not IdentityValid(actor, generation, apiContext) Then Error.Raise(If(apiContext, "Invalid token", "Sign in required"))
  BoardAccess.RequireContainer(boardId, "board", boardId)
  If expectedCard > 0 Then BoardAccess.RequireCard(boardId, expectedCard)
  ImportExportPolicy.RequireExport()
  If data.Count Then TransferPolicy.RequireTransfer(transfer, Len(bytes))
  DatabaseTransactions.Commit(db)
  transaction = False
  outcome["status"] = 200
  outcome["data"] = data
  Return outcome
Catch
  failure = Error.Text
  If transaction Then Try DatabaseTransactions.Rollback(db)
  Select failure
    Case "Invalid token", "Sign in required"
      Return Result(401, If(apiContext, "Invalid token", "Sign in required"))
    Case "Board not accessible", "Card not accessible", "Board permission denied", "Assigned-only members cannot copy, export or transfer containers"
      Return Result(403, "Forbidden")
    Case "Export is disabled by the administrator."
      outcome = Result(403, failure)
      outcome["plain"] = True
      Return outcome
    Case "API downloads are disabled by administrator", "Attachment downloads are disabled by administrator"
      Return Result(403, failure)
    Case "Attachment exceeds API download limit", "Attachment exceeds download limit"
      Return Result(413, failure)
    Case Else
      Return Result(500, "Attachment export failed")
  End Select
End
