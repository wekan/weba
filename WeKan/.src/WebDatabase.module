' Gambas module file

Export
Private $hConn As Connection

Public Function OpenConnection() As Connection
  If $hConn Then Return $hConn
  $hConn = New Connection
  $hConn.Type = If(Env["WEBA_DB_TYPE"], Env["WEBA_DB_TYPE"], "sqlite3")
  $hConn.Host = If(Env["WEBA_DB_HOST"], Env["WEBA_DB_HOST"], ModVar.PathDatabase)
  $hConn.Name = If(Env["WEBA_DB_NAME"], Env["WEBA_DB_NAME"], "database.db")
  $hConn.Login = Env["WEBA_DB_USER"]
  $hConn.Password = Env["WEBA_DB_PASSWORD"]
  If $hConn.Type = "sqlite3" And Not Exist($hConn.Host &/ $hConn.Name) Then
    CreateSQLiteDatabase()
  Endif
  $hConn.Open()
  EnsureAccountSchema()
  Return $hConn
Catch
  $hConn = Null
  Error.Propagate()
End

Private Sub CreateSQLiteDatabase()
  Dim name As String = $hConn.Name
  $hConn.Name = ""
  $hConn.Open()
  $hConn.Databases.Add(name)
  $hConn.Close()
  $hConn.Name = name
End

Private Sub EnsureAccountSchema()
  Dim t As Table
  If Not $hConn.Tables.Exist("users") Then
    t = $hConn.Tables.Add("users")
    t.Fields.Add("username", db.String, 255)
    t.Fields.Add("password", db.String, 255)
    t.Fields.Add("fullname", db.String, 255)
    t.Fields.Add("admin", db.Boolean)
    t.PrimaryKey = ["username"]
    t.Update()
  Endif
  If Not $hConn.Tables.Exist("account_bootstrap") Then
    t = $hConn.Tables.Add("account_bootstrap")
    t.Fields.Add("id", db.Integer)
    t.PrimaryKey = ["id"]
    t.Update()
  Endif
End

Public Sub Register(username As String, password As String)
  Dim r As Result
  Dim first As Boolean
  Dim transaction As Boolean
  Init()
  username = Trim(username)
  If Not username Or Len(username) > 255 Then Error.Raise("Enter a username (maximum 255 characters)")
  If Len(password) < 8 Then Error.Raise("Use a password of at least 8 characters")
  $hConn.Begin()
  transaction = True
  r = $hConn.Find("users")
  first = Not r.Available
  If first Then
    ' A unique claim inside the same transaction prevents two first admins.
    ' A concurrent losing registration can retry and becomes a normal user.
    r = $hConn.Create("account_bootstrap")
    r["id"] = 1
    r.Update()
  Endif
  $hConn.Exec("INSERT INTO users (username, password, fullname, admin) VALUES (&1, &2, &3, &4)", username, Crypt.Sha256(password), "", first)
  $hConn.Commit()
  transaction = False
Catch
  If transaction Then Try $hConn.Rollback()
  Error.Propagate()
End

Private Sub Init()
  OpenConnection()
End

Private Sub SignedInRequired()
  If Not Session["username"] Then Error.Raise("Please sign in")
  If Not UserExists(Session["username"]) Then Error.Raise("Unknown user")
End

Private Sub AdminRequired()
  SignedInRequired()
  If Not GetIsAdmin(Session["username"]) Then Error.Raise("Administrator required")
End

Private Sub AdminOrOwnRequired(username As String)
  SignedInRequired()
  If username = Session["username"] Then Return
  AdminRequired()
End

Public Function Login(username As String, password As String) As Boolean
  Dim r As Result
  Init()
  r = $hConn.Exec("SELECT password FROM users WHERE username = &1", username)
  If Not r.Available Then Return False
  ' Crypt.Check follows Gambas error convention: True means mismatch.
  Return Not Crypt.Check(password, r["password"])
End

Public Function UserExists(username As String) As Boolean
  Dim r As Result
  Init()
  r = $hConn.Exec("SELECT username FROM users WHERE username = &1", username)
  Return r.Available
End

Public Function GetIsAdmin(username As String) As Boolean
  Dim r As Result
  SignedInRequired()
  Init()
  r = $hConn.Exec("SELECT admin FROM users WHERE username = &1", username)
  If Not r.Available Then Return False
  Return r["admin"]
End

Public Function GetUsers() As Result
  Init()
  AdminRequired()
  Return $hConn.Exec("SELECT username, fullname, admin FROM users ORDER BY username")
End

Public Sub NewUser(username As String, password As String, is_admin As Boolean)
  Init()
  AdminRequired()
  If Not Trim(username) Or Len(password) < 8 Then Error.Raise("Username and password of at least 8 characters required")
  $hConn.Exec("INSERT INTO users (username, password, fullname, admin) VALUES (&1, &2, &3, &4)", Trim(username), Crypt.Sha256(password), "", is_admin)
End

Public Sub DeleteUser(username As String)
  Init()
  AdminRequired()
  If username = Session["username"] Then Error.Raise("Cannot delete your own account")
  $hConn.Exec("DELETE FROM users WHERE username = &1", username)
End

Public Function GetFullname(username As String) As String
  Dim r As Result
  Init()
  AdminOrOwnRequired(username)
  r = $hConn.Exec("SELECT fullname FROM users WHERE username = &1", username)
  If Not r.Available Then Error.Raise("Unknown user")
  Return r["fullname"]
End

Public Sub SetFullname(username As String, fullname As String)
  Init()
  AdminOrOwnRequired(username)
  $hConn.Exec("UPDATE users SET fullname = &1 WHERE username = &2", fullname, username)
End

Public Function SetPassword(username As String, oldpass As String, newpass As String) As Boolean
  Init()
  AdminOrOwnRequired(username)
  If Len(newpass) < 8 Then Error.Raise("Use a password of at least 8 characters")
  If Not Login(username, oldpass) Then Return False
  $hConn.Exec("UPDATE users SET password = &1 WHERE username = &2", Crypt.Sha256(newpass), username)
  Return True
End

Public Function ForceResetPassword(adminuser As String, username As String, newpass As String) As Boolean
  Init()
  ' Always authorize the session, never a caller-supplied administrator name.
  AdminRequired()
  If Len(newpass) < 8 Then Error.Raise("Use a password of at least 8 characters")
  If Not UserExists(username) Then Return False
  $hConn.Exec("UPDATE users SET password = &1 WHERE username = &2", Crypt.Sha256(newpass), username)
  Return True
End

Public Sub SetIsAdmin(username As String, is_admin As Boolean)
  Init()
  AdminRequired()
  If username = Session["username"] And Not is_admin Then Error.Raise("Cannot remove your own administrator role")
  $hConn.Exec("UPDATE users SET admin = &1 WHERE username = &2", is_admin, username)
End
