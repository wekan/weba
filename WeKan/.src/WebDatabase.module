' Gambas module file

Export
Private $hConn As Connection
Public RegistrationError As String

Public Function OpenConnection() As Connection
  If $hConn Then Return $hConn
  $hConn = New Connection
  $hConn.Type = If(Env["WEBA_DB_TYPE"], Env["WEBA_DB_TYPE"], "sqlite3")
  $hConn.Host = If(Env["WEBA_DB_HOST"], Env["WEBA_DB_HOST"], ModVar.PathDatabase)
  $hConn.Name = If(Env["WEBA_DB_NAME"], Env["WEBA_DB_NAME"], "database.db")
  $hConn.Login = Env["WEBA_DB_USER"]
  $hConn.Password = Env["WEBA_DB_PASSWORD"]
  If $hConn.Type = "sqlite3" And Not Exist($hConn.Host &/ $hConn.Name) Then
    CreateSQLiteDatabase()
  Endif
  $hConn.Open()
  EnsureAccountSchema()
  Return $hConn
Catch
  $hConn = Null
  Error.Propagate()
End

Private Sub CreateSQLiteDatabase()
  Dim name As String = $hConn.Name
  $hConn.Name = ""
  $hConn.Open()
  $hConn.Databases.Add(name)
  $hConn.Close()
  $hConn.Name = name
End

Private Sub EnsureAccountSchema()
  Dim t As Table
  If Not $hConn.Tables.Exist("users") Then
    t = $hConn.Tables.Add("users")
    t.Fields.Add("username", db.String, 255)
    t.Fields.Add("password", db.String, 255)
    t.Fields.Add("fullname", db.String, 255)
    t.Fields.Add("admin", db.Boolean)
    t.PrimaryKey = ["username"]
    t.Update()
  Endif
  If Not $hConn.Tables.Exist("account_settings") Then
    t = $hConn.Tables.Add("account_settings")
    t.Fields.Add("id", db.Integer)
    t.Fields.Add("password_length_enforce", db.Boolean)
    t.Fields.Add("password_min_length", db.Integer)
    t.PrimaryKey = ["id"]
    t.Update()
  Endif
  If Not $hConn.Tables.Exist("account_bootstrap") Then
    t = $hConn.Tables.Add("account_bootstrap")
    t.Fields.Add("id", db.Integer)
    t.PrimaryKey = ["id"]
    t.Update()
  Endif
  If Not $hConn.Tables.Exist("account_generation_ids") Then
    t = $hConn.Tables.Add("account_generation_ids")
    t.Fields.Add("id", db.Serial)
    t.Fields.Add("allocated", db.Boolean)
    t.PrimaryKey = ["id"]
    t.Update()
  Endif
  If Not $hConn.Tables.Exist("account_sessions") Then
    t = $hConn.Tables.Add("account_sessions")
    t.Fields.Add("username", db.String, 255)
    t.Fields.Add("generation", db.Long)
    t.PrimaryKey = ["username"]
    t.Update()
  Endif
  ' Prepare display-only deletion provenance before any account transaction.
  RetiredAuthors.OpenStore()
End

Public Function SessionGeneration(username As String) As Long
  Dim r As Result
  Init()
  If Not username Or Not UserExists(username) Then Return 0
  r = $hConn.Find("account_sessions", "username = &1", username)
  If r.Available Then Return r!generation
  Return 0
End

Public Function LoginGeneration(username As String, password As String) As Long
  Dim generation As Long
  Dim transaction As Boolean
  Dim failure As String
  Init()
  DatabaseTransactions.Begin($hConn)
  transaction = True
  ' Verify credentials and choose their session version under the same lock.
  $hConn.Exec("UPDATE users SET username = username WHERE username = &1", username)
  If Not Login(username, password) Then
    DatabaseTransactions.Rollback($hConn)
    transaction = False
    Return 0
  Endif
  generation = SessionGeneration(username)
  If Not generation Then generation = RotateSessionGeneration(username)
  DatabaseTransactions.Commit($hConn)
  transaction = False
  Return generation
Catch
  failure = Error.Text
  If transaction Then Try DatabaseTransactions.Rollback($hConn)
  Error.Raise(failure)
End

Private Function RotateSessionGeneration(username As String) As Long
  Dim r As Result
  Dim generation As Long
  ' Retain these anonymous allocation rows so deleted/re-created names never
  ' reuse a generation, even on drivers that recycle the highest serial value.
  r = $hConn.Create("account_generation_ids")
  r["allocated"] = True
  r.Update()
  generation = $hConn.LastInsertId
  r = $hConn.Edit("account_sessions", "username = &1", username)
  If Not r.Available Then
    r = $hConn.Create("account_sessions")
    r["username"] = username
  Endif
  r["generation"] = generation
  r.Update()
  Return generation
End

Public Sub Register(username As String, password As String)
  Dim r As Result
  Dim first As Boolean
  Dim transaction As Boolean
  Dim passwordHash As String
  RegistrationError = "Registration could not be completed. Please retry."
  username = Trim(username)
  If Not username Or Len(username) > 255 Then
    RegistrationError = "Enter a username (maximum 255 characters)"
    Error.Raise(RegistrationError)
  Endif
  Init()
  If PasswordError(password) Then
    RegistrationError = PasswordError(password)
    Error.Raise(RegistrationError)
  Endif
  If UserExists(username) Then
    RegistrationError = "Username already exists. Choose another username or log in."
    Error.Raise(RegistrationError)
  Endif
  RetiredAuthors.OpenStore()
  passwordHash = Crypt.Sha256(password)
  DatabaseTransactions.Begin($hConn)
  transaction = True
  r = $hConn.Find("users")
  first = Not r.Available
  r = Null
  If first Then
    ' A unique claim inside the same transaction prevents two first admins.
    ' A concurrent losing registration can retry and becomes a normal user.
    r = $hConn.Create("account_bootstrap")
    r["id"] = 1
    r.Update()
    r = Null
  Endif
  CleanupUserReferences(username)
  $hConn.Exec("INSERT INTO users (username, password, fullname, admin) VALUES (&1, &2, &3, &4)", username, passwordHash, "", first)
  RotateSessionGeneration(username)
  DatabaseTransactions.Commit($hConn)
  transaction = False
Catch
  r = Null
  If transaction Then Try DatabaseTransactions.Rollback($hConn)
  Error.Raise(RegistrationError)
End

Public Function PasswordLengthEnforced() As Boolean
  Dim r As Result
  Init()
  r = $hConn.Find("account_settings", "id = &1", 1)
  If Not r.Available Then Return False
  Return r["password_length_enforce"]
End

Public Function PasswordMinLength() As Integer
  Dim r As Result
  Init()
  r = $hConn.Find("account_settings", "id = &1", 1)
  If Not r.Available Then Return 8
  Return r["password_min_length"]
End

Public Sub SetPasswordPolicy(enforce As Boolean, minimum As Integer)
  Dim r As Result
  Init()
  AdminRequired()
  If minimum < 1 Or minimum > 256 Then Error.Raise("Choose a minimum from 1 to 256 characters")
  r = $hConn.Edit("account_settings", "id = &1", 1)
  If Not r.Available Then
    r = $hConn.Create("account_settings")
    r["id"] = 1
  Endif
  r["password_length_enforce"] = enforce
  r["password_min_length"] = minimum
  r.Update()
End

Private Function PasswordError(password As String) As String
  If Not password Then Return "Enter a password"
  If PasswordLengthEnforced() Then
    If String.Len(password) < PasswordMinLength() Then Return "Use a password of at least " & Str(PasswordMinLength()) & " characters"
  Endif
End

Private Sub RequirePassword(password As String)
  Dim message As String = PasswordError(password)
  If message Then Error.Raise(message)
End

Private Sub Init()
  OpenConnection()
End

Private Sub SignedInRequired()
  If Not WebIdentity.Username Then Error.Raise("Please sign in")
  If Not UserExists(WebIdentity.Username) Then Error.Raise("Unknown user")
End

Private Sub AdminRequired()
  SignedInRequired()
  If Not GetIsAdmin(WebIdentity.Username) Then Error.Raise("Administrator required")
End

Private Sub AdminOrOwnRequired(username As String)
  SignedInRequired()
  If username = WebIdentity.Username Then Return
  AdminRequired()
End

Public Function Login(username As String, password As String) As Boolean
  Dim r As Result
  Init()
  r = $hConn.Exec("SELECT password FROM users WHERE username = &1", username)
  If Not r.Available Then Return False
  ' Crypt.Check follows Gambas error convention: True means mismatch.
  Return Not Crypt.Check(password, r["password"])
End

Public Function UserExists(username As String) As Boolean
  Dim r As Result
  Init()
  r = $hConn.Exec("SELECT username FROM users WHERE username = &1", username)
  Return r.Available
End

Public Function GetIsAdmin(username As String) As Boolean
  Dim r As Result
  SignedInRequired()
  Init()
  r = $hConn.Exec("SELECT admin FROM users WHERE username = &1", username)
  If Not r.Available Then Return False
  Return r["admin"]
End

Public Function GetUsers() As Result
  Init()
  AdminRequired()
  Return $hConn.Exec("SELECT username, fullname, admin FROM users ORDER BY username")
End

Public Sub NewUser(username As String, password As String, is_admin As Boolean)
  Dim transaction As Boolean
  Dim failure As String
  Dim passwordHash As String
  Init()
  AdminRequired()
  username = Trim(username)
  If Not username Or Len(username) > 255 Then Error.Raise("Enter a username")
  RequirePassword(password)
  RetiredAuthors.OpenStore()
  passwordHash = Crypt.Sha256(password)
  DatabaseTransactions.Begin($hConn)
  transaction = True
  AdminRequired()
  If UserExists(username) Then Error.Raise("Username already exists")
  CleanupUserReferences(username)
  $hConn.Exec("INSERT INTO users (username, password, fullname, admin) VALUES (&1, &2, &3, &4)", username, passwordHash, "", is_admin)
  RotateSessionGeneration(username)
  DatabaseTransactions.Commit($hConn)
  transaction = False
Catch
  failure = Error.Text
  If transaction Then Try DatabaseTransactions.Rollback($hConn)
  Error.Raise(failure)
End

Public Function DeleteUser(username As String) As Boolean
  Return DeleteAccount(username, False)
End

Public Function DeleteApiUser(username As String) As Boolean
  If Env["WEBA_API_REQUEST"] <> "1" Then Error.Raise("API context required")
  ' The original REST route permits a site admin to delete their own account.
  Return DeleteAccount(username, True)
End

Private Function DeleteAccount(username As String, allowSelf As Boolean) As Boolean
  Dim transaction As Boolean
  Dim failure As String
  Init()
  AdminRequired()
  If Not username Or Len(username) > 255 Then Error.Raise("Choose a user")
  If Not allowSelf And username = WebIdentity.Username Then Error.Raise("Cannot delete your own account")
  ApiTokens.PrepareStore()
  RetiredAuthors.OpenStore()
  DatabaseTransactions.Begin($hConn)
  transaction = True
  $hConn.Exec("UPDATE users SET username = username WHERE username = &1", username)
  AdminRequired()
  If Not UserExists(username) Then
    DatabaseTransactions.Rollback($hConn)
    transaction = False
    Return False
  Endif
  CleanupUserReferences(username)
  $hConn.Delete("users", "username = &1", username)
  ApiTokens.RevokeUser(username)
  $hConn.Delete("account_sessions", "username = &1", username)
  DatabaseTransactions.Commit($hConn)
  transaction = False
  Return True
Catch
  failure = Error.Text
  If transaction Then Try DatabaseTransactions.Rollback($hConn)
  Error.Raise(failure)
End

Private Sub CleanupUserReferences(username As String)
  Dim r As Result
  Dim remaining As Result
  Dim primary As String
  Dim minutes As Float
  Dim changed As New Collection
  Dim tableName As String
  Dim key As String
  If $hConn.Tables.Exist("kb_cards") And $hConn.Tables.Exist("kb_item_changes") Then
    r = $hConn.Find("kb_cards", "assignee=&1", username)
    For Each r
      changed[CStr(r!id)] = r!board_id
    Next
    For Each tableName In ["kb_card_assignees", "kb_card_members", "kb_card_people_sequence"]
      If Not $hConn.Tables.Exist(tableName) Then Continue
      r = $hConn.Exec("SELECT c.id,c.board_id FROM kb_cards c INNER JOIN " & tableName & " p ON p.card_id=c.id AND p.board_id=c.board_id WHERE p.username=&1", username)
      For Each r
        changed[CStr(r!id)] = r!board_id
      Next
    Next
  Endif
  If $hConn.Tables.Exist("kb_members") Then $hConn.Delete("kb_members", "username = &1", username)
  If $hConn.Tables.Exist("kb_member_flags") Then $hConn.Delete("kb_member_flags", "username = &1", username)
  If $hConn.Tables.Exist("kb_removed_members") Then $hConn.Delete("kb_removed_members", "username = &1", username)
  If $hConn.Tables.Exist("kb_user_meta") Then $hConn.Delete("kb_user_meta", "username = &1", username)
  If $hConn.Tables.Exist("kb_board_space_assignments") Then $hConn.Delete("kb_board_space_assignments", "username=&1", username)
  If $hConn.Tables.Exist("kb_board_space_collapsed") Then $hConn.Delete("kb_board_space_collapsed", "username=&1", username)
  If $hConn.Tables.Exist("kb_board_space_icons") Then $hConn.Delete("kb_board_space_icons", "username=&1", username)
  If $hConn.Tables.Exist("kb_board_spaces") Then $hConn.Delete("kb_board_spaces", "username=&1", username)
  If $hConn.Tables.Exist("kb_board_order") Then $hConn.Delete("kb_board_order", "username = &1", username)
  If $hConn.Tables.Exist("kb_board_preferences") Then $hConn.Delete("kb_board_preferences", "username = &1", username)
  If $hConn.Tables.Exist("kb_card_assignees") Then $hConn.Delete("kb_card_assignees", "username = &1", username)
  If $hConn.Tables.Exist("kb_card_members") Then $hConn.Delete("kb_card_members", "username = &1", username)
  If $hConn.Tables.Exist("kb_card_people_order") Then $hConn.Delete("kb_card_people_order", "username = &1", username)
  If $hConn.Tables.Exist("kb_card_people_sequence") Then $hConn.Delete("kb_card_people_sequence", "username = &1", username)
  If $hConn.Tables.Exist("kb_boards") Then
    If $hConn.Tables.Exist("kb_meta") Then $hConn.Delete("kb_meta", "board_id IN (SELECT id FROM kb_boards WHERE owner = &1) AND (setting = &2 OR setting = &3)", username, "star", "watch")
    ' A missing principal has no implicit owner rights. Other board members and
    ' administrators keep their roles; never silently promote a normal member.
    $hConn.Exec("UPDATE kb_boards SET owner = NULL WHERE owner = &1", username)
  Endif
  If $hConn.Tables.Exist("kb_cards") Then
    r = $hConn.Find("kb_cards", "assignee = &1", username)
    For Each r
      primary = ""
      If $hConn.Tables.Exist("kb_card_assignees") Then
        If $hConn.Tables.Exist("kb_card_people_order") Then
          remaining = $hConn.Exec("SELECT m.username FROM kb_card_assignees m LEFT JOIN kb_card_people_order o ON o.board_id = m.board_id AND o.card_id = m.card_id AND o.username = m.username AND o.field = &3 WHERE m.board_id = &1 AND m.card_id = &2 ORDER BY o.sort_order, m.username", r!board_id, r!id, "assignees")
        Else
          remaining = $hConn.Find("kb_card_assignees", "board_id = &1 AND card_id = &2 ORDER BY username", r!board_id, r!id)
        Endif
        If remaining.Available Then primary = remaining!username
      Endif
      $hConn.Exec("UPDATE kb_cards SET assignee = &1 WHERE id = &2", primary, r!id)
    Next
  Endif
  If $hConn.Tables.Exist("kb_entries") Then
    r = $hConn.Find("kb_entries", "author = &1", username)
    For Each r
      RetiredAuthors.Remember("entry", r!id, r!board_id, r!card_id, username)
      If r!kind = "time" And Not r!done Then
        minutes = Max(0, r!amount)
        If TypeOf(r!created_at) = gb.Date Then minutes = Max(0, DateDiff(r!created_at, Now, gb.Second)) / 60
        $hConn.Exec("UPDATE kb_entries SET author = NULL, done = &1, title = &2, amount = &3 WHERE id = &4", True, "Tracked time", minutes, r!id)
      Else
        $hConn.Exec("UPDATE kb_entries SET author = NULL WHERE id = &1", r!id)
      Endif
    Next
  Endif
  If $hConn.Tables.Exist("kb_files") Then
    r = $hConn.Find("kb_files", "author = &1", username)
    For Each r
      RetiredAuthors.Remember("file", r!id, r!board_id, r!card_id, username)
      $hConn.Exec("UPDATE kb_files SET author = NULL WHERE id = &1", r!id)
    Next
  Endif
  For Each key In changed.Keys
    ItemChanges.Mark(changed[key], "card", CInt(key))
  Next
End

Public Function GetFullname(username As String) As String
  Dim r As Result
  Init()
  AdminOrOwnRequired(username)
  r = $hConn.Exec("SELECT fullname FROM users WHERE username = &1", username)
  If Not r.Available Then Error.Raise("Unknown user")
  Return r["fullname"]
End

Public Sub SetFullname(username As String, fullname As String)
  Init()
  AdminOrOwnRequired(username)
  $hConn.Exec("UPDATE users SET fullname = &1 WHERE username = &2", fullname, username)
End

Public Function SetPassword(username As String, oldpass As String, newpass As String) As Boolean
  Init()
  AdminOrOwnRequired(username)
  Return ChangeCredential(username, newpass, oldpass, False)
End

Public Function ForceResetPassword(adminuser As String, username As String, newpass As String) As Boolean
  Init()
  ' Always authorize the session, never a caller-supplied administrator name.
  AdminRequired()
  Return ChangeCredential(username, newpass, "", True)
End

Private Function ChangeCredential(username As String, newpass As String, oldpass As String, reset As Boolean) As Boolean
  Dim transaction As Boolean
  Dim failure As String
  Dim passwordHash As String
  Dim generation As Long
  Dim keepCurrent As Boolean
  RequirePassword(newpass)
  passwordHash = Crypt.Sha256(newpass)
  keepCurrent = Not reset And Env["WEBA_API_REQUEST"] <> "1" And WebIdentity.Username = username
  ApiTokens.PrepareStore()
  DatabaseTransactions.Begin($hConn)
  transaction = True
  $hConn.Exec("UPDATE users SET username = username WHERE username = &1", username)
  If reset Then
    AdminRequired()
  Else
    AdminOrOwnRequired(username)
  Endif
  If Not UserExists(username) Then
    DatabaseTransactions.Rollback($hConn)
    transaction = False
    Return False
  Endif
  If Not reset Then
    If Not Login(username, oldpass) Then
      DatabaseTransactions.Rollback($hConn)
      transaction = False
      Return False
    Endif
  Endif
  $hConn.Exec("UPDATE users SET password = &1 WHERE username = &2", passwordHash, username)
  generation = RotateSessionGeneration(username)
  ApiTokens.RevokeUser(username)
  DatabaseTransactions.Commit($hConn)
  transaction = False
  If keepCurrent Then Session["auth_generation"] = generation
  Return True
Catch
  failure = Error.Text
  If transaction Then Try DatabaseTransactions.Rollback($hConn)
  Error.Raise(failure)
End

Public Sub SetIsAdmin(username As String, is_admin As Boolean)
  Init()
  AdminRequired()
  If username = WebIdentity.Username And Not is_admin Then Error.Raise("Cannot remove your own administrator role")
  $hConn.Exec("UPDATE users SET admin = &1 WHERE username = &2", is_admin, username)
End
