' Private per-form selected-board export queue. Completed JSON is retained only
' until every selected board has passed fresh export checks and the browser has
' received the ZIP payload.
Export

Public Function NewBatch(selection As Collection, Optional format As String = "weba") As Collection
  Dim data As New Collection
  Dim ids As Integer[] = BoardSelection.ActionIds(selection)
  If ids.Count > 1000 Then Error.Raise("Select at most 1000 boards")
  If format <> "weba" And format <> "csv" And format <> "scsv" And format <> "tsv" And format <> "excel" And format <> "kanboard" And format <> "markdown" And format <> "leo" And format <> "opml" And format <> "orgmode" And format <> "todotxt" And format <> "taskwarrior" And format <> "focalboard" And format <> "todoist" And format <> "planner" And format <> "meistertask" And format <> "obsidian" And format <> "linear" And format <> "ticktick" And format <> "clickup" And format <> "nullboard" And format <> "kanri" And format <> "pivotal" And format <> "redmine" And format <> "tasksorg" And format <> "monday" And format <> "businessmap" And format <> "superproductivity" And format <> "taiga" And format <> "vikunja" And format <> "wrikeworkflow" And format <> "wrike" And format <> "teamwork" And format <> "quire" And format <> "notion" And format <> "deck" And format <> "openproject" And format <> "github" And format <> "gitea" And format <> "forgejo" Then Error.Raise("Unknown export format")
  data["username"] = WebIdentity.Username
  data["generation"] = WebDatabase.SessionGeneration(WebIdentity.Username)
  data["revision"] = BoardSelection.Revision(selection)
  data["format"] = format
  data["ids"] = ids.Copy()
  data["remaining"] = ids.Copy()
  data["files"] = New Variant[]
  data["busy"] = False
  Return data
End

Public Function Format(batch As Collection) As String
  If Not batch Then Return ""
  Return batch["format"]
End

Private Sub CheckIdentity(batch As Collection)
  If Not batch Then Error.Raise("Board selection changed")
  If WebIdentity.Username = "" Or WebIdentity.Username <> batch["username"] Then Error.Raise("Sign in required")
  If WebDatabase.SessionGeneration(WebIdentity.Username) <> batch["generation"] Then Error.Raise("Sign in required")
End

Private Sub CheckCached(batch As Collection)
  Dim ids As Integer[] = batch["ids"]
  Dim files As Variant[] = batch["files"]
  Dim completed As New Integer[]
  Dim index As Integer
  CheckIdentity(batch)
  For index = 0 To files.Count - 1
    completed.Add(ids[index])
  Next
  BoardExportCacheGuard.Validate(completed, batch["username"], batch["generation"])
End

Private Sub Check(batch As Collection, selection As Collection)
  CheckIdentity(batch)
  If Not BoardSelection.Active(selection) Or BoardSelection.Revision(selection) <> batch["revision"] Then Error.Raise("Board selection changed")
  If JSON.Encode(BoardSelection.ActionIds(selection)) <> JSON.Encode(batch["ids"]) Then Error.Raise("Board selection changed")
End

Public Function Revision(batch As Collection) As Long
  If Not batch Then Return -1
  Return batch["revision"]
End

Public Function Remaining(batch As Collection) As Integer
  Dim ids As Integer[] = batch["remaining"]
  Return ids.Count
End

Public Function Completed(batch As Collection) As Integer
  Dim files As Variant[] = batch["files"]
  Return files.Count
End

Public Function Files(batch As Collection) As Variant[]
  Dim result As New Variant[]
  Dim file As Collection
  CheckIdentity(batch)
  ImportExportPolicy.RequireExport()
  CheckCached(batch)
  For Each file In batch["files"]
    result.Add(file.Copy())
  Next
  Return result
End

Public Sub Run(batch As Collection, selection As Collection)
  Dim pending As Integer[]
  Dim files As Variant[]
  Dim file As Collection
  Dim acquired As Boolean
  Dim failure As String
  Check(batch, selection)
  ImportExportPolicy.RequireExport()
  If batch["busy"] Then Error.Raise("Board export is already running")
  CheckCached(batch)
  batch["busy"] = True
  acquired = True
  pending = batch["remaining"]
  files = batch["files"]
  While pending.Count
    Check(batch, selection)
    file = New Collection
    file["name"] = "board-" & CStr(pending[0]) & If(batch["format"] = "weba" Or batch["format"] = "openproject" Or batch["format"] = "forgejo" Or batch["format"] = "gitea" Or batch["format"] = "github" Or batch["format"] = "deck" Or batch["format"] = "kanboard" Or batch["format"] = "taskwarrior" Or batch["format"] = "kanri" Or batch["format"] = "tasksorg" Or batch["format"] = "superproductivity" Or batch["format"] = "taiga" Or batch["format"] = "wrikeworkflow", ".json", If(batch["format"] = "focalboard", ".jsonl", If(batch["format"] = "nullboard", ".nbx", If(batch["format"] = "tsv", ".tsv", If(batch["format"] = "excel" Or batch["format"] = "planner" Or batch["format"] = "monday" Or batch["format"] = "businessmap" Or batch["format"] = "wrike" Or batch["format"] = "teamwork", ".xlsx", If(batch["format"] = "markdown" Or batch["format"] = "obsidian", ".md", If(batch["format"] = "leo", ".leo", If(batch["format"] = "opml", ".opml", If(batch["format"] = "orgmode", ".org", If(batch["format"] = "todotxt", ".txt", ".csv"))))))))))
    If batch["format"] = "vikunja" Then file["name"] = "board-" & CStr(pending[0]) & ".zip"
    If batch["format"] = "csv" Then
      file["content"] = BoardTransfer.ExportActiveBoardCsv(pending[0])
    Else If batch["format"] = "scsv" Then
      file["content"] = BoardTransfer.ExportActiveBoardSemicolonCsv(pending[0])
    Else If batch["format"] = "tsv" Then
      file["content"] = BoardTransfer.ExportActiveBoardTsv(pending[0])
    Else If batch["format"] = "excel" Then
      file["content"] = BoardTransfer.ExportActiveBoardExcel(pending[0])
    Else If batch["format"] = "kanboard" Then
      file["content"] = BoardTransfer.ExportActiveBoardKanboard(pending[0])
    Else If batch["format"] = "markdown" Then
      file["content"] = BoardTransfer.ExportActiveBoardMarkdown(pending[0])
    Else If batch["format"] = "leo" Then
      file["content"] = BoardTransfer.ExportActiveBoardLeo(pending[0])
    Else If batch["format"] = "opml" Then
      file["content"] = BoardTransfer.ExportActiveBoardOpml(pending[0])
    Else If batch["format"] = "orgmode" Then
      file["content"] = BoardTransfer.ExportActiveBoardOrgMode(pending[0])
    Else If batch["format"] = "todotxt" Then
      file["content"] = BoardTransfer.ExportActiveBoardTodoTxt(pending[0])
    Else If batch["format"] = "taskwarrior" Then
      file["content"] = BoardTransfer.ExportActiveBoardTaskwarrior(pending[0])
    Else If batch["format"] = "focalboard" Then
      file["content"] = BoardTransfer.ExportActiveBoardFocalboard(pending[0])
    Else If batch["format"] = "todoist" Then
      file["content"] = BoardTransfer.ExportActiveBoardTodoist(pending[0])
    Else If batch["format"] = "planner" Then
      file["content"] = BoardTransfer.ExportActiveBoardPlanner(pending[0])
    Else If batch["format"] = "meistertask" Then
      file["content"] = BoardTransfer.ExportActiveBoardMeisterTask(pending[0])
    Else If batch["format"] = "obsidian" Then
      file["content"] = BoardTransfer.ExportActiveBoardObsidian(pending[0])
    Else If batch["format"] = "linear" Then
      file["content"] = BoardTransfer.ExportActiveBoardLinear(pending[0])
    Else If batch["format"] = "ticktick" Then
      file["content"] = BoardTransfer.ExportActiveBoardTickTickCsv(pending[0])
    Else If batch["format"] = "clickup" Then
      file["content"] = BoardTransfer.ExportActiveBoardClickUp(pending[0])
    Else If batch["format"] = "nullboard" Then
      file["content"] = BoardTransfer.ExportActiveBoardNullboard(pending[0])
    Else If batch["format"] = "openproject" Then
      file["format"] = "openproject"
      file["content"] = BoardTransfer.ExportActiveBoardOpenProject(pending[0])
    Else If batch["format"] = "forgejo" Then
      file["content"] = BoardTransfer.ExportActiveBoardForgejo(pending[0])
    Else If batch["format"] = "gitea" Then
      file["content"] = BoardTransfer.ExportActiveBoardGitea(pending[0])
    Else If batch["format"] = "github" Then
      file["content"] = BoardTransfer.ExportActiveBoardGithub(pending[0])
    Else If batch["format"] = "deck" Then
      file["content"] = BoardTransfer.ExportActiveBoardDeck(pending[0])
    Else If batch["format"] = "kanri" Then
      file["content"] = BoardTransfer.ExportActiveBoardKanri(pending[0])
    Else If batch["format"] = "pivotal" Then
      file["content"] = BoardTransfer.ExportActiveBoardPivotal(pending[0])
    Else If batch["format"] = "redmine" Then
      file["content"] = BoardTransfer.ExportActiveBoardRedmine(pending[0])
    Else If batch["format"] = "tasksorg" Then
      file["content"] = BoardTransfer.ExportActiveBoardTasksOrg(pending[0])
    Else If batch["format"] = "notion" Then
      file["format"] = "notion"
      file["content"] = BoardTransfer.ExportActiveBoardNotion(pending[0])
    Else If batch["format"] = "quire" Then
      file["content"] = BoardTransfer.ExportActiveBoardQuire(pending[0])
    Else If batch["format"] = "teamwork" Then
      file["content"] = BoardTransfer.ExportActiveBoardTeamwork(pending[0])
    Else If batch["format"] = "wrike" Then
      file["content"] = BoardTransfer.ExportActiveBoardWrike(pending[0])
    Else If batch["format"] = "wrikeworkflow" Then
      file["format"] = "wrikeworkflow"
      file["content"] = BoardTransfer.ExportActiveBoardWrikeWorkflow(pending[0])
    Else If batch["format"] = "vikunja" Then
      file["format"] = "vikunja"
      file["content"] = BoardTransfer.ExportActiveBoardVikunja(pending[0])
    Else If batch["format"] = "taiga" Then
      file["format"] = "taiga"
      file["content"] = BoardTransfer.ExportActiveBoardTaiga(pending[0])
    Else If batch["format"] = "superproductivity" Then
      file["content"] = BoardTransfer.ExportActiveBoardSuperProductivity(pending[0])
    Else If batch["format"] = "businessmap" Then
      file["content"] = BoardTransfer.ExportActiveBoardBusinessmap(pending[0])
    Else If batch["format"] = "monday" Then
      file["content"] = BoardTransfer.ExportActiveBoardMonday(pending[0])
    Else
      file["content"] = BoardTransfer.ExportActiveBoard(pending[0])
    Endif
    files.Add(file)
    pending.Remove(0)
  Wend
  Check(batch, selection)
  ImportExportPolicy.RequireExport()
  CheckCached(batch)
  batch["busy"] = False
Catch
  failure = Error.Text
  If acquired Then batch["busy"] = False
  Error.Raise(failure)
End
