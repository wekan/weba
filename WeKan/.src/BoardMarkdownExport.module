' Native counterpart of the parent Markdown task-list Kanban formatter.
Export

Private Function TextValue(value As Variant) As String
  If IsNull(value) Then Return ""
  Return CStr(value)
End

Private Function ClosedList(title As String) As Boolean
  Dim code As Integer
  Dim word As String
  ' JavaScript's non-Unicode /i matches these ASCII literals only.
  For code = 65 To 90
    title = Replace(title, Chr(code), Chr(code + 32))
  Next
  For Each word In ["done", "closed", "complete", "archiv", "finished"]
    If InStr(title, word) Then Return True
  Next
  Return False
End

Public Function Build(boardId As Integer, db As Connection, Optional wanted As Collection) As String
  Dim lines As New String[]
  Dim board As Result
  Dim lists As Result
  Dim cards As Result
  Dim title As String
  Dim descriptionLine As String
  BoardAccess.RequireContainer(boardId, "board", boardId)
  board = db.Exec(ExportText.SelectRows(db, "kb_boards") & " WHERE " & "id=&1", boardId)
  If Not board.Available Then Error.Raise("Board not found")
  title = ExportText.ReadValue(board, "title")
  If Not title Then title = "Imported board"
  lines.Add("# " & title)
  lines.Add("")
  lists = db.Exec(ExportText.SelectRows(db, "kb_lists") & " WHERE " & ListDeletion.LiveSql("list", "kb_lists") & " AND board_id=&1 ORDER BY lane,sort_order,id", boardId)
  For Each lists
    cards = db.Exec(ExportText.Preserve(db, "SELECT c.* FROM kb_cards c LEFT JOIN kb_card_lists cl ON cl.board_id=c.board_id AND cl.card_id=c.id LEFT JOIN kb_lists l ON l.board_id=c.board_id AND l.id=cl.list_id AND " & ListDeletion.LiveSql("list", "l") & " LEFT JOIN kb_order o ON o.board_id=c.board_id AND o.kind=&2 AND o.item=CAST(c.id AS TEXT) WHERE " & ListDeletion.LiveSql("card", "c") & " AND c.board_id=&1 AND " & ExportText.MatchText(db, "COALESCE(l.title,'')", 3, ExportText.ReadValue(lists, "title")) & " AND c.archived=&4 ORDER BY COALESCE(o.sort_order,c.id),c.id"), boardId, "card", ExportText.BindText(db, ExportText.ReadValue(lists, "title")), False)
    If Not cards.Available Then Continue
    lines.Add("## " & ExportText.ReadValue(lists, "title"))
    lines.Add("")
    For Each cards
      lines.Add("- [" & If(ClosedList(ExportText.ReadValue(lists, "title")), "x", " ") & "] " & ExportText.ReadValue(cards, "title"))
      If Not ExternalExportFields.Wants(wanted, "description") Then Continue
      For Each descriptionLine In Split(ExportText.ReadValue(cards, "description"), Chr(10))
        If descriptionLine Then lines.Add("  " & descriptionLine)
      Next
    Next
    lines.Add("")
  Next
  Return lines.Join(Chr(10))
End
