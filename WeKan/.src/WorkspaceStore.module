' Portable board/list/swimlane/card menu operations.
Export
Private $db As Connection
Private $copyMap As Collection

Public Sub OpenStore()
  Dim t As Table
  If $db Then Return
  KanbanStore.OpenDatabase()
  $db = WebDatabase.OpenConnection()
  If Not $db.Tables.Exist("kb_meta") Then
    t = $db.Tables.Add("kb_meta")
    t.Fields.Add("board_id", db.Integer)
    t.Fields.Add("kind", db.String, 16)
    t.Fields.Add("item_id", db.Integer)
    t.Fields.Add("setting", db.String, 64)
    t.Fields.Add("value", db.String)
    t.PrimaryKey = ["board_id", "kind", "item_id", "setting"]
    t.Update()
  Endif
  If Not $db.Tables.Exist("kb_history") Then
    t = $db.Tables.Add("kb_history")
    t.Fields.Add("id", db.Serial)
    t.Fields.Add("board_id", db.Integer)
    t.Fields.Add("kind", db.String, 16)
    t.Fields.Add("item_id", db.Integer)
    t.Fields.Add("actor", db.String, 255)
    t.Fields.Add("message", db.String)
    t.Fields.Add("created_at", db.Date)
    t.PrimaryKey = ["id"]
    t.Update()
  Endif
End

Public Sub Log(boardId As Integer, kind As String, itemId As Integer, message As String)
  Dim r As Result
  OpenStore()
  BoardAccess.RequireActivity(boardId)
  r = $db.Create("kb_history")
  r["board_id"] = boardId
  r["kind"] = kind
  r["item_id"] = itemId
  r["actor"] = WebIdentity.Username
  r["message"] = message
  r["created_at"] = Now
  r.Update()
End

Public Function History(boardId As Integer, kind As String, itemId As Integer) As Result
  Record(boardId, kind, itemId)
  If kind = "board" Then Return KanbanStore.Activities(boardId)
  Return $db.Find("kb_history", "board_id = &1 AND kind = &2 AND item_id = &3 ORDER BY id DESC", boardId, kind, itemId)
End

Public Function Record(boardId As Integer, kind As String, itemId As Integer) As Result
  Dim r As Result
  Dim tableName As String
  OpenStore()
  KanbanStore.RequireBoard(boardId)
  Select kind
    Case "board"
      If boardId <> itemId Then Error.Raise("Board not accessible")
      tableName = "kb_boards"
    Case "lane"
      tableName = "kb_lanes"
    Case "list"
      tableName = "kb_lists"
    Case "card"
      tableName = "kb_cards"
    Case Else
      Error.Raise("Unknown menu context")
  End Select
  If kind = "board" Then
    r = $db.Find(tableName, "id = &1", itemId)
  Else
    r = $db.Find(tableName, "id = &1 AND board_id = &2", itemId, boardId)
  Endif
  If Not r.Available Then Error.Raise("Item not accessible")
  If kind = "list" And If ListDeletion.IsDeleted(boardId, kind, itemId) Then Error.Raise("List not accessible")
  If kind = "card" Then BoardAccess.RequireCard(boardId, itemId)
  Return r
End

Public Function Setting(boardId As Integer, kind As String, itemId As Integer, name As String, Optional fallback As String) As String
  Dim r As Result
  Record(boardId, kind, itemId)
  If name = "star" Or name = "watch" Then
    BoardAccess.OpenStore()
    r = $db.Find("kb_user_meta", "board_id = &1 AND kind = &2 AND item_id = &3 AND username = &4 AND setting = &5", boardId, kind, itemId, WebIdentity.Username, name)
    If r.Available Then Return r["value"]
    r = $db.Find("kb_boards", "id = &1 AND owner = &2", boardId, WebIdentity.Username)
    If Not r.Available Then Return fallback
  Endif
  r = $db.Find("kb_meta", "board_id = &1 AND kind = &2 AND item_id = &3 AND setting = &4", boardId, kind, itemId, name)
  If r.Available Then Return r["value"]
  Return fallback
End

Public Sub SetSetting(boardId As Integer, kind As String, itemId As Integer, name As String, value As String)
  Dim actor As String = WebIdentity.Username
  Dim r As Result
  Dim index As Integer
  Dim tableName As String = "kb_meta"
  Dim transaction As Boolean
  Dim failure As String
  Record(boardId, kind, itemId)
  BoardAccess.OpenStore()
  If name = "star" Or name = "watch" Then
    tableName = "kb_user_meta"
  Else If kind = "board" Then
    BoardAccess.Require(boardId, "manageBoard")
  Else
    BoardAccess.Require(boardId, "write")
  Endif
  Select name
    Case "star", "watch", "archived", "wip_strict", "allowsAttachments"
      If value <> "0" And value <> "1" Then Error.Raise("Expected a boolean setting")
    Case "color", "wip", "description"
    Case Else
      Error.Raise("Unknown item setting")
  End Select
  If name = "allowsAttachments" And kind <> "board" Then Error.Raise("Board setting required")
  If name = "color" And value Then
    If Len(value) <> 7 Or Left(value) <> "#" Then Error.Raise("Use #RRGGBB")
    For index = 2 To 7
      If InStr("0123456789abcdef", LCase(Mid(value, index, 1))) = 0 Then Error.Raise("Use #RRGGBB")
    Next
  Endif
  If name = "wip" Then
    If CFloat(value) <> CInt(value) Or CInt(value) < 0 Or CInt(value) > 100000 Then Error.Raise("Invalid WIP limit")
  Endif
  DatabaseTransactions.Begin($db)
  transaction = True
  If name = "allowsAttachments" Then $db.Exec("UPDATE users SET username=username WHERE username=&1", actor)
  $db.Exec("UPDATE kb_boards SET title=title WHERE id=&1", boardId)
  If kind = "card" Then $db.Exec("UPDATE kb_cards SET title=title WHERE board_id=&1 AND id=&2", boardId, itemId)
  Record(boardId, kind, itemId)
  If tableName <> "kb_user_meta" Then
    BoardAccess.Require(boardId, If(kind = "board", "manageBoard", "write"))
  Endif
  If tableName = "kb_user_meta" Then
    r = $db.Edit(tableName, "board_id = &1 AND kind = &2 AND item_id = &3 AND setting = &4 AND username = &5", boardId, kind, itemId, name, WebIdentity.Username)
  Else
    r = $db.Edit(tableName, "board_id = &1 AND kind = &2 AND item_id = &3 AND setting = &4", boardId, kind, itemId, name)
  Endif
  If Not r.Available Then
    r = $db.Create(tableName)
    If tableName = "kb_user_meta" Then r["username"] = WebIdentity.Username
    r["board_id"] = boardId
    r["kind"] = kind
    r["item_id"] = itemId
    r["setting"] = name
  Endif
  r["value"] = value
  r.Update()
  If tableName <> "kb_user_meta" And (kind = "list" Or kind = "card") Then ItemChanges.Mark(boardId, kind, itemId)
  If name = "allowsAttachments" Then
    If WebIdentity.Username <> actor Then Error.Raise("Board setting identity changed")
    Record(boardId, kind, itemId)
    BoardAccess.Require(boardId, "manageBoard")
    If Setting(boardId, kind, itemId, name) <> value Then Error.Raise("Board setting changed")
  Endif
  DatabaseTransactions.Commit($db)
  transaction = False
Catch
  failure = Error.Text
  If transaction Then Try DatabaseTransactions.Rollback($db)
  Error.Raise(failure)
End

Public Sub Toggle(boardId As Integer, kind As String, itemId As Integer, name As String)
  If name <> "star" And name <> "watch" Then Error.Raise("Unknown toggle")
  SetSetting(boardId, kind, itemId, name, If(Setting(boardId, kind, itemId, name) = "1", "0", "1"))
End

Public Function Archived(boardId As Integer, kind As String, itemId As Integer) As Boolean
  Dim r As Result = Record(boardId, kind, itemId)
  If kind = "board" Or kind = "card" Then Return r!archived
  Return Setting(boardId, kind, itemId, "archived") = "1"
End

Public Sub SetArchived(boardId As Integer, kind As String, itemId As Integer, value As Boolean)
  Record(boardId, kind, itemId)
  If kind = "board" Then
    BoardAccess.Require(boardId, "manageBoard")
  Else
    BoardAccess.Require(boardId, "write")
  Endif
  Select kind
    Case "board"
      KanbanStore.ArchiveBoard(boardId, value)
    Case "card"
      KanbanStore.ArchiveCard(boardId, itemId, value)
    Case Else
      SetSetting(boardId, kind, itemId, "archived", If(value, "1", "0"))
      KanbanStore.Activity(boardId, "Changed " & kind & " archive state", kind, itemId)
  End Select
End

Public Function ListHidden(boardId As Integer, listId As Integer) As Boolean
  Dim r As Result
  Dim lane As Result
  If Not listId Then Return False
  r = Record(boardId, "list", listId)
  If Archived(boardId, "list", listId) Then Return True
  lane = $db.Find("kb_lanes", "board_id = &1 AND title = &2", boardId, r!lane)
  If lane.Available Then Return Archived(boardId, "lane", lane!id)
  Return False
End

Public Sub Rename(boardId As Integer, kind As String, itemId As Integer, title As String)
  Dim r As Result
  Dim linked As Result
  Dim tableName As String
  Dim oldTitle As String
  Dim failure As String
  r = Record(boardId, kind, itemId)
  If kind = "board" Then
    BoardAccess.Require(boardId, "manageBoard")
  Else
    BoardAccess.Require(boardId, "write")
  Endif
  title = Trim(title)
  If Not title Or String.Len(title) > If(kind = "list", 32, 255) Then Error.Raise("Enter a valid title")
  oldTitle = r!title
  If kind = "lane" Then
    r = $db.Find("kb_lanes", "board_id = &1 AND title = &2 AND id <> &3", boardId, title, itemId)
    If r.Available Then Error.Raise("Swimlane already exists")
  Endif
  KanbanStore.PrimeCardLinks(boardId)
  DatabaseTransactions.Begin($db)
  Select kind
    Case "board"
      tableName = "kb_boards"
    Case "lane"
      tableName = "kb_lanes"
    Case "list"
      tableName = "kb_lists"
    Case "card"
      tableName = "kb_cards"
  End Select
  r = $db.Edit(tableName, "id = &1", itemId)
  r["title"] = title
  r.Update()
  If kind = "list" Then
    linked = $db.Find("kb_card_lists", "board_id = &1 AND list_id = &2", boardId, itemId)
    For Each linked
      r = $db.Edit("kb_cards", "id = &1 AND board_id = &2", linked!card_id, boardId)
      If Not r.Available Then Continue
      r["status"] = title
      r.Update()
    Next
  Else If kind = "lane" Then
    r = $db.Edit("kb_lists", "board_id = &1 AND lane = &2", boardId, oldTitle)
    For Each r
      r["lane"] = title
      r.Update()
    Next
    If oldTitle = "Default" Then
      r = $db.Edit("kb_cards", "board_id = &1 AND (lane = &2 OR lane = &3 OR lane IS NULL)", boardId, oldTitle, "")
    Else
      r = $db.Edit("kb_cards", "board_id = &1 AND lane = &2", boardId, oldTitle)
    Endif
    For Each r
      r["lane"] = title
      r.Update()
    Next
    r = $db.Edit("kb_order", "board_id = &1 AND kind = &2 AND item = &3", boardId, "lane", oldTitle)
    If r.Available Then
      r["item"] = title
      r.Update()
    Endif
  Endif
  KanbanStore.Activity(boardId, "Renamed " & kind & ": " & oldTitle & " → " & title, kind, itemId)
  DatabaseTransactions.Commit($db)
Catch
  failure = Error.Text
  Try DatabaseTransactions.Rollback($db)
  Error.Raise(failure)
End

Private Function CloneCard(sourceBoard As Integer, cardId As Integer, targetBoard As Integer, listId As Integer, lane As String, listTitle As String, title As String, Optional options As Collection) As Integer
  Dim fields As Collection
  Dim labels As String
  Dim r As Result = Record(sourceBoard, "card", cardId)
  Dim id As Integer
  Dim assignee As String
  If Not options Then options = CopyOptions.Defaults()
  fields = CopyOptions.Normalize(options)
  If fields["labels"] Then labels = r!labels
  If Not BoardAccess.Can(targetBoard, "seesAllCards") Then assignee = WebIdentity.Username
  id = KanbanStore.SaveCard(targetBoard, 0, title, r!description, lane, listTitle, assignee, labels, r!due_day, listId)
  BoardAccess.CopyAssignees(sourceBoard, cardId, targetBoard, id)
  BoardAccess.CopyCardMembers(sourceBoard, cardId, targetBoard, id)
  CardDates.CopyDates(sourceBoard, cardId, targetBoard, id)
  $copyMap[CStr(cardId)] = id
  CardContent.CopyRecords(sourceBoard, cardId, targetBoard, id, fields)
  CopySettings(sourceBoard, "card", cardId, targetBoard, id)
  Return id
End

Public Function Copy(boardId As Integer, kind As String, itemId As Integer, title As String, Optional targetLane As String, Optional options As Collection) As Integer
  Dim fields As Collection
  Dim actor As String = WebIdentity.Username
  Dim transaction As Boolean
  Dim sourceArchived As Boolean
  Dim sourceTitle As String
  Dim sourceOwner As String
  Dim sourceId As Integer = boardId
  Dim source As Result
  Dim r As Result
  Dim laneRows As Result
  Dim newId As Integer
  Dim listId As Integer
  Dim failure As String
  Dim original As String
  Dim relationKind As String
  Dim relations As Result
  Dim targetId As Integer
  Dim targetBoard As Integer
  If options And kind <> "board" Then Error.Raise("Board copy options required")
  If Not options Then options = CopyOptions.Defaults()
  fields = CopyOptions.Normalize(options)
  source = Record(boardId, kind, itemId)
  BoardAccess.RequireContainer(boardId, kind, itemId)
  BoardAccess.Require(boardId, If(kind = "board", "manageBoard", "write"))
  If kind = "board" Then BoardCreation.Require()
  title = Trim(title)
  If Not title Or String.Len(title) > If(kind = "list", 32, 255) Then Error.Raise("Enter a valid copy title")
  CardContent.OpenStore()
  $copyMap = New Collection
  If kind = "list" Then
    If Not targetLane Then targetLane = source!lane
    r = $db.Find("kb_lanes", "board_id = &1 AND title = &2", boardId, targetLane)
    If Not r.Available Then Error.Raise("Destination swimlane not accessible")
  Endif
  DatabaseTransactions.Begin($db)
  transaction = True
  If kind = "board" Then
    $db.Exec("UPDATE users SET username=username WHERE username=&1", actor)
    BoardCreation.Lock()
    BoardCreation.Require()
    $db.Exec("UPDATE kb_boards SET title=title WHERE id=&1", boardId)
    BoardAccess.RequireContainer(boardId, kind, itemId)
    BoardAccess.Require(boardId, "manageBoard")
    source = Record(boardId, kind, itemId)
    sourceArchived = source!archived
    sourceTitle = source!title
    sourceOwner = source!owner
  Endif
  If kind <> "board" Or fields["cards"] Then KanbanStore.PrimeCardLinks(boardId)
  Select kind
    Case "card"
      listId = KanbanStore.CardListId(boardId, itemId)
      newId = CloneCard(boardId, itemId, boardId, listId, source!lane, source!status, title)
    Case "board"
      newId = KanbanStore.AddBoard(title)
      If fields["swimlanes"] Then
        laneRows = KanbanStore.Lanes(boardId)
        For Each laneRows
          If Archived(boardId, "lane", laneRows!id) Then Continue
          CloneLane(boardId, laneRows!id, newId, laneRows!title, fields)
        Next
      Endif
    Case "lane"
      newId = CloneLane(boardId, itemId, boardId, title)
    Case "list"
      newId = CloneList(boardId, itemId, boardId, targetLane, title)
  End Select
  targetBoard = boardId
  If kind = "board" Then targetBoard = newId
  For Each original In $copyMap.Keys
    For Each relationKind In ["dependency", "subtask"]
      relations = CardContent.Entries(boardId, CInt(original), relationKind)
      For Each relations
        targetId = CInt(relations!amount)
        If $copyMap.Exist(CStr(targetId)) Then
          targetId = $copyMap[CStr(targetId)]
        Else If targetBoard <> boardId Then
          Continue
        Endif
        CardContent.Save(targetBoard, $copyMap[original], 0, relationKind, "", "", 0, False, targetId)
      Next
    Next
  Next
  CopySettings(boardId, kind, itemId, targetBoard, newId)
  If BoardAccess.Can(boardId, "write") Or BoardAccess.Can(boardId, "comment") Then KanbanStore.Activity(boardId, "Copied " & kind & ": " & title, kind, itemId, False)
  If kind = "board" Then
    BoardCreation.Require()
    If WebIdentity.Username <> actor Then Error.Raise("Copy identity changed")
    BoardAccess.RequireContainer(sourceId, "board", sourceId)
    BoardAccess.Require(sourceId, "manageBoard")
    source = Record(sourceId, "board", sourceId)
    If source!archived <> sourceArchived Or source!title <> sourceTitle Or source!owner <> sourceOwner Then Error.Raise("Source board changed during copy")
    source = Record(newId, "board", newId)
    If source!owner <> actor Or source!archived Or source!title <> title Then Error.Raise("Copied board changed")
  Endif
  DatabaseTransactions.Commit($db)
  transaction = False
  Return newId
Catch
  failure = Error.Text
  If transaction Then Try DatabaseTransactions.Rollback($db)
  Error.Raise(failure)
End

Private Sub CopySettings(sourceBoard As Integer, kind As String, sourceId As Integer, targetBoard As Integer, targetId As Integer)
  Dim name As String
  Dim value As String
  If kind = "board" Then SetSetting(targetBoard, kind, targetId, "allowsAttachments", Setting(sourceBoard, kind, sourceId, "allowsAttachments", "1"))
  For Each name In ["color", "wip", "wip_strict", "description"]
    value = Setting(sourceBoard, kind, sourceId, name)
    If value Then SetSetting(targetBoard, kind, targetId, name, value)
  Next
End

Private Function CloneLane(sourceBoard As Integer, laneId As Integer, targetBoard As Integer, title As String, Optional options As Collection) As Integer
  Dim source As Result = Record(sourceBoard, "lane", laneId)
  Dim r As Result
  Dim lists As Result
  Dim id As Integer
  r = $db.Find("kb_lanes", "board_id = &1 AND title = &2", targetBoard, title)
  If r.Available Then Error.Raise("Swimlane already exists")
  r = $db.Create("kb_lanes")
  r["board_id"] = targetBoard
  r["title"] = title
  r.Update()
  id = $db.LastInsertId
  If Not options Then options = CopyOptions.Defaults()
  If options["lists"] Then
    lists = KanbanStore.Lists(sourceBoard, source!title)
    For Each lists
      If Archived(sourceBoard, "list", lists!id) Then Continue
      CloneList(sourceBoard, lists!id, targetBoard, title, lists!title, options)
    Next
  Endif
  CopySettings(sourceBoard, "lane", laneId, targetBoard, id)
  Return id
End

Private Function CloneList(sourceBoard As Integer, listId As Integer, targetBoard As Integer, lane As String, title As String, Optional options As Collection) As Integer
  Dim r As Result
  Dim source As Result = Record(sourceBoard, "list", listId)
  Dim cards As Result
  Dim id As Integer
  Dim rank As Integer
  If String.Len(title) > 32 Then Error.Raise("List titles have at most 32 characters")
  r = $db.Find("kb_lists", ListDeletion.LiveSql("list", "kb_lists") & " AND board_id = &1 AND lane = &2 ORDER BY sort_order DESC", targetBoard, lane)
  If r.Available Then rank = r!sort_order + 1
  r = $db.Create("kb_lists")
  r["board_id"] = targetBoard
  r["lane"] = lane
  r["title"] = title
  r["sort_order"] = rank
  r.Update()
  id = $db.LastInsertId
  ItemChanges.Mark(targetBoard, "list", id)
  If Not options Then options = CopyOptions.Defaults()
  If options["cards"] Then
    cards = $db.Find("kb_cards", ListDeletion.LiveSql("card", "kb_cards") & " AND board_id = &1 AND archived = &2", sourceBoard, False)
    For Each cards
      If KanbanStore.CardListId(sourceBoard, cards!id) <> listId Then Continue
      CloneCard(sourceBoard, cards!id, targetBoard, id, lane, title, cards!title, options)
    Next
  Endif
  CopySettings(sourceBoard, "list", listId, targetBoard, id)
  Return id
End

Public Function ExportData(boardId As Integer, kind As String, itemId As Integer) As String
  Return BoardTransfer.ExportData(boardId, kind, itemId)
End

Public Function ListCount(boardId As Integer, listId As Integer) As Integer
  Dim r As Result
  Dim count As Integer
  Record(boardId, "list", listId)
  r = KanbanStore.Cards(boardId)
  For Each r
    If KanbanStore.CardListId(boardId, r!id) = listId Then Inc count
  Next
  Return count
End

Public Sub RequireCapacity(boardId As Integer, listId As Integer, cardId As Integer)
  Dim r As Result
  Dim limit As Integer
  If Setting(boardId, "list", listId, "wip_strict", "0") <> "1" Then Return
  limit = CInt(Setting(boardId, "list", listId, "wip", "0"))
  If limit <= 0 Then Return
  If cardId Then
    If KanbanStore.CardListId(boardId, cardId) = listId Then Return
  Endif
  KanbanStore.PrimeCardLinks(boardId)
  r = $db.Exec("SELECT COUNT(*) AS total FROM kb_cards INNER JOIN kb_card_lists ON kb_cards.id = kb_card_lists.card_id WHERE kb_cards.board_id = &1 AND kb_card_lists.list_id = &2 AND kb_cards.archived = &3", boardId, listId, False)
  If r!total >= limit Then Error.Raise("List WIP limit reached")
End
