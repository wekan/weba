' Card detail records are scoped by both board and card at every entry point.
Export
Private $db As Connection

Public Sub OpenStore()
  Dim t As Table
  If $db Then Return
  WorkspaceStore.OpenStore()
  $db = WebDatabase.OpenConnection()
  If Not $db.Tables.Exist("kb_entries") Then
    t = $db.Tables.Add("kb_entries")
    t.Fields.Add("id", db.Serial)
    t.Fields.Add("board_id", db.Integer)
    t.Fields.Add("card_id", db.Integer)
    t.Fields.Add("kind", db.String, 32)
    t.Fields.Add("parent_id", db.Integer)
    t.Fields.Add("title", db.String, 255)
    t.Fields.Add("body", db.String)
    t.Fields.Add("value_type", db.String, 16)
    t.Fields.Add("done", db.Boolean)
    t.Fields.Add("amount", db.Float)
    t.Fields.Add("author", db.String, 255)
    t.Fields.Add("created_at", db.Date)
    t.PrimaryKey = ["id"]
    t.Update()
  Endif
  If Not $db.Tables.Exist("kb_files") Then
    t = $db.Tables.Add("kb_files")
    t.Fields.Add("id", db.Serial)
    t.Fields.Add("board_id", db.Integer)
    t.Fields.Add("card_id", db.Integer)
    t.Fields.Add("filename", db.String, 255)
    t.Fields.Add("content", db.Blob)
    t.Fields.Add("author", db.String, 255)
    t.Fields.Add("created_at", db.Date)
    t.PrimaryKey = ["id"]
    t.Update()
  Endif
  RetiredAuthors.OpenStore()
  AttachmentLifecycle.OpenStore()
  AttachmentData.OpenStore()
  TransferPolicy.OpenStore()
End

Private Sub RequireCard(boardId As Integer, cardId As Integer)
  OpenStore()
  WorkspaceStore.Record(boardId, "card", cardId)
End

Public Function Entries(boardId As Integer, cardId As Integer, kind As String) As Result
  RequireCard(boardId, cardId)
  If kind = "subtask" Or kind = "dependency" Then
    If Not BoardAccess.Can(boardId, "seesAllCards") Then Return $db.Find("kb_entries", "board_id = &1 AND card_id = &2 AND kind = &3 AND amount IN (SELECT id FROM kb_cards WHERE " & ListDeletion.LiveSql("card", "kb_cards") & " AND board_id = &1 AND (assignee = &4 OR id IN (SELECT card_id FROM kb_card_assignees WHERE board_id = &1 AND username = &4))) ORDER BY id", boardId, cardId, kind, WebIdentity.Username)
    Return $db.Find("kb_entries", "board_id=&1 AND card_id=&2 AND kind=&3 AND amount IN (SELECT id FROM kb_cards WHERE " & ListDeletion.LiveSql("card", "kb_cards") & " AND board_id=&1) ORDER BY id", boardId, cardId, kind)
  Endif
  Return $db.Find("kb_entries", "board_id = &1 AND card_id = &2 AND kind = &3 ORDER BY id", boardId, cardId, kind)
End

Public Function Entry(boardId As Integer, cardId As Integer, entryId As Integer) As Result
  Dim r As Result
  RequireCard(boardId, cardId)
  r = $db.Find("kb_entries", "board_id = &1 AND card_id = &2 AND id = &3", boardId, cardId, entryId)
  If Not r.Available Then Error.Raise("Card entry not accessible")
  If r!kind = "subtask" Or r!kind = "dependency" Then BoardAccess.RequireCard(boardId, CInt(r!amount))
  Return r
End

Public Function AuthorName(boardId As Integer, cardId As Integer, kind As String, itemId As Integer) As String
  Dim r As Result
  If kind = "entry" Then
    r = Entry(boardId, cardId, itemId)
  Else If kind = "file" Then
    r = FileRecord(boardId, cardId, itemId)
  Else
    Error.Raise("Unknown author record")
  Endif
  Return RetiredAuthors.DisplayName(kind, itemId, r!author)
End

Public Sub RetainAuthorName(boardId As Integer, cardId As Integer, kind As String, itemId As Integer, authorName As String)
  Dim r As Result
  Dim tableName As String
  If kind = "entry" Then
    r = Entry(boardId, cardId, itemId)
    tableName = "kb_entries"
  Else If kind = "file" Then
    r = FileRecord(boardId, cardId, itemId)
    tableName = "kb_files"
  Else
    Error.Raise("Unknown author record")
  Endif
  BoardAccess.Require(boardId, "write")
  If r!author <> WebIdentity.Username Then Error.Raise("Author provenance requires a newly created record")
  If ExportText.Length(authorName) > 255 Then Error.Raise("Author name is too long")
  ' Imported names are display text, never a claim to a local account.
  $db.Exec("UPDATE " & tableName & " SET author = NULL WHERE id = &1 AND board_id = &2 AND card_id = &3", itemId, boardId, cardId)
  RetiredAuthors.Remember(kind, itemId, boardId, cardId, authorName)
End

Private Sub CopyAuthor(boardId As Integer, cardId As Integer, kind As String, itemId As Integer, author As String, displayName As String)
  Dim tableName As String = If(kind = "entry", "kb_entries", "kb_files")
  If Not author Then
    RetainAuthorName(boardId, cardId, kind, itemId, displayName)
    Return
  Endif
  $db.Exec("UPDATE " & tableName & " SET author = &1 WHERE id = &2 AND board_id = &3 AND card_id = &4", author, itemId, boardId, cardId)
End

Private Function Reaches(boardId As Integer, startId As Integer, targetId As Integer, kind As String, skipId As Integer) As Boolean
  Dim pending As New Integer[]
  Dim seen As New Collection
  Dim id As Integer
  Dim r As Result
  pending.Add(startId)
  While pending.Count
    id = pending[0]
    pending.Remove(0)
    If id = targetId Then Return True
    If seen.Exist(CStr(id)) Then Continue
    seen[CStr(id)] = True
    r = $db.Find("kb_entries", "board_id = &1 AND card_id = &2 AND kind = &3", boardId, id, kind)
    For Each r
      If r!id = skipId Then Continue
      pending.Add(CInt(r!amount))
    Next
  Wend
  Return False
End

Private Sub BeginChange(boardId As Integer, cardId As Integer, capability As String)
  Dim transaction As Boolean
  Dim failure As String
  RequireCard(boardId, cardId)
  BoardAccess.Require(boardId, capability)
  DatabaseTransactions.Begin($db)
  transaction = True
  $db.Exec("UPDATE kb_boards SET title=title WHERE id=&1", boardId)
  $db.Exec("UPDATE kb_cards SET title=title WHERE board_id=&1 AND id=&2", boardId, cardId)
  RequireCard(boardId, cardId)
  BoardAccess.Require(boardId, capability)
Catch
  failure = Error.Text
  If transaction Then Try DatabaseTransactions.Rollback($db)
  Error.Raise(failure)
End

Public Function Save(boardId As Integer, cardId As Integer, entryId As Integer, kind As String, title As String, body As String, parentId As Integer, done As Boolean, amount As Float, Optional valueType As String = "text", Optional baseline As Collection) As Integer
  Return SaveEntry(boardId, cardId, entryId, kind, title, body, parentId, done, amount, valueType, False, baseline)
End

Private Function SaveEntry(boardId As Integer, cardId As Integer, entryId As Integer, kind As String, title As String, body As String, parentId As Integer, done As Boolean, amount As Float, valueType As String, isCopy As Boolean, Optional baseline As Collection) As Integer
  Dim transaction As Boolean
  Dim failure As String
  Dim r As Result
  Dim target As Result
  Dim id As Integer = entryId
  Dim merged As Collection
  Dim number As Float
  RequireCard(boardId, cardId)
  BoardAccess.Require(boardId, If(kind = "comment" And Not isCopy, "comment", "write"))
  BeginChange(boardId, cardId, If(kind = "comment" And Not isCopy, "comment", "write"))
  transaction = True
  If entryId Then
    r = Entry(boardId, cardId, entryId)
    If kind = "comment" And r!author <> WebIdentity.Username And Not BoardAccess.Can(boardId, "manageBoard") Then Error.Raise("Comment not editable")
    If r!kind <> kind Then Error.Raise("Entry type cannot be changed")
    If baseline Then
      merged = EntryDraft.Merge(boardId, cardId, entryId, r, EntryDraft.Values(title, body, parentId, done, amount, valueType), baseline)
      title = merged["title"]
      body = merged["body"]
      parentId = merged["parent_id"]
      done = merged["done"]
      amount = merged["amount"]
      valueType = merged["value_type"]
    Endif
  Endif
  Select kind
    Case "comment"
      If Not Trim(body) Then Error.Raise("Enter a comment")
    Case "checklist", "checkitem", "custom"
      If Not Trim(title) Then Error.Raise("Enter a title")
    Case "subtask", "dependency"
      If amount <> CInt(amount) Then Error.Raise("Choose a whole card ID")
      target = WorkspaceStore.Record(boardId, "card", CInt(amount))
      If Reaches(boardId, CInt(amount), cardId, kind, entryId) Then Error.Raise("Circular card relationship")
      title = target!title
    Case "time"
      If amount < 0 Or amount > 525600 Then Error.Raise("Enter minutes between 0 and 525600")
      done = True
    Case Else
      Error.Raise("Unknown card detail type")
  End Select
  If ExportText.Length(title) > 255 Then Error.Raise("Title is too long")
  If kind = "checkitem" Then
    r = Entry(boardId, cardId, parentId)
    If r!kind <> "checklist" Then Error.Raise("Choose a checklist")
  Endif
  If kind = "custom" Then
    Select valueType
      Case "text"
      Case "number"
        If Not ExportNumber.ParseFinite(body, ByRef number) Then Error.Raise("Invalid numeric field")
        body = CStr(number)
      Case "date"
        If Len(body) <> 10 Or Mid(body, 5, 1) <> "-" Or Mid(body, 8, 1) <> "-" Then Error.Raise("Use YYYY-MM-DD")
        If Format(Date(CInt(Left(body, 4)), CInt(Mid(body, 6, 2)), CInt(Right(body, 2))), "yyyy-mm-dd") <> body Then Error.Raise("Invalid date")
      Case "checkbox"
        body = If(done, "true", "false")
      Case Else
        Error.Raise("Unknown field type")
    End Select
  Endif
  If entryId Then
    r = $db.Edit("kb_entries", "id = &1 AND board_id = &2 AND card_id = &3", entryId, boardId, cardId)
  Else
    r = $db.Create("kb_entries")
    r["board_id"] = boardId
    r["card_id"] = cardId
    r["author"] = WebIdentity.Username
    r["created_at"] = Now
  Endif
  r["kind"] = kind
  r["title"] = Trim(title)
  r["body"] = body
  r["parent_id"] = parentId
  r["done"] = done
  r["amount"] = amount
  r["value_type"] = valueType
  If entryId Then
    DatabaseText.Save($db, r, "kb_entries", ["kind", "title", "body", "parent_id", "done", "amount", "value_type"], False)
  Else
    DatabaseText.Save($db, r, "kb_entries", ["board_id", "card_id", "author", "created_at", "kind", "title", "body", "parent_id", "done", "amount", "value_type"], True)
  Endif
  If Not entryId Then id = $db.LastInsertId
  KanbanStore.Activity(boardId, "Saved " & kind & " on card " & CStr(cardId), "card", cardId)
  DatabaseTransactions.Commit($db)
  transaction = False
  Return id
Catch
  failure = Error.Text
  If transaction Then Try DatabaseTransactions.Rollback($db)
  Error.Raise(failure)
End

Public Sub DeleteEntry(boardId As Integer, cardId As Integer, entryId As Integer)
  Dim transaction As Boolean
  Dim failure As String
  Dim r As Result = Entry(boardId, cardId, entryId)
  BoardAccess.Require(boardId, If(r!kind = "comment", "comment", "write"))
  BeginChange(boardId, cardId, If(r!kind = "comment", "comment", "write"))
  transaction = True
  r = Entry(boardId, cardId, entryId)
  If r!kind = "comment" And r!author <> WebIdentity.Username And Not BoardAccess.Can(boardId, "manageBoard") Then Error.Raise("Comment not editable")
  If r!kind = "checklist" Then $db.Exec("DELETE FROM kb_entries WHERE board_id = &1 AND card_id = &2 AND parent_id = &3", boardId, cardId, entryId)
  $db.Exec("DELETE FROM kb_entries WHERE board_id = &1 AND card_id = &2 AND id = &3", boardId, cardId, entryId)
  RetiredAuthors.Prune(boardId)
  KanbanStore.Activity(boardId, "Deleted card detail", "card", cardId)
  DatabaseTransactions.Commit($db)
  transaction = False
Catch
  failure = Error.Text
  If transaction Then Try DatabaseTransactions.Rollback($db)
  Error.Raise(failure)
End

Public Function NewSubtask(boardId As Integer, cardId As Integer, title As String) As Integer
  Dim parent As Result
  Dim child As Integer
  Dim failure As String
  RequireCard(boardId, cardId)
  BoardAccess.Require(boardId, "write")
  parent = WorkspaceStore.Record(boardId, "card", cardId)
  DatabaseTransactions.Begin($db)
  child = KanbanStore.SaveCard(boardId, 0, title, "", parent!lane, parent!status, WebIdentity.Username, "", "", KanbanStore.CardListId(boardId, cardId))
  Save(boardId, cardId, 0, "subtask", title, "", 0, False, child)
  DatabaseTransactions.Commit($db)
  Return child
Catch
  failure = Error.Text
  Try DatabaseTransactions.Rollback($db)
  Error.Raise(failure)
End

Public Sub StartTimer(boardId As Integer, cardId As Integer)
  Dim transaction As Boolean
  Dim failure As String
  Dim r As Result
  RequireCard(boardId, cardId)
  BoardAccess.Require(boardId, "write")
  BeginChange(boardId, cardId, "write")
  transaction = True
  r = $db.Find("kb_entries", "board_id = &1 AND card_id = &2 AND kind = &3 AND author = &4 AND done = &5", boardId, cardId, "time", WebIdentity.Username, False)
  If r.Available Then Error.Raise("Timer already running")
  r = $db.Create("kb_entries")
  r["board_id"] = boardId
  r["card_id"] = cardId
  r["kind"] = "time"
  r["title"] = "Running timer"
  r["author"] = WebIdentity.Username
  r["created_at"] = Now
  r["amount"] = 0
  r["done"] = False
  r.Update()
  KanbanStore.Activity(boardId, "Started card timer", "card", cardId)
  DatabaseTransactions.Commit($db)
  transaction = False
Catch
  failure = Error.Text
  If transaction Then Try DatabaseTransactions.Rollback($db)
  Error.Raise(failure)
End

Public Sub StopTimer(boardId As Integer, cardId As Integer)
  Dim transaction As Boolean
  Dim failure As String
  Dim r As Result
  RequireCard(boardId, cardId)
  BoardAccess.Require(boardId, "write")
  BeginChange(boardId, cardId, "write")
  transaction = True
  r = $db.Edit("kb_entries", "board_id = &1 AND card_id = &2 AND kind = &3 AND author = &4 AND done = &5", boardId, cardId, "time", WebIdentity.Username, False)
  If Not r.Available Then Error.Raise("No running timer")
  r["amount"] = Max(0, DateDiff(r!created_at, Now, gb.Second)) / 60
  r["done"] = True
  r["title"] = "Tracked time"
  r.Update()
  KanbanStore.Activity(boardId, "Stopped card timer", "card", cardId)
  DatabaseTransactions.Commit($db)
  transaction = False
Catch
  failure = Error.Text
  If transaction Then Try DatabaseTransactions.Rollback($db)
  Error.Raise(failure)
End

Public Function Files(boardId As Integer, cardId As Integer) As Result
  RequireCard(boardId, cardId)
  Return $db.Find("kb_files", AttachmentLifecycle.LiveSql("kb_files") & " AND board_id = &1 AND card_id = &2 ORDER BY id", boardId, cardId)
End

Public Function FileSummaries(boardId As Integer, cardId As Integer) As Result
  RequireCard(boardId, cardId)
  Return $db.Exec("SELECT id,board_id,card_id,filename,author,created_at FROM kb_files WHERE " & AttachmentLifecycle.LiveSql("kb_files") & " AND board_id=&1 AND card_id=&2 ORDER BY id", boardId, cardId)
End

Public Function AddFile(boardId As Integer, cardId As Integer, filename As String, data As String, Optional mime As String = "application/octet-stream", Optional maxBytes As Integer = 10485760) As Integer
  Dim transaction As Boolean
  Dim failure As String
  Dim r As Result
  Dim id As Integer
  RequireCard(boardId, cardId)
  BoardAccess.Require(boardId, "write")
  BeginChange(boardId, cardId, "write")
  transaction = True
  filename = Replace(filename, "\\", "/")
  If InStr(filename, Chr(0)) Then
    filename = Mid(filename, RInStr(filename, "/") + 1)
  Else
    filename = File.Name(filename)
  Endif
  If Not filename Or ExportText.Length(filename) > 255 Or maxBytes < 0 Or maxBytes > 67108864 Or Len(data) > maxBytes Then Error.Raise("Choose a file within the size limit with a valid name")
  r = $db.Create("kb_files")
  r["board_id"] = boardId
  r["card_id"] = cardId
  r["filename"] = filename
  r["content"] = data
  r["author"] = WebIdentity.Username
  r["created_at"] = Now
  DatabaseText.Save($db, r, "kb_files", ["board_id", "card_id", "filename", "content", "author", "created_at"], True)
  id = $db.LastInsertId
  AttachmentData.Record(boardId, cardId, id, mime)
  KanbanStore.Activity(boardId, "Attached file: " & filename, "card", cardId)
  RequireCard(boardId, cardId)
  BoardAccess.Require(boardId, "write")
  DatabaseTransactions.Commit($db)
  transaction = False
  Return id
Catch
  failure = Error.Text
  If transaction Then Try DatabaseTransactions.Rollback($db)
  Error.Raise(failure)
End

Public Function FileRecord(boardId As Integer, cardId As Integer, fileId As Integer) As Result
  Dim r As Result
  RequireCard(boardId, cardId)
  r = $db.Find("kb_files", AttachmentLifecycle.LiveSql("kb_files") & " AND board_id = &1 AND card_id = &2 AND id = &3", boardId, cardId, fileId)
  If Not r.Available Then Error.Raise("Attachment not accessible")
  Return r
End

Public Sub DeleteFile(boardId As Integer, cardId As Integer, fileId As Integer)
  AttachmentLifecycle.Delete(boardId, cardId, fileId)
End

Public Sub CopyRecords(sourceBoard As Integer, sourceCard As Integer, targetBoard As Integer, targetCard As Integer, Optional options As Collection)
  Dim fields As Collection
  Dim r As Result
  Dim kind As String
  Dim parents As New Collection
  Dim parentId As Integer
  Dim id As Integer
  Dim cover As Integer
  RequireCard(sourceBoard, sourceCard)
  RequireCard(targetBoard, targetCard)
  BoardAccess.Require(targetBoard, "write")
  If Not options Then options = CopyOptions.Defaults()
  fields = CopyOptions.Normalize(options)
  For Each kind In ["checklist", "checkitem", "comment", "custom", "time"]
    If (kind = "checklist" Or kind = "checkitem") And Not fields["checklists"] Then Continue
    If kind = "comment" And Not fields["comments"] Then Continue
    If kind = "custom" And Not fields["customFields"] Then Continue
    r = Entries(sourceBoard, sourceCard, kind)
    For Each r
      If kind = "time" And Not r!done Then Continue
      parentId = 0
      If kind = "checkitem" Then
        If Not parents.Exist(CStr(r!parent_id)) Then Continue
        parentId = parents[CStr(r!parent_id)]
      Endif
      id = SaveEntry(targetBoard, targetCard, 0, kind, r!title, r!body, parentId, r!done, r!amount, r!value_type, True)
      CopyAuthor(targetBoard, targetCard, "entry", id, r!author, AuthorName(sourceBoard, sourceCard, "entry", r!id))
      If kind = "checklist" Then parents[CStr(r!id)] = id
    Next
  Next
  If Not fields["attachments"] Then Return
  cover = AttachmentLifecycle.CoverId(sourceBoard, sourceCard)
  r = Files(sourceBoard, sourceCard)
  For Each r
    id = AddFile(targetBoard, targetCard, r!filename, r!content.Data, AttachmentData.Mime(sourceBoard, sourceCard, r!id), 67108864)
    If r!id = cover Then AttachmentLifecycle.SetCover(targetBoard, targetCard, id)
    CopyAuthor(targetBoard, targetCard, "file", id, r!author, AuthorName(sourceBoard, sourceCard, "file", r!id))
  Next
End

Public Function UploadFile(boardId As Integer, cardId As Integer, filename As String, bytes As String, Optional mime As String = "application/octet-stream") As Integer
  Dim actor As String = WebIdentity.Username
  Dim id As Integer
  Dim transaction As Boolean
  Dim failure As String
  OpenStore()
  RequireCard(boardId, cardId)
  BoardAccess.Require(boardId, "write")
  If WorkspaceStore.Setting(boardId, "board", boardId, "allowsAttachments", "1") <> "1" Then Error.Raise("Attachments are not allowed on this board")
  TransferPolicy.RequireTransfer("attachmentsUpload", Len(bytes))
  DatabaseTransactions.Begin($db)
  transaction = True
  $db.Exec("UPDATE users SET username=username WHERE username=&1", actor)
  TransferPolicy.Lock()
  RequireCard(boardId, cardId)
  BoardAccess.Require(boardId, "write")
  If WorkspaceStore.Setting(boardId, "board", boardId, "allowsAttachments", "1") <> "1" Then Error.Raise("Attachments are not allowed on this board")
  TransferPolicy.RequireTransfer("attachmentsUpload", Len(bytes))
  id = AddFile(boardId, cardId, filename, bytes, mime, CInt(Floor(TransferPolicy.Limit("attachmentsUpload"))))
  If WebIdentity.Username <> actor Then Error.Raise("Sign in required")
  RequireCard(boardId, cardId)
  BoardAccess.Require(boardId, "write")
  If WorkspaceStore.Setting(boardId, "board", boardId, "allowsAttachments", "1") <> "1" Then Error.Raise("Attachments are not allowed on this board")
  TransferPolicy.RequireTransfer("attachmentsUpload", Len(bytes))
  DatabaseTransactions.Commit($db)
  transaction = False
  Return id
Catch
  failure = Error.Text
  If transaction Then Try DatabaseTransactions.Rollback($db)
  Error.Raise(failure)
End

Public Function DownloadFile(boardId As Integer, cardId As Integer, fileId As Integer) As Result
  Dim r As Result
  RequireCard(boardId, cardId)
  TransferPolicy.RequireTransfer("attachmentsDownload", 0)
  r = $db.Exec("SELECT COALESCE(LENGTH(content),0) AS size FROM kb_files WHERE " & AttachmentLifecycle.LiveSql("kb_files") & " AND board_id=&1 AND card_id=&2 AND id=&3", boardId, cardId, fileId)
  If Not r.Available Then Error.Raise("Attachment not accessible")
  TransferPolicy.RequireTransfer("attachmentsDownload", r!size)
  r = FileRecord(boardId, cardId, fileId)
  TransferPolicy.RequireTransfer("attachmentsDownload", Len(r!content.Data))
  RequireCard(boardId, cardId)
  Return r
End
