' Card detail records are scoped by both board and card at every entry point.
Export
Private $db As Connection

Public Sub OpenStore()
  Dim t As Table
  If $db Then Return
  WorkspaceStore.OpenStore()
  $db = WebDatabase.OpenConnection()
  If Not $db.Tables.Exist("kb_entries") Then
    t = $db.Tables.Add("kb_entries")
    t.Fields.Add("id", db.Serial)
    t.Fields.Add("board_id", db.Integer)
    t.Fields.Add("card_id", db.Integer)
    t.Fields.Add("kind", db.String, 32)
    t.Fields.Add("parent_id", db.Integer)
    t.Fields.Add("title", db.String, 255)
    t.Fields.Add("body", db.String)
    t.Fields.Add("value_type", db.String, 16)
    t.Fields.Add("done", db.Boolean)
    t.Fields.Add("amount", db.Float)
    t.Fields.Add("author", db.String, 255)
    t.Fields.Add("created_at", db.Date)
    t.PrimaryKey = ["id"]
    t.Update()
  Endif
  If Not $db.Tables.Exist("kb_files") Then
    t = $db.Tables.Add("kb_files")
    t.Fields.Add("id", db.Serial)
    t.Fields.Add("board_id", db.Integer)
    t.Fields.Add("card_id", db.Integer)
    t.Fields.Add("filename", db.String, 255)
    t.Fields.Add("content", db.Blob)
    t.Fields.Add("author", db.String, 255)
    t.Fields.Add("created_at", db.Date)
    t.PrimaryKey = ["id"]
    t.Update()
  Endif
  RetiredAuthors.OpenStore()
  AttachmentLifecycle.OpenStore()
  AttachmentData.OpenStore()
  TransferPolicy.OpenStore()
End

Private Sub RequireCard(boardId As Integer, cardId As Integer)
  OpenStore()
  WorkspaceStore.Record(boardId, "card", cardId)
End

Public Function Entries(boardId As Integer, cardId As Integer, kind As String, Optional completeText As Boolean) As Result
  Dim projection As String
  RequireCard(boardId, cardId)
  projection = If(completeText, ExportText.SelectRows($db, "kb_entries"), "SELECT * FROM kb_entries")
  If kind = "subtask" Or kind = "dependency" Then
    If Not BoardAccess.Can(boardId, "seesAllCards") Then Return $db.Exec(projection & " WHERE " & "board_id = &1 AND card_id = &2 AND kind = &3 AND amount IN (SELECT id FROM kb_cards WHERE " & ListDeletion.LiveSql("card", "kb_cards") & " AND board_id = &1 AND (assignee = &4 OR id IN (SELECT card_id FROM kb_card_assignees WHERE board_id = &1 AND username = &4))) ORDER BY id", boardId, cardId, kind, WebIdentity.Username)
    Return $db.Exec(projection & " WHERE " & "board_id=&1 AND card_id=&2 AND kind=&3 AND amount IN (SELECT id FROM kb_cards WHERE " & ListDeletion.LiveSql("card", "kb_cards") & " AND board_id=&1) ORDER BY id", boardId, cardId, kind)
  Endif
  Return $db.Exec(projection & " WHERE " & "board_id = &1 AND card_id = &2 AND kind = &3 ORDER BY id", boardId, cardId, kind)
End

Public Function Entry(boardId As Integer, cardId As Integer, entryId As Integer, Optional completeText As Boolean) As Result
  Dim r As Result
  RequireCard(boardId, cardId)
  If completeText Then
    r = $db.Exec(ExportText.SelectRows($db, "kb_entries") & " WHERE board_id=&1 AND card_id=&2 AND id=&3", boardId, cardId, entryId)
  Else
    r = $db.Find("kb_entries", "board_id = &1 AND card_id = &2 AND id = &3", boardId, cardId, entryId)
  Endif
  If Not r.Available Then Error.Raise("Card entry not accessible")
  If ExportText.ReadValue(r, "kind") = "subtask" Or ExportText.ReadValue(r, "kind") = "dependency" Then BoardAccess.RequireCard(boardId, CInt(r!amount))
  Return r
End

Public Function AuthorName(boardId As Integer, cardId As Integer, kind As String, itemId As Integer) As String
  Dim r As Result
  If kind = "entry" Then
    r = Entry(boardId, cardId, itemId, True)
  Else If kind = "file" Then
    r = FileRecord(boardId, cardId, itemId, True)
  Else
    Error.Raise("Unknown author record")
  Endif
  Return RetiredAuthors.DisplayName(kind, itemId, ExportText.ReadValue(r, "author"))
End

Public Sub RetainAuthorName(boardId As Integer, cardId As Integer, kind As String, itemId As Integer, authorName As String)
  Dim r As Result
  Dim tableName As String
  If kind = "entry" Then
    r = Entry(boardId, cardId, itemId, True)
    tableName = "kb_entries"
  Else If kind = "file" Then
    r = FileRecord(boardId, cardId, itemId, True)
    tableName = "kb_files"
  Else
    Error.Raise("Unknown author record")
  Endif
  BoardAccess.Require(boardId, "write")
  If ExportText.ReadValue(r, "author") <> WebIdentity.Username Then Error.Raise("Author provenance requires a newly created record")
  If ExportText.Length(authorName) > 255 Then Error.Raise("Author name is too long")
  ' Imported names are display text, never a claim to a local account.
  $db.Exec("UPDATE " & tableName & " SET author = NULL WHERE id = &1 AND board_id = &2 AND card_id = &3", itemId, boardId, cardId)
  RetiredAuthors.Remember(kind, itemId, boardId, cardId, authorName)
End

Private Sub CopyAuthor(boardId As Integer, cardId As Integer, kind As String, itemId As Integer, author As String, displayName As String)
  Dim tableName As String = If(kind = "entry", "kb_entries", "kb_files")
  If Not author Then
    RetainAuthorName(boardId, cardId, kind, itemId, displayName)
    Return
  Endif
  $db.Exec("UPDATE " & tableName & " SET author = &1 WHERE id = &2 AND board_id = &3 AND card_id = &4", author, itemId, boardId, cardId)
End

Private Function Reaches(boardId As Integer, startId As Integer, targetId As Integer, kind As String, skipId As Integer) As Boolean
  Dim pending As New Integer[]
  Dim seen As New Collection
  Dim id As Integer
  Dim r As Result
  pending.Add(startId)
  While pending.Count
    id = pending[0]
    pending.Remove(0)
    If id = targetId Then Return True
    If seen.Exist(CStr(id)) Then Continue
    seen[CStr(id)] = True
    r = $db.Find("kb_entries", "board_id = &1 AND card_id = &2 AND kind = &3", boardId, id, kind)
    For Each r
      If r!id = skipId Then Continue
      pending.Add(CInt(r!amount))
    Next
  Wend
  Return False
End

Private Sub BeginChange(boardId As Integer, cardId As Integer, capability As String, Optional actor As String)
  Dim transaction As Boolean
  Dim failure As String
  If Not actor Then actor = WebIdentity.Username
  RequireCard(boardId, cardId)
  BoardAccess.Require(boardId, capability)
  DatabaseTransactions.Begin($db)
  transaction = True
  If actor Then
    $db.Exec("UPDATE users SET username=username WHERE username=&1", actor)
    If WebIdentity.Username <> actor Then Error.Raise("Sign in required")
  Endif
  $db.Exec("UPDATE kb_boards SET title=title WHERE id=&1", boardId)
  $db.Exec("UPDATE kb_cards SET title=title WHERE board_id=&1 AND id=&2", boardId, cardId)
  RequireCard(boardId, cardId)
  BoardAccess.Require(boardId, capability)
  If actor And WebIdentity.Username <> actor Then Error.Raise("Sign in required")
Catch
  failure = Error.Text
  If transaction Then Try DatabaseTransactions.Rollback($db)
  Error.Raise(failure)
End

Public Function Save(boardId As Integer, cardId As Integer, entryId As Integer, kind As String, title As String, body As String, parentId As Integer, done As Boolean, amount As Float, Optional valueType As String = "text", Optional baseline As Collection) As Integer
  Return SaveEntry(boardId, cardId, entryId, kind, title, body, parentId, done, amount, valueType, False, baseline)
End

Private Function SaveEntry(boardId As Integer, cardId As Integer, entryId As Integer, kind As String, title As String, body As String, parentId As Integer, done As Boolean, amount As Float, valueType As String, isCopy As Boolean, Optional baseline As Collection) As Integer
  Dim transaction As Boolean
  Dim failure As String
  Dim r As Result
  Dim target As Result
  Dim id As Integer = entryId
  Dim merged As Collection
  Dim number As Float
  Dim actor As String = WebIdentity.Username
  Dim capability As String = If(kind = "comment" And Not isCopy, "comment", "write")
  Dim scope As New Collection
  Dim values As Collection
  Dim field As String
  RequireCard(boardId, cardId)
  BoardAccess.Require(boardId, If(kind = "comment" And Not isCopy, "comment", "write"))
  BeginChange(boardId, cardId, capability, actor)
  transaction = True
  scope.Add(actor, "actor")
  scope.Add(capability, "capability")
  scope.Add(kind, "kind")
  scope.Add(actor, "author")
  scope.Add(False, "authorNull")
  CaptureDetailScope(boardId, cardId, scope)
  If entryId Then
    $db.Exec("UPDATE kb_entries SET title=title WHERE board_id=&1 AND card_id=&2 AND id=&3", boardId, cardId, entryId)
    r = Entry(boardId, cardId, entryId, True)
    If kind = "comment" And ExportText.ReadValue(r, "author") <> WebIdentity.Username And Not BoardAccess.Can(boardId, "manageBoard") Then Error.Raise("Comment not editable")
    If ExportText.ReadValue(r, "kind") <> kind Then Error.Raise("Entry type cannot be changed")
    scope["author"] = ExportText.ReadValue(r, "author")
    scope["authorNull"] = TextIsNull(r, "author")
    scope.Add(JSON.Encode(r["created_at"]), "createdAt")
    If baseline Then
      merged = EntryDraft.Merge(boardId, cardId, entryId, r, EntryDraft.Values(title, body, parentId, done, amount, valueType), baseline)
      title = merged["title"]
      body = merged["body"]
      parentId = merged["parent_id"]
      done = merged["done"]
      amount = merged["amount"]
      valueType = merged["value_type"]
    Endif
  Endif
  Select kind
    Case "comment"
      If Not Trim(body) Then Error.Raise("Enter a comment")
    Case "checklist", "checkitem", "custom"
      If Not Trim(title) Then Error.Raise("Enter a title")
    Case "subtask", "dependency"
      If amount <> CInt(amount) Then Error.Raise("Choose a whole card ID")
      $db.Exec("UPDATE kb_cards SET title=title WHERE board_id=&1 AND id=&2", boardId, CInt(amount))
      target = WorkspaceStore.Record(boardId, "card", CInt(amount))
      scope.Add(CBool(target!archived), "targetArchived")
      If Reaches(boardId, CInt(amount), cardId, kind, entryId) Then Error.Raise("Circular card relationship")
      title = ExportText.ReadValue(target, "title")
    Case "time"
      If amount < 0 Or amount > 525600 Then Error.Raise("Enter minutes between 0 and 525600")
      done = True
    Case Else
      Error.Raise("Unknown card detail type")
  End Select
  If ExportText.Length(title) > 255 Then Error.Raise("Title is too long")
  If kind = "checkitem" Then
    $db.Exec("UPDATE kb_entries SET title=title WHERE board_id=&1 AND card_id=&2 AND id=&3", boardId, cardId, parentId)
    r = Entry(boardId, cardId, parentId, True)
    If ExportText.ReadValue(r, "kind") <> "checklist" Then Error.Raise("Choose a checklist")
  Endif
  If kind = "custom" Then
    Select valueType
      Case "text"
      Case "number"
        If Not ExportNumber.ParseFinite(body, ByRef number) Then Error.Raise("Invalid numeric field")
        If Not isCopy Then body = CStr(number)
      Case "date"
        If Len(body) <> 10 Or Mid(body, 5, 1) <> "-" Or Mid(body, 8, 1) <> "-" Then Error.Raise("Use YYYY-MM-DD")
        If Format(Date(CInt(Left(body, 4)), CInt(Mid(body, 6, 2)), CInt(Right(body, 2))), "yyyy-mm-dd") <> body Then Error.Raise("Invalid date")
      Case "checkbox"
        body = If(done, "true", "false")
      Case Else
        Error.Raise("Unknown field type")
    End Select
  Endif
  values = EntryDraft.Values(Trim(title), body, parentId, done, amount, valueType)
  For Each field In values.Keys
    scope.Add(values[field], field)
  Next
  If entryId Then
    r = $db.Edit("kb_entries", "id = &1 AND board_id = &2 AND card_id = &3", entryId, boardId, cardId)
  Else
    r = $db.Create("kb_entries")
    r["board_id"] = boardId
    r["card_id"] = cardId
    r["author"] = WebIdentity.Username
    scope.Add(Now, "newCreatedAt")
    r["created_at"] = scope["newCreatedAt"]
  Endif
  r["kind"] = kind
  r["title"] = Trim(title)
  r["body"] = body
  r["parent_id"] = parentId
  r["done"] = done
  r["amount"] = amount
  r["value_type"] = valueType
  If entryId Then
    DatabaseText.Save($db, r, "kb_entries", ["kind", "title", "body", "parent_id", "done", "amount", "value_type"], False)
  Else
    DatabaseText.Save($db, r, "kb_entries", ["board_id", "card_id", "author", "created_at", "kind", "title", "body", "parent_id", "done", "amount", "value_type"], True)
  Endif
  If Not entryId Then id = $db.LastInsertId
  RequireSavedEntry(boardId, cardId, id, scope)
  KanbanStore.Activity(boardId, "Saved " & kind & " on card " & CStr(cardId), "card", cardId)
  RequireSavedEntry(boardId, cardId, id, scope)
  DatabaseTransactions.Commit($db)
  transaction = False
  Return id
Catch
  failure = Error.Text
  If transaction Then Try DatabaseTransactions.Rollback($db)
  Error.Raise(failure)
End

Private Sub CaptureDetailScope(boardId As Integer, cardId As Integer, scope As Collection)
  Dim r As Result
  Dim target As Result
  r = WorkspaceStore.Record(boardId, "board", boardId)
  scope.Add(CBool(r!archived), "boardArchived")
  r = WorkspaceStore.Record(boardId, "card", cardId)
  scope.Add(CBool(r!archived), "cardArchived")
  scope.Add(ExportText.ReadValue(r, "lane"), "cardLane")
  scope.Add(ExportText.ReadValue(r, "status"), "cardStatus")
  scope.Add(KanbanStore.ReadCardListId(boardId, cardId), "listId")
  If scope["listId"] > 0 Then
    r = WorkspaceStore.Record(boardId, "list", scope["listId"])
    scope.Add(ExportText.ReadValue(r, "lane"), "listLane")
    scope.Add(ExportText.ReadValue(r, "title"), "listTitle")
    scope.Add(WorkspaceStore.ListHidden(boardId, scope["listId"]), "listHidden")
    scope.Add(WorkspaceStore.Archived(boardId, "list", scope["listId"]), "listArchived")
    target = $db.Exec("SELECT id FROM kb_lanes WHERE board_id=&1 AND " & ExportText.MatchText($db, "title", 2, scope["listLane"]), boardId, ExportText.BindText($db, scope["listLane"]))
    scope.Add(target.Available, "laneExists")
    If target.Available Then scope.Add(WorkspaceStore.Archived(boardId, "lane", target!id), "laneArchived")
  Endif
End

Private Sub RequireDetailScope(boardId As Integer, cardId As Integer, scope As Collection)
  Dim row As Result
  Dim listId As Integer = scope["listId"]
  If Not WebIdentity.Username Or WebIdentity.Username <> scope["actor"] Then Error.Raise("Sign in required")
  RequireCard(boardId, cardId)
  BoardAccess.Require(boardId, scope["capability"])
  row = WorkspaceStore.Record(boardId, "board", boardId)
  If CBool(row!archived) <> scope["boardArchived"] Then Error.Raise("Board archive state changed")
  row = WorkspaceStore.Record(boardId, "card", cardId)
  If CBool(row!archived) <> scope["cardArchived"] Then Error.Raise("Card archive state changed")
  If ExportText.ReadValue(row, "lane") <> scope["cardLane"] Or ExportText.ReadValue(row, "status") <> scope["cardStatus"] Then Error.Raise("Card placement changed")
  If KanbanStore.ReadCardListId(boardId, cardId) <> listId Then Error.Raise("Card destination changed")
  If listId > 0 Then
    row = WorkspaceStore.Record(boardId, "list", listId)
    If ExportText.ReadValue(row, "lane") <> scope["listLane"] Or ExportText.ReadValue(row, "title") <> scope["listTitle"] Then Error.Raise("Card list changed")
    If WorkspaceStore.ListHidden(boardId, listId) <> scope["listHidden"] Then Error.Raise("Card container archive state changed")
    If WorkspaceStore.Archived(boardId, "list", listId) <> scope["listArchived"] Then Error.Raise("Card list archive state changed")
    row = $db.Exec("SELECT id FROM kb_lanes WHERE board_id=&1 AND " & ExportText.MatchText($db, "title", 2, scope["listLane"]), boardId, ExportText.BindText($db, scope["listLane"]))
    If row.Available <> scope["laneExists"] Then Error.Raise("Card swimlane changed")
    If row.Available Then
      If WorkspaceStore.Archived(boardId, "lane", row!id) <> scope["laneArchived"] Then Error.Raise("Card swimlane archive state changed")
    Endif
  Endif
End

Private Function TextIsNull(row As Result, field As String) As Boolean
  If row.Fields.Exist("__weba_null_" & field) Then Return CBool(row["__weba_null_" & field])
  Return TypeOf(row[field]) <> gb.String And IsNull(row[field])
End

' The caller retains its transaction through data, history and change-clock writes.
Private Sub RequireSavedEntry(boardId As Integer, cardId As Integer, entryId As Integer, scope As Collection)
  Dim row As Result
  Dim values As Collection
  Dim field As String
  Dim kind As String = scope["kind"]
  RequireDetailScope(boardId, cardId, scope)
  row = Entry(boardId, cardId, entryId, True)
  values = EntryDraft.Record(row)
  If Not $db.Find("kb_entries", "board_id=&1 AND card_id=&2 AND id=&3 AND title IS NOT NULL AND body IS NOT NULL AND parent_id IS NOT NULL AND done IS NOT NULL AND amount IS NOT NULL AND value_type IS NOT NULL", boardId, cardId, entryId).Available Then Error.Raise("Entry value became null")
  If values["kind"] <> kind Then Error.Raise("Entry type changed")
  For Each field In ["title", "body", "parent_id", "done", "amount", "value_type"]
    If values[field] <> scope[field] Then Error.Raise("Entry changed during save")
  Next
  If values["author"] <> scope["author"] Or TextIsNull(row, "author") <> scope["authorNull"] Then Error.Raise("Entry author changed")
  If scope.Exist("createdAt") And If JSON.Encode(row["created_at"]) <> scope["createdAt"] Then Error.Raise("Entry creation time changed")
  If scope.Exist("newCreatedAt") Then
    If Not $db.Find("kb_entries", "board_id=&1 AND card_id=&2 AND id=&3 AND created_at=&4", boardId, cardId, entryId, scope["newCreatedAt"]).Available Then Error.Raise("Entry creation time changed")
  Endif
  If kind = "comment" And scope["author"] <> scope["actor"] And Not BoardAccess.Can(boardId, "manageBoard") Then Error.Raise("Comment not editable")
  If kind = "checkitem" Then
    row = Entry(boardId, cardId, scope["parent_id"], True)
    If ExportText.ReadValue(row, "kind") <> "checklist" Then Error.Raise("Checklist parent changed")
  Endif
  If kind = "subtask" Or kind = "dependency" Then
    row = WorkspaceStore.Record(boardId, "card", CInt(scope["amount"]))
    If CBool(row!archived) <> scope["targetArchived"] Or Trim(ExportText.ReadValue(row, "title")) <> scope["title"] Then Error.Raise("Related card changed")
    If Reaches(boardId, CInt(scope["amount"]), cardId, kind, entryId) Then Error.Raise("Circular card relationship")
  Endif
End

Public Sub DeleteEntry(boardId As Integer, cardId As Integer, entryId As Integer)
  Dim transaction As Boolean
  Dim failure As String
  Dim actor As String = WebIdentity.Username
  Dim r As Result = Entry(boardId, cardId, entryId, True)
  Dim kind As String = ExportText.ReadValue(r, "kind")
  Dim capability As String = If(kind = "comment", "comment", "write")
  Dim scope As New Collection
  Dim ids As New Integer[]
  Dim order As New Integer[]
  Dim removed As New Integer[]
  Dim stamps As New Collection
  Dim id As Integer
  BoardAccess.Require(boardId, capability)
  If kind = "comment" And ExportText.ReadValue(r, "author") <> actor And Not BoardAccess.Can(boardId, "manageBoard") Then Error.Raise("Comment not editable")
  BeginChange(boardId, cardId, capability, actor)
  transaction = True
  scope.Add(actor, "actor")
  scope.Add(capability, "capability")
  scope.Add(kind, "kind")
  CaptureDetailScope(boardId, cardId, scope)
  ids.Add(entryId)
  If kind = "checklist" Then
    r = $db.Find("kb_entries", "board_id=&1 AND card_id=&2 AND parent_id=&3", boardId, cardId, entryId)
    For Each r
      If ids.Find(r!id) < 0 Then ids.Add(r!id)
    Next
  Endif
  ids.Sort()
  For Each id In ids
    $db.Exec("UPDATE kb_entries SET title=title WHERE board_id=&1 AND card_id=&2 AND id=&3", boardId, cardId, id)
  Next
  r = Entry(boardId, cardId, entryId, True)
  If ExportText.ReadValue(r, "kind") <> kind Then Error.Raise("Entry type changed; reopen before deleting")
  scope.Add(ExportText.ReadValue(r, "author"), "author")
  If kind = "comment" And scope["author"] <> actor And Not BoardAccess.Can(boardId, "manageBoard") Then Error.Raise("Comment not editable")
  If kind = "subtask" Or kind = "dependency" Then
    scope.Add(CInt(r!amount), "relatedId")
    r = WorkspaceStore.Record(boardId, "card", scope["relatedId"])
    scope.Add(CBool(r!archived), "relatedArchived")
  Endif
  For Each id In ids
    r = $db.Exec(ExportText.SelectRows($db, "kb_entries") & " WHERE board_id=&1 AND card_id=&2 AND id=&3", boardId, cardId, id)
    If Not r.Available Then Error.Raise("Entry deletion set changed")
    If kind = "checklist" And id <> entryId Then
      If IsNull(r!parent_id) Or r!parent_id <> entryId Then Error.Raise("Checklist deletion set changed")
    Endif
    stamps.Add(DeletionStamp(r), CStr(id))
    If id <> entryId Then order.Add(id)
  Next
  order.Add(entryId)
  RequireEntryDeletion(boardId, cardId, entryId, scope, ids, stamps, removed, False)
  For Each id In order
    RequireEntryDeletion(boardId, cardId, entryId, scope, ids, stamps, removed, False, id)
    $db.Exec("DELETE FROM kb_entries WHERE board_id=&1 AND card_id=&2 AND id=&3", boardId, cardId, id)
    removed.Add(id)
    RequireEntryDeletion(boardId, cardId, entryId, scope, ids, stamps, removed, False, id)
  Next
  RequireEntryDeletion(boardId, cardId, entryId, scope, ids, stamps, removed, False)
  RetiredAuthors.Prune(boardId)
  RequireEntryDeletion(boardId, cardId, entryId, scope, ids, stamps, removed, True)
  KanbanStore.Activity(boardId, "Deleted card detail", "card", cardId)
  RequireEntryDeletion(boardId, cardId, entryId, scope, ids, stamps, removed, True)
  DatabaseTransactions.Commit($db)
  transaction = False
Catch
  failure = Error.Text
  If transaction Then Try DatabaseTransactions.Rollback($db)
  Error.Raise(failure)
End

Private Function EntryState(row As Result) As Collection
  Dim data As New Collection
  Dim field As ResultField
  Dim value As Variant
  For Each field In row.Fields
    If Left(field.Name, 7) = "__weba_" Then Continue
    If field.Type = DB.String Then
      If TextIsNull(row, field.Name) Then
        data.Add(JSON.Null, field.Name)
      Else
        data.Add(ExportText.ReadValue(row, field.Name), field.Name)
      Endif
    Else If field.Type = DB.Float Then
      value = ExportText.ReadNumber(row, field.Name)
      data.Add(If(IsNull(value), JSON.Null, value), field.Name)
    Else If field.Type = DB.Blob Then
      If IsNull(row[field.Name]) Then
        data.Add(JSON.Null, field.Name)
      Else
        data.Add(Base64(row[field.Name].Data), field.Name)
      Endif
    Else
      value = row[field.Name]
      data.Add(If(IsNull(value), JSON.Null, value), field.Name)
    Endif
  Next
  Return data
End

Private Function DeletionStamp(row As Result) As String
  Return JsonText.Encode(EntryState(row))
End

Private Sub RequireEntryDeletion(boardId As Integer, cardId As Integer, entryId As Integer, scope As Collection, ids As Integer[], stamps As Collection, removed As Integer[], cleaned As Boolean, Optional effectId As Integer)
  Dim id As Integer
  Dim row As Result
  Dim checking As Integer[]
  RequireDetailScope(boardId, cardId, scope)
  If scope["kind"] = "comment" And scope["author"] <> scope["actor"] And Not BoardAccess.Can(boardId, "manageBoard") Then Error.Raise("Comment not editable")
  If scope.Exist("relatedId") Then
    row = WorkspaceStore.Record(boardId, "card", scope["relatedId"])
    If CBool(row!archived) <> scope["relatedArchived"] Then Error.Raise("Related card archive state changed")
  Endif
  If effectId > 0 Then
    checking = New Integer[]
    checking.Add(entryId)
    If effectId <> entryId Then checking.Add(effectId)
  Else
    checking = ids
  Endif
  For Each id In checking
    If removed.Find(id) >= 0 Then
      If $db.Exec("SELECT id FROM kb_entries WHERE id=&1", id).Available Then Error.Raise("Deleted entry reappeared")
      If cleaned And If $db.Tables.Exist("kb_retired_authors") Then
        If $db.Exec("SELECT item_id FROM kb_retired_authors WHERE kind='entry' AND item_id=&1", id).Available Then Error.Raise("Deleted entry provenance remains")
      Endif
    Else
      row = $db.Exec(ExportText.SelectRows($db, "kb_entries") & " WHERE board_id=&1 AND card_id=&2 AND id=&3", boardId, cardId, id)
      If Not row.Available Then Error.Raise("Entry deletion set changed")
      If DeletionStamp(row) <> stamps[CStr(id)] Then Error.Raise("Entry changed during deletion")
    Endif
  Next
  If scope["kind"] = "checklist" And (effectId = 0 Or effectId = entryId) Then
    row = $db.Find("kb_entries", "board_id=&1 AND card_id=&2 AND parent_id=&3 AND id<>&3", boardId, cardId, entryId)
    For Each row
      If ids.Find(row!id) < 0 Or removed.Find(row!id) >= 0 Then Error.Raise("Checklist deletion set changed")
    Next
  Endif
End

Public Function NewSubtask(boardId As Integer, cardId As Integer, title As String) As Integer
  Dim parent As Result
  Dim child As Integer
  Dim failure As String
  RequireCard(boardId, cardId)
  BoardAccess.Require(boardId, "write")
  parent = WorkspaceStore.Record(boardId, "card", cardId)
  DatabaseTransactions.Begin($db)
  child = KanbanStore.SaveCard(boardId, 0, title, "", parent!lane, parent!status, WebIdentity.Username, "", "", KanbanStore.CardListId(boardId, cardId))
  Save(boardId, cardId, 0, "subtask", title, "", 0, False, child)
  DatabaseTransactions.Commit($db)
  Return child
Catch
  failure = Error.Text
  Try DatabaseTransactions.Rollback($db)
  Error.Raise(failure)
End

Private Function RunningTimers(boardId As Integer, cardId As Integer, actor As String) As Integer[]
  Dim ids As New Integer[]
  Dim row As Result = $db.Find("kb_entries", "board_id=&1 AND card_id=&2 AND kind=&3 AND author=&4 AND done=&5 ORDER BY id", boardId, cardId, "time", actor, False)
  For Each row
    ids.Add(row!id)
  Next
  Return ids
End

Private Sub RequireTimer(boardId As Integer, cardId As Integer, scope As Collection)
  Dim row As Result
  Dim state As Collection
  Dim expected As Collection = scope["timerState"]
  Dim key As String
  Dim id As Integer
  RequireDetailScope(boardId, cardId, scope)
  row = $db.Exec(ExportText.SelectRows($db, "kb_entries") & " WHERE board_id=&1 AND card_id=&2 AND id=&3", boardId, cardId, scope["timerId"])
  If Not row.Available Then Error.Raise("Timer not accessible")
  state = EntryState(row)
  If state.Count <> expected.Count Then Error.Raise("Timer changed during write")
  For Each key In expected.Keys
    If Not state.Exist(key) Then Error.Raise("Timer changed during write")
    If JsonText.Encode(state[key]) <> JsonText.Encode(expected[key]) Then Error.Raise("Timer changed during write")
  Next
  If JsonText.Encode(RunningTimers(boardId, cardId, scope["actor"])) <> JsonText.Encode(scope["running"]) Then Error.Raise("Running timer set changed")
  For Each key In scope["others"].Keys
    id = CInt(key)
    row = $db.Exec(ExportText.SelectRows($db, "kb_entries") & " WHERE board_id=&1 AND card_id=&2 AND id=&3", boardId, cardId, id)
    If Not row.Available Then Error.Raise("Running timer set changed")
    If DeletionStamp(row) <> scope["others"][key] Then Error.Raise("Other running timer changed")
  Next
End

Public Sub StartTimer(boardId As Integer, cardId As Integer)
  Dim transaction As Boolean
  Dim failure As String
  Dim r As Result
  Dim id As Integer
  Dim actor As String = WebIdentity.Username
  Dim stamp As Date
  Dim others As New Collection
  Dim scope As New Collection
  RequireCard(boardId, cardId)
  BoardAccess.Require(boardId, "write")
  BeginChange(boardId, cardId, "write", actor)
  transaction = True
  scope.Add(actor, "actor")
  scope.Add("write", "capability")
  CaptureDetailScope(boardId, cardId, scope)
  If RunningTimers(boardId, cardId, actor).Count Then Error.Raise("Timer already running")
  stamp = Now
  r = $db.Create("kb_entries")
  r["board_id"] = boardId
  r["card_id"] = cardId
  r["kind"] = "time"
  r["title"] = "Running timer"
  r["author"] = actor
  r["created_at"] = stamp
  r["amount"] = 0.0
  r["done"] = False
  DatabaseText.Save($db, r, "kb_entries", ["board_id", "card_id", "kind", "title", "author", "created_at", "amount", "done"], True)
  id = $db.LastInsertId
  RequireDetailScope(boardId, cardId, scope)
  If Not $db.Find("kb_entries", "board_id=&1 AND card_id=&2 AND id=&3 AND kind=&4 AND author=&5 AND title=&6 AND amount=0 AND done=&7 AND created_at=&8 AND parent_id IS NULL AND body IS NULL AND value_type IS NULL", boardId, cardId, id, "time", actor, "Running timer", False, stamp).Available Then Error.Raise("Timer changed during start")
  r = $db.Exec(ExportText.SelectRows($db, "kb_entries") & " WHERE board_id=&1 AND card_id=&2 AND id=&3", boardId, cardId, id)
  scope.Add(id, "timerId")
  scope.Add(EntryState(r), "timerState")
  scope.Add([id], "running")
  scope.Add(others, "others")
  RequireTimer(boardId, cardId, scope)
  KanbanStore.Activity(boardId, "Started card timer", "card", cardId)
  RequireTimer(boardId, cardId, scope)
  DatabaseTransactions.Commit($db)
  transaction = False
Catch
  failure = Error.Text
  If transaction Then Try DatabaseTransactions.Rollback($db)
  Error.Raise(failure)
End

Public Sub StopTimer(boardId As Integer, cardId As Integer)
  Dim transaction As Boolean
  Dim failure As String
  Dim r As Result
  Dim actor As String = WebIdentity.Username
  Dim scope As New Collection
  Dim ids As Integer[]
  Dim remaining As New Integer[]
  Dim others As New Collection
  Dim locked As New Collection
  Dim expected As Collection
  Dim id As Integer
  Dim timerId As Integer
  Dim minutes As Float
  RequireCard(boardId, cardId)
  BoardAccess.Require(boardId, "write")
  BeginChange(boardId, cardId, "write", actor)
  transaction = True
  scope.Add(actor, "actor")
  scope.Add("write", "capability")
  CaptureDetailScope(boardId, cardId, scope)
  ids = RunningTimers(boardId, cardId, actor)
  If Not ids.Count Then Error.Raise("No running timer")
  For Each id In ids
    r = $db.Exec(ExportText.SelectRows($db, "kb_entries") & " WHERE board_id=&1 AND card_id=&2 AND id=&3", boardId, cardId, id)
    locked.Add(DeletionStamp(r), CStr(id))
  Next
  For Each id In ids
    $db.Exec("UPDATE kb_entries SET title=title WHERE board_id=&1 AND card_id=&2 AND id=&3", boardId, cardId, id)
  Next
  RequireDetailScope(boardId, cardId, scope)
  If JsonText.Encode(RunningTimers(boardId, cardId, actor)) <> JsonText.Encode(ids) Then Error.Raise("Running timer set changed")
  timerId = ids[0]
  For Each id In ids
    r = $db.Exec(ExportText.SelectRows($db, "kb_entries") & " WHERE board_id=&1 AND card_id=&2 AND id=&3", boardId, cardId, id)
    If DeletionStamp(r) <> locked[CStr(id)] Then Error.Raise("Timer changed during lock")
    If id = timerId Then
      If IsNull(r!created_at) Then Error.Raise("Timer start time unavailable")
      minutes = Max(0, DateDiff(r!created_at, Now, gb.Second)) / 60
      expected = EntryState(r)
      expected["amount"] = minutes
      expected["done"] = True
      expected["title"] = "Tracked time"
    Else
      remaining.Add(id)
      others.Add(DeletionStamp(r), CStr(id))
    Endif
  Next
  r = $db.Edit("kb_entries", "board_id=&1 AND card_id=&2 AND id=&3", boardId, cardId, timerId)
  r["amount"] = minutes
  r["done"] = True
  r["title"] = "Tracked time"
  DatabaseText.Save($db, r, "kb_entries", ["amount", "done", "title"], False)
  scope.Add(timerId, "timerId")
  scope.Add(expected, "timerState")
  scope.Add(remaining, "running")
  scope.Add(others, "others")
  RequireTimer(boardId, cardId, scope)
  KanbanStore.Activity(boardId, "Stopped card timer", "card", cardId)
  RequireTimer(boardId, cardId, scope)
  DatabaseTransactions.Commit($db)
  transaction = False
Catch
  failure = Error.Text
  If transaction Then Try DatabaseTransactions.Rollback($db)
  Error.Raise(failure)
End

Public Function Files(boardId As Integer, cardId As Integer, Optional completeText As Boolean) As Result
  RequireCard(boardId, cardId)
  If completeText Then Return $db.Exec(ExportText.SelectRows($db, "kb_files") & " WHERE " & AttachmentLifecycle.LiveSql("kb_files") & " AND board_id = &1 AND card_id = &2 ORDER BY id", boardId, cardId)
  Return $db.Find("kb_files", AttachmentLifecycle.LiveSql("kb_files") & " AND board_id = &1 AND card_id = &2 ORDER BY id", boardId, cardId)
End

Public Function FileSummaries(boardId As Integer, cardId As Integer, Optional completeText As Boolean) As Result
  RequireCard(boardId, cardId)
  If completeText Then Return $db.Exec(ExportText.Preserve($db, "SELECT id,board_id,card_id,filename,author,created_at FROM kb_files WHERE " & AttachmentLifecycle.LiveSql("kb_files") & " AND board_id=&1 AND card_id=&2 ORDER BY id"), boardId, cardId)
  Return $db.Exec("SELECT id,board_id,card_id,filename,author,created_at FROM kb_files WHERE " & AttachmentLifecycle.LiveSql("kb_files") & " AND board_id=&1 AND card_id=&2 ORDER BY id", boardId, cardId)
End

Public Function AddFile(boardId As Integer, cardId As Integer, filename As String, data As String, Optional mime As String = "application/octet-stream", Optional maxBytes As Integer = 10485760) As Integer
  Return CreateFile(boardId, cardId, filename, data, mime, maxBytes, False)
End

Private Sub RequireFileCreation(boardId As Integer, cardId As Integer, fileId As Integer, scope As Collection, metadata As Boolean)
  Dim r As Result
  Dim contentNull As Boolean
  RequireDetailScope(boardId, cardId, scope)
  If scope["upload"] Then
    If WorkspaceStore.Setting(boardId, "board", boardId, "allowsAttachments", "1") <> "1" Then Error.Raise("Attachments are not allowed on this board")
    TransferPolicy.RequireTransfer("attachmentsUpload", scope["size"])
  Endif
  r = $db.Exec(ExportText.SelectRows($db, "kb_files") & " WHERE board_id=&1 AND card_id=&2 AND id=&3", boardId, cardId, fileId)
  If Not r.Available Then Error.Raise("Attachment changed during creation")
  If TextIsNull(r, "filename") Or TextIsNull(r, "author") Then Error.Raise("Attachment value became null")
  If ExportText.ReadValue(r, "filename") <> scope["filename"] Or ExportText.ReadValue(r, "author") <> scope["actor"] Then Error.Raise("Attachment changed during creation")
  If r!content.Data <> scope["bytes"] Then Error.Raise("Attachment bytes changed during creation")
  If Not $db.Exec("SELECT id FROM kb_files WHERE board_id=&1 AND card_id=&2 AND id=&3 AND created_at=&4", boardId, cardId, fileId, scope["created"]).Available Then Error.Raise("Attachment creation time changed")
  contentNull = $db.Exec("SELECT id FROM kb_files WHERE id=&1 AND content IS NULL", fileId).Available
  If scope.Exist("contentNull") Then
    If contentNull <> scope["contentNull"] Then Error.Raise("Attachment bytes became null")
  Else
    scope.Add(contentNull, "contentNull")
  Endif
  If $db.Find("kb_attachment_deletions", "file_id=&1", fileId).Available Or $db.Find("kb_attachment_history", "file_id=&1", fileId).Available Then Error.Raise("Attachment lifecycle changed during creation")
  If $db.Find("kb_retired_authors", "kind='file' AND item_id=&1", fileId).Available Then Error.Raise("Attachment author provenance changed")
  r = $db.Exec(ExportText.SelectRows($db, "kb_attachment_data") & " WHERE file_id=&1", fileId)
  If Not metadata Then
    If r.Available Then Error.Raise("Attachment metadata appeared during creation")
    Return
  Endif
  If Not r.Available Then Error.Raise("Attachment metadata missing")
  If r!board_id <> boardId Or r!card_id <> cardId Or TextIsNull(r, "mime") Or ExportText.ReadValue(r, "mime") <> scope["mime"] Then Error.Raise("Attachment metadata changed")
  If IsNull(r!uploaded_ms) Or r!uploaded_ms <> scope["uploaded"] Then Error.Raise("Attachment upload time changed")
  If scope.Exist("metadataState") Then
    If DeletionStamp(r) <> scope["metadataState"] Then Error.Raise("Attachment metadata changed")
  Else
    scope.Add(DeletionStamp(r), "metadataState")
  Endif
End

Private Function CreateFile(boardId As Integer, cardId As Integer, filename As String, data As String, mime As String, maxBytes As Integer, upload As Boolean) As Integer
  Dim transaction As Boolean
  Dim failure As String
  Dim r As Result
  Dim id As Integer
  Dim actor As String = WebIdentity.Username
  Dim stamp As Date
  Dim scope As New Collection
  RequireCard(boardId, cardId)
  BoardAccess.Require(boardId, "write")
  BeginChange(boardId, cardId, "write", actor)
  transaction = True
  scope.Add(actor, "actor")
  scope.Add("write", "capability")
  scope.Add(upload, "upload")
  scope.Add(Len(data), "size")
  CaptureDetailScope(boardId, cardId, scope)
  If upload Then
    If WorkspaceStore.Setting(boardId, "board", boardId, "allowsAttachments", "1") <> "1" Then Error.Raise("Attachments are not allowed on this board")
    TransferPolicy.RequireTransfer("attachmentsUpload", Len(data))
  Endif
  filename = Replace(filename, "\\", "/")
  If InStr(filename, Chr(0)) Then
    filename = Mid(filename, RInStr(filename, "/") + 1)
  Else
    filename = File.Name(filename)
  Endif
  If Not filename Or ExportText.Length(filename) > 255 Or maxBytes < 0 Or maxBytes > 67108864 Or Len(data) > maxBytes Then Error.Raise("Choose a file within the size limit with a valid name")
  If Not mime Then mime = "application/octet-stream"
  scope.Add(filename, "filename")
  scope.Add(data, "bytes")
  scope.Add(mime, "mime")
  stamp = Now
  scope.Add(stamp, "created")
  r = $db.Create("kb_files")
  r["board_id"] = boardId
  r["card_id"] = cardId
  r["filename"] = filename
  r["content"] = data
  r["author"] = actor
  r["created_at"] = stamp
  DatabaseText.Save($db, r, "kb_files", ["board_id", "card_id", "filename", "content", "author", "created_at"], True)
  id = $db.LastInsertId
  RequireFileCreation(boardId, cardId, id, scope, False)
  scope.Add(ItemChanges.UtcNow(), "uploaded")
  AttachmentData.Record(boardId, cardId, id, mime, scope["uploaded"])
  RequireFileCreation(boardId, cardId, id, scope, True)
  KanbanStore.Activity(boardId, "Attached file: " & filename, "card", cardId)
  RequireFileCreation(boardId, cardId, id, scope, True)
  DatabaseTransactions.Commit($db)
  transaction = False
  Return id
Catch
  failure = Error.Text
  If transaction Then Try DatabaseTransactions.Rollback($db)
  Error.Raise(failure)
End

Public Function FileRecord(boardId As Integer, cardId As Integer, fileId As Integer, Optional completeText As Boolean) As Result
  Dim r As Result
  RequireCard(boardId, cardId)
  If completeText Then
    r = $db.Exec(ExportText.SelectRows($db, "kb_files") & " WHERE " & AttachmentLifecycle.LiveSql("kb_files") & " AND board_id=&1 AND card_id=&2 AND id=&3", boardId, cardId, fileId)
  Else
    r = $db.Find("kb_files", AttachmentLifecycle.LiveSql("kb_files") & " AND board_id = &1 AND card_id = &2 AND id = &3", boardId, cardId, fileId)
  Endif
  If Not r.Available Then Error.Raise("Attachment not accessible")
  Return r
End

Public Sub DeleteFile(boardId As Integer, cardId As Integer, fileId As Integer)
  AttachmentLifecycle.Delete(boardId, cardId, fileId)
End

Public Sub CopyRecords(sourceBoard As Integer, sourceCard As Integer, targetBoard As Integer, targetCard As Integer, Optional options As Collection)
  Dim fields As Collection
  Dim r As Result
  Dim kind As String
  Dim parents As New Collection
  Dim parentId As Integer
  Dim id As Integer
  Dim cover As Integer
  RequireCard(sourceBoard, sourceCard)
  RequireCard(targetBoard, targetCard)
  BoardAccess.Require(targetBoard, "write")
  If Not options Then options = CopyOptions.Defaults()
  fields = CopyOptions.Normalize(options)
  For Each kind In ["checklist", "checkitem", "comment", "custom", "time"]
    If (kind = "checklist" Or kind = "checkitem") And Not fields["checklists"] Then Continue
    If kind = "comment" And Not fields["comments"] Then Continue
    If kind = "custom" And Not fields["customFields"] Then Continue
    r = Entries(sourceBoard, sourceCard, kind, True)
    For Each r
      If kind = "time" And Not r!done Then Continue
      parentId = 0
      If kind = "checkitem" Then
        If Not parents.Exist(CStr(r!parent_id)) Then Continue
        parentId = parents[CStr(r!parent_id)]
      Endif
      id = SaveEntry(targetBoard, targetCard, 0, kind, ExportText.ReadValue(r, "title"), ExportText.ReadValue(r, "body"), parentId, r!done, r!amount, ExportText.ReadValue(r, "value_type"), True)
      CopyAuthor(targetBoard, targetCard, "entry", id, ExportText.ReadValue(r, "author"), AuthorName(sourceBoard, sourceCard, "entry", r!id))
      If kind = "checklist" Then parents[CStr(r!id)] = id
    Next
  Next
  If Not fields["attachments"] Then Return
  cover = AttachmentLifecycle.CoverId(sourceBoard, sourceCard)
  r = Files(sourceBoard, sourceCard, True)
  For Each r
    id = AddFile(targetBoard, targetCard, ExportText.ReadValue(r, "filename"), r!content.Data, AttachmentData.Mime(sourceBoard, sourceCard, r!id), 67108864)
    If r!id = cover Then AttachmentLifecycle.SetCover(targetBoard, targetCard, id)
    CopyAuthor(targetBoard, targetCard, "file", id, ExportText.ReadValue(r, "author"), AuthorName(sourceBoard, sourceCard, "file", r!id))
  Next
End

Public Function UploadFile(boardId As Integer, cardId As Integer, filename As String, bytes As String, Optional mime As String = "application/octet-stream") As Integer
  Dim actor As String = WebIdentity.Username
  Dim id As Integer
  Dim transaction As Boolean
  Dim failure As String
  OpenStore()
  RequireCard(boardId, cardId)
  BoardAccess.Require(boardId, "write")
  If WorkspaceStore.Setting(boardId, "board", boardId, "allowsAttachments", "1") <> "1" Then Error.Raise("Attachments are not allowed on this board")
  TransferPolicy.RequireTransfer("attachmentsUpload", Len(bytes))
  DatabaseTransactions.Begin($db)
  transaction = True
  $db.Exec("UPDATE users SET username=username WHERE username=&1", actor)
  TransferPolicy.Lock()
  RequireCard(boardId, cardId)
  BoardAccess.Require(boardId, "write")
  If WorkspaceStore.Setting(boardId, "board", boardId, "allowsAttachments", "1") <> "1" Then Error.Raise("Attachments are not allowed on this board")
  TransferPolicy.RequireTransfer("attachmentsUpload", Len(bytes))
  id = CreateFile(boardId, cardId, filename, bytes, mime, CInt(Floor(TransferPolicy.Limit("attachmentsUpload"))), True)
  If WebIdentity.Username <> actor Then Error.Raise("Sign in required")
  RequireCard(boardId, cardId)
  BoardAccess.Require(boardId, "write")
  If WorkspaceStore.Setting(boardId, "board", boardId, "allowsAttachments", "1") <> "1" Then Error.Raise("Attachments are not allowed on this board")
  TransferPolicy.RequireTransfer("attachmentsUpload", Len(bytes))
  DatabaseTransactions.Commit($db)
  transaction = False
  Return id
Catch
  failure = Error.Text
  If transaction Then Try DatabaseTransactions.Rollback($db)
  Error.Raise(failure)
End

Public Function DownloadFile(boardId As Integer, cardId As Integer, fileId As Integer, Optional completeText As Boolean) As Result
  Dim r As Result
  RequireCard(boardId, cardId)
  TransferPolicy.RequireTransfer("attachmentsDownload", 0)
  r = $db.Exec("SELECT COALESCE(LENGTH(content),0) AS size FROM kb_files WHERE " & AttachmentLifecycle.LiveSql("kb_files") & " AND board_id=&1 AND card_id=&2 AND id=&3", boardId, cardId, fileId)
  If Not r.Available Then Error.Raise("Attachment not accessible")
  TransferPolicy.RequireTransfer("attachmentsDownload", r!size)
  r = FileRecord(boardId, cardId, fileId, completeText)
  TransferPolicy.RequireTransfer("attachmentsDownload", Len(r!content.Data))
  RequireCard(boardId, cardId)
  Return r
End
