' Shared boards use the same capability matrix as WeKan; unknown roles deny.
Export
Private $db As Connection
Private $roles As Collection

Public Sub OpenStore()
  Dim t As Table
  If $db Then Return
  KanbanStore.OpenDatabase()
  $db = WebDatabase.OpenConnection()
  $roles = JSON.Decode(File.Load(".public/board-roles.json"))
  If Not $db.Tables.Exist("kb_members") Then
    t = $db.Tables.Add("kb_members")
    t.Fields.Add("board_id", db.Integer)
    t.Fields.Add("username", db.String, 255)
    t.Fields.Add("role", db.String, 64)
    t.PrimaryKey = ["board_id", "username"]
    t.Update()
  Endif
  If Not $db.Tables.Exist("kb_card_assignees") Then
    t = $db.Tables.Add("kb_card_assignees")
    t.Fields.Add("board_id", db.Integer)
    t.Fields.Add("card_id", db.Integer)
    t.Fields.Add("username", db.String, 255)
    t.PrimaryKey = ["card_id", "username"]
    t.Update()
  Endif
  If Not $db.Tables.Exist("kb_user_meta") Then
    t = $db.Tables.Add("kb_user_meta")
    t.Fields.Add("board_id", db.Integer)
    t.Fields.Add("kind", db.String, 16)
    t.Fields.Add("item_id", db.Integer)
    t.Fields.Add("username", db.String, 255)
    t.Fields.Add("setting", db.String, 64)
    t.Fields.Add("value", db.String)
    t.PrimaryKey = ["board_id", "kind", "item_id", "username", "setting"]
    t.Update()
  Endif
End

Public Function Role(boardId As Integer) As String
  Return RoleOf(boardId, WebIdentity.Username)
End

Private Function RoleOf(boardId As Integer, username As String) As String
  Dim r As Result
  If Not username Then Return ""
  If Not WebDatabase.UserExists(username) Then Return ""
  OpenStore()
  r = $db.Find("kb_boards", "id = &1", boardId)
  If Not r.Available Then Return ""
  If r!owner = username Then Return "board-admin"
  r = $db.Find("kb_members", "board_id = &1 AND username = &2", boardId, username)
  If Not r.Available Then Return ""
  If Not $roles.Exist(r!role) Then Return ""
  Return r!role
End

Public Function Can(boardId As Integer, capability As String) As Boolean
  Dim roleKey As String = Role(boardId)
  Dim caps As Collection
  If Not roleKey Then Return False
  caps = $roles[roleKey]
  Return caps[capability] = True
End

Public Sub RequireRead(boardId As Integer)
  If Not Role(boardId) Then Error.Raise("Board not accessible")
End

Public Sub Require(boardId As Integer, capability As String)
  RequireRead(boardId)
  If Not Can(boardId, capability) Then Error.Raise("Board permission denied")
End

Public Sub RequireActivity(boardId As Integer)
  RequireRead(boardId)
  If Not Can(boardId, "write") And Not Can(boardId, "comment") And Not Can(boardId, "moveCard") Then Error.Raise("Board permission denied")
End

Public Sub SetMember(boardId As Integer, username As String, role As String)
  Dim r As Result
  Dim transaction As Boolean
  Dim failure As String
  Require(boardId, "manageBoard")
  If Not $roles.Exist(role) Then Error.Raise("Unknown role")
  If Not WebDatabase.UserExists(username) Then Error.Raise("Unknown user")
  r = $db.Find("kb_boards", "id = &1", boardId)
  If r!owner = username Then
    If role <> "board-admin" Then Error.Raise("Transfer ownership before changing the owner's role")
    Return
  Endif
  WorkspaceStore.OpenStore()
  DatabaseTransactions.Begin($db)
  transaction = True
  $db.Exec("UPDATE users SET username = username WHERE username = &1", username)
  If Not WebDatabase.UserExists(username) Then Error.Raise("Unknown user")
  $db.Exec("UPDATE kb_boards SET title = title WHERE id = &1", boardId)
  Require(boardId, "manageBoard")
  CheckLastAdmin(boardId, username, role)
  KanbanStore.Activity(boardId, "Changed board membership: " & username)
  r = $db.Edit("kb_members", "board_id = &1 AND username = &2", boardId, username)
  If Not r.Available Then
    r = $db.Create("kb_members")
    r["board_id"] = boardId
    r["username"] = username
  Endif
  r["role"] = role
  r.Update()
  DatabaseTransactions.Commit($db)
  transaction = False
Catch
  failure = Error.Text
  If transaction Then Try DatabaseTransactions.Rollback($db)
  Error.Raise(failure)
End

Public Sub RemoveMember(boardId As Integer, username As String)
  Dim r As Result
  Dim transaction As Boolean
  Dim failure As String
  Require(boardId, "manageBoard")
  r = $db.Find("kb_boards", "id = &1", boardId)
  If r!owner = username Then Error.Raise("Transfer ownership before removing the owner")
  WorkspaceStore.OpenStore()
  DatabaseTransactions.Begin($db)
  transaction = True
  $db.Exec("UPDATE kb_boards SET title = title WHERE id = &1", boardId)
  Require(boardId, "manageBoard")
  CheckLastAdmin(boardId, username, "")
  KanbanStore.Activity(boardId, "Removed board member: " & username)
  $db.Delete("kb_members", "board_id = &1 AND username = &2", boardId, username)
  DatabaseTransactions.Commit($db)
  transaction = False
Catch
  failure = Error.Text
  If transaction Then Try DatabaseTransactions.Rollback($db)
  Error.Raise(failure)
End

Public Function Members(boardId As Integer) As Result
  Dim r As Result
  Dim owner As String
  RequireRead(boardId)
  r = $db.Find("kb_boards", "id = &1", boardId)
  owner = r!owner
  Return $db.Exec("SELECT owner AS username, &1 AS role FROM kb_boards WHERE id = &2 AND owner IS NOT NULL AND owner <> &3 AND owner IN (SELECT username FROM users) UNION ALL SELECT m.username, m.role FROM kb_members m INNER JOIN users u ON u.username = m.username WHERE m.board_id = &2 AND m.username <> &4", "board-admin", boardId, "", owner)
End

Private Sub CheckLastAdmin(boardId As Integer, username As String, nextRole As String)
  Dim r As Result
  Dim owner As String
  Dim count As Integer
  If nextRole = "board-admin" Then Return
  If RoleOf(boardId, username) <> "board-admin" Then Return
  r = $db.Find("kb_boards", "id = &1", boardId)
  owner = r!owner
  If owner Then
    If WebDatabase.UserExists(owner) Then Inc count
  Endif
  r = $db.Exec("SELECT COUNT(*) AS total FROM kb_members m INNER JOIN users u ON u.username = m.username WHERE m.board_id = &1 AND m.role = &2 AND m.username <> &3", boardId, "board-admin", owner)
  count += r!total
  If count <= 1 Then Error.Raise("The board must keep an administrator")
End

Public Function CardRows(boardId As Integer, Optional byArchive As Boolean, Optional archived As Boolean) As Result
  RequireRead(boardId)
  If Not Can(boardId, "seesAllCards") Then
    If byArchive Then Return $db.Find("kb_cards", "board_id = &1 AND archived = &2 AND (assignee = &3 OR id IN (SELECT card_id FROM kb_card_assignees WHERE board_id = &1 AND username = &3)) ORDER BY id", boardId, archived, WebIdentity.Username)
    Return $db.Find("kb_cards", "board_id = &1 AND (assignee = &2 OR id IN (SELECT card_id FROM kb_card_assignees WHERE board_id = &1 AND username = &2)) ORDER BY id", boardId, WebIdentity.Username)
  Endif
  If byArchive Then Return $db.Find("kb_cards", "board_id = &1 AND archived = &2 ORDER BY id", boardId, archived)
  Return $db.Find("kb_cards", "board_id = &1 ORDER BY id", boardId)
End

Public Sub RequireCard(boardId As Integer, cardId As Integer)
  Dim r As Result
  RequireRead(boardId)
  If Can(boardId, "seesAllCards") Then
    r = $db.Find("kb_cards", "board_id = &1 AND id = &2", boardId, cardId)
  Else
    r = $db.Find("kb_cards", "board_id = &1 AND id = &2 AND (assignee = &3 OR id IN (SELECT card_id FROM kb_card_assignees WHERE board_id = &1 AND username = &3))", boardId, cardId, WebIdentity.Username)
  Endif
  If Not r.Available Then Error.Raise("Card not accessible")
End

Public Sub RequireContainer(boardId As Integer, kind As String, itemId As Integer)
  RequireRead(boardId)
  If kind = "card" Then
    RequireCard(boardId, itemId)
  Else If Not Can(boardId, "seesAllCards") Then
    Error.Raise("Assigned-only members cannot copy, export or transfer containers")
  Endif
End

Public Function IsAssigned(boardId As Integer, cardId As Integer, username As String) As Boolean
  Dim r As Result
  RequireCard(boardId, cardId)
  r = $db.Find("kb_cards", "board_id = &1 AND id = &2 AND assignee = &3", boardId, cardId, username)
  If r.Available Then Return True
  r = $db.Find("kb_card_assignees", "board_id = &1 AND card_id = &2 AND username = &3", boardId, cardId, username)
  Return r.Available
End

Public Function Assignees(boardId As Integer, cardId As Integer) As String[]
  Dim names As New String[]
  Dim r As Result
  RequireCard(boardId, cardId)
  r = $db.Find("kb_cards", "board_id = &1 AND id = &2", boardId, cardId)
  If r!assignee Then names.Add(r!assignee)
  r = $db.Find("kb_card_assignees", "board_id = &1 AND card_id = &2 ORDER BY username", boardId, cardId)
  For Each r
    If names.Find(r!username) < 0 Then names.Add(r!username)
  Next
  Return names
End

Public Sub SetAssignees(boardId As Integer, cardId As Integer, names As String[])
  Dim previous As String[]
  Dim username As String
  RequireCard(boardId, cardId)
  If Not Can(boardId, "write") Then
    If Role(boardId) <> "worker" Then Error.Raise("Board permission denied")
    previous = Assignees(boardId, cardId)
    For Each username In previous
      If username <> WebIdentity.Username And names.Find(username) < 0 Then Error.Raise("Workers may change only their own assignment")
    Next
    For Each username In names
      If username <> WebIdentity.Username And previous.Find(username) < 0 Then Error.Raise("Workers may change only their own assignment")
    Next
  Endif
  For Each username In names
    If Not RoleOf(boardId, username) Then Error.Raise("Assignee must be an active board member")
  Next
  WriteAssignees(boardId, cardId, names)
End

Public Sub CopyAssignees(sourceBoard As Integer, sourceCard As Integer, targetBoard As Integer, targetCard As Integer)
  Dim names As String[] = Assignees(sourceBoard, sourceCard)
  Require(targetBoard, "write")
  RequireCard(targetBoard, targetCard)
  WriteAssignees(targetBoard, targetCard, names)
End

Public Sub RestoreAssignees(boardId As Integer, cardId As Integer, names As String[])
  Require(boardId, "manageBoard")
  RequireCard(boardId, cardId)
  WriteAssignees(boardId, cardId, names)
End

Private Sub WriteAssignees(boardId As Integer, cardId As Integer, names As String[])
  Dim r As Result
  Dim username As String
  Dim unique As New String[]
  Dim transaction As Boolean
  Dim failure As String
  For Each username In names
    If Not username Or String.Len(username) > 255 Then Error.Raise("Invalid assignee")
    If unique.Find(username) < 0 Then unique.Add(username)
  Next
  WorkspaceStore.OpenStore()
  DatabaseTransactions.Begin($db)
  transaction = True
  KanbanStore.Activity(boardId, "Changed card assignments", "card", cardId)
  $db.Delete("kb_card_assignees", "board_id = &1 AND card_id = &2", boardId, cardId)
  For Each username In unique
    r = $db.Create("kb_card_assignees")
    r["board_id"] = boardId
    r["card_id"] = cardId
    r["username"] = username
    r.Update()
  Next
  r = $db.Edit("kb_cards", "board_id = &1 AND id = &2", boardId, cardId)
  r["assignee"] = ""
  If unique.Count Then r["assignee"] = unique[0]
  r.Update()
  DatabaseTransactions.Commit($db)
  transaction = False
Catch
  failure = Error.Text
  If transaction Then Try DatabaseTransactions.Rollback($db)
  Error.Raise(failure)
End
