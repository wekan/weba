' Shared boards use the same capability matrix as WeKan; unknown roles deny.
Export
Private $db As Connection
Private $roles As Collection
Private $apiMemberBoard As Integer

Public Sub OpenStore()
  Dim t As Table
  If $db Then Return
  KanbanStore.OpenDatabase()
  $db = WebDatabase.OpenConnection()
  $roles = JSON.Decode(File.Load(".public/board-roles.json"))
  If Not $db.Tables.Exist("kb_members") Then
    t = $db.Tables.Add("kb_members")
    t.Fields.Add("board_id", db.Integer)
    t.Fields.Add("username", db.String, 255)
    t.Fields.Add("role", db.String, 64)
    t.PrimaryKey = ["board_id", "username"]
    t.Update()
  Endif
  If Not $db.Tables.Exist("kb_removed_members") Then
    t = $db.Tables.Add("kb_removed_members")
    t.Fields.Add("board_id", db.Integer)
    t.Fields.Add("username", db.String, 255)
    t.Fields.Add("role", db.String, 64)
    t.PrimaryKey = ["board_id", "username"]
    t.Update()
  Endif
  If Not $db.Tables.Exist("kb_member_flags") Then
    t = $db.Tables.Add("kb_member_flags")
    t.Fields.Add("board_id", db.Integer)
    t.Fields.Add("username", db.String, 255)
    t.Fields.Add("flag", db.String, 32)
    t.PrimaryKey = ["board_id", "username", "flag"]
    t.Update()
  Endif
  If Not $db.Tables.Exist("kb_card_assignees") Then
    t = $db.Tables.Add("kb_card_assignees")
    t.Fields.Add("board_id", db.Integer)
    t.Fields.Add("card_id", db.Integer)
    t.Fields.Add("username", db.String, 255)
    t.PrimaryKey = ["card_id", "username"]
    t.Update()
  Endif
  If Not $db.Tables.Exist("kb_card_members") Then
    t = $db.Tables.Add("kb_card_members")
    t.Fields.Add("board_id", db.Integer)
    t.Fields.Add("card_id", db.Integer)
    t.Fields.Add("username", db.String, 255)
    t.PrimaryKey = ["card_id", "username"]
    t.Update()
  Endif
  If Not $db.Tables.Exist("kb_card_people_order") Then
    t = $db.Tables.Add("kb_card_people_order")
    t.Fields.Add("board_id", db.Integer)
    t.Fields.Add("card_id", db.Integer)
    t.Fields.Add("field", db.String, 16)
    t.Fields.Add("username", db.String, 255)
    t.Fields.Add("sort_order", db.Integer)
    t.PrimaryKey = ["card_id", "field", "username"]
    t.Update()
  Endif
  If Not $db.Tables.Exist("kb_card_people_sequence") Then
    t = $db.Tables.Add("kb_card_people_sequence")
    t.Fields.Add("board_id", db.Integer)
    t.Fields.Add("card_id", db.Integer)
    t.Fields.Add("field", db.String, 16)
    t.Fields.Add("username", db.String, 255)
    t.Fields.Add("sort_order", db.Integer)
    t.PrimaryKey = ["card_id", "field", "sort_order"]
    t.Update()
  Endif
  If Not $db.Tables.Exist("kb_card_dates") Then
    t = $db.Tables.Add("kb_card_dates")
    t.Fields.Add("board_id", db.Integer)
    t.Fields.Add("card_id", db.Integer)
    t.Fields.Add("field", db.String, 16)
    t.Fields.Add("epoch_ms", db.Long)
    t.PrimaryKey = ["card_id", "field"]
    t.Update()
  Endif
  If Not $db.Tables.Exist("kb_user_meta") Then
    t = $db.Tables.Add("kb_user_meta")
    t.Fields.Add("board_id", db.Integer)
    t.Fields.Add("kind", db.String, 16)
    t.Fields.Add("item_id", db.Integer)
    t.Fields.Add("username", db.String, 255)
    t.Fields.Add("setting", db.String, 64)
    t.Fields.Add("value", db.String)
    t.PrimaryKey = ["board_id", "kind", "item_id", "username", "setting"]
    t.Update()
  Endif
End

Public Function Role(boardId As Integer) As String
  ' The scoped exception exists only inside an authenticated site-admin member
  ' mutation. It does not grant unrelated API reads or native board access.
  If $apiMemberBoard > 0 And boardId = $apiMemberBoard And Env["WEBA_API_REQUEST"] = "1" Then
    If WebDatabase.GetIsAdmin(WebIdentity.Username) Then Return "board-admin"
  Endif
  Return RoleOf(boardId, WebIdentity.Username)
End

Private Function RoleOf(boardId As Integer, username As String) As String
  Dim r As Result
  If Not username Then Return ""
  If Not WebDatabase.UserExists(username) Then Return ""
  OpenStore()
  r = $db.Find("kb_boards", "id = &1", boardId)
  If Not r.Available Then Return ""
  If IsRemoved(boardId, username) Then Return ""
  If r!owner = username Then Return "board-admin"
  r = $db.Find("kb_members", "board_id = &1 AND username = &2", boardId, username)
  If Not r.Available Then Return ""
  If Not $roles.Exist(r!role) Then Return ""
  Return r!role
End

Private Function IsRemoved(boardId As Integer, username As String) As Boolean
  Dim r As Result = $db.Find("kb_removed_members", "board_id = &1 AND username = &2", boardId, username)
  Return r.Available
End

Private Function RemovedRole(boardId As Integer, username As String) As String
  Dim r As Result = $db.Find("kb_removed_members", "board_id = &1 AND username = &2", boardId, username)
  If r.Available Then Return r!role
  Return ""
End

Private Sub RememberRemoval(boardId As Integer, username As String, flags As Collection)
  Dim r As Result = $db.Edit("kb_removed_members", "board_id = &1 AND username = &2", boardId, username)
  If Not r.Available Then
    r = $db.Create("kb_removed_members")
    r["board_id"] = boardId
    r["username"] = username
  Endif
  r["role"] = ApiMemberRoles.RoleFor(flags)
  r.Update()
End

Public Function Can(boardId As Integer, capability As String) As Boolean
  Dim roleKey As String = Role(boardId)
  Dim caps As Collection
  If Not roleKey Then Return False
  caps = $roles[roleKey]
  Return caps[capability] = True
End

Public Sub RequireRead(boardId As Integer)
  If Not Role(boardId) Then Error.Raise("Board not accessible")
End

Public Sub Require(boardId As Integer, capability As String)
  RequireRead(boardId)
  If Not Can(boardId, capability) Then Error.Raise("Board permission denied")
End

Public Sub RequireActivity(boardId As Integer)
  RequireRead(boardId)
  If Not Can(boardId, "write") And Not Can(boardId, "comment") And Not Can(boardId, "moveCard") Then Error.Raise("Board permission denied")
End

Public Sub SetMember(boardId As Integer, username As String, role As String)
  Dim r As Result
  Dim transaction As Boolean
  Dim failure As String
  Require(boardId, "manageBoard")
  If Not $roles.Exist(role) Then Error.Raise("Unknown role")
  If Not WebDatabase.UserExists(username) Then Error.Raise("Unknown user")
  r = $db.Find("kb_boards", "id = &1", boardId)
  If r!owner = username Then
    If role <> "board-admin" Then Error.Raise("Transfer ownership before changing the owner's role")
    $db.Delete("kb_member_flags", "board_id = &1 AND username = &2", boardId, username)
    $db.Delete("kb_removed_members", "board_id = &1 AND username = &2", boardId, username)
    Return
  Endif
  WorkspaceStore.OpenStore()
  DatabaseTransactions.Begin($db)
  transaction = True
  $db.Exec("UPDATE users SET username = username WHERE username = &1", username)
  If Not WebDatabase.UserExists(username) Then Error.Raise("Unknown user")
  $db.Exec("UPDATE kb_boards SET title = title WHERE id = &1", boardId)
  Require(boardId, "manageBoard")
  CheckLastAdmin(boardId, username, role)
  KanbanStore.Activity(boardId, "Changed board membership: " & username)
  r = $db.Edit("kb_members", "board_id = &1 AND username = &2", boardId, username)
  If Not r.Available Then
    r = $db.Create("kb_members")
    r["board_id"] = boardId
    r["username"] = username
  Endif
  r["role"] = role
  r.Update()
  $db.Delete("kb_removed_members", "board_id = &1 AND username = &2", boardId, username)
  $db.Delete("kb_member_flags", "board_id = &1 AND username = &2", boardId, username)
  DatabaseTransactions.Commit($db)
  transaction = False
Catch
  failure = Error.Text
  If transaction Then Try DatabaseTransactions.Rollback($db)
  Error.Raise(failure)
End

Public Sub RemoveMember(boardId As Integer, username As String)
  Dim r As Result
  Dim flags As Collection
  Dim roleKey As String
  Dim transaction As Boolean
  Dim failure As String
  Require(boardId, "manageBoard")
  r = $db.Find("kb_boards", "id = &1", boardId)
  If r!owner = username Then Error.Raise("Transfer ownership before removing the owner")
  WorkspaceStore.OpenStore()
  DatabaseTransactions.Begin($db)
  transaction = True
  $db.Exec("UPDATE kb_boards SET title = title WHERE id = &1", boardId)
  Require(boardId, "manageBoard")
  roleKey = RoleOf(boardId, username)
  If roleKey Then
    CheckLastAdmin(boardId, username, "")
    flags = ApiMemberRoles.MemberData(boardId, username, roleKey)
    flags["isAdmin"] = False
    ' Log while the actor still has access, including self-removal.
    KanbanStore.Activity(boardId, "Removed board member: " & username)
    RememberRemoval(boardId, username, flags)
    $db.Delete("kb_members", "board_id = &1 AND username = &2", boardId, username)
    ApiMemberRoles.Save(boardId, username, flags)
  Else If Not WebDatabase.UserExists(username) Then
    ' Orphaned account entries are purged rather than retained as inactive.
    $db.Delete("kb_members", "board_id = &1 AND username = &2", boardId, username)
    $db.Delete("kb_removed_members", "board_id = &1 AND username = &2", boardId, username)
    $db.Delete("kb_member_flags", "board_id = &1 AND username = &2", boardId, username)
  Endif
  DatabaseTransactions.Commit($db)
  transaction = False
Catch
  failure = Error.Text
  If transaction Then Try DatabaseTransactions.Rollback($db)
  Error.Raise(failure)
End

Public Function Members(boardId As Integer) As Result
  Dim r As Result
  Dim owner As String
  RequireRead(boardId)
  r = $db.Find("kb_boards", "id = &1", boardId)
  owner = r!owner
  Return $db.Exec("SELECT b.owner AS username, &1 AS role FROM kb_boards b INNER JOIN users u ON u.username = b.owner WHERE b.id = &2 AND b.owner <> &3 AND NOT EXISTS (SELECT 1 FROM kb_removed_members d WHERE d.board_id = b.id AND d.username = b.owner) UNION ALL SELECT m.username, m.role FROM kb_members m INNER JOIN users u ON u.username = m.username WHERE m.board_id = &2 AND m.username <> &4 AND NOT EXISTS (SELECT 1 FROM kb_removed_members d WHERE d.board_id = m.board_id AND d.username = m.username)", "board-admin", boardId, "", owner)
End

Private Sub CheckLastAdmin(boardId As Integer, username As String, nextRole As String)
  If nextRole = "board-admin" Then Return
  If RoleOf(boardId, username) <> "board-admin" Then Return
  If AdminCount(boardId) <= 1 Then Error.Raise("The board must keep an administrator")
End

Private Function AdminCount(boardId As Integer) As Integer
  Dim r As Result
  Dim owner As String
  Dim count As Integer
  r = $db.Find("kb_boards", "id = &1", boardId)
  owner = r!owner
  If owner Then
    If Not IsRemoved(boardId, owner) Then
      If WebDatabase.UserExists(owner) Then Inc count
    Endif
  Endif
  r = $db.Exec("SELECT COUNT(*) AS total FROM kb_members m INNER JOIN users u ON u.username = m.username WHERE m.board_id = &1 AND m.role = &2 AND m.username <> &3 AND NOT EXISTS (SELECT 1 FROM kb_removed_members d WHERE d.board_id = m.board_id AND d.username = m.username)", boardId, "board-admin", owner)
  Return count + r!total
End

Public Function ApiMembers(boardId As Integer) As Variant[]
  Dim r As Result = Members(boardId)
  Dim rows As New Variant[]
  For Each r
    If $roles.Exist(r!role) Then rows.Add(ApiMemberRoles.MemberData(boardId, r!username, r!role))
  Next
  r = $db.Exec("SELECT d.username, d.role FROM kb_removed_members d INNER JOIN users u ON u.username = d.username WHERE d.board_id = &1 ORDER BY d.username", boardId)
  For Each r
    If $roles.Exist(r!role) Then rows.Add(ApiMemberRoles.MemberData(boardId, r!username, r!role, False))
  Next
  Return rows
End

Private Sub MaterializeOwner(boardId As Integer, owner As String)
  Dim r As Result
  Dim meta As Result
  If Not owner Then Return
  ' Retain the legacy owner's personal flags when its implicit role is replaced
  ' by an explicit member record, without assigning ownership to another user.
  meta = $db.Find("kb_meta", "board_id = &1 AND (setting = &2 OR setting = &3)", boardId, "star", "watch")
  For Each meta
    r = $db.Find("kb_user_meta", "board_id = &1 AND kind = &2 AND item_id = &3 AND username = &4 AND setting = &5", boardId, meta!kind, meta!item_id, owner, meta!setting)
    If r.Available Then Continue
    r = $db.Create("kb_user_meta")
    r["board_id"] = boardId
    r["kind"] = meta!kind
    r["item_id"] = meta!item_id
    r["username"] = owner
    r["setting"] = meta!setting
    r["value"] = meta!value
    r.Update()
  Next
  r = $db.Edit("kb_members", "board_id = &1 AND username = &2", boardId, owner)
  If Not r.Available Then
    r = $db.Create("kb_members")
    r["board_id"] = boardId
    r["username"] = owner
  Endif
  r["role"] = "board-admin"
  r.Update()
  $db.Exec("UPDATE kb_boards SET owner = NULL WHERE id = &1", boardId)
End

Private Function ApiAnswer(status As Integer, data As Variant, Optional empty As Boolean) As Collection
  Dim result As New Collection
  result["status"] = status
  result["data"] = data
  result["empty"] = empty
  Return result
End

Private Function ApiFailure(status As Integer, message As String) As Collection
  Dim data As New Collection
  data["error"] = message
  Return ApiAnswer(status, data)
End

Public Function MutateApiMember(boardId As Integer, username As String, action As String, payload As Collection) As Collection
  Dim actor As String = WebIdentity.Username
  Dim r As Result
  Dim flags As Collection
  Dim roleKey As String
  Dim currentRole As String
  Dim inactiveRole As String
  Dim previous As Collection
  Dim owner As String
  Dim title As String
  Dim siteAdmin As Boolean
  Dim transaction As Boolean
  Dim status As Integer = 500
  Dim failure As String
  Dim rows As New Variant[]
  Dim row As New Collection
  Dim empty As Boolean
  $apiMemberBoard = 0
  If Env["WEBA_API_REQUEST"] <> "1" Then Return ApiFailure(403, "API context required")
  If Not actor Then Return ApiFailure(401, "Invalid credentials")
  If Not WebDatabase.UserExists(actor) Then Return ApiFailure(401, "Invalid credentials")
  OpenStore()
  WorkspaceStore.OpenStore()
  siteAdmin = WebDatabase.GetIsAdmin(actor)
  If Not siteAdmin And Not Can(boardId, "manageBoard") Then Return ApiFailure(403, "Only a board admin can change members")
  If Not username Or Len(username) > 255 Then Return ApiFailure(400, "Invalid member ID")
  If action <> "add" And action <> "remove" And action <> "set" Then Return ApiFailure(404, "API route not found")
  If action <> "set" Then
    If TypeOf(payload["action"]) <> gb.String Then Return ApiFailure(400, "Expected member action")
    If payload["action"] <> action Then Return ApiFailure(400, "Member action does not match route")
  Endif
  If action <> "remove" Then
    Try flags = ApiMemberRoles.Parse(payload)
    If Error Then Return ApiFailure(400, "Invalid member role or flags")
  Endif
  r = $db.Find("kb_boards", "id = &1", boardId)
  If Not r.Available Then
    If action = "set" Then Return ApiFailure(404, "Board not found")
    Return ApiAnswer(200, rows)
  Endif
  DatabaseTransactions.Begin($db)
  transaction = True
  $db.Exec("UPDATE users SET username = username WHERE username = &1", username)
  $db.Exec("UPDATE kb_boards SET title = title WHERE id = &1", boardId)
  siteAdmin = WebDatabase.GetIsAdmin(actor)
  If Not siteAdmin And Not Can(boardId, "manageBoard") Then
    status = 403
    Error.Raise("Only a board admin can change members")
  Endif
  If siteAdmin Then $apiMemberBoard = boardId
  r = $db.Find("kb_boards", "id = &1", boardId)
  If Not r.Available Then
    status = 404
    Error.Raise("Board not found")
  Endif
  title = r!title
  owner = r!owner
  currentRole = RoleOf(boardId, username)
  inactiveRole = RemovedRole(boardId, username)
  If Not WebDatabase.UserExists(username) Then
    If action = "set" Then
      status = 404
      Error.Raise("Member not found")
    Endif
    empty = True
    Goto FINISH
  Endif
  If action = "add" Then
    If currentRole Then Goto FINISH
    roleKey = ApiMemberRoles.RoleFor(flags)
    SetMember(boardId, username, roleKey)
    ApiMemberRoles.Save(boardId, username, flags)
  Else If action = "set" Then
    If Not currentRole And Not inactiveRole Then
      status = 404
      Error.Raise("Member not found")
    Endif
    ' Self role changes preserve the stored admin bit, including inactive rows;
    ' changing that bit never activates a removed membership.
    If actor = username Then
      If currentRole Then
        previous = ApiMemberRoles.MemberData(boardId, username, currentRole)
      Else
        previous = ApiMemberRoles.MemberData(boardId, username, inactiveRole, False)
      Endif
      flags["isAdmin"] = previous["isAdmin"]
    Endif
    roleKey = ApiMemberRoles.RoleFor(flags)
    If Not currentRole Then
      KanbanStore.Activity(boardId, "Changed inactive board membership: " & username)
      RememberRemoval(boardId, username, flags)
      ApiMemberRoles.Save(boardId, username, flags)
      Goto FINISH
    Endif
    If currentRole = "board-admin" And roleKey <> "board-admin" Then
      If AdminCount(boardId) <= 1 Then
        status = 400
        Error.Raise("The board must keep an administrator")
      Endif
    Endif
    If username = owner And roleKey <> "board-admin" Then MaterializeOwner(boardId, owner)
    SetMember(boardId, username, roleKey)
    ApiMemberRoles.Save(boardId, username, flags)
  Else
    If Not currentRole Then Goto FINISH
    ' Match WeKan's idempotent removal: the final admin remains active.
    If currentRole = "board-admin" Then
      If AdminCount(boardId) <= 1 Then Goto FINISH
    Endif
    If username = owner Then MaterializeOwner(boardId, owner)
    RemoveMember(boardId, username)
  Endif
FINISH:
  DatabaseTransactions.Commit($db)
  transaction = False
  $apiMemberBoard = 0
  If empty Then Return ApiAnswer(200, Null, True)
  If action = "set" Then Return ApiAnswer(200, 1)
  row["_id"] = CStr(boardId)
  row["title"] = title
  rows.Add(row)
  Return ApiAnswer(200, rows)
Catch
  failure = Error.Text
  $apiMemberBoard = 0
  If transaction Then Try DatabaseTransactions.Rollback($db)
  If status = 500 Then failure = "Membership update failed"
  Return ApiFailure(status, failure)
End

Public Function CardRows(boardId As Integer, Optional byArchive As Boolean, Optional archived As Boolean) As Result
  RequireRead(boardId)
  If Not Can(boardId, "seesAllCards") Then
    If byArchive Then Return $db.Find("kb_cards", "board_id = &1 AND archived = &2 AND (assignee = &3 OR id IN (SELECT card_id FROM kb_card_assignees WHERE board_id = &1 AND username = &3)) ORDER BY id", boardId, archived, WebIdentity.Username)
    Return $db.Find("kb_cards", "board_id = &1 AND (assignee = &2 OR id IN (SELECT card_id FROM kb_card_assignees WHERE board_id = &1 AND username = &2)) ORDER BY id", boardId, WebIdentity.Username)
  Endif
  If byArchive Then Return $db.Find("kb_cards", "board_id = &1 AND archived = &2 ORDER BY id", boardId, archived)
  Return $db.Find("kb_cards", "board_id = &1 ORDER BY id", boardId)
End

Public Sub RequireCard(boardId As Integer, cardId As Integer)
  Dim r As Result
  RequireRead(boardId)
  If Can(boardId, "seesAllCards") Then
    r = $db.Find("kb_cards", "board_id = &1 AND id = &2", boardId, cardId)
  Else
    r = $db.Find("kb_cards", "board_id = &1 AND id = &2 AND (assignee = &3 OR id IN (SELECT card_id FROM kb_card_assignees WHERE board_id = &1 AND username = &3))", boardId, cardId, WebIdentity.Username)
  Endif
  If Not r.Available Then Error.Raise("Card not accessible")
End

Public Sub RequireContainer(boardId As Integer, kind As String, itemId As Integer)
  RequireRead(boardId)
  If kind = "card" Then
    RequireCard(boardId, itemId)
  Else If Not Can(boardId, "seesAllCards") Then
    Error.Raise("Assigned-only members cannot copy, export or transfer containers")
  Endif
End

Public Function IsAssigned(boardId As Integer, cardId As Integer, username As String) As Boolean
  Dim r As Result
  RequireCard(boardId, cardId)
  r = $db.Find("kb_cards", "board_id = &1 AND id = &2 AND assignee = &3", boardId, cardId, username)
  If r.Available Then Return True
  r = $db.Find("kb_card_assignees", "board_id = &1 AND card_id = &2 AND username = &3", boardId, cardId, username)
  Return r.Available
End

Public Function Assignees(boardId As Integer, cardId As Integer) As String[]
  Dim names As New String[]
  Dim r As Result
  RequireCard(boardId, cardId)
  r = $db.Find("kb_card_people_sequence", "board_id = &1 AND card_id = &2 AND field = &3 ORDER BY sort_order", boardId, cardId, "assignees")
  If r.Available Then
    For Each r
      names.Add(r!username)
    Next
    Return names
  Endif
  r = $db.Find("kb_cards", "board_id = &1 AND id = &2", boardId, cardId)
  If r!assignee Then names.Add(r!assignee)
  r = $db.Exec("SELECT m.username FROM kb_card_assignees m LEFT JOIN kb_card_people_order o ON o.board_id = m.board_id AND o.card_id = m.card_id AND o.username = m.username AND o.field = &3 WHERE m.board_id = &1 AND m.card_id = &2 ORDER BY o.sort_order, m.username", boardId, cardId, "assignees")
  For Each r
    If names.Find(r!username) < 0 Then names.Add(r!username)
  Next
  Return names
End

Public Function CardMembers(boardId As Integer, cardId As Integer) As String[]
  Dim names As New String[]
  Dim r As Result
  RequireCard(boardId, cardId)
  r = $db.Find("kb_card_people_sequence", "board_id = &1 AND card_id = &2 AND field = &3 ORDER BY sort_order", boardId, cardId, "members")
  If r.Available Then
    For Each r
      names.Add(r!username)
    Next
    Return names
  Endif
  r = $db.Exec("SELECT m.username FROM kb_card_members m LEFT JOIN kb_card_people_order o ON o.board_id = m.board_id AND o.card_id = m.card_id AND o.username = m.username AND o.field = &3 WHERE m.board_id = &1 AND m.card_id = &2 ORDER BY o.sort_order, m.username", boardId, cardId, "members")
  For Each r
    names.Add(r!username)
  Next
  Return names
End

Public Sub CopyCardMembers(sourceBoard As Integer, sourceCard As Integer, targetBoard As Integer, targetCard As Integer)
  Dim names As String[] = CardMembers(sourceBoard, sourceCard)
  Require(targetBoard, "write")
  RequireCard(targetBoard, targetCard)
  WriteCardMembers(targetBoard, targetCard, names)
End

Public Sub RestoreCardMembers(boardId As Integer, cardId As Integer, names As String[])
  Require(boardId, "manageBoard")
  RequireCard(boardId, cardId)
  WriteCardMembers(boardId, cardId, names)
End

Public Sub ChangeCardMember(boardId As Integer, cardId As Integer, username As String, add As Boolean)
  Dim names As String[]
  Dim transaction As Boolean
  Dim failure As String
  Require(boardId, "write")
  RequireCard(boardId, cardId)
  If Not username Or String.Len(username) > 255 Then Error.Raise("Choose a member")
  WorkspaceStore.OpenStore()
  DatabaseTransactions.Begin($db)
  transaction = True
  $db.Exec("UPDATE users SET username = username WHERE username = &1", username)
  $db.Exec("UPDATE kb_boards SET title = title WHERE id = &1", boardId)
  $db.Exec("UPDATE kb_cards SET title = title WHERE id = &1 AND board_id = &2", cardId, boardId)
  Require(boardId, "write")
  RequireCard(boardId, cardId)
  If add Then
    If Not RoleOf(boardId, username) Then Error.Raise("Member must be an active board member")
  Endif
  names = CardMembers(boardId, cardId)
  If add Then
    If names.Find(username) < 0 Then names.Add(username)
  Else
    While names.Find(username) >= 0
      names.Remove(names.Find(username))
    Wend
  Endif
  WriteCardMembers(boardId, cardId, names)
  DatabaseTransactions.Commit($db)
  transaction = False
Catch
  failure = Error.Text
  If transaction Then Try DatabaseTransactions.Rollback($db)
  Error.Raise(failure)
End

Private Sub WriteCardMembers(boardId As Integer, cardId As Integer, names As String[])
  Dim r As Result
  Dim username As String
  Dim unique As New String[]
  Dim transaction As Boolean
  Dim failure As String
  For Each username In names
    If Not username Or String.Len(username) > 255 Then Error.Raise("Invalid card member")
    If unique.Find(username) < 0 Then unique.Add(username)
  Next
  WorkspaceStore.OpenStore()
  DatabaseTransactions.Begin($db)
  transaction = True
  KanbanStore.Activity(boardId, "Changed card members", "card", cardId)
  WritePeopleOrder(boardId, cardId, "members", unique)
  WritePeopleSequence(boardId, cardId, "members", names)
  $db.Delete("kb_card_members", "board_id = &1 AND card_id = &2", boardId, cardId)
  For Each username In unique
    r = $db.Create("kb_card_members")
    r["board_id"] = boardId
    r["card_id"] = cardId
    r["username"] = username
    r.Update()
  Next
  DatabaseTransactions.Commit($db)
  transaction = False
Catch
  failure = Error.Text
  If transaction Then Try DatabaseTransactions.Rollback($db)
  Error.Raise(failure)
End

Public Function MutateApiCardPerson(boardId As Integer, listId As Integer, cardId As Integer, field As String, username As String, add As Boolean) As Collection
  Return ChangeApiCardPeople(boardId, listId, cardId, field, username, If(add, "add", "remove"), Null)
End

Public Function UpdateApiCardPeople(boardId As Integer, listId As Integer, cardId As Integer, payload As Collection) As Collection
  Return ChangeApiCardPeople(boardId, listId, cardId, "", "", "replace", payload)
End

Private Function ChangeApiCardPeople(boardId As Integer, listId As Integer, cardId As Integer, field As String, username As String, operation As String, payload As Collection) As Collection
  Dim r As Result
  Dim names As String[]
  Dim memberNames As String[]
  Dim assigneeNames As String[]
  Dim key As String
  Dim target As String
  Dim targets As New Collection
  Dim add As Boolean = operation = "add"
  Dim replace As Boolean = operation = "replace"
  Dim archived As Boolean
  Dim dateChanges As New Collection
  Dim parsedDate As Collection
  Dim data As New Collection
  Dim actor As String = WebIdentity.Username
  Dim siteAdmin As Boolean
  Dim transaction As Boolean
  Dim status As Integer = 500
  Dim failure As String
  $apiMemberBoard = 0
  If Env["WEBA_API_REQUEST"] <> "1" Then Return ApiFailure(403, "API context required")
  If Not actor Then Return ApiFailure(401, "Invalid credentials")
  If Not WebDatabase.UserExists(actor) Then Return ApiFailure(401, "Invalid credentials")
  If Not replace Then
    If field <> "members" And field <> "assignees" Then Return ApiFailure(404, "API route not found")
  Endif
  OpenStore()
  WorkspaceStore.OpenStore()
  r = $db.Find("kb_boards", "id = &1", boardId)
  If Not r.Available Then Return ApiFailure(404, "Board not found")
  siteAdmin = WebDatabase.GetIsAdmin(actor)
  If Not siteAdmin Then
    If Not Can(boardId, "write") Or Not Can(boardId, "seesAllCards") Then Return ApiFailure(403, "Forbidden")
  Endif
  If replace Then
    If Not payload Then Return ApiFailure(400, "Expected a JSON object")
    For Each key In payload.Keys
      If key = "members" Or key = "assignees" Then Continue
      If CardDates.Fields().Find(key) < 0 Then Return ApiFailure(400, "Card field not implemented")
      parsedDate = CardDates.Parse(payload[key])
      If parsedDate["valid"] Then dateChanges[key] = parsedDate
    Next
    If payload.Exist("members") Then memberNames = RestPeople(payload["members"])
    If payload.Exist("assignees") Then assigneeNames = RestPeople(payload["assignees"])
    If memberNames Then
      For Each target In memberNames
        If String.Len(target) <= 255 Then targets[target] = True
      Next
    Endif
    If assigneeNames Then
      For Each target In assigneeNames
        If String.Len(target) <= 255 Then targets[target] = True
      Next
    Endif
  Else
    If Not username Or Len(username) > 255 Then Return ApiFailure(400, "Invalid member ID")
    targets[username] = True
  Endif
  If siteAdmin Then $apiMemberBoard = boardId
  KanbanStore.PrimeCardLinks(boardId)
  DatabaseTransactions.Begin($db)
  transaction = True
  names = targets.Keys
  names.Sort()
  For Each target In names
    $db.Exec("UPDATE users SET username = username WHERE username = &1", target)
  Next
  $db.Exec("UPDATE kb_boards SET title = title WHERE id = &1", boardId)
  $db.Exec("UPDATE kb_cards SET title = title WHERE id = &1 AND board_id = &2", cardId, boardId)
  siteAdmin = WebDatabase.GetIsAdmin(actor)
  If Not siteAdmin Then
    $apiMemberBoard = 0
    If Not Can(boardId, "write") Or Not Can(boardId, "seesAllCards") Then
      status = 403
      Error.Raise("Forbidden")
    Endif
  Endif
  r = $db.Find("kb_cards", "board_id = &1 AND id = &2", boardId, cardId)
  If Not r.Available Then
    status = 404
    Error.Raise("Card not found")
  Endif
  archived = r!archived
  If archived And Not replace Then
    status = 404
    Error.Raise("Card not found")
  Endif
  If KanbanStore.CardListId(boardId, cardId) <> listId Then
    status = 404
    Error.Raise("Card not found")
  Endif
  If replace Then
    If Not payload.Exist("members") And Not payload.Exist("assignees") And dateChanges.Count = 0 Then
      DatabaseTransactions.Rollback($db)
      transaction = False
      $apiMemberBoard = 0
      data["message"] = "Error"
      Return ApiAnswer(404, data)
    Endif
    If Not archived Then
      If memberNames Then WriteCardMembers(boardId, cardId, ActivePeople(boardId, memberNames))
      If assigneeNames Then WriteAssignees(boardId, cardId, ActivePeople(boardId, assigneeNames))
      If dateChanges.Count Then CardDates.Apply(boardId, cardId, dateChanges)
    Endif
    data["_id"] = CStr(cardId)
    Goto FINISH
  Endif
  If add Then
    If Not RoleOf(boardId, username) Then
      status = 400
      Error.Raise("userId is not an active member of this board")
    Endif
  Endif
  If field = "members" Then
    names = CardMembers(boardId, cardId)
  Else
    names = Assignees(boardId, cardId)
  Endif
  If add Then
    If names.Find(username) < 0 Then names.Add(username)
  Else
    While names.Find(username) >= 0
      names.Remove(names.Find(username))
    Wend
  Endif
  If field = "members" Then
    WriteCardMembers(boardId, cardId, names)
  Else
    WriteAssignees(boardId, cardId, names)
  Endif
  data["_id"] = CStr(cardId)
  data["members"] = CardMembers(boardId, cardId)
  data["assignees"] = Assignees(boardId, cardId)
FINISH:
  DatabaseTransactions.Commit($db)
  transaction = False
  $apiMemberBoard = 0
  Return ApiAnswer(200, data)
Catch
  failure = Error.Text
  $apiMemberBoard = 0
  If transaction Then Try DatabaseTransactions.Rollback($db)
  If status = 500 Then failure = "Card membership update failed"
  Return ApiFailure(status, failure)
End

Private Function RestPeople(value As Variant) As String[]
  Dim names As New String[]
  Dim item As Variant
  If TypeOf(value) = gb.String Then
    If value <> "" Then names.Add(value)
  Else If TypeOf(value) = gb.Object Then
    If (value Is Variant[]) Or (value Is String[]) Then
      For Each item In value
        If TypeOf(item) = gb.String Then
          If item <> "" Then names.Add(item)
        Endif
      Next
    Endif
  Endif
  Return names
End

Private Function ActivePeople(boardId As Integer, names As String[]) As String[]
  Dim active As New String[]
  Dim username As String
  Dim allowed As New Collection
  For Each username In names
    If String.Len(username) > 255 Then Continue
    If Not allowed.Exist(username) Then allowed[username] = RoleOf(boardId, username) <> ""
    If allowed[username] Then active.Add(username)
  Next
  Return active
End

Public Sub SetAssignees(boardId As Integer, cardId As Integer, names As String[])
  Dim previous As String[]
  Dim username As String
  RequireCard(boardId, cardId)
  If Not Can(boardId, "write") Then
    If Role(boardId) <> "worker" Then Error.Raise("Board permission denied")
    previous = Assignees(boardId, cardId)
    For Each username In previous
      If username <> WebIdentity.Username And names.Find(username) < 0 Then Error.Raise("Workers may change only their own assignment")
    Next
    For Each username In names
      If username <> WebIdentity.Username And previous.Find(username) < 0 Then Error.Raise("Workers may change only their own assignment")
    Next
  Endif
  For Each username In names
    If Not RoleOf(boardId, username) Then Error.Raise("Assignee must be an active board member")
  Next
  WriteAssignees(boardId, cardId, names)
End

Public Sub CopyAssignees(sourceBoard As Integer, sourceCard As Integer, targetBoard As Integer, targetCard As Integer)
  Dim names As String[] = Assignees(sourceBoard, sourceCard)
  Require(targetBoard, "write")
  RequireCard(targetBoard, targetCard)
  WriteAssignees(targetBoard, targetCard, names)
End

Public Sub RestoreAssignees(boardId As Integer, cardId As Integer, names As String[])
  Require(boardId, "manageBoard")
  RequireCard(boardId, cardId)
  WriteAssignees(boardId, cardId, names)
End

Private Sub WriteAssignees(boardId As Integer, cardId As Integer, names As String[])
  Dim r As Result
  Dim username As String
  Dim unique As New String[]
  Dim transaction As Boolean
  Dim failure As String
  For Each username In names
    If Not username Or String.Len(username) > 255 Then Error.Raise("Invalid assignee")
    If unique.Find(username) < 0 Then unique.Add(username)
  Next
  WorkspaceStore.OpenStore()
  DatabaseTransactions.Begin($db)
  transaction = True
  KanbanStore.Activity(boardId, "Changed card assignments", "card", cardId)
  WritePeopleOrder(boardId, cardId, "assignees", unique)
  WritePeopleSequence(boardId, cardId, "assignees", names)
  $db.Delete("kb_card_assignees", "board_id = &1 AND card_id = &2", boardId, cardId)
  For Each username In unique
    r = $db.Create("kb_card_assignees")
    r["board_id"] = boardId
    r["card_id"] = cardId
    r["username"] = username
    r.Update()
  Next
  r = $db.Edit("kb_cards", "board_id = &1 AND id = &2", boardId, cardId)
  r["assignee"] = ""
  If unique.Count Then r["assignee"] = unique[0]
  r.Update()
  DatabaseTransactions.Commit($db)
  transaction = False
Catch
  failure = Error.Text
  If transaction Then Try DatabaseTransactions.Rollback($db)
  Error.Raise(failure)
End

Private Sub WritePeopleSequence(boardId As Integer, cardId As Integer, field As String, names As String[])
  Dim r As Result
  Dim username As String
  Dim position As Integer
  $db.Delete("kb_card_people_sequence", "board_id = &1 AND card_id = &2 AND field = &3", boardId, cardId, field)
  For Each username In names
    r = $db.Create("kb_card_people_sequence")
    r["board_id"] = boardId
    r["card_id"] = cardId
    r["field"] = field
    r["username"] = username
    r["sort_order"] = position
    r.Update()
    Inc position
  Next
End

Private Sub WritePeopleOrder(boardId As Integer, cardId As Integer, field As String, names As String[])
  Dim r As Result
  Dim username As String
  Dim position As Integer
  $db.Delete("kb_card_people_order", "board_id = &1 AND card_id = &2 AND field = &3", boardId, cardId, field)
  For Each username In names
    r = $db.Create("kb_card_people_order")
    r["board_id"] = boardId
    r["card_id"] = cardId
    r["field"] = field
    r["username"] = username
    r["sort_order"] = position
    r.Update()
    Inc position
  Next
End
