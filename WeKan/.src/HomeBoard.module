' Private Home mark; board placement and stars are independent.
Export
Private $db As Connection

Private Sub OpenStore()
  Dim t As Table
  If $db Then Return
  BoardAccess.OpenStore()
  $db = WebDatabase.OpenConnection()
  If Not $db.Tables.Exist("kb_default_boards") Then
    t = $db.Tables.Add("kb_default_boards")
    t.Fields.Add("username", db.String, 255)
    t.Fields.Add("board_id", db.Integer)
    t.PrimaryKey = ["username"]
    t.Update()
  Endif
Catch
  $db = Null
  Error.Propagate()
End

Private Function Principal() As String
  Dim actor As String = WebIdentity.Username
  If Not actor Then Error.Raise("Sign in required")
  OpenStore()
  If Not WebDatabase.UserExists(actor) Then Error.Raise("Sign in required")
  Return actor
End

Public Function Saved() As Integer
  Dim actor As String = Principal()
  Return ReadSaved(actor)
End

Private Function ReadSaved(actor As String) As Integer
  Dim r As Result = $db.Find("kb_default_boards", "username=&1", actor)
  If r.Available Then Return r!board_id
  Return 0
End

Private Sub RequireTarget(boardId As Integer)
  Dim r As Result
  If boardId <= 0 Then Error.Raise("Board not accessible")
  BoardAccess.RequireRead(boardId)
  r = $db.Find("kb_boards", "id=&1 AND archived=&2", boardId, False)
  If Not r.Available Then Error.Raise("Board not accessible")
End

Public Function Visible() As Integer
  Dim boardId As Integer = Saved()
  If Not boardId Then Return 0
  Try RequireTarget(boardId)
  If Error Then Return 0
  Return boardId
End

Public Sub SetBoard(boardId As Integer)
  Change(boardId, "set")
End

Public Sub Toggle(boardId As Integer)
  Change(boardId, "toggle")
End

Public Sub Clear(boardId As Integer)
  Change(boardId, "clear")
End

Private Sub Change(boardId As Integer, mode As String)
  Dim actor As String = Principal()
  Dim desired As Integer
  Dim r As Result
  Dim transaction As Boolean
  Dim failure As String
  If boardId <= 0 Then Error.Raise("Board not accessible")
  DatabaseTransactions.Begin($db)
  transaction = True
  $db.Exec("UPDATE users SET username=username WHERE username=&1", actor)
  If WebIdentity.Username <> actor Or Not WebDatabase.UserExists(actor) Then Error.Raise("Sign in required")
  desired = ReadSaved(actor)
  If mode = "clear" Then
    If desired <> boardId Then
      DatabaseTransactions.Commit($db)
      transaction = False
      Return
    Endif
    desired = 0
  Else
    $db.Exec("UPDATE kb_boards SET title=title WHERE id=&1", boardId)
    RequireTarget(boardId)
    If mode = "toggle" And desired = boardId Then
      desired = 0
    Else
      desired = boardId
    Endif
  Endif
  $db.Delete("kb_default_boards", "username=&1", actor)
  If desired Then
    r = $db.Create("kb_default_boards")
    r["username"] = actor
    r["board_id"] = desired
    r.Update()
  Endif
  If WebIdentity.Username <> actor Or Not WebDatabase.UserExists(actor) Then Error.Raise("Sign in required")
  If mode <> "clear" Then RequireTarget(boardId)
  If ReadSaved(actor) <> desired Then Error.Raise("Home board changed")
  DatabaseTransactions.Commit($db)
  transaction = False
Catch
  failure = Error.Text
  If transaction Then Try DatabaseTransactions.Rollback($db)
  Error.Raise(failure)
End


' Source withHomeFirst is a presentation transform after server paging.
' Raw catalog totals and stored stars/ranks remain unchanged.
Public Function PresentStarred(ids As Integer[], search As String) As Integer[]
  Dim result As New Integer[]
  Dim homeId As Integer
  Dim id As Integer
  If Not ids Then Error.Raise("Invalid board page")
  If SearchActive(search) Then Return ids.Copy()
  homeId = Visible()
  If Not homeId Then Return ids.Copy()
  result.Add(homeId)
  For Each id In ids
    If id <> homeId Then result.Add(id)
  Next
  Return result
End


Private Function SearchActive(text As String) As Boolean
  Dim whitespace As Integer[] = [9, 10, 11, 12, 13, 32, 160, 5760, 8192, 8193, 8194, 8195, 8196, 8197, 8198, 8199, 8200, 8201, 8202, 8232, 8233, 8239, 8287, 12288, 65279]
  Dim index As Integer
  For index = 1 To String.Len(text)
    If whitespace.Find(String.Code(text, index)) < 0 Then Return True
  Next
  Return False
End


Public Sub Drop(ids As Integer[], remove As Boolean)
  Dim actor As String = Principal()
  Dim seen As New Collection
  Dim id As Integer
  Dim savedId As Integer
  If Not ids Then Error.Raise("Invalid board drop")
  If ids.Count = 0 Then Error.Raise("Invalid board drop")
  For Each id In ids
    If id <= 0 Or seen.Exist(CStr(id)) Then Error.Raise("Invalid board drop")
    seen[CStr(id)] = True
  Next
  If Not remove Then
    If ids.Count <> 1 Then Error.Raise("Please select only one board")
    SetBoard(ids[0])
  Else
    savedId = Saved()
    If savedId > 0 And ids.Find(savedId) >= 0 Then Clear(savedId)
  Endif
End
