' Scoped native snapshot for the Businessmap workbook renderer.
Export
Private $db As Connection
Private $boardId As Integer

Private Function TextValue(value As Variant) As String
  If IsNull(value) Then Return ""
  Return CStr(value)
End

Private Function Whitespace(character As String) As Boolean
  Dim code As Integer = String.Code(character)
  Return (code >= 9 And code <= 13) Or code = 32 Or code = 160 Or code = 5760 Or (code >= 8192 And code <= 8202) Or code = 8232 Or code = 8233 Or code = 8239 Or code = 8287 Or code = 12288 Or code = 65279
End

Private Function TrimText(value As String) As String
  Dim first As Integer = 1
  Dim finish As Integer = String.Len(value)
  While first <= finish
    If Not Whitespace(String.Mid(value, first, 1)) Then Break
    Inc first
  Wend
  While finish >= first
    If Not Whitespace(String.Mid(value, finish, 1)) Then Break
    Dec finish
  Wend
  If finish < first Then Return ""
  Return String.Mid(value, first, finish - first + 1)
End

Private Function CustomFields(cardId As Integer) As Collection
  Dim result As New Collection
  Dim rows As Result = $db.Find("kb_entries", "board_id=&1 AND card_id=&2 AND kind=&3 ORDER BY id", $boardId, cardId, "custom")
  Dim number As Float
  Dim value As Variant
  Dim numeric As Collection
  For Each rows
    If Not TextValue(rows!title) Then Continue
    Select TextValue(rows!value_type)
      Case "checkbox"
        value = CBool(rows!done)
      Case "number"
        If Not ExportNumber.ParseFinite(TextValue(rows!body), ByRef number) Then Error.Raise("Invalid numeric export field")
        ' Keep exact stored decimal text until JavaScript constructs the cell.
        numeric = New Collection
        numeric.Add(TextValue(rows!body), "number")
        value = numeric
      Case Else
        value = TextValue(rows!body)
    End Select
    result[TextValue(rows!title)] = value
  Next
  Return result
End


Private Sub ValidateName(title As String)
  Dim index As Integer
  Dim units As Integer
  Dim width As Integer
  Dim character As String
  Dim ending As String
  If title = "History" Then Error.Raise("Invalid worksheet name")
  If Left(title, 1) = "'" Then Error.Raise("Invalid worksheet name")
  For index = 1 To String.Len(title)
    character = String.Mid(title, index, 1)
    width = If(String.Code(character) > 65535, 2, 1)
    If units + width > 31 Then
      ending = ""
      Break
    Endif
    units += width
    ending = character
    If units = 31 Then Break
  Next
  If ending = "'" Then Error.Raise("Invalid worksheet name")
End

Public Function Build(boardId As Integer, db As Connection) As String
  Dim output As New Collection
  Dim items As New Variant[]
  Dim board As Result
  Dim rows As Result
  Dim entries As Result
  Dim item As Collection
  Dim comment As Collection
  Dim comments As Variant[]
  Dim fields As Collection
  Dim names As New Collection
  Dim name As String
  Dim dates As Collection
  Dim key As String
  Dim people As String[]
  Dim members As String[]
  Dim person As String
  Dim labels As String[]
  Dim label As String
  Dim maxComments As Integer
  $db = db
  $boardId = boardId
  BoardAccess.RequireContainer(boardId, "board", boardId)
  board = db.Find("kb_boards", "id=&1", boardId)
  If Not board.Available Then Error.Raise("Board not found")
  ValidateName(TextValue(board!title))
  rows = db.Exec("SELECT c.*,l.title AS list_title FROM kb_cards c LEFT JOIN kb_card_lists cl ON cl.board_id=c.board_id AND cl.card_id=c.id LEFT JOIN kb_lists l ON l.board_id=c.board_id AND l.id=cl.list_id LEFT JOIN kb_order o ON o.board_id=c.board_id AND o.kind=&2 AND o.item=CAST(c.id AS TEXT) WHERE " & ListDeletion.LiveSql("card", "c") & " AND c.board_id=&1 AND c.archived=&3 ORDER BY COALESCE(o.sort_order,c.id),c.id", boardId, "card", False)
  For Each rows
    item = New Collection
    item.Add(CStr(rows!id), "cardId")
    item.Add(TextValue(rows!title), "title")
    item.Add(TextValue(rows!description), "description")
    item.Add(TextValue(rows!lane), "swimlaneTitle")
    item.Add(TextValue(rows!list_title), "listTitle")
    item.Add(WorkspaceStore.Setting(boardId, "card", rows!id, "color"), "color")
    fields = CustomFields(rows!id)
    item.Add(fields, "customFields")
    For Each name In fields.Keys
      names[name] = True
    Next
    people = BoardAccess.Assignees(boardId, rows!id)
    members = BoardAccess.CardMembers(boardId, rows!id)
    For Each person In members
      people.Add(person)
    Next
    If people.Count Then
      item.Add(people[0], "owner")
    Else
      item.Add("", "owner")
    Endif
    If people.Count Then people.Remove(0)
    item.Add(people, "assignees")
    labels = New String[]
    For Each label In Split(TextValue(rows!labels), ",")
      label = TrimText(label)
      If label Then labels.Add(label)
    Next
    item.Add(labels, "labels")
    dates = CardDates.ReadDates(boardId, rows!id)
    For Each key In ["dueAt", "startAt", "endAt"]
      If dates.Exist(key) Then
        item.Add(CardDates.Iso(dates[key]), key)
      Else
        item.Add("", key)
      Endif
    Next
    comments = New Variant[]
    entries = db.Find("kb_entries", "board_id=&1 AND card_id=&2 AND kind=&3 ORDER BY id", boardId, rows!id, "comment")
    For Each entries
      If Not TrimText(TextValue(entries!body)) Then Continue
      comment = New Collection
      comment.Add(TextValue(entries!body), "text")
      comment.Add(CardContent.AuthorName(boardId, rows!id, "entry", entries!id), "author")
      comments.Add(comment)
    Next
    maxComments = Max(maxComments, comments.Count)
    item.Add(comments, "comments")
    entries = db.Find("kb_entries", "board_id=&1 AND kind=&2 AND amount=&3 ORDER BY id", boardId, "subtask", rows!id)
    If entries.Available Then
      item.Add(CStr(entries!card_id), "parentCardId")
    Else
      item.Add("", "parentCardId")
    Endif
    items.Add(item)
  Next
  ' Bound the possible table before completing the retained export queue.
  If items.Count + 1 > 1048576 Or names.Count + maxComments + 21 > 16384 Then Error.Raise("Worksheet exceeds Excel dimensions")
  output.Add("businessmap", "format")
  output.Add(If(TextValue(board!title), TextValue(board!title), "Cards"), "title")
  output.Add(items, "items")
  Return JSON.Encode(output)
End
