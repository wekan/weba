Export
Private $db As Connection
Private $fields As String[] = ["externalLinkPatternPrefix", "externalLinkPatternUrl", "externalLinkRules", "externalLinkIdentifierAliases"]

Public Sub OpenStore()
  Dim t As Table
  Dim field As String
  If $db Then Return
  $db = WebDatabase.OpenConnection()
  If Not $db.Tables.Exist("markdown_external_settings") Then
    t = $db.Tables.Add("markdown_external_settings")
    t.Fields.Add("id", db.Integer)
    For Each field In $fields
      t.Fields.Add(field, db.String)
    Next
    t.Fields.Add("actor", db.String, 255)
    t.Fields.Add("changed_ms", db.Long)
    t.PrimaryKey = ["id"]
    t.Update()
  Endif
  If Not $db.Find("markdown_external_settings", "id=1").Available Then
    Try $db.Exec("INSERT INTO markdown_external_settings (id) SELECT 1 WHERE NOT EXISTS (SELECT 1 FROM markdown_external_settings WHERE id=1)")
    If Error Then
      If Not $db.Find("markdown_external_settings", "id=1").Available Then Error.Propagate()
    Endif
  Endif
Catch
  $db = Null
  Error.Propagate()
End

' Only the four source-public strings; no actor/time audit.
Public Function Snapshot() As Collection
  Dim data As New Collection
  Dim field As String
  Dim r As Result
  OpenStore()
  r = $db.Find("markdown_external_settings", "id=1")
  For Each field In $fields
    data.Add(CStr(r[field]), field)
  Next
  Return data
End

Public Function Settings() As Collection
  Dim data As Collection
  Dim r As Result
  RecoveryStore.RequireAdmin()
  data = Snapshot()
  r = $db.Find("markdown_external_settings", "id=1")
  data.Add(r!actor, "actor")
  data.Add(r!changed_ms, "changedMs")
  Return data
End

Private Function Utf16Length(text As String) As Integer
  Dim i As Integer
  Dim count As Integer = String.Len(text)
  For i = 1 To String.Len(text)
    If String.Code(text, i) > 65535 Then Inc count
  Next
  Return count
End

Public Sub Save(data As Collection)
  Dim actor As String = WebIdentity.Username
  Dim r As Result
  Dim field As String
  Dim saved As Collection
  Dim transaction As Boolean
  Dim failure As String
  RecoveryStore.RequireAdmin()
  If Not data Then Error.Raise("Expected four text settings")
  If data.Count <> 4 Then Error.Raise("Expected four text settings")
  For Each field In $fields
    If Not data.Exist(field) Then Error.Raise("Expected four text settings")
    If TypeOf(data[field]) <> gb.String Then Error.Raise("Expected text setting")
  Next
  If Utf16Length(data["externalLinkRules"]) > 20000 Or Utf16Length(data["externalLinkIdentifierAliases"]) > 5000 Then Error.Raise("External link setting is too long")
  OpenStore()
  DatabaseTransactions.Begin($db)
  transaction = True
  $db.Exec("UPDATE users SET username=username WHERE username=&1", actor)
  $db.Exec("UPDATE markdown_external_settings SET id=id WHERE id=1")
  If WebIdentity.Username <> actor Then Error.Raise("Administrator required")
  RecoveryStore.RequireAdmin()
  r = $db.Edit("markdown_external_settings", "id=1")
  For Each field In $fields
    r[field] = data[field]
  Next
  r["actor"] = actor
  r["changed_ms"] = ItemChanges.UtcNow()
  r.Update()
  If WebIdentity.Username <> actor Then Error.Raise("Administrator required")
  RecoveryStore.RequireAdmin()
  saved = Snapshot()
  For Each field In $fields
    If CStr(saved[field]) <> CStr(data[field]) Then Error.Raise("External link setting changed")
  Next
  DatabaseTransactions.Commit($db)
  transaction = False
Catch
  failure = Error.Text
  If transaction Then Try DatabaseTransactions.Rollback($db)
  Error.Raise(failure)
End
