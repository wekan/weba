' REST projections run only inside BoardAccess.ReadApiBoard's checked scope.
Export

Public Function Read(boardId As Integer, kind As String, Optional listId As Integer) As Variant
  Dim db As Connection = WebDatabase.OpenConnection()
  Dim r As Result
  Dim item As Collection
  Dim rows As New Variant[]
  Dim data As Collection
  Dim index As Integer
  Dim prior As Collection
  Dim changes As Collection
  Dim times As Collection
  If Env["WEBA_API_REQUEST"] <> "1" Then Error.Raise("API context required")
  BoardAccess.RequireRead(boardId)
  r = db.Find("kb_boards", "id = &1", boardId)
  If kind = "board" Then
    data = New Collection
    data["_id"] = CStr(r!id)
    data["title"] = r!title
    data["archived"] = r!archived
    data["members"] = BoardAccess.ApiMembers(boardId)
  Else If kind = "lists" Or kind = "swimlanes" Then
    If kind = "lists" Then
      changes = ItemChanges.Lists(boardId)
      r = db.Find("kb_lists", "board_id = &1 ORDER BY sort_order, id", boardId)
    Else
      r = KanbanStore.Lanes(boardId)
    Endif
    For Each r
      If WorkspaceStore.Archived(boardId, If(kind = "lists", "list", "lane"), r!id) Then Continue
      item = JSON.Decode("{}", True)
      item["_id"] = CStr(r!id)
      item["title"] = r!title
      If kind = "lists" Then
        times = changes[CStr(r!id)]
        item["modifiedAt"] = times["modifiedAt"]
        item["cardsModifiedAt"] = times["cardsModifiedAt"]
      Endif
      rows.Add(item)
    Next
  Else If kind = "cards_count" Then
    data = New Collection
    r = db.Find("kb_cards", "board_id = &1 AND archived = &2", boardId, False)
    data["board_cards_count"] = r.Count
  Else If kind = "cards" Or kind = "list_cards_count" Then
    KanbanStore.PrimeCardLinks(boardId)
    r = db.Exec("SELECT c.* FROM kb_cards c INNER JOIN kb_card_lists l ON l.board_id = c.board_id AND l.card_id = c.id WHERE c.board_id = &1 AND l.list_id = &2 AND c.archived = &3 ORDER BY c.id", boardId, listId, False)
    If kind = "list_cards_count" Then
      data = New Collection
      data["list_cards_count"] = r.Count
    Else
      For Each r
        item = CardFields(boardId, r)
        index = 0
        For Each prior In rows
          If prior["sort"] > item["sort"] Then Break
          Inc index
        Next
        rows.Add(item, index)
      Next
    Endif
  Else
    Error.Raise("Unknown board read")
  Endif
  If data Then Return data
  Return rows
End

Private Function CardFields(boardId As Integer, record As Result) As Collection
  Dim db As Connection = WebDatabase.OpenConnection()
  Dim item As New Collection
  Dim lane As Result
  Dim values As Collection
  Dim field As String
  item["_id"] = CStr(record!id)
  item.Add(CStr(record!title), "title")
  item.Add(CStr(record!description), "description")
  lane = db.Find("kb_lanes", "board_id=&1 AND title=&2", boardId, record!lane)
  If lane.Available Then item["swimlaneId"] = CStr(lane!id)
  item["assignees"] = BoardAccess.Assignees(boardId, record!id)
  item["sort"] = KanbanStore.ItemOrder(boardId, "card", CStr(record!id), record!id)
  values = CardDates.ReadDates(boardId, record!id)
  For Each field In values.Keys
    item[field] = CardDates.Iso(values[field])
  Next
  Return item
End

Public Function Card(boardId As Integer, cardId As Integer) As Collection
  Dim db As Connection = WebDatabase.OpenConnection()
  Dim r As Result
  Dim row As Result
  Dim subrow As Result
  Dim item As Collection
  Dim checklist As Collection
  Dim entry As Collection
  Dim checklists As New Variant[]
  Dim entries As Variant[]
  If Env["WEBA_API_REQUEST"] <> "1" Then Error.Raise("API context required")
  BoardAccess.RequireCard(boardId, cardId)
  If Not BoardAccess.Can(boardId, "seesAllCards") Then Error.Raise("Whole-board permission required")
  KanbanStore.PrimeCardLinks(boardId)
  r = db.Find("kb_cards", "board_id=&1 AND id=&2", boardId, cardId)
  If Not r.Available Then Error.Raise("Card not found")
  item = CardFields(boardId, r)
  item["boardId"] = CStr(boardId)
  item["listId"] = CStr(KanbanStore.CardListId(boardId, cardId))
  item["archived"] = r!archived
  item["members"] = BoardAccess.CardMembers(boardId, cardId)
  row = db.Find("kb_item_changes", "board_id=&1 AND kind=&2 AND item_id=&3", boardId, "card", cardId)
  If row.Available Then item["modifiedAt"] = CardDates.Iso(row!modified_ms)
  CardContent.OpenStore()
  row = CardContent.Entries(boardId, cardId, "checklist")
  For Each row
    checklist = New Collection
    checklist["_id"] = CStr(row!id)
    checklist["boardId"] = CStr(boardId)
    checklist["cardId"] = CStr(cardId)
    checklist.Add(CStr(row!title), "title")
    checklist["sort"] = row!id
    checklist["dueAt"] = JSON.Null
    If TypeOf(row!created_at) = gb.Date And Not IsNull(row!created_at) Then checklist["createdAt"] = CardDates.Iso(ItemChanges.Epoch(row!created_at))
    entries = New Variant[]
    subrow = db.Find("kb_entries", "board_id=&1 AND card_id=&2 AND kind=&3 AND parent_id=&4 ORDER BY id", boardId, cardId, "checkitem", row!id)
    For Each subrow
      entry = New Collection
      entry["_id"] = CStr(subrow!id)
      entry.Add(CStr(subrow!title), "title")
      entry["isFinished"] = subrow!done
      entry["dueAt"] = JSON.Null
      entries.Add(entry)
    Next
    checklist["items"] = entries
    checklists.Add(checklist)
  Next
  item["checklists"] = checklists
  Return item
End
