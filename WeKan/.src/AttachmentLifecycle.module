' Ordinary attachment removal retains bytes; only explicit container purge erases.
Export
Private $db As Connection

Public Sub OpenStore()
  Dim t As Table
  If $db Then Return
  $db = WebDatabase.OpenConnection()
  If Not $db.Tables.Exist("kb_attachment_deletions") Then
    t = $db.Tables.Add("kb_attachment_deletions")
    t.Fields.Add("file_id", db.Integer)
    t.Fields.Add("board_id", db.Integer)
    t.Fields.Add("card_id", db.Integer)
    t.Fields.Add("actor", db.String, 255)
    t.Fields.Add("deleted_at", db.Long)
    t.Fields.Add("batch_id", db.String, 128)
    t.PrimaryKey = ["file_id"]
    t.Update()
  Endif
  If Not $db.Tables.Exist("kb_attachment_history") Then
    t = $db.Tables.Add("kb_attachment_history")
    t.Fields.Add("id", db.Serial)
    t.Fields.Add("file_id", db.Integer)
    t.Fields.Add("board_id", db.Integer)
    t.Fields.Add("card_id", db.Integer)
    t.Fields.Add("actor", db.String, 255)
    t.Fields.Add("changed_at", db.Long)
    t.Fields.Add("previous_at", db.Long)
    t.Fields.Add("batch_id", db.String, 128)
    t.Fields.Add("filename", db.String, 255)
    t.Fields.Add("action", db.String, 16)
    t.PrimaryKey = ["id"]
    t.Update()
  Endif
Catch
  $db = Null
  Error.Propagate()
End

Public Function LiveSql(tableAlias As String) As String
  Return "NOT EXISTS (SELECT 1 FROM kb_attachment_deletions deleted_file WHERE deleted_file.file_id=" & tableAlias & ".id AND deleted_file.board_id=" & tableAlias & ".board_id AND deleted_file.card_id=" & tableAlias & ".card_id)"
End

Private Function RawFile(boardId As Integer, cardId As Integer, fileId As Integer) As Result
  Dim r As Result = $db.Exec(ExportText.SelectRows($db, "kb_files") & " WHERE board_id=&1 AND card_id=&2 AND id=&3", boardId, cardId, fileId)
  If Not r.Available Then Error.Raise("Attachment not accessible")
  Return r
End

Private Sub CheckWriter(boardId As Integer, cardId As Integer, actor As String)
  If Not actor Or WebIdentity.Username <> actor Then Error.Raise("Sign in required")
  BoardAccess.RequireCard(boardId, cardId)
  BoardAccess.Require(boardId, "write")
End

Private Function StateStamp(state As Collection) As String
  Dim ordered As New Collection
  Dim keys As String[] = state.Keys
  Dim key As String
  keys.Sort()
  For Each key In keys
    ordered.Add(state[key], key)
  Next
  Return JsonText.Encode(ordered)
End

Private Function Stamp(row As Result, Optional omitContent As Boolean) As String
  Return StateStamp(CardContent.RecordState(row, omitContent))
End

Private Function Rows(tableName As String, filter As String, fileId As Integer, Optional boardId As Integer, Optional cardId As Integer) As String[]
  Dim result As New String[]
  Dim row As Result = $db.Exec(ExportText.SelectRows($db, tableName) & " WHERE " & filter, fileId, boardId, cardId)
  For Each row
    result.Add(Stamp(row))
  Next
  Return result
End

Private Function CoverRows(boardId As Integer, cardId As Integer) As String[]
  Return Rows("kb_meta", "item_id=&1 AND board_id=&2 AND kind='card' AND setting='cover'", cardId, boardId)
End

Private Sub RequireState(boardId As Integer, cardId As Integer, fileId As Integer, scope As Collection)
  Dim file As Result
  Dim contentNull As Boolean
  CardContent.RequireMutationScope(boardId, cardId, scope)
  file = RawFile(boardId, cardId, fileId)
  If Stamp(file, True) <> scope["file"] Or file!content.Data <> scope["bytes"] Then Error.Raise("Attachment changed during mutation")
  contentNull = $db.Exec("SELECT id FROM kb_files WHERE id=&1 AND content IS NULL", fileId).Available
  If contentNull <> scope["contentNull"] Then Error.Raise("Attachment byte state changed")
  If JsonText.Encode(Rows("kb_attachment_data", "file_id=&1", fileId)) <> scope["metadata"] Then Error.Raise("Attachment metadata changed")
  If JsonText.Encode(Rows("kb_retired_authors", "kind='file' AND item_id=&1", fileId)) <> scope["provenance"] Then Error.Raise("Attachment provenance changed")
  If JsonText.Encode(Rows("kb_attachment_deletions", "file_id=&1", fileId)) <> JsonText.Encode(scope["marks"]) Then Error.Raise("Attachment deletion changed")
  If JsonText.Encode(Rows("kb_attachment_history", "file_id=&1 ORDER BY id", fileId)) <> JsonText.Encode(scope["history"]) Then Error.Raise("Attachment history changed")
  If JsonText.Encode(CoverRows(boardId, cardId)) <> JsonText.Encode(scope["cover"]) Then Error.Raise("Attachment cover changed")
End

Private Function BeginChange(boardId As Integer, cardId As Integer, fileId As Integer) As Collection
  Dim actor As String = WebIdentity.Username
  Dim transaction As Boolean
  Dim failure As String
  Dim scope As Collection
  Dim file As Result
  CardContent.OpenStore()
  OpenStore()
  CheckWriter(boardId, cardId, actor)
  RawFile(boardId, cardId, fileId)
  DatabaseTransactions.Begin($db)
  transaction = True
  $db.Exec("UPDATE users SET username=username WHERE username=&1", actor)
  $db.Exec("UPDATE kb_boards SET title=title WHERE id=&1", boardId)
  $db.Exec("UPDATE kb_cards SET title=title WHERE board_id=&1 AND id=&2", boardId, cardId)
  CheckWriter(boardId, cardId, actor)
  scope = CardContent.MutationScope(boardId, cardId, actor, "write")
  file = RawFile(boardId, cardId, fileId)
  scope.Add(Stamp(file, True), "file")
  scope.Add(file!content.Data, "bytes")
  scope.Add($db.Exec("SELECT id FROM kb_files WHERE id=&1 AND content IS NULL", fileId).Available, "contentNull")
  scope.Add(JsonText.Encode(Rows("kb_attachment_data", "file_id=&1", fileId)), "metadata")
  scope.Add(JsonText.Encode(Rows("kb_retired_authors", "kind='file' AND item_id=&1", fileId)), "provenance")
  scope.Add(Rows("kb_attachment_deletions", "file_id=&1", fileId), "marks")
  scope.Add(Rows("kb_attachment_history", "file_id=&1 ORDER BY id", fileId), "history")
  scope.Add(CoverRows(boardId, cardId), "cover")
  $db.Exec("UPDATE kb_files SET filename=filename WHERE board_id=&1 AND card_id=&2 AND id=&3", boardId, cardId, fileId)
  $db.Exec("UPDATE kb_attachment_data SET file_id=file_id WHERE file_id=&1", fileId)
  $db.Exec("UPDATE kb_attachment_deletions SET file_id=file_id WHERE file_id=&1", fileId)
  RequireState(boardId, cardId, fileId, scope)
  Return scope
Catch
  failure = Error.Text
  If transaction Then Try DatabaseTransactions.Rollback($db)
  Error.Raise(failure)
End

Private Function Mark(boardId As Integer, cardId As Integer, fileId As Integer) As Result
  Return $db.Exec(ExportText.SelectRows($db, "kb_attachment_deletions") & " WHERE board_id=&1 AND card_id=&2 AND file_id=&3", boardId, cardId, fileId)
End

Public Function IsDeleted(boardId As Integer, cardId As Integer, fileId As Integer) As Boolean
  OpenStore()
  Return Mark(boardId, cardId, fileId).Available
End

Private Sub AddHistory(boardId As Integer, cardId As Integer, fileId As Integer, actor As String, filename As String, action As String, at As Long, batchId As String, previousAt As Long, scope As Collection)
  Dim r As Result = $db.Create("kb_attachment_history")
  Dim expected As Collection
  r["board_id"] = boardId
  r["card_id"] = cardId
  r["file_id"] = fileId
  r["actor"] = actor
  r["filename"] = filename
  r["action"] = action
  r["changed_at"] = at
  r["batch_id"] = batchId
  r["previous_at"] = previousAt
  expected = CardContent.RecordState(r)
  DatabaseText.Save($db, r, "kb_attachment_history", ["board_id", "card_id", "file_id", "actor", "filename", "action", "changed_at", "batch_id", "previous_at"], True)
  expected["id"] = $db.LastInsertId
  scope["history"].Add(StateStamp(expected))
End

Public Function Delete(boardId As Integer, cardId As Integer, fileId As Integer) As String
  Dim scope As Collection
  Dim file As Result
  Dim r As Result
  Dim batchId As String
  Dim at As Long
  Dim marks As New String[]
  Dim empty As New String[]
  Dim transaction As Boolean
  Dim failure As String
  scope = BeginChange(boardId, cardId, fileId)
  transaction = True
  file = RawFile(boardId, cardId, fileId)
  r = Mark(boardId, cardId, fileId)
  If r.Available Then
    batchId = ExportText.ReadValue(r, "batch_id")
  Else
    at = ItemChanges.UtcNow()
    batchId = "attachment-" & Str(fileId) & "-" & Str(at)
    If StoredCover(cardId, boardId) = fileId Then
      $db.Delete("kb_meta", "board_id=&1 AND kind=&2 AND item_id=&3 AND setting=&4", boardId, "card", cardId, "cover")
      scope["cover"] = empty
      RequireState(boardId, cardId, fileId, scope)
    Endif
    r = $db.Create("kb_attachment_deletions")
    r["file_id"] = fileId
    r["board_id"] = boardId
    r["card_id"] = cardId
    r["actor"] = scope["actor"]
    r["deleted_at"] = at
    r["batch_id"] = batchId
    marks.Add(Stamp(r))
    r.Update()
    scope["marks"] = marks
    RequireState(boardId, cardId, fileId, scope)
    AddHistory(boardId, cardId, fileId, scope["actor"], ExportText.ReadValue(file, "filename"), "removed", at, batchId, 0, scope)
    RequireState(boardId, cardId, fileId, scope)
    KanbanStore.Activity(boardId, "Deleted attachment: " & ExportText.ReadValue(file, "filename"), "card", cardId)
  Endif
  RequireState(boardId, cardId, fileId, scope)
  DatabaseTransactions.Commit($db)
  transaction = False
  Return batchId
Catch
  failure = Error.Text
  If transaction Then Try DatabaseTransactions.Rollback($db)
  Error.Raise(failure)
End

Public Function Restore(boardId As Integer, cardId As Integer, fileId As Integer) As Boolean
  Dim scope As Collection
  Dim file As Result
  Dim r As Result
  Dim batchId As String
  Dim at As Long
  Dim empty As New String[]
  Dim changed As Boolean
  Dim transaction As Boolean
  Dim failure As String
  scope = BeginChange(boardId, cardId, fileId)
  transaction = True
  file = RawFile(boardId, cardId, fileId)
  r = Mark(boardId, cardId, fileId)
  If r.Available Then
    changed = True
    batchId = ExportText.ReadValue(r, "batch_id")
    If Not IsNull(r!deleted_at) Then at = r!deleted_at
    $db.Delete("kb_attachment_deletions", "board_id=&1 AND card_id=&2 AND file_id=&3", boardId, cardId, fileId)
    scope["marks"] = empty
    RequireState(boardId, cardId, fileId, scope)
    AddHistory(boardId, cardId, fileId, scope["actor"], ExportText.ReadValue(file, "filename"), "added", ItemChanges.UtcNow(), batchId, at, scope)
    RequireState(boardId, cardId, fileId, scope)
    KanbanStore.Activity(boardId, "Restored attachment: " & ExportText.ReadValue(file, "filename"), "card", cardId)
  Endif
  RequireState(boardId, cardId, fileId, scope)
  DatabaseTransactions.Commit($db)
  transaction = False
  Return changed
Catch
  failure = Error.Text
  If transaction Then Try DatabaseTransactions.Rollback($db)
  Error.Raise(failure)
End

Private Function StoredCover(cardId As Integer, boardId As Integer) As Integer
  Dim r As Result = $db.Find("kb_meta", "board_id=&1 AND kind=&2 AND item_id=&3 AND setting=&4", boardId, "card", cardId, "cover")
  If r.Available Then Return Val(r!value)
End

Public Function CoverId(boardId As Integer, cardId As Integer) As Integer
  Dim id As Integer
  Dim r As Result
  CardContent.OpenStore()
  OpenStore()
  BoardAccess.RequireCard(boardId, cardId)
  id = StoredCover(cardId, boardId)
  If id <= 0 Then Return 0
  r = $db.Find("kb_files", "board_id=&1 AND card_id=&2 AND id=&3 AND " & LiveSql("kb_files"), boardId, cardId, id)
  If r.Available Then Return id
End

Public Sub SetCover(boardId As Integer, cardId As Integer, fileId As Integer)
  Dim scope As Collection
  Dim r As Result
  Dim cover As New String[]
  Dim transaction As Boolean
  Dim failure As String
  scope = BeginChange(boardId, cardId, fileId)
  transaction = True
  If Mark(boardId, cardId, fileId).Available Then Error.Raise("Choose a live attachment")
  If StoredCover(cardId, boardId) <> fileId Then
    r = $db.Edit("kb_meta", "board_id=&1 AND kind=&2 AND item_id=&3 AND setting=&4", boardId, "card", cardId, "cover")
    If Not r.Available Then
      r = $db.Create("kb_meta")
      r["board_id"] = boardId
      r["kind"] = "card"
      r["item_id"] = cardId
      r["setting"] = "cover"
    Endif
    r["value"] = CStr(fileId)
    cover.Add(Stamp(r))
    r.Update()
    scope["cover"] = cover
    RequireState(boardId, cardId, fileId, scope)
    ItemChanges.Mark(boardId, "card", cardId)
  Endif
  RequireState(boardId, cardId, fileId, scope)
  If CoverId(boardId, cardId) <> fileId Then Error.Raise("Attachment cover changed")
  DatabaseTransactions.Commit($db)
  transaction = False
Catch
  failure = Error.Text
  If transaction Then Try DatabaseTransactions.Rollback($db)
  Error.Raise(failure)
End

Public Function History(boardId As Integer, cardId As Integer, Optional completeText As Boolean) As Result
  CardContent.OpenStore()
  OpenStore()
  BoardAccess.RequireCard(boardId, cardId)
  If completeText Then Return $db.Exec(ExportText.Preserve($db, "SELECT h.*,CASE WHEN d.file_id IS NULL THEN 0 ELSE 1 END AS deleted FROM kb_attachment_history h INNER JOIN kb_files f ON f.id=h.file_id AND f.board_id=h.board_id AND f.card_id=h.card_id LEFT JOIN kb_attachment_deletions d ON d.file_id=f.id AND d.board_id=f.board_id AND d.card_id=f.card_id WHERE h.board_id=&1 AND h.card_id=&2 ORDER BY h.id DESC"), boardId, cardId)
  Return $db.Exec("SELECT h.*,CASE WHEN d.file_id IS NULL THEN 0 ELSE 1 END AS deleted FROM kb_attachment_history h INNER JOIN kb_files f ON f.id=h.file_id AND f.board_id=h.board_id AND f.card_id=h.card_id LEFT JOIN kb_attachment_deletions d ON d.file_id=f.id AND d.board_id=f.board_id AND d.card_id=f.card_id WHERE h.board_id=&1 AND h.card_id=&2 ORDER BY h.id DESC", boardId, cardId)
End

Public Function HistoryEntry(boardId As Integer, cardId As Integer, historyId As Integer) As Result
  Dim r As Result
  CardContent.OpenStore()
  OpenStore()
  BoardAccess.RequireCard(boardId, cardId)
  r = $db.Find("kb_attachment_history", "board_id=&1 AND card_id=&2 AND id=&3", boardId, cardId, historyId)
  If Not r.Available Then Error.Raise("Attachment history not accessible")
  RawFile(boardId, cardId, r!file_id)
  Return r
End
