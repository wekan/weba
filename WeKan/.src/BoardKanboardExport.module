' Native counterpart of the parent Kanboard JSON formatter. Unsupported source
' identity fields remain absent; native comments, checklist items and card
' relationships are retained in the shapes Kanboard imports.
Export

Private Function TextValue(value As Variant) As String
  If IsNull(value) Then Return ""
  Return CStr(value)
End

Private Function DateValue(dates As Collection, key As String) As String
  If Not dates.Exist(key) Then Return ""
  Return CardDates.Iso(CLong(dates[key]))
End

Private Function Whitespace(character As String) As Boolean
  Dim code As Integer = String.Code(character)
  Return (code >= 9 And code <= 13) Or code = 32 Or code = 160 Or code = 5760 Or (code >= 8192 And code <= 8202) Or code = 8232 Or code = 8233 Or code = 8239 Or code = 8287 Or code = 12288 Or code = 65279
End

Private Function TrimText(value As String) As String
  Dim first As Integer = 1
  Dim finish As Integer = String.Len(value)
  While first <= finish
    If Not Whitespace(String.Mid(value, first, 1)) Then Break
    Inc first
  Wend
  While finish >= first
    If Not Whitespace(String.Mid(value, finish, 1)) Then Break
    Dec finish
  Wend
  If finish < first Then Return ""
  Return String.Mid(value, first, finish - first + 1)
End

Private Function Labels(value As Variant) As String[]
  Dim result As New String[]
  Dim label As String
  For Each label In Split(TextValue(value), ",")
    label = TrimText(label)
    If label Then result.Add(label)
  Next
  Return result
End

Private Sub AddLink(linksByCard As Collection, numbers As Collection, seen As Collection, fromId As Integer, toId As Integer, label As String, ByRef nextId As Integer)
  Dim key As String = CStr(fromId) & ">" & CStr(toId) & ":" & label
  Dim links As Variant[]
  Dim item As New Collection
  If fromId = toId Or Not numbers.Exist(CStr(fromId)) Or Not numbers.Exist(CStr(toId)) Or seen.Exist(key) Then Return
  seen[key] = True
  Inc nextId
  item.Add(nextId, "id")
  item.Add(numbers[CStr(toId)], "task_id")
  item.Add(label, "label")
  links = linksByCard[CStr(fromId)]
  links.Add(item)
End

Private Sub AddLinkPair(linksByCard As Collection, numbers As Collection, seen As Collection, fromId As Integer, toId As Integer, label As String, opposite As String, ByRef nextId As Integer)
  AddLink(linksByCard, numbers, seen, fromId, toId, label, ByRef nextId)
  AddLink(linksByCard, numbers, seen, toId, fromId, opposite, ByRef nextId)
End

Public Function Build(boardId As Integer, db As Connection, Optional wanted As Collection) As String
  Dim data As New Collection
  Dim boardData As New Collection
  Dim columns As New Variant[]
  Dim swimlanes As New Variant[]
  Dim cards As New Variant[]
  Dim tasks As New Variant[]
  Dim numbers As New Collection
  Dim linksByCard As New Collection
  Dim seenLinks As New Collection
  Dim board As Result
  Dim r As Result
  Dim related As Result
  Dim row As Collection
  Dim task As Collection
  Dim item As Collection
  Dim dates As Collection
  Dim subtasks As Variant[]
  Dim comments As Variant[]
  Dim links As Variant[]
  Dim emptyLinks As Variant[]
  Dim cardId As Integer
  Dim index As Integer
  Dim people As String[]
  Dim person As String
  Dim nextLinkId As Integer
  BoardAccess.RequireContainer(boardId, "board", boardId)
  board = db.Find("kb_boards", "id=&1", boardId)
  If Not board.Available Then Error.Raise("Board not found")
  boardData.Add(TextValue(board!title), "name")
  data.Add(boardData, "board")
  r = db.Find("kb_lists", ListDeletion.LiveSql("list", "kb_lists") & " AND board_id=&1 ORDER BY lane,sort_order,id", boardId)
  For Each r
    item = New Collection
    item.Add(TextValue(r!title), "title")
    columns.Add(item)
  Next
  data.Add(columns, "columns")
  r = db.Find("kb_lanes", "board_id=&1 ORDER BY id", boardId)
  For Each r
    item = New Collection
    item.Add(TextValue(r!title), "name")
    swimlanes.Add(item)
  Next
  data.Add(swimlanes, "swimlanes")
  r = db.Exec("SELECT c.*,l.title AS list_title FROM kb_cards c LEFT JOIN kb_card_lists cl ON cl.board_id=c.board_id AND cl.card_id=c.id LEFT JOIN kb_lists l ON l.board_id=c.board_id AND l.id=cl.list_id AND " & ListDeletion.LiveSql("list", "l") & " WHERE " & ListDeletion.LiveSql("card", "c") & " AND c.board_id=&1 AND c.archived=&2 ORDER BY c.id", boardId, False)
  For Each r
    Inc index
    row = New Collection
    row.Add(CInt(r!id), "cardId")
    row.Add(index, "number")
    row.Add(TextValue(r!title), "title")
    row.Add(If(ExternalExportFields.Wants(wanted, "description"), TextValue(r!description), ""), "description")
    row.Add(TextValue(r!list_title), "column")
    row.Add(If(TextValue(r!lane), TextValue(r!lane), "Default"), "swimlane")
    If ExternalExportFields.Wants(wanted, "labels") Then
      row.Add(Labels(r!labels), "tags")
    Else
      row.Add(Labels(""), "tags")
    Endif
    dates = New Collection
    If ExternalExportFields.Wants(wanted, "dates") Then dates = CardDates.ReadDates(boardId, r!id)
    row.Add(DateValue(dates, "dueAt"), "due")
    row.Add(DateValue(dates, "startAt"), "start")
    row.Add(DateValue(dates, "endAt"), "end")
    cards.Add(row)
    numbers.Add(index, CStr(r!id))
    emptyLinks = New Variant[]
    linksByCard.Add(emptyLinks, CStr(r!id))
  Next
  For Each row In cards
    cardId = row["cardId"]
    If ExternalExportFields.Wants(wanted, "subtasks") Then
      related = db.Find("kb_entries", "board_id=&1 AND amount=&2 AND kind=&3 ORDER BY id", boardId, cardId, "subtask")
      If related.Available Then AddLinkPair(linksByCard, numbers, seenLinks, cardId, CInt(related!card_id), "is a child of", "is a parent of", ByRef nextLinkId)
    Endif
    If ExternalExportFields.Wants(wanted, "dependencies") Then
      related = db.Find("kb_entries", "board_id=&1 AND card_id=&2 AND kind=&3 ORDER BY id", boardId, cardId, "dependency")
      For Each related
        AddLinkPair(linksByCard, numbers, seenLinks, cardId, CInt(related!amount), "relates to", "relates to", ByRef nextLinkId)
      Next
    Endif
  Next
  For Each row In cards
    cardId = row["cardId"]
    task = New Collection
    task.Add(row["number"], "id")
    task.Add(row["title"], "title")
    task.Add(row["description"], "description")
    task.Add(row["column"], "column_name")
    task.Add(row["swimlane"], "swimlane_name")
    If row["due"] Then task.Add(row["due"], "date_due")
    If row["start"] Then task.Add(row["start"], "date_started")
    If row["end"] Then task.Add(row["end"], "date_completed")
    task.Add(row["tags"], "tags")
    If ExternalExportFields.Wants(wanted, "people") Then
      people = BoardAccess.Assignees(boardId, cardId)
      For Each person In BoardAccess.CardMembers(boardId, cardId)
        people.Add(person)
      Next
      If people.Count Then task.Add(people[0], "owner_username")
    Endif
    subtasks = New Variant[]
    If ExternalExportFields.Wants(wanted, "checklists") Then
      related = db.Exec("SELECT e.* FROM kb_entries e JOIN kb_entries p ON p.id=e.parent_id AND p.board_id=e.board_id AND p.card_id=e.card_id AND p.kind=&4 WHERE e.board_id=&1 AND e.card_id=&2 AND e.kind=&3 ORDER BY p.id,e.id", boardId, cardId, "checkitem", "checklist")
      For Each related
        item = New Collection
        item.Add(TextValue(related!title), "title")
        item.Add(If(CBool(related!done), 2, 0), "status")
        subtasks.Add(item)
      Next
    Endif
    If subtasks.Count Then task.Add(subtasks, "subtasks")
    comments = New Variant[]
    If ExternalExportFields.Wants(wanted, "comments") Then
      related = db.Find("kb_entries", "board_id=&1 AND card_id=&2 AND kind=&3 ORDER BY id", boardId, cardId, "comment")
      For Each related
        item = New Collection
        item.Add(TextValue(related!body), "comment")
        BoardAccess.RequireCard(boardId, cardId)
        item.Add(RetiredAuthors.DisplayName("entry", related!id, TextValue(related!author)), "username")
        If TypeOf(related!created_at) = gb.Date And Not IsNull(related!created_at) Then item.Add(CardDates.Iso(ItemChanges.Epoch(related!created_at)), "date_creation")
        comments.Add(item)
      Next
    Endif
    If comments.Count Then task.Add(comments, "comments")
    links = linksByCard[CStr(cardId)]
    If links.Count Then task.Add(links, "links")
    tasks.Add(task)
  Next
  data.Add(tasks, "tasks")
  Return JSON.Encode(data)
End
