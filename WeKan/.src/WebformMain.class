Private Sub ValidateBoardCreation()
  Dim allowed As Boolean = BoardCreation.Allowed()
  Dim canImport As Boolean = ImportExportPolicy.ImportAllowed()
  Dim admin As Boolean = WebDatabase.GetIsAdmin(WebIdentity.Username)
  BoardCreationSettings.Visible = admin
  If Not admin And BoardCreationPanel.Visible Then
    BoardCreationPanel.Hide()
    ImportExportPanel.Hide()
    MarkdownPanel.Hide()
    CreationAdminOnly.Value = False
    $creationBase = False
  Endif
  If admin And BoardCreationPanel.Visible And CreationAdminOnly.Value = $creationBase Then
    CreationAdminOnly.Value = BoardCreation.AdminOnly()
    $creationBase = CreationAdminOnly.Value
  Endif
  AddBoard.Visible = ViewMenu.Visible And allowed
  AddBoardTile.Visible = allowed
  NewBoard.Visible = allowed
  BoardTitle.Visible = allowed
  ImportBoard.Visible = allowed And canImport
  DuplicateSelectedBoards.Visible = IsOverview() And Not $archive And BoardSelection.Active(SelectionState()) And allowed And canImport
  If ContextMenu.Visible And $contextKind = "board" Then ContextCopy.Visible = allowed And canImport And BoardAccess.Can($contextBoard, "manageBoard") And BoardAccess.Can($contextBoard, "seesAllCards")
  If Not allowed Then BoardTitle.Text = ""
  If allowed And canImport Then Return
  SelectedCopyPanel.Hide()
  If ActionPanel.Visible And ($action = "Import" Or ($action = "Copy" And $contextKind = "board")) Then
    ActionPanel.Hide()
    ActionText.Text = ""
    $importText = ""
    ClearSingleCopy()
  Endif
  If $contextKind = "board" Then ContextCopy.Hide()
End

Private Sub ClearSingleCopy()
  $singleCopy = Null
  SingleCopyOptions.Hide()
End

