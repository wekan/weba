Public Sub AttachmentTransferSettings_Click()
  Dim data As Collection = TransferPolicy.Settings()
  LoadTransferSettings(data)
  ContentRow.Hide()
  PasswordPolicyPanel.Hide()
  BoardCreationPanel.Hide()
  ImportExportPanel.Hide()
  MarkdownPanel.Hide()
  PermanentDeletePanel.Hide()
  RecoveryPanel.Hide()
