End
Public Sub DetailUpload_Click()
  BoardAccess.RequireCard($detailsBoard, $detailsCard)
  BoardAccess.Require($detailsBoard, "write")
  TransferPolicy.RequireTransfer("attachmentsUpload", 0)
  If WorkspaceStore.Setting($detailsBoard, "board", $detailsBoard, "allowsAttachments", "1") <> "1" Then Error.Raise("Attachments are not allowed on this board")
  DetailUpload.Upload()
Catch
  Notice.Text = Error.Text
End
Public Sub DetailUpload_Finish()
  BoardAccess.RequireCard($detailsBoard, $detailsCard)
  BoardAccess.Require($detailsBoard, "write")
  TransferPolicy.RequireTransfer("attachmentsUpload", 0)
  TransferPolicy.RequireTransfer("attachmentsUpload", Stat(DetailUpload.Path).Size)
  CardContent.UploadFile($detailsBoard, $detailsCard, DetailUpload.File, File.Load(DetailUpload.Path))
  LoadDetails()
Catch
  Notice.Text = Error.Text
End
Public Sub DetailExport_Click()
  Dim outcome As Collection
  Dim data As Collection
  Dim text As String
  ImportExportPolicy.RequireExport()
  If Not DetailsPanel.Visible Then Error.Raise("Select attachment first")
  If DetailCode() <> "file" Or $attachmentHistory Or $fileId <= 0 Then Error.Raise("Select attachment first")
  outcome = AttachmentExport.ReadNative($detailsBoard, $detailsCard, CStr($fileId))
  If outcome["status"] <> 200 Then Error.Raise(outcome["data"]["error"])
  data = outcome["data"]
  text = JSON.Encode(data)
  WebForm.Exec("(function(){const a=document.createElement('a');a.href=URL.createObjectURL(new Blob([" & JS(text) & "],{type:'application/json'}));a.download='wekan-attachment.json';a.click();setTimeout(()=>URL.revokeObjectURL(a.href),1000);})();")
Catch
  Notice.Text = Error.Text
End

Private Sub UpdateAttachmentExportControl()
  Dim available As Boolean
  Dim enabled As Boolean
  If DetailsPanel.Visible Then
    If DetailCode() = "file" And Not $attachmentHistory And $fileId > 0 Then
      available = ImportExportPolicy.ExportAllowed() And BoardAccess.Can($detailsBoard, "seesAllCards")
    Endif
  Endif
  If available Then enabled = Not TransferPolicy.Blocked("attachmentsDownload")
  DetailExport.Visible = available
  DetailExport.Enabled = enabled
End

Public Sub DetailDownload_Click()
  Dim r As Result = CardContent.DownloadFile($detailsBoard, $detailsCard, $fileId)
  Dim data As String = Base64(r!content.Data)
  WebForm.Exec("(function(){const bytes=Uint8Array.from(atob(" & JS(data) & "),c=>c.charCodeAt(0));const a=document.createElement('a');a.href=URL.createObjectURL(new Blob([bytes],{type:'application/octet-stream'}));a.download=" & JS(r!filename) & ";a.click();setTimeout(()=>URL.revokeObjectURL(a.href),1000);})();")
Catch
  Notice.Text = Error.Text
End
