  $loadingTransfer = False
Catch
  $loadingTransfer = False
  Notice.Text = Error.Text
End

Private Sub LoadTransferSettings(data As Collection)
  $loadingTransfer = True
  LoadTransferField("attachmentsUpload", NativeUploadMode, NativeUploadValue, NativeUploadUnit, data)
  LoadTransferField("attachmentsDownload", NativeDownloadMode, NativeDownloadValue, NativeDownloadUnit, data)
  LoadTransferField("apiUpload", ApiUploadMode, ApiUploadValue, ApiUploadUnit, data)
  LoadTransferField("apiDownload", ApiDownloadMode, ApiDownloadValue, ApiDownloadUnit, data)
  $loadingTransfer = False
Catch
  $loadingTransfer = False
  Error.Propagate()
End

Private Sub LoadTransferField(kind As String, mode As WebComboBox, value As WebTextBox, unit As WebComboBox, data As Collection)
  Dim size As Float = data[kind & "MaxBytes"]
  Dim factor As Float = 1
  mode.List = ["Unlimited", "Maximum file size", "Blocked"]
  mode.Index = If(data[kind & "Blocked"], 2, If(size > 0, 1, 0))
  unit.List = ["GB", "MB", "Bytes"]
  unit.Index = TransferPolicy.DisplayUnit(size)
  factor = [1073741824, 1048576, 1][unit.Index]
  value.Text = Str(size / factor)
  ShowTransferField(mode, value, unit)
End

Private Sub ShowTransferField(mode As WebComboBox, value As WebTextBox, unit As WebComboBox)
  value.Parent.Visible = mode.Index = 1
  value.Visible = mode.Index = 1
  unit.Visible = mode.Index = 1
End

Public Sub NativeUploadMode_Click()
  If Not $loadingTransfer Then ShowTransferField(NativeUploadMode, NativeUploadValue, NativeUploadUnit)
End
Public Sub NativeDownloadMode_Click()
  If Not $loadingTransfer Then ShowTransferField(NativeDownloadMode, NativeDownloadValue, NativeDownloadUnit)
End
Public Sub ApiUploadMode_Click()
  If Not $loadingTransfer Then ShowTransferField(ApiUploadMode, ApiUploadValue, ApiUploadUnit)
End
Public Sub ApiDownloadMode_Click()
  If Not $loadingTransfer Then ShowTransferField(ApiDownloadMode, ApiDownloadValue, ApiDownloadUnit)
End

Private Sub AddTransferField(data As Collection, kind As String, mode As WebComboBox, value As WebTextBox, unit As WebComboBox)
  Dim field As Collection = TransferPolicy.FormLimit(mode.Index, value.Text, unit.Index)
  data.Add(field["maxBytes"], kind & "MaxBytes")
  data.Add(field["blocked"], kind & "Blocked")
End

Public Sub SaveTransferLimits_Click()
  Dim data As New Collection
  Dim current As Collection
  RecoveryStore.RequireAdmin()
  AddTransferField(data, "attachmentsUpload", NativeUploadMode, NativeUploadValue, NativeUploadUnit)
  AddTransferField(data, "attachmentsDownload", NativeDownloadMode, NativeDownloadValue, NativeDownloadUnit)
  AddTransferField(data, "apiUpload", ApiUploadMode, ApiUploadValue, ApiUploadUnit)
  AddTransferField(data, "apiDownload", ApiDownloadMode, ApiDownloadValue, ApiDownloadUnit)
  current = TransferPolicy.Settings()
  data.Add(current["avatarsUploadBlocked"], "avatarsUploadBlocked")
  TransferPolicy.Save(data)
  LoadTransferSettings(TransferPolicy.Settings())
  Notice.Text = "Attachment transfer limits saved."
Catch
  Notice.Text = Error.Text
End

Private Sub ValidateTransferPanel()
  AttachmentTransferSettings.Visible = WebDatabase.GetIsAdmin(WebIdentity.Username)
  If Not TransferLimitsPanel.Visible Then Return
  Try RecoveryStore.RequireAdmin()
  If Not Error Then Return
  TransferLimitsPanel.Hide()
  $loadingTransfer = True
  NativeUploadMode.Index = 0
  NativeDownloadMode.Index = 0
  ApiUploadMode.Index = 0
  ApiDownloadMode.Index = 0
  NativeUploadValue.Text = ""
  NativeDownloadValue.Text = ""
  ApiUploadValue.Text = ""
  ApiDownloadValue.Text = ""
  $loadingTransfer = False
End

