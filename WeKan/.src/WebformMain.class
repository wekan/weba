Private Sub UpdateCardActions()
  Dim permitted As Boolean = BoardAccess.Can($board, "write")
  Dim cardArchived As Boolean = $routeCard = $card And $routeCardBoard = $board And $routeCardArchived
  Dim writable As Boolean = permitted And Not cardArchived
  SaveCard.Enabled = writable
  ArchiveCard.Enabled = permitted And $card > 0
  ArchiveCard.Text = If(cardArchived Or $archive, "Restore", "Archive")
  NewCard.Enabled = permitted And Not $archive
  ArchiveBoard.Enabled = BoardAccess.Can($board, "manageBoard")
  CardTitle.ReadOnly = Not writable
  Description.ReadOnly = Not writable
  Assignee.ReadOnly = Not writable
  Labels.ReadOnly = Not writable
  Lane.ReadOnly = Not writable
  Status.ReadOnly = Not writable
  DueDay.ReadOnly = Not writable
  CardComments.Enabled = $card > 0
  CardChecklists.Enabled = $card > 0
  CardChecklistItems.Enabled = $card > 0
  CardSubtasks.Enabled = $card > 0
  CardDependencies.Enabled = $card > 0
  CardFields.Enabled = $card > 0
  CardTime.Enabled = $card > 0
  CardAttachments.Enabled = $card > 0
  CardMembersButton.Enabled = $card > 0
  CardAssigneesButton.Enabled = $card > 0
End

Private Function MemberRoles() As String[]
  Return ["board-admin", "normal", "normal-assigned-only", "no-comments", "comment-only", "comment-assigned-only", "worker", "read-only", "read-assigned-only"]
End

