Public Sub ContextArchive_Click()
  Dim row As Result
  If $contextKind = "board" Then
    $boardArchive = BoardArchive.Prepare($contextBoard)
    $boardArchiveContext = LandingContext()
    $boardArchiveHome = $board = $contextBoard And Not IsOverview()
    row = WorkspaceStore.Record($contextBoard, "board", $contextBoard)
    BoardArchiveName.Text = row!title
    ContextMenu.Hide()
    BoardArchivePanel.Show()
    Return
  Endif
  WorkspaceStore.SetArchived($contextBoard, $contextKind, $contextId, True)
  ContextMenu.Hide()
  If $contextKind = "card" And $board = $contextBoard Then
    ClearCardEditor()
    $navigationRevision += 1
    $navigationHome = False
  Else
    Editor.Hide()
  Endif
  If $contextKind = "board" And $board = $contextBoard Then $board = 0
  RefreshTree()
Catch
  Notice.Text = Error.Text
End
Public Sub ContextRestore_Click()
  Dim data As Collection
  If $contextKind = "board" Then
    BoardArchive.Restore($contextBoard)
    data = BoardRoute.Resolve(CStr($contextBoard))
    ContextMenu.Hide()
    ResetHome()
    $board = data["id"]
    $archive = False
    $view = PreferredBoardView()
    $card = 0
    $navigationHome = False
    $navigationRevision += 1
    RefreshTree()
    Return
  Endif
  WorkspaceStore.SetArchived($contextBoard, $contextKind, $contextId, False)
  ContextMenu.Hide()
  RefreshTree()
  If $browsingArchive Then ArchivedItems_Click()
Catch
  Notice.Text = Error.Text
End
Public Sub CloseBoardArchive_Click()
  $boardArchive = Null
  $boardArchiveContext = ""
  $boardArchiveHome = False
  BoardArchiveName.Text = ""
  BoardArchivePanel.Hide()
End

Public Sub CancelBoardArchive_Click()
  CloseBoardArchive_Click()
End

Private Sub ValidateBoardArchive()
  If Not $boardArchive Then Return
  Try BoardArchive.Validate($boardArchive)
  If Error Then
    CloseBoardArchive_Click()
    Return
  Endif
  If LandingContext() <> $boardArchiveContext Or $contextKind <> "board" Or $contextBoard <> $boardArchive["boardId"] Then CloseBoardArchive_Click()
End

Public Sub ConfirmBoardArchive_Click()
  Dim state As Collection = $boardArchive
  Dim goHome As Boolean = $boardArchiveHome
  If Not state Then Error.Raise("Board archive confirmation changed")
  If LandingContext() <> $boardArchiveContext Or $contextKind <> "board" Or $contextBoard <> state["boardId"] Then Error.Raise("Board archive confirmation changed")
  CloseBoardArchive_Click()
  BoardArchive.Confirm(state)
  If goHome Then
    $navigationHome = True
    $navigationRevision += 1
    Home_Click()
  Else
    RefreshTree()
  Endif
Catch
  Notice.Text = Error.Text
  CloseBoardArchive_Click()
End

