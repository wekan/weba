Private Sub ShowDetails(index As Integer, boardId As Integer, cardId As Integer)
  Dim r As Result = WorkspaceStore.Record(boardId, "card", cardId)
  $loadingDetails = True
  $detailsBoard = boardId
  $detailsCard = cardId
  $attachmentHistory = False
  DetailsTitle.Text = r!title
  DetailKind.List = ["Comments", "Checklists", "Checklist items", "Subtasks", "Dependencies", "Custom fields", "Time tracking", "Attachments"]
  DetailType.List = ["text", "number", "date", "checkbox"]
  DetailType.Index = 0
  DetailKind.Index = index
  ContextMenu.Hide()
  DetailsPanel.Show()
  $loadingDetails = False
  LoadDetails()
Catch
  $loadingDetails = False
  Error.Propagate()
End

Private Function DetailCode() As String
  Return ["comment", "checklist", "checkitem", "subtask", "dependency", "custom", "time", "file"][DetailKind.Index]
End

Private Sub RefreshLiveDetails()
  Dim data As Collection
  If $detailsCard <= 0 Then Return
  If Not DetailsPanel.Visible Then Return
  If Not OpenCardVisible($detailsBoard, $detailsCard, $archive) Then
    ValidateOpenCards()
    Return
  Endif
  data = DetailLive.Read($detailsBoard, $detailsCard, DetailCode(), $attachmentHistory)
  If JSON.Encode(data) <> $detailState Then LoadDetails(True, data)
Catch
  Notice.Text = "Card details refresh failed"
End

Private Function CurrentDetailParent() As Integer
  Dim id As Integer
  If DetailCode() <> "checkitem" Then Return 0
  If Not DetailParent.Text Then Return 0
  Try id = CInt(Split(DetailParent.Text, " | ")[0])
  If Error Then Return -1
  Return id
End

Private Sub SelectDetailParent(id As Integer)
  Dim index As Integer
  DetailParent.Index = -1
  If id <= 0 Then Return
  For index = 0 To DetailParent.List.Max
    If CInt(Split(DetailParent.List[index], " | ")[0]) = id Then
      DetailParent.Index = index
      Return
    Endif
  Next
End

Private Function DetailFormValues() As Collection
  Dim data As New Collection
  data.Add(DetailTitle.Text, "title")
  data.Add(DetailBody.Text, "body")
  data.Add(DetailNumber.Text, "amount")
  data.Add(DetailDone.Value, "done")
  data.Add(DetailType.Text, "value_type")
  data.Add(CurrentDetailParent(), "parent_id")
  Return data
End

Private Sub SetDetailField(field As String, value As Variant)
  Select field
    Case "title"
      DetailTitle.Text = CStr(value)
    Case "body"
      DetailBody.Text = CStr(value)
    Case "amount"
      DetailNumber.Text = CStr(value)
    Case "done"
      DetailDone.Value = CBool(value)
    Case "value_type"
      DetailType.Index = DetailType.List.Find(CStr(value))
    Case "parent_id"
      SelectDetailParent(CInt(value))
  End Select
End

Private Sub ClearDetailEditor()
  $entryId = 0
  $fileId = 0
  $attachmentHistoryId = 0
  $entryBaseline = Null
  DetailTitle.Text = ""
  DetailBody.Text = ""
  DetailNumber.Text = "0"
  DetailDone.Value = False
  $detailFormBase = DetailFormValues()
End

Private Function DetailRecord(data As Collection, id As Integer) As Collection
  Dim row As Collection
  For Each row In data["entries"]
    If row["entryId"] = id Then Return row
  Next
  For Each row In data["checklists"]
    If row["entryId"] = id Then Return row
  Next
  Return Null
End

Private Sub ShowEntry(data As Collection)
  Dim field As String
  For Each field In ["title", "body", "amount", "done", "value_type", "parent_id"]
    SetDetailField(field, data[field])
  Next
  $entryBaseline = data
  $detailFormBase = DetailFormValues()
End

Private Sub LoadDetails(Optional preserve As Boolean, Optional data As Collection)
  Dim row As Collection
  Dim selected As Collection
  Dim draft As Collection
  Dim baseline As Collection = $entryBaseline
  Dim formBase As Collection = $detailFormBase
  Dim checklists As New String[]
  Dim field As String
  Dim value As String
  Dim state As String
  Dim kind As String = DetailCode()
  Dim typeConflict As Boolean
  If Not data Then data = DetailLive.Read($detailsBoard, $detailsCard, kind, $attachmentHistory)
  If preserve Then draft = DetailFormValues()
  $loadingDetails = True
  state = JSON.Encode(data)
  DetailsTitle.Text = data["title"]
  DetailTree.Clear()
  For Each row In data["checklists"]
    checklists.Add(CStr(row["entryId"]) & " | " & row["title"])
    DetailTree.Add("e" & CStr(row["entryId"]), row["title"])
    DetailTree["e" & CStr(row["entryId"])].Expanded = True
  Next
  DetailParent.List = checklists
  If checklists.Count Then DetailParent.Index = 0
  For Each row In data["attachmentHistory"]
    DetailTree.Add("h" & CStr(row["id"]), If(row["action"] = "removed", "− ", "+ ") & row["filename"] & " · " & row["actor"])
  Next
  For Each row In data["files"]
    DetailTree.Add("f" & CStr(row["id"]), row["filename"])
  Next
  For Each row In data["entries"]
    value = row["title"]
    If kind = "comment" Then value = row["authorName"] & ": " & row["body"]
    If kind = "custom" Then value &= ": " & row["body"]
    If kind = "time" Then value &= " · " & Str(Round(row["amount"], -2)) & " min"
    If kind = "checkitem" Then
      value = If(row["done"], "[x] ", "[ ] ") & value
      DetailTree.Add("e" & CStr(row["entryId"]), value, "", "e" & CStr(row["parent_id"]))
    Else
      DetailTree.Add("e" & CStr(row["entryId"]), value)
    Endif
  Next
  If preserve And $entryId > 0 Then
    selected = DetailRecord(data, $entryId)
    If selected Then
      ShowEntry(selected)
      If baseline Then
        If formBase Then
          If baseline["kind"] = "custom" And selected["value_type"] <> baseline["value_type"] Then
            typeConflict = draft["body"] <> formBase["body"] Or draft["done"] <> formBase["done"]
          Endif
          For Each field In ["title", "body", "amount", "done", "value_type", "parent_id"]
            If draft[field] <> formBase[field] Or (field = "value_type" And typeConflict) Then
              SetDetailField(field, draft[field])
              EntryDraft.SetValue($entryBaseline, field, baseline[field])
              EntryDraft.SetValue($detailFormBase, field, formBase[field])
            Endif
          Next
        Endif
      Endif
      DetailTree.Key = "e" & CStr($entryId)
    Else
      ClearDetailEditor()
    Endif
  Else If preserve And $attachmentHistoryId > 0 Then
    If DetailTree.Exist("h" & CStr($attachmentHistoryId)) Then
      DetailTree.Key = "h" & CStr($attachmentHistoryId)
    Else
      ClearDetailEditor()
    Endif
  Else If preserve And $fileId > 0 Then
    If DetailTree.Exist("f" & CStr($fileId)) Then
      DetailTree.Key = "f" & CStr($fileId)
    Else
      ClearDetailEditor()
    Endif
  Else If preserve Then
    For Each field In ["title", "body", "amount", "done", "value_type", "parent_id"]
      SetDetailField(field, draft[field])
    Next
  Else
    ClearDetailEditor()
  Endif
  UpdateDetailControls()
  $detailState = state
  $loadingDetails = False
Catch
  $loadingDetails = False
  Error.Propagate()
End

Private Sub UpdateDetailControls()
  Dim kind As String = DetailCode()
  Dim editable As Boolean = BoardAccess.Can($detailsBoard, If(kind = "comment", "comment", "write"))
  DetailTitle.Visible = kind <> "file"
  DetailBody.Visible = kind = "comment" Or kind = "custom" Or kind = "time"
  DetailNumber.Visible = kind = "subtask" Or kind = "dependency" Or kind = "time"
  DetailDone.Visible = kind = "checkitem" Or kind = "custom"
  DetailType.Visible = kind = "custom"
  DetailParent.Visible = kind = "checkitem"
  DetailTitle.ReadOnly = Not editable
  If kind = "dependency" Then DetailTitle.ReadOnly = True
  If kind = "subtask" And $entryId > 0 Then DetailTitle.ReadOnly = True
  DetailBody.ReadOnly = Not editable
  DetailNumber.ReadOnly = Not editable
  DetailType.Enabled = editable
  DetailParent.Enabled = editable
  DetailDone.Enabled = editable
  DetailDelete.Visible = editable And Not $attachmentHistory
  DetailDelete.Enabled = $entryId > 0 Or $fileId > 0
  DetailSave.Visible = editable And kind <> "file"
  DetailNew.Visible = editable And kind <> "file"
  DetailStart.Visible = editable And kind = "time"
  DetailStop.Visible = editable And kind = "time"
  DetailUpload.Visible = editable And kind = "file" And Not $attachmentHistory And Not TransferPolicy.Blocked("attachmentsUpload") And WorkspaceStore.Setting($detailsBoard, "board", $detailsBoard, "allowsAttachments", "1") = "1"
  DetailDownload.Visible = kind = "file" And Not $attachmentHistory
  DetailDownload.Enabled = $fileId > 0 And Not TransferPolicy.Blocked("attachmentsDownload")
  UpdateAttachmentExportControl()
  DetailAttachmentHistory.Visible = kind = "file" And Not $attachmentHistory
  DetailLiveAttachments.Visible = kind = "file" And $attachmentHistory
  DetailRestoreAttachment.Visible = False
  If kind = "file" And $attachmentHistory And $attachmentHistoryId > 0 And editable Then
    DetailRestoreAttachment.Visible = AttachmentLifecycle.IsDeleted($detailsBoard, $detailsCard, $fileId)
  Endif
  If $entryId > 0 Then
    If $entryBaseline Then
      If $entryBaseline["kind"] = "comment" And $entryBaseline["author"] <> WebIdentity.Username And Not BoardAccess.Can($detailsBoard, "manageBoard") Then
        DetailSave.Hide()
        DetailDelete.Hide()
        DetailBody.ReadOnly = True
        DetailTitle.ReadOnly = True
      Endif
    Endif
  Endif
End

Public Sub DetailKind_Click()
  If $loadingDetails Then Return
  $attachmentHistory = False
  LoadDetails()
Catch
  Notice.Text = Error.Text
End

Public Sub DetailTree_Select()
  Dim r As Result
  If $loadingDetails Then Return
  If Not DetailTree.Key Then Return
  If Left(DetailTree.Key) = "h" Then
    If DetailCode() <> "file" Or Not $attachmentHistory Then Error.Raise("Choose attachment history")
    $attachmentHistoryId = CInt(Mid(DetailTree.Key, 2))
    r = AttachmentLifecycle.HistoryEntry($detailsBoard, $detailsCard, $attachmentHistoryId)
    $fileId = r!file_id
    $entryId = 0
    UpdateDetailControls()
    Return
  Endif
  If Left(DetailTree.Key) = "f" Then
    $fileId = CInt(Mid(DetailTree.Key, 2))
    UpdateDetailControls()
    Return
  Endif
  $entryId = CInt(Mid(DetailTree.Key, 2))
  $fileId = 0
  $loadingDetails = True
  r = CardContent.Entry($detailsBoard, $detailsCard, $entryId)
  DetailKind.Index = ["comment", "checklist", "checkitem", "subtask", "dependency", "custom", "time"].Find(r!kind)
  ShowEntry(EntryDraft.Read($detailsBoard, $detailsCard, $entryId))
  UpdateDetailControls()
  $loadingDetails = False
Catch
  $loadingDetails = False
  Notice.Text = Error.Text
End

Public Sub DetailNew_Click()
  ClearDetailEditor()
  UpdateDetailControls()
End

Public Sub DetailSave_Click()
  Dim parentId As Integer
  Dim kind As String = DetailCode()
  Dim number As Float
  If DetailNumber.Text Then number = CFloat(DetailNumber.Text)
  If kind = "checkitem" Then
    parentId = CurrentDetailParent()
    If parentId <= 0 Then Error.Raise("Choose a checklist")
  Endif
  If kind = "subtask" And number = 0 Then
    CardContent.NewSubtask($detailsBoard, $detailsCard, DetailTitle.Text)
  Else
    CardContent.Save($detailsBoard, $detailsCard, $entryId, kind, DetailTitle.Text, DetailBody.Text, parentId, DetailDone.Value, number, DetailType.Text, $entryBaseline)
  Endif
  LoadDetails()
  RefreshTree()
Catch
  Notice.Text = Error.Text
End

Public Sub DetailDelete_Click()
  If $attachmentHistory Then Error.Raise("Choose a live attachment")
  If DetailCode() = "file" Then
    CardContent.DeleteFile($detailsBoard, $detailsCard, $fileId)
  Else
    CardContent.DeleteEntry($detailsBoard, $detailsCard, $entryId)
  Endif
  LoadDetails()
Catch
  Notice.Text = Error.Text
End

Public Sub DetailStart_Click()
  CardContent.StartTimer($detailsBoard, $detailsCard)
  LoadDetails()
Catch
  Notice.Text = Error.Text
End
Public Sub DetailStop_Click()
  CardContent.StopTimer($detailsBoard, $detailsCard)
  LoadDetails()
Catch
