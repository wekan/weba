  If $selectedArchiveRevision < 0 Or $selectedArchiveRevision <> BoardSelection.Revision(SelectionState()) Then Error.Raise("Board selection changed")
  If Not SelectedArchiveConfirmation.Value Then Error.Raise("Confirm board archive")
  source = If($view = "Starred", "starred", If($spaceMenu > 0, "workspace", "remaining"))
  BoardSpaces.DropBoards(ids, "archive", 0, source)
  BoardSelection.Clear(SelectionState())
