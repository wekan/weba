End

Public Sub CardSubtasks_Click()
  ShowDetails(3, $board, $card)
Catch
  Notice.Text = Error.Text
End

Public Sub CardDependencies_Click()
  ShowDetails(4, $board, $card)
Catch
  Notice.Text = Error.Text
End

Public Sub CardFields_Click()
  ShowDetails(5, $board, $card)
Catch
  Notice.Text = Error.Text
End

Public Sub CardTime_Click()
  ShowDetails(6, $board, $card)
Catch
  Notice.Text = Error.Text
End

Public Sub CardAttachments_Click()
  ShowDetails(7, $board, $card)
Catch
  Notice.Text = Error.Text
End

Private Sub UpdateCardActions()
  Dim writable As Boolean = BoardAccess.Can($board, "write")
  SaveCard.Enabled = writable
  ArchiveCard.Enabled = writable And $card > 0
  NewCard.Enabled = writable And Not $archive
  ArchiveBoard.Enabled = BoardAccess.Can($board, "manageBoard")
  CardTitle.ReadOnly = Not writable
  Description.ReadOnly = Not writable
  Assignee.ReadOnly = Not writable
  Labels.ReadOnly = Not writable
  Lane.ReadOnly = Not writable
  Status.ReadOnly = Not writable
  DueDay.ReadOnly = Not writable
  CardComments.Enabled = $card > 0
  CardChecklists.Enabled = $card > 0
  CardChecklistItems.Enabled = $card > 0
  CardSubtasks.Enabled = $card > 0
  CardDependencies.Enabled = $card > 0
  CardFields.Enabled = $card > 0
  CardTime.Enabled = $card > 0
  CardAttachments.Enabled = $card > 0
  CardMembersButton.Enabled = $card > 0
  CardAssigneesButton.Enabled = $card > 0
End

Private Function MemberRoles() As String[]
  Return ["board-admin", "normal", "normal-assigned-only", "no-comments", "comment-only", "comment-assigned-only", "worker", "read-only", "read-assigned-only"]
End

Public Sub ContextMembers_Click()
  If $contextKind = "card" Then
    ContextMenu.Hide()
    OpenCardPeople($contextBoard, $contextId)
    Return
  Endif
  $membersBoard = $contextBoard
  MemberRole.List = ["Board administrator", "Normal", "Normal (assigned cards only)", "No comments", "Comment only", "Comment (assigned cards only)", "Worker", "Read only", "Read (assigned cards only)"]
  MemberRole.Index = 1
  MemberUsername.Text = ""
  ContextMenu.Hide()
  RefreshMembers()
  MembersPanel.Show()
Catch
  Notice.Text = Error.Text
End

Public Sub CardMembersButton_Click()
  OpenCardPeople($board, $card)
Catch
  Notice.Text = Error.Text
End

Public Sub CardAssigneesButton_Click()
  OpenCardPeople($board, $card, True)
Catch
  Notice.Text = Error.Text
End

Public Sub ContextAssignees_Click()
  ContextMenu.Hide()
  OpenCardPeople($contextBoard, $contextId, True)
Catch
  Notice.Text = Error.Text
End

Private Sub OpenCardPeople(boardId As Integer, cardId As Integer, Optional assignees As Boolean = False)
  $peopleBoard = boardId
  $peopleCard = cardId
  $peopleAssignees = assignees
  CardPeopleHeading.Text = If(assignees, "Assignee", "Members")
  RefreshCardPeople()
  CardPeoplePanel.Show()
End

Private Sub RefreshCardPeople()
  Dim r As Result = WorkspaceStore.Record($peopleBoard, "card", $peopleCard)
  Dim names As String[]
  Dim choices As New String[]
  Dim displayed As New Collection
  Dim username As String
  Dim writable As Boolean = BoardAccess.Can($peopleBoard, "write")
  If $peopleAssignees Then
    names = BoardAccess.Assignees($peopleBoard, $peopleCard)
  Else
    names = BoardAccess.CardMembers($peopleBoard, $peopleCard)
  Endif
  CardPeopleName.Text = r!title
  CardPeopleTree.Clear()
  For Each username In names
    If Not displayed.Exist(username) Then CardPeopleTree.Add(username, username)
    displayed[username] = True
  Next
  r = BoardAccess.Members($peopleBoard)
  For Each r
    If names.Find(r!username) < 0 Then choices.Add(r!username)
  Next
  CardPersonChoice.List = choices
  If choices.Count Then CardPersonChoice.Index = 0
  CardPersonChoice.Enabled = writable And choices.Count > 0
  AddCardPerson.Visible = writable
  AddCardPerson.Enabled = writable And choices.Count > 0
  RemoveCardPerson.Visible = writable
  RemoveCardPerson.Enabled = False
End

Public Sub CardPeopleTree_Select()
  RemoveCardPerson.Enabled = BoardAccess.Can($peopleBoard, "write") And Len(CardPeopleTree.Key) > 0
Catch
  Notice.Text = Error.Text
End

Public Sub AddCardPerson_Click()
  If $peopleAssignees Then
    BoardAccess.ChangeCardAssignee($peopleBoard, $peopleCard, CardPersonChoice.Text, True)
  Else
    BoardAccess.ChangeCardMember($peopleBoard, $peopleCard, CardPersonChoice.Text, True)
  Endif
  RefreshChangedCardPeople()
  Notice.Text = "Member saved"
Catch
  Notice.Text = Error.Text
End

Public Sub RemoveCardPerson_Click()
  If $peopleAssignees Then
    BoardAccess.ChangeCardAssignee($peopleBoard, $peopleCard, CardPeopleTree.Key, False)
  Else
    BoardAccess.ChangeCardMember($peopleBoard, $peopleCard, CardPeopleTree.Key, False)
  Endif
  RefreshChangedCardPeople()
  Notice.Text = "Member removed"
Catch
  Notice.Text = Error.Text
End

Private Sub RefreshChangedCardPeople()
  Dim r As Result
  Try BoardAccess.RequireCard($peopleBoard, $peopleCard)
  If Error Then
    CardPeoplePanel.Hide()
    Editor.Hide()
    $card = 0
  Else
    RefreshCardPeople()
    If $peopleAssignees And $board = $peopleBoard And $card = $peopleCard Then
      r = WorkspaceStore.Record($peopleBoard, "card", $peopleCard)
      Assignee.Text = r!assignee
      CardDraft.SetValue($draft, "assignee", CStr(r!assignee))
    Endif
  Endif
  RefreshTree()
End

Public Sub CloseCardPeople_Click()
  CardPeoplePanel.Hide()
End

Private Sub RefreshMembers()
  Dim r As Result
  Dim keys As String[] = MemberRoles()
  Dim index As Integer
  r = WorkspaceStore.Record($membersBoard, "board", $membersBoard)
  MemberBoardName.Text = r!title
  $memberOwner = r!owner
  MembersTree.Clear()
  r = BoardAccess.Members($membersBoard)
  For Each r
    index = keys.Find(r!role)
    If index < 0 Then Continue
    MembersTree.Add(r!username, r!username & " · " & MemberRole.List[index])
  Next
  UpdateMemberEditor()
End

Private Sub UpdateMemberEditor()
  Dim manager As Boolean = BoardAccess.Can($membersBoard, "manageBoard")
  MemberUsername.ReadOnly = Not manager
  MemberRole.Enabled = manager
  SaveMember.Visible = manager
  RemoveMember.Visible = manager
  UpdateMemberButtons()
End

Private Sub UpdateMemberButtons()
  Dim manager As Boolean = BoardAccess.Can($membersBoard, "manageBoard")
  SaveMember.Enabled = manager And MemberUsername.Text <> $memberOwner
  RemoveMember.Enabled = manager And MemberUsername.Text <> $memberOwner And Len(MemberUsername.Text) > 0
End

Public Sub MemberUsername_Change()
  UpdateMemberButtons()
End

Public Sub MembersTree_Select()
  Dim r As Result
  If Not MembersTree.Key Then Return
  MemberUsername.Text = MembersTree.Key
  r = BoardAccess.Members($membersBoard)
  For Each r
    If r!username = MembersTree.Key Then MemberRole.Index = MemberRoles().Find(r!role)
  Next
  UpdateMemberEditor()
Catch
  Notice.Text = Error.Text
End

Public Sub SaveMember_Click()
  If MemberRole.Index < 0 Or MemberRole.Index > MemberRoles().Max Then Error.Raise("Choose a role")
  BoardAccess.SetMember($membersBoard, Trim(MemberUsername.Text), MemberRoles()[MemberRole.Index])
  RefreshMembers()
  RefreshTree()
  Notice.Text = "Member saved"
Catch
  Notice.Text = Error.Text
End

Public Sub RemoveMember_Click()
  BoardAccess.RemoveMember($membersBoard, MemberUsername.Text)
  If Not BoardAccess.Role($membersBoard) Then
    MembersPanel.Hide()
    $board = 0
    $card = 0
    $view = "Boards"
  Else
    RefreshMembers()
  Endif
  RefreshTree()
  Notice.Text = "Member removed"
Catch
  Notice.Text = Error.Text
End

Public Sub CloseMembers_Click()
  MembersPanel.Hide()
End

Public Sub ContextAssignSelf_Click()
  Dim names As String[] = BoardAccess.Assignees($contextBoard, $contextId)
  Dim index As Integer = names.Find(WebIdentity.Username)
  If index < 0 Then
    names.Add(WebIdentity.Username)
  Else
    While names.Find(WebIdentity.Username) >= 0
      names.Remove(names.Find(WebIdentity.Username))
    Wend
  Endif
  BoardAccess.SetAssignees($contextBoard, $contextId, names)
  ContextMenu.Hide()
  Editor.Hide()
  RefreshTree()
Catch
  Notice.Text = Error.Text
End
