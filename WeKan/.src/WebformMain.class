Private Function WorkspaceNameTrim(text As String) As String
  Dim whitespace As Integer[] = [9, 10, 11, 12, 13, 32, 160, 5760, 8192, 8193, 8194, 8195, 8196, 8197, 8198, 8199, 8200, 8201, 8202, 8232, 8233, 8239, 8287, 12288, 65279]
  Dim leftIndex As Integer = 1
  Dim rightIndex As Integer = String.Len(text)
  While leftIndex <= rightIndex
    If whitespace.Find(String.Code(text, leftIndex)) < 0 Then Break
    Inc leftIndex
  Wend
  While rightIndex >= leftIndex
    If whitespace.Find(String.Code(text, rightIndex)) < 0 Then Break
    Dec rightIndex
  Wend
  If leftIndex > rightIndex Then Return ""
  Return String.Mid(text, leftIndex, rightIndex - leftIndex + 1)
End

Public Sub WorkspaceCreateAction_Change()
  Dim fields As String[] = Split(WorkspaceCreateAction.Text, "|")
  Dim revision As Long
  Dim name As String
  If fields.Count < 3 Then Error.Raise("Workspace form changed")
  If fields[0] = "create" Then
    If fields.Count <> 3 Or $workspaceEdit <> 0 Then Error.Raise("Workspace form changed")
  Else If fields[0] = "edit" Then
    If fields.Count <> 4 Or $workspaceEdit <= 0 Then Error.Raise("Workspace form changed")
  Else If fields[0] = "subspace" Then
    If fields.Count <> 3 Or $workspaceEdit <= 0 Then Error.Raise("Workspace form changed")
  Else
    Error.Raise("Workspace form changed")
  Endif
  If Not WorkspacePanel.Visible Then Error.Raise("Workspace form changed")
  revision = CLong(fields[1])
  If CStr(revision) <> fields[1] Or revision <> $workspaceRevision Then Error.Raise("Workspace form changed")
  If WebIdentity.Username <> $workspaceActor Or WebDatabase.SessionGeneration($workspaceActor) <> $workspaceGeneration Then Error.Raise("Sign in required")
  name = UnBase64(fields[2])
  If fields[0] = "subspace" Then name = WorkspaceNameTrim(name)
  If Trim(name) = "" Then
    If fields[0] = "subspace" Then
      Inc $workspaceRevision
      WorkspacePanel.Hide()
    Else
      WorkspaceName.SetFocus()
    Endif
    Return
  Endif
  If fields[0] = "edit" Then
    BoardSpaces.Edit($workspaceEdit, name, UnBase64(fields[3]))
  Else If fields[0] = "subspace" Then
    BoardSpaces.Add(name, $workspaceEdit)
  Else
    BoardSpaces.Add(name, $workspaceParent)
  Endif
  Inc $workspaceRevision
  WorkspacePanel.Hide()
  RefreshTree()
Catch
  Notice.Text = Error.Text
End

Public Sub DeleteWorkspace_Click()
  If $workspaceEdit <= 0 Then Error.Raise("Workspace not found")
  If Not ConfirmWorkspaceDelete.Value Then Return
  BoardSpaces.Remove($workspaceEdit)
  WorkspacePanel.Hide()
  RefreshTree()
Catch
  Notice.Text = Error.Text
End

Public Sub CloseWorkspace_Click()
  Inc $workspaceRevision
  WorkspacePanel.Hide()
End

Private Sub AddWorkspaceChoices(nodes As Variant[], prefix As String)
  Dim node As Collection
  Dim caption As String
  For Each node In nodes
    caption = prefix & CStr(node["name"])
    WorkspaceDestination.Add(caption)
    $workspaceChoices.Add(CInt(node["id"]))
    AddWorkspaceChoices(node["children"], caption & " / ")
  Next
End

Public Sub ContextWorkspace_Click()
  Dim assignments As Collection
  Dim selected As Integer
  If $contextKind <> "board" Then Error.Raise("Select a board first")
  BoardAccess.RequireRead($contextBoard)
  $workspaceBoard = $contextBoard
  BoardWorkspaceName.Text = WorkspaceStore.Record($workspaceBoard, "board", $workspaceBoard)!title
  WorkspaceDestination.Clear()
  WorkspaceDestination.Add("Remaining")
  $workspaceChoices.Clear()
  $workspaceChoices.Add(0)
  AddWorkspaceChoices(BoardSpaces.Tree(), "")
  assignments = BoardSpaces.Assignments()
  If assignments.Exist(CStr($workspaceBoard)) Then selected = CInt(assignments[CStr($workspaceBoard)])
  WorkspaceDestination.Index = Max(0, $workspaceChoices.Find(selected))
  CloseHeaderMenus()
  ContextMenu.Hide()
  WorkspacePanel.Hide()
  BoardWorkspacePanel.Show()
Catch
  Notice.Text = Error.Text
End

Public Sub SaveBoardWorkspace_Click()
  If WorkspaceDestination.Index < 0 Or WorkspaceDestination.Index >= $workspaceChoices.Count Then Error.Raise("Workspace not found")
  BoardSpaces.Assign($workspaceBoard, $workspaceChoices[WorkspaceDestination.Index])
  BoardWorkspacePanel.Hide()
  RefreshTree()
Catch
  Notice.Text = Error.Text
End

Public Sub CloseBoardWorkspace_Click()
  BoardWorkspacePanel.Hide()
End


Private Function SelectionState() As Collection
  If Not $boardSelection Then $boardSelection = BoardSelection.NewState()
  Return $boardSelection
End

Private Sub UpdateSelectionControls()
  Dim active As Boolean = BoardSelection.Active(SelectionState())
  MultiBoards.Visible = IsOverview()
  MultiBoards.Class = "weba-icon-only fa fa-check-square-o" & If(active, " weba-active", "")
  MultiBoards.Tooltip = "Multi-Selection"
  If active Then MultiBoards.Tooltip = "Multi-Selection is on"
  CloseMultiBoards.Visible = IsOverview() And active
  BoardSelectionControls.Visible = IsOverview() And active
  BoardSelectionPanel.Visible = IsOverview() And active And $overviewSidebar = "selection"
  BoardSearchPanel.Visible = IsOverview() And Not BoardSelectionPanel.Visible
  SelectedBoardsCount.Text = Str(BoardSelection.Count(SelectionState()))
  $purgeAllowed = RecoveryStore.CanPurge()
  PurgeSelectedBoards.Visible = IsOverview() And $archive And active And $purgeAllowed
  BoardSelectionHint.Text = "Click checkboxes to select boards"
  If IsOverview() And $archive And Not $purgeAllowed Then BoardSelectionHint.Text = "If at Admin Panel / Problems / Delete is checked Enable permanent delete for Global Admin then here will become visible button for Delete."
  If Not IsOverview() Or Not $archive Or Not active Or Not $purgeAllowed Or $selectedPurgeRevision <> BoardSelection.Revision(SelectionState()) Then CancelSelectedPurge_Click()
  ArchiveSelectedBoards.Visible = IsOverview() And Not $archive And active
  If Not IsOverview() Or $archive Or Not active Or $selectedArchiveRevision <> BoardSelection.Revision(SelectionState()) Then CancelSelectedArchive_Click()
  DuplicateSelectedBoards.Visible = IsOverview() And Not $archive And active And BoardCreation.Allowed() And ImportExportPolicy.ImportAllowed()
  If $selectedCopy Then
    If Not IsOverview() Or $archive Or Not active Or $selectedCopy["revision"] <> BoardSelection.Revision(SelectionState()) Then CancelSelectedCopy_Click()
  Endif
  ExportSelectedBoards.Visible = IsOverview() And Not $archive And active And ImportExportPolicy.ExportAllowed()
  If $selectedExport Then
    If Not IsOverview() Or $archive Or Not active Or BoardBatchExport.Revision($selectedExport) <> BoardSelection.Revision(SelectionState()) Then ClearSelectedExport()
  Endif
  HomeSelectedBoards.Visible = IsOverview() And Not $archive And active
  HomeSelectedBoards.Text = "Set as Home board (opened after login)"
  Try SetHomeCaption()
  StarSelectedBoards.Visible = IsOverview() And Not $archive And active
  StarSelectedBoards.Text = "Star the selected boards"
  Try SetSelectedStarCaption()
End

Private Sub SetHomeCaption()
  Dim ids As Integer[] = BoardSelection.Ids(SelectionState())
  If ids.Count = 1 Then
    If HomeBoard.Saved() = ids[0] Then HomeSelectedBoards.Text = "Unset as Home board"
  Endif
End

Public Sub HomeSelectedBoards_Click()
  Dim ids As Integer[]
  If Not IsOverview() Or $archive Then Error.Raise("Select active boards first")
  If Not BoardSelection.Active(SelectionState()) Then Error.Raise("Activate multi-selection first")
  ids = BoardSelection.Ids(SelectionState())
  If ids.Count <> 1 Then Error.Raise("Please select only one board")
  HomeBoard.Toggle(ids[0])
  RefreshTree()
Catch
  Notice.Text = Error.Text
End

Public Sub HomeBoards_Click()
