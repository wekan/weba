 ' Gambas class file

Export

Private $board As Integer
Private $listId As Integer
Private $card As Integer
Private $view As String = "Boards"
Private $boardTitle As String
Private $archive As Boolean

Public Sub WebForm_Open()
  If Not Session["username"] Then
    WebForm.Goto(WebformLogin)
    Return
  Endif
  Status.Text = "Todo"
  AccountToggle.Text = Session["username"]
  Admin.Visible = WebDatabase.GetIsAdmin(Session["username"])
  RefreshTree()
Catch
  Notice.Text = Error.Text
End

Private Sub RefreshTree()
  Dim b As Result
  Dim c As Result
  Boards.Clear()
  b = KanbanStore.Boards($archive)
  For Each b
    If b!id = $board Then $boardTitle = b!title
    Boards.Add("b" & b!id, b!title, "Icons/16x16/folder.png")
    c = KanbanStore.Cards(b!id, $archive)
    For Each c
      Boards.Add("c" & c!id & ":" & b!id, c!title, "Icons/16x16/doc.png", "b" & b!id)
    Next
  Next
  UpdateHeader()
  Visual.Refresh()
End

Public Sub Boards_Select()
  Dim parts As String[]
  Dim c As Result
  If Not Boards.Key Then Return
  $card = 0
  If Left(Boards.Key, 1) = "b" Then
    $board = CInt(Mid(Boards.Key, 2))
    Editor.Hide()
  Else
    parts = Split(Mid(Boards.Key, 2), ":")
    $card = CInt(parts[0])
    $board = CInt(parts[1])
    c = KanbanStore.Cards($board, $archive)
    For Each c
      If c!id <> $card Then Continue
      $listId = KanbanStore.CardListId($board, $card)
      CardTitle.Text = c!title
      Description.Text = c!description
      Lane.Text = c!lane
      Status.Text = c!status
      Assignee.Text = c!assignee
      Labels.Text = c!labels
      DueDay.Text = c!due_day
    Next
    Editor.Show()
  Endif
  If Left(Boards.Key, 1) = "b" Or $view = "Boards" Or $view = "Archive" Then $view = "Swimlanes"
  ContentRow.Show()
  AccountPanel.Hide()
  PasswordPolicyPanel.Hide()
  AdminPanel.Hide()
  PageActions.Show()
  RefreshTree()
Catch
  Notice.Text = Error.Text
End

Public Sub NewBoard_Click()
  KanbanStore.AddBoard(BoardTitle.Text)
  BoardTitle.Text = ""
  RefreshTree()
Catch
  Notice.Text = Error.Text
End

Public Sub NewCard_Click()
  Dim laneRows As Result
  Dim listRows As Result
  Dim found As Boolean
  If Not $board Then
    Notice.Text = "Select a board first"
    Return
  Endif
  laneRows = KanbanStore.Lanes($board)
  For Each laneRows
    listRows = KanbanStore.Lists($board, laneRows!title)
    If Not listRows.Available Then Continue
    Lane.Text = laneRows!title
    Status.Text = listRows!title
    $listId = listRows!id
    found = True
    Break
  Next
  If Not found Then
    Notice.Text = "Add a list first"
    Return
  Endif
  Editor.Show()
  $card = 0
  CardTitle.Text = ""
  Description.Text = ""
  Assignee.Text = Session["username"]
  Labels.Text = ""
  DueDay.Text = ""
End

Public Sub SaveCard_Click()
  $card = KanbanStore.SaveCard($board, $card, CardTitle.Text, Description.Text, Lane.Text, Status.Text, Assignee.Text, Labels.Text, DueDay.Text, $listId)
  Notice.Text = "Card saved"
  RefreshTree()
Catch
  Notice.Text = Error.Text
End

Public Sub ArchiveCard_Click()
  KanbanStore.ArchiveCard($board, $card, Not $archive)
  $card = 0
  RefreshTree()
Catch
  Notice.Text = Error.Text
End

Public Sub ArchiveBoard_Click()
  KanbanStore.ArchiveBoard($board, Not $archive)
  $board = 0
  RefreshTree()
Catch
  Notice.Text = Error.Text
End

Public Sub Logout_Click()
  Session.Abandon()
  WebForm.Goto(WebformLogin)
End

Public Sub Search_Click()
  Visual.Refresh()
End

Private Sub ShowView(view As String)
  AccountPanel.Visible = view = "Profile"
  AdminPanel.Visible = False
  PasswordPolicyPanel.Hide()
  If view = "Admin panel" Then AdminPanel.Visible = WebDatabase.GetIsAdmin(Session["username"])
  If view = "Profile" Then Fullname.Text = WebDatabase.GetFullname(Session["username"])
  $view = view
  ContentRow.Visible = view <> "Profile"
  PageActions.Visible = view <> "Profile" And view <> "Admin panel"
  Editor.Hide()
  Views.Hide()
  AccountMenu.Hide()
  UpdateHeader()
  Visual.Refresh()
End

Public Sub Home_Click()
  Editor.Hide()
  ContentRow.Show()
  PageActions.Show()
  Views.Hide()
  AccountMenu.Hide()
  AccountPanel.Hide()
  AdminPanel.Hide()
  PasswordPolicyPanel.Hide()
  $archive = False
  $board = 0
  $view = "Boards"
  RefreshTree()
End

Public Sub Archive_Click()
  Editor.Hide()
  ContentRow.Show()
  PageActions.Show()
  Views.Hide()
  AccountMenu.Hide()
  AccountPanel.Hide()
  AdminPanel.Hide()
  PasswordPolicyPanel.Hide()
  $archive = True
  $board = 0
  $view = "Archive"
  RefreshTree()
End

Public Sub Visual_Render()
  Dim b As Result
  Dim c As Result
  Dim a As Result
  Dim text As String
  Dim lane As Result
  Dim list As Result
  If Not Session["username"] Then Return
  Print "<script>" & File.Load(".public/kanban.js") & "</script>"
  Print "<link rel=\"stylesheet\" href=\"kanban.css\">"
  Print "<section data-drag=\"" & Html(DragAction.Name) & "\" data-board=\"" & Str($board) & "\" data-action=\"" & Html(BoardAction.Name) & "\" data-editable=\"" & If($board And Not $archive, "true", "false") & "\" class=\"weba-content\" data-tree=\"" & Html(Boards.Name) & "\" data-view=\"" & Html($view) & "\">"
  If $view = "Profile" Then
    Print "<p>Signed in as " & Html(Session["username"]) & "</p>"
  Else If $view = "Admin panel" Then
    If Not WebDatabase.GetIsAdmin(Session["username"]) Then Error.Raise("Administrator required")
    a = WebDatabase.GetUsers()
    Print "<table><tr><th>Username</th><th>Full name</th><th>Administrator</th></tr>"
    For Each a
      Print "<tr><td>" & Html(a!username) & "</td><td>" & Html(a!fullname) & "</td><td>" & Html(If(a!admin, "Admin", "Normal")) & "</td></tr>"
    Next
    Print "</table>"
  Else If $view = "Activities" And $board Then
    a = KanbanStore.Activities($board)
    For Each a
      Print "<p>" & Html(Str(a!created_at)) & " · " & Html(a!actor) & " · " & Html(a!message) & "</p>"
    Next
  Else
    b = KanbanStore.Boards($archive)
    If $board Then
      Print "<div class=\"weba-layout\" hidden>"
      lane = KanbanStore.Lanes($board)
      For Each lane
        Print "<section data-order=\"" & Str(KanbanStore.ItemOrder($board, "lane", lane!title, lane!id)) & "\" data-lane=\"" & Html(lane!title) & "\">"
        list = KanbanStore.Lists($board, lane!title)
        For Each list
          Print "<span data-list-id=\"" & Str(list!id) & "\" data-list=\"" & Html(list!title) & "\"></span>"
        Next
        Print "</section>"
      Next
      Print "</div>"
    Endif
    Print "<div class=\"weba-data\">"
    For Each b
      If $board And b!id <> $board Then Continue
      If Not $board And ($view = "Boards" Or $view = "Archive") Then
        Print "<button type=\"button\" class=\"weba-board-tile\" data-board-key=\"b" & Str(b!id) & "\"><strong>" & Html(b!title) & "</strong></button>"
        Continue
      Endif
      Print "<h3>" & Html(b!title) & "</h3>"
      c = KanbanStore.Cards(b!id, $archive)
      For Each c
        If $view = "My cards" And c!assignee <> Session["username"] Then Continue
        If $view = "Due cards" Then
          If Not c!due_day Then Continue
          If c!due_day > Format(Now, "yyyy-mm-dd") Then Continue
        Endif
        text = c!title & " " & c!description & " " & c!labels & " " & c!assignee
        If Filter.Text And InStr(LCase(text), LCase(Filter.Text)) = 0 Then Continue
        Print "<article data-list-id=\"" & Str(KanbanStore.CardListId(b!id, c!id)) & "\" data-order=\"" & Str(KanbanStore.ItemOrder(b!id, "card", CStr(c!id), c!id)) & "\" data-card-id=\"" & Str(c!id) & "\" class=\"weba-card\" data-card-key=\"c" & Str(c!id) & ":" & Str(b!id) & "\" data-status=\"" & Html(c!status) & "\" data-lane=\"" & Html(c!lane) & "\" data-due=\"" & Html(c!due_day) & "\">"
        Print "<strong>" & Html(c!title) & "</strong><p>" & Html(c!description) & "</p><small>" & Html(c!status) & " · " & Html(c!assignee) & " · " & Html(c!labels) & " · " & Html(c!due_day) & "</small></article>"
      Next
    Next
    Print "</div><div class=\"weba-report\"></div>"
  Endif
  Print "</section>"
  WebForm.Exec("window.webaRender && window.webaRender();gw.onFocus();window.webaAlignFocus && window.webaAlignFocus();")
Catch
  Print "<p role=\"alert\">" & Html(Error.Text) & "</p>"
End

Private Function Html(value As String) As String
  value = Replace(value, "&", "&amp;")
  value = Replace(value, "<", "&lt;")
  value = Replace(value, ">", "&gt;")
  value = Replace(value, "\"", "&quot;")
  Return Replace(value, "'", "&#39;")
End

