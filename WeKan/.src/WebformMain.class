Public Sub _HandleMessage()
  If Not WebIdentity.Username Then
    ' Reject before the native dispatcher decodes or invokes a stale command.
    ' Raising in WebForm_Event discards queued navigation and becomes an alert.
    Session.Abandon()
    WebForm.Goto(WebformLogin)
    Response.Buffered = True
    Response.ContentType = "text/javascript;charset=utf-8"
    Response.Begin
    Print "location.reload(true);"
    Response.End
    Return
  Endif
  If CGI["WEBA_NATIVE_PASSIVE"] = "1" Then
    Response.ContentType = "text/javascript;charset=utf-8"
    Response.Begin
    Response.End
    Return
  Endif
  Super._HandleMessage()
End

Private Function LandingContext() As String
  Return CStr($board) & "|" & $view & "|" & CStr($spaceMenu)
End

Private $dragHandleActor As String
Private $dragHandleGeneration As Long
Private $dragHandleRevision As Long
Private $dragHandleValue As String

Private Function DragHandleValue() As String
  Dim value As Variant = DragHandlePreference.Stored()
  If IsNull(value) Then Return "auto"
  Return If(value, "true", "false")
End

Private Sub RefreshDragHandlePreference()
  Dim value As String = DragHandleValue()
  If value = $dragHandleValue Then Return
  $dragHandleValue = value
  Inc $dragHandleRevision
  DragHandleState.Refresh()
  If $view = "Profile" Then DragHandleSettings.Refresh()
End

Public Sub DragHandleState_Render()
  Print "<span hidden data-weba-drag-preference=\"" & Html(DragHandleValue()) & "\"></span>"
End

Public Sub DragHandleSettings_Render()
  If $view <> "Profile" Or Not $dragHandleActor Then Return
  If WebIdentity.Username <> $dragHandleActor Or WebDatabase.SessionGeneration($dragHandleActor) <> $dragHandleGeneration Then Return
  Print "<button type=\"button\" role=\"checkbox\" class=\"weba-drag-preference-toggle\" data-command=\"" & Html(DragHandleAction.Name) & "\" data-revision=\"" & Str($dragHandleRevision) & "\" aria-checked=\"false\"><span data-caption=\"Show desktop drag handles\">Show desktop drag handles</span></button>"
End

Public Sub DragHandleAction_Change()
  Dim wire As String = DragHandleAction.Text
  Dim fields As String[]
  If Not wire Then Return
  DragHandleAction.Text = ""
  If Len(wire) > 64 Then Error.Raise("Error")
  fields = Split(wire, "|")
  If $view <> "Profile" Or Not $dragHandleActor Then Error.Raise("Error")
  If fields.Count <> 2 Then Error.Raise("Error")
  If fields[0] <> Str($dragHandleRevision) Then Error.Raise("Error")
  If fields[1] <> "true" And fields[1] <> "false" Then Error.Raise("Error")
  DragHandlePreference.Save(fields[1] = "true", $dragHandleActor, $dragHandleGeneration)
  RefreshDragHandlePreference()
  Notice.Text = "Saved"
Finally
  If wire Then
    Inc $dragHandleRevision
    DragHandleSettings.Refresh()
  Endif
Catch
  Notice.Text = "Error"
End

Public Sub _BeforeRender()
  ' Read the current CGI frame: Request's convenience properties may be cached.
  If CGI["REQUEST_METHOD"] = "GET" And CGI["PATH_INFO"] = "/" Then
    $landingConsumed = False
    $landingContext = LandingContext()
  Else If Not $landingContext Then
    $landingContext = LandingContext()
  Endif
  Super._BeforeRender()
End

Public Sub WebForm_Event()
  NativeCommands.ApplyLarge(Me)
End

Public Sub WebForm_Open()
  If Not WebIdentity.Username Then
    WebForm.Goto(WebformLogin)
    Return
  Endif
  $dragHandleValue = DragHandleValue()
  $boardSelection = BoardSelection.NewState()
  Status.Text = "Todo"
  $catalogSort = BoardCatalog.SortBy()
  UpdateCatalogSort()
  AccountToggle.Text = WebIdentity.Username
  Admin.Visible = WebDatabase.GetIsAdmin(WebIdentity.Username)
  RefreshTree()
Catch
  Notice.Text = Error.Text
End

Private Sub RefreshTree()
  Dim b As Result
  Dim c As Result
  Dim unavailable As Boolean
  Dim overviewSnapshot As String
  If $view = "Public" Then
    Boards.Clear()
    RefreshPublic(True)
    UpdateHeader()
    Return
  Endif
  If $board Then
    If Not BoardAccess.CanRead($board) Then
      unavailable = True
    Else
      unavailable = WorkspaceStore.Archived($board, "board", $board) <> $archive
    Endif
    If unavailable Then
      $board = 0
      ' ValidateOpenCards clears stale fields before resetting the card ID.
      $view = If($archive, "Archive", "Boards")
      Editor.Hide()
      DetailsPanel.Hide()
      MembersPanel.Hide()
      CardPeoplePanel.Hide()
      ContextMenu.Hide()
      ActionPanel.Hide()
    Endif
  Endif
  RefreshSpaces()
  ValidateDeleteListPanel()
  ValidateOpenCards()
  RefreshDeletedListPanel()
  If IsOverview() Then overviewSnapshot = BoardLive.Overview($archive)
  Boards.Clear()
  b = KanbanStore.Boards($archive, False, $board, True)
  For Each b
    If b!id = $board Then $boardTitle = b!title
    Boards.Add("b" & b!id, b!title, "Icons/16x16/folder.png")
    c = KanbanStore.Cards(b!id, $archive)
    For Each c
      Boards.Add("c" & c!id & ":" & b!id, c!title, "Icons/16x16/doc.png", "b" & b!id)
    Next
  Next
  UpdateHeader()
  UpdateCardActions()
  If IsOverview() Then $catalogData = LoadBoardOverview()
  Visual.Refresh()
  If IsOverview() Then $overviewState = overviewSnapshot
End

Public Sub BoardPoll_Timer()
  Dim state As String
  RefreshDragHandlePreference()
  If $view = "Public" Then
    RefreshPublic(False)
    Return
  Endif
  ValidateBoardArchive()
  ValidateRecoveryPanels()
  ValidateTransferPanel()
  ValidateBoardCreation()
  ValidateInstanceFeatures()
  ValidateImportExportPolicy()
  ValidateMarkdownPolicy()
  ValidateAttachmentAllowance()
  ValidateBoardVisibility()
  ValidateBoardViews()
  ValidateBoardCopy()
  ValidateDeleteListPanel()
  RefreshDeletedListPanel()
  If IsOverview() And $archive Then
    If RecoveryStore.CanPurge() <> $purgeAllowed Then RefreshCatalogVisual()
  Endif
  If RefreshSpaces() Then
    If IsOverview() Then
      RefreshTree()
    Else
      UpdateHeader()
    Endif
  Endif
  If $board = 0 Then RefreshViewPreference()
  If $board > 0 Then
    If $view <> "Profile" And $view <> "Admin panel" Then
      If Not BoardAccess.CanRead($board) Then
        RefreshTree()
        Return
      Endif
      RefreshViewPreference()
      state = BoardLive.State($board, $archive)
      If state <> $liveState Then RefreshTree()
    Endif
  Else If IsOverview() Then
    If BoardCatalog.SortBy() <> $catalogSort Then
      $catalogSort = BoardCatalog.SortBy()
      $catalogPage = 1
      UpdateCatalogSort()
      RefreshTree()
    Endif
    state = BoardLive.Overview($archive)
    If state <> $overviewState Then RefreshTree()
  Endif
  If $routeCard > 0 And $card > 0 Then
    If Not OpenCardVisible($board, $card, $archive) Then
      ValidateOpenCards()
      UpdateHeader()
    Endif
  Endif
  RefreshLiveDetails()
  RefreshLiveCardPeople()
  RefreshLiveMembers()
Catch
  Notice.Text = "Board refresh failed"
End

Private Function IsOverview() As Boolean
  Return $board = 0 And ($view = "Boards" Or $view = "Archive" Or $view = "Starred" Or $view = "Home")
End

Private Function OpenCardVisible(boardId As Integer, cardId As Integer, archived As Boolean) As Boolean
  Dim row As Result
  If $routeCard = cardId And $routeCardBoard = boardId And $card = cardId And $board = boardId Then
    ' An explicit card subscription is not filtered by the grid's archive state.
    BoardAccess.RequireCard(boardId, cardId)
    row = WorkspaceStore.Record(boardId, "card", cardId)
    $routeCardArchived = CBool(row!archived)
    Return True
  Endif
  Return BoardLive.Visible(boardId, cardId, archived)
Catch
  Return False
End

Private Sub ValidateOpenCards()
  If $workspaceBoard > 0 And BoardWorkspacePanel.Visible Then
    If Not BoardAccess.CanRead($workspaceBoard) Then
      BoardWorkspacePanel.Hide()
      BoardWorkspaceName.Text = ""
      WorkspaceDestination.Clear()
      $workspaceChoices.Clear()
      $workspaceBoard = 0
    Endif
  Endif
  If $card > 0 Then
    If Not OpenCardVisible($board, $card, $archive) Then
      $card = 0
      Editor.Hide()
      $draft = Null
      CardTitle.Text = ""
      Description.Text = ""
      Assignee.Text = ""
      Labels.Text = ""
      DueDay.Text = ""
    Endif
  Endif
  If $detailsCard > 0 Then
    If Not OpenCardVisible($detailsBoard, $detailsCard, $archive) Then
      $detailsCard = 0
      DetailsPanel.Hide()
      DetailTree.Clear()
      DetailTitle.Text = ""
      DetailBody.Text = ""
    Endif
  Endif
  If $peopleCard > 0 Then
    If Not OpenCardVisible($peopleBoard, $peopleCard, $archive) Then
      CloseStaleCardPeople()
    Endif
  Endif
  If $contextKind = "card" Then
    If Not OpenCardVisible($contextBoard, $contextId, $archive) Then
      $contextId = 0
      $contextKind = ""
      ContextMenu.Hide()
      ActionPanel.Hide()
    Endif
  Endif
End

Public Sub Boards_Select()
  Dim previousBoard As Integer = $board
  Dim parts As String[]
  Dim c As Result
  If Not Boards.Key Then Return
  CloseBoardArchive_Click()
  $landingConsumed = True
  $routeCard = 0
  $routeCardBoard = 0
  $card = 0
  If Left(Boards.Key, 1) = "b" Then
    $board = CInt(Mid(Boards.Key, 2))
    Editor.Hide()
  Else
    parts = Split(Mid(Boards.Key, 2), ":")
    $card = CInt(parts[0])
    $board = CInt(parts[1])
    LoadCardDraft()
    Editor.Show()
  Endif
  UpdateCardActions()
  If Left(Boards.Key, 1) = "b" Or $view = "Boards" Or $view = "Archive" Or $board <> previousBoard Then $view = PreferredBoardView()
  ContentRow.Show()
  AccountPanel.Hide()
  PasswordPolicyPanel.Hide()
  BoardCreationPanel.Hide()
  ClearInstanceFeatures()
  ImportExportPanel.Hide()
  MarkdownPanel.Hide()
  TransferLimitsPanel.Hide()
  PermanentDeletePanel.Hide()
  RecoveryPanel.Hide()
  AdminPanel.Hide()
  PageActions.Show()
  RefreshTree()
Catch
  Notice.Text = Error.Text
End

Private Sub LoadCardDraft()
  $draft = CardDraft.Read($board, $card)
  $routeCard = $card
  $routeCardBoard = $board
  $routeCardArchived = WorkspaceStore.Archived($board, "card", $card)
  $listId = $draft["listId"]
  CardTitle.Text = $draft["title"]
  Description.Text = $draft["description"]
  Lane.Text = $draft["lane"]
  Status.Text = $draft["status"]
  Assignee.Text = $draft["assignee"]
  Labels.Text = $draft["labels"]
  DueDay.Text = $draft["due_day"]
End

Public Sub NewBoard_Click()
  If $view = "Public" Then Error.Raise("Public boards are read-only")
  KanbanStore.AddBoard(BoardTitle.Text)
  BoardTitle.Text = ""
  RefreshTree()
Catch
  Notice.Text = Error.Text
End

Public Sub NewCard_Click()
  Dim hadCard As Boolean = $card > 0
  Dim laneRows As Result
  Dim listRows As Result
  Dim found As Boolean
  If Not $board Then
    Notice.Text = "Select a board first"
    Return
  Endif
  laneRows = KanbanStore.Lanes($board)
  For Each laneRows
    listRows = KanbanStore.Lists($board, laneRows!title)
    If Not listRows.Available Then Continue
    Lane.Text = laneRows!title
    Status.Text = listRows!title
    $listId = listRows!id
    found = True
    Break
  Next
  If Not found Then
    Notice.Text = "Add a list first"
    Return
  Endif
  ClearCardEditor()
  Editor.Show()
  If hadCard Then
    $navigationRevision += 1
    $navigationHome = False
  Endif
  UpdateCardActions()
  CardTitle.Text = ""
  Description.Text = ""
  Assignee.Text = WebIdentity.Username
  Labels.Text = ""
  DueDay.Text = ""
  UpdateHeader()
End

Public Sub SaveCard_Click()
  $card = KanbanStore.SaveCard($board, $card, CardTitle.Text, Description.Text, Lane.Text, Status.Text, Assignee.Text, Labels.Text, DueDay.Text, $listId, $draft)
  If OpenCardVisible($board, $card, $archive) Then
    LoadCardDraft()
  Else
    Editor.Hide()
    $card = 0
    $draft = Null
  Endif
  UpdateCardActions()
  Notice.Text = "Card saved"
  RefreshTree()
Catch
  Notice.Text = Error.Text
End

Public Sub ArchiveCard_Click()
  Dim restoring As Boolean = If($routeCard = $card And $routeCardBoard = $board, $routeCardArchived, $archive)
  KanbanStore.ArchiveCard($board, $card, Not restoring)
  If restoring Then
    $routeCardArchived = False
  Else
    ' The source archive action closes its card and navigates to the board.
    ClearCardEditor()
    $navigationRevision += 1
    $navigationHome = False
  Endif
  UpdateCardActions()
  RefreshTree()
Catch
  Notice.Text = Error.Text
End

Public Sub ArchiveBoard_Click()
  KanbanStore.ArchiveBoard($board, Not $archive)
  $board = 0
  RefreshTree()
Catch
  Notice.Text = Error.Text
End

Public Sub Logout_Click()
  NativeAuth.Logout()
  Session.Abandon()
  WebForm.Goto(WebformLogin)
End

Private Function LoadBoardOverview() As Collection
  Dim params As New Collection
  Dim data As Collection
  Dim lastPage As Integer
  params.Add(BoardSearch.Text, "search")
  params["sortBy"] = $catalogSort
  params["menu"] = If($view = "Starred", "starred", "remaining")
  If $view <> "Starred" And $spaceMenu > 0 Then params["menu"] = CStr($spaceMenu)
  If $view = "Boards" And $spaceMenu < 0 Then params["menu"] = "workspaces"
  If $view = "Archive" Then params["menu"] = "archive"
  If $view = "Home" Then params["menu"] = "home"
  params["page"] = $catalogPage
  If $catalogSort = "custom" Then
    data = BoardCatalog.Unpaged(params, $archive)
  Else
    data = BoardCatalog.Page(params, $archive)
    lastPage = Max(1, Int((data["total"] + 24) / 25))
    If $catalogPage > lastPage Then
      $catalogPage = lastPage
      params["page"] = $catalogPage
      data = BoardCatalog.Page(params, $archive)
    Endif
  Endif
  If $view = "Starred" Then data["ids"] = HomeBoard.PresentStarred(data["ids"], BoardSearch.Text)
  $catalogTotal = data["total"]
  lastPage = Max(1, Int(($catalogTotal + 24) / 25))
  BoardPageLabel.Text = Str($catalogPage) & " / " & Str(lastPage) & " · " & Str($catalogTotal)
  PreviousBoardPage.Enabled = $catalogPage > 1
  NextBoardPage.Enabled = $catalogPage < lastPage
  BoardPagination.Visible = IsOverview() And $catalogSort <> "custom"
  BoardPagination.Class = "weba-board-pagination" & If(BoardPagination.Visible, " boards-pagination", "")
  Return data
End

Private Sub UpdateCatalogSort()
  SortCustom.Class = "js-boards-sort fa fa-arrows" & If($catalogSort = "custom", " weba-active active", "")
  SortTitleAsc.Class = "js-boards-sort fa fa-sort-alpha-asc" & If($catalogSort = "title-asc", " weba-active active", "")
  SortTitleDesc.Class = "js-boards-sort fa fa-sort-alpha-desc" & If($catalogSort = "title-desc", " weba-active active", "")
End

Private Sub ChooseCatalogSort(value As String)
  BoardCatalog.SetSortBy(value)
  $catalogSort = value
  $catalogPage = 1
  UpdateCatalogSort()
  BoardSortMenu.Hide()
  RefreshTree()
End

