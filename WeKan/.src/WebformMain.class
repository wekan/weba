Public Sub ContextExport_Click()
  Dim text As String = WorkspaceStore.ExportData($contextBoard, $contextKind, $contextId)
  WebForm.Exec("(function(){const b=new Blob([" & JS(text) & "],{type:'application/json'});const a=document.createElement('a');a.href=URL.createObjectURL(b);a.download='weba-export.json';a.click();setTimeout(()=>URL.revokeObjectURL(a.href),1000);})();")
  ContextMenu.Hide()
Catch
