Public Sub BoardSelectionAction_Change()
  Dim wire As String
  Dim fields As String[]
  Dim data As Collection
  Dim ids As Integer[]
  If Not BoardSelectionAction.Text Then Return
  wire = BoardSelectionAction.Text
  BoardSelectionAction.Text = ""
  If Not IsOverview() Then Error.Raise("Select All Boards first")
  fields = Split(wire, "|")
  If fields.Count <> 2 Or fields[0] <> "toggle" Then Error.Raise("Invalid board selection")
  data = LoadBoardOverview()
  ids = data["ids"]
  BoardSelection.Toggle(SelectionState(), CInt(UnBase64(fields[1])), ids)
  RefreshCatalogVisual()
Catch
