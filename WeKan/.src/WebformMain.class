Public Sub ActionConfirm_Click()
  Dim r As Result
  Dim destination As Integer
  Dim afterRef As String
  Dim oldTitle As String
  Select $action
    Case "Import"
      $board = BoardTransfer.ImportData($importText, ActionText.Text)
      $importText = ""
      $view = PreferredBoardView()
      $archive = False
    Case "Delete"
      If $contextKind = "board" Then Error.Raise("Use Archive multi-selection to delete boards")
      WorkspaceActions.DeleteArchived($contextBoard, $contextKind, $contextId, ActionText.Text)
      If $contextKind = "board" And $board = $contextBoard Then $board = 0
      ItemBrowser.Hide()
      Editor.Hide()
      DetailsPanel.Hide()
    Case "Add list"
      If $contextKind = "list" Then
        r = WorkspaceStore.Record($contextBoard, "list", $contextId)
        If r!lane = DestinationLane.Text Then afterRef = "#" & CStr($contextId)
      Endif
      KanbanStore.AddList($contextBoard, DestinationLane.Text, ActionText.Text, afterRef)
    Case "Add swimlane"
      KanbanStore.AddLane($contextBoard, ActionText.Text)
    Case "Rename"
      r = WorkspaceStore.Record($contextBoard, $contextKind, $contextId)
      oldTitle = r!title
      WorkspaceStore.Rename($contextBoard, $contextKind, $contextId, ActionText.Text)
      If $contextKind = "lane" And Lane.Text = oldTitle Then
        Lane.Text = ActionText.Text
        CardDraft.SetValue($draft, "lane", Lane.Text)
      Endif
      If $contextKind = "list" And $listId = $contextId Then
        Status.Text = ActionText.Text
        CardDraft.SetValue($draft, "status", Status.Text)
      Endif
      If $contextKind = "card" And $card = $contextId Then
        CardTitle.Text = ActionText.Text
        CardDraft.SetValue($draft, "title", CardTitle.Text)
      Endif
    Case "Copy"
      If $contextKind = "board" Then
        BoardAccess.Require($contextBoard, "manageBoard")
        BoardCreation.Require()
        ImportExportPolicy.RequireImport()
        If Not ActionPanel.Visible Then Error.Raise("Copy form changed")
        destination = SingleBoardCopy.Copy($singleCopy, $contextBoard, ActionText.Text)
        $board = destination
        $card = 0
        $draft = Null
        Editor.Hide()
        $view = PreferredBoardView()
        $archive = False
      Else
        If $singleCopy Or Not ActionPanel.Visible Then Error.Raise("Copy form changed")
        WorkspaceStore.Copy($contextBoard, $contextKind, $contextId, ActionText.Text, DestinationLane.Text)
      Endif
    Case "Color"
      WorkspaceStore.SetSetting($contextBoard, $contextKind, $contextId, "color", ActionText.Text)
    Case "WIP"
      WorkspaceStore.SetSetting($contextBoard, $contextKind, $contextId, "wip", ActionText.Text)
      WorkspaceStore.SetSetting($contextBoard, $contextKind, $contextId, "wip_strict", If(ActionFlag.Value, "1", "0"))
    Case "Allow attachments"
      If $contextKind <> "board" Then Error.Raise("Board setting required")
      WorkspaceStore.SetSetting($contextBoard, "board", $contextBoard, "allowsAttachments", If(ActionFlag.Value, "1", "0"))
    Case "Description"
      WorkspaceStore.SetSetting($contextBoard, $contextKind, $contextId, "description", ActionText.Text)
    Case "Move"
      r = WorkspaceStore.Record($contextBoard, $contextKind, $contextId)
      If TargetBoard() <> $contextBoard Then
        If $contextKind = "card" Then destination = CInt(Split(DestinationList.Text, " | ")[0])
        WorkspaceActions.Move($contextBoard, $contextKind, $contextId, TargetBoard(), DestinationLane.Text, destination)
        Editor.Hide()
        DetailsPanel.Hide()
      Else
      Select $contextKind
        Case "card"
          destination = CInt(Split(DestinationList.Text, " | ")[0])
          KanbanStore.MoveCard($contextBoard, $contextId, DestinationLane.Text, "#" & CStr(destination), 0)
          If $card = $contextId Then
            r = KanbanStore.GetList($contextBoard, "#" & CStr(destination), DestinationLane.Text)
            Lane.Text = DestinationLane.Text
            Status.Text = r!title
            $listId = destination
            CardDraft.SetValue($draft, "lane", Lane.Text)
            CardDraft.SetValue($draft, "status", Status.Text)
            If $draft Then $draft["listId"] = $listId
          Endif
        Case "list"
          KanbanStore.MoveList($contextBoard, r!lane, "#" & CStr($contextId), DestinationLane.Text, "")
          If $listId = $contextId Then
            Lane.Text = DestinationLane.Text
            CardDraft.SetValue($draft, "lane", Lane.Text)
          Endif
        Case "lane"
          KanbanStore.MoveLane($contextBoard, r!title, DestinationLane.Text)
      End Select
      Endif
    Case Else
      Error.Raise("Unknown menu action")
  End Select
  ActionPanel.Hide()
  ClearSingleCopy()
  Notice.Text = "Saved"
  RefreshTree()
Catch
  Notice.Text = Error.Text
End

