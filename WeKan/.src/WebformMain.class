Private Sub CheckDeletedListContext()
  If Not DeletedListsPanel.Visible Or $deletedListBoard <= 0 Or $board <> $deletedListBoard Then Error.Raise("Select a deleted list first")
  If $view = "Profile" Or $view = "Admin panel" Then Error.Raise("Select a deleted list first")
  BoardAccess.Require($deletedListBoard, "write")
End

Private Sub RefreshDeletedListPanel()
  Dim r As Result
  Dim rows As New Variant[]
  Dim row As Collection
  Dim state As String
  Dim selected As Boolean
  If Not DeletedListsPanel.Visible Then Return
  CheckDeletedListContext()
  r = ListDeletion.DeletedLists($deletedListBoard)
  For Each r
    row = New Collection
    row["id"] = r!id
    row.Add(CStr(r!title), "title")
    row["batch"] = r!batch_id
    row["at"] = r!deleted_at
    rows.Add(row)
  Next
  state = JSON.Encode(rows)
  If state <> $deletedListsState Then
    DeletedListTree.Clear()
    For Each row In rows
      DeletedListTree.Add("deleted-list:" & Str(row["id"]), CStr(row["title"]))
    Next
    $deletedListsState = state
  Endif
  For Each row In rows
    If row["id"] <> $deletedListId Then Continue
    selected = True
    If $deletedListBatch <> row["batch"] Then
      $deletedPurgeBatch = 0
      DeletedListPurgeConfirmed.Value = False
      DeletedListPurgePanel.Hide()
    Endif
    $deletedListBatch = row["batch"]
    SelectedDeletedList.Text = CStr(row["title"])
    If DeletedListTree.Key <> "deleted-list:" & Str($deletedListId) Then DeletedListTree.Key = "deleted-list:" & Str($deletedListId)
  Next
  If Not selected Then
    $deletedListId = 0
    $deletedListBatch = 0
    SelectedDeletedList.Text = ""
  Endif
  RestoreDeletedList.Visible = selected
  PurgeDeletedList.Visible = selected And RecoveryStore.CanPurge()
  If Not PurgeDeletedList.Visible Then
    $deletedPurgeBatch = 0
    DeletedListPurgeConfirmed.Value = False
    DeletedListPurgePanel.Hide()
  Endif
Catch
  CloseDeletedLists_Click()
End

Public Sub DeletedListTree_Select()
  Dim fields As String[]
  CheckDeletedListContext()
  fields = Split(DeletedListTree.Key, ":")
  If fields.Count <> 2 Or fields[0] <> "deleted-list" Then Error.Raise("Select a deleted list first")
  $deletedListId = CInt(fields[1])
  $deletedPurgeBatch = 0
  DeletedListPurgeConfirmed.Value = False
  DeletedListPurgePanel.Hide()
  RefreshDeletedListPanel()
Catch
  Notice.Text = Error.Text
End

Public Sub RestoreDeletedList_Click()
  CheckDeletedListContext()
  RefreshDeletedListPanel()
  If $deletedListId <= 0 Then Error.Raise("Select a deleted list first")
  ListDeletion.Restore($deletedListBoard, $deletedListId)
  RefreshTree()
Catch
  Notice.Text = Error.Text
End

Public Sub PurgeDeletedList_Click()
  CheckDeletedListContext()
  RecoveryStore.RequirePurge()
  RefreshDeletedListPanel()
  If $deletedListId <= 0 Then Error.Raise("Select a deleted list first")
  $deletedPurgeBatch = $deletedListBatch
  DeletedListPurgeConfirmed.Value = False
  DeletedListPurgePanel.Show()
Catch
  Notice.Text = Error.Text
End

Public Sub ConfirmDeletedListPurge_Click()
  CheckDeletedListContext()
  RecoveryStore.RequirePurge()
  If $deletedListId <= 0 Or $deletedPurgeBatch <= 0 Or $deletedPurgeBatch <> $deletedListBatch Then Error.Raise("List deletion changed")
  If Not DeletedListPurgeConfirmed.Value Then Error.Raise("Confirm permanent list deletion")
  WorkspaceActions.PurgeList($deletedListBoard, $deletedListId, $deletedPurgeBatch)
  $deletedPurgeBatch = 0
  DeletedListPurgeConfirmed.Value = False
  DeletedListPurgePanel.Hide()
  RefreshTree()
Catch
  Notice.Text = Error.Text
End

