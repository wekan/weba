  ImportExportPolicy.Save(DisableAllImport.Value, DisableAllExport.Value)
  $exchangeImportBase = DisableAllImport.Value
  $exchangeExportBase = DisableAllExport.Value
  Notice.Text = "Saved"
  ValidateBoardCreation()
  ValidateImportExportPolicy()
  ValidateMarkdownPolicy()
  ValidateBoardCopy()
Catch
  Notice.Text = Error.Text
