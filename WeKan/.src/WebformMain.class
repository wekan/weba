  Dim data As Collection = MarkdownPolicy.Settings()
  AlwaysShowCodeAsText.Value = data["alwaysShowCodeAsText"]
  $markdownRawBase = AlwaysShowCodeAsText.Value
  data = MarkdownPolicy.UrlSettings()
  MarkdownSchemes.Text = data["automaticLinkedUrlSchemes"]
  $markdownSchemesBase = MarkdownSchemes.Text
  LoadExternalLinks(ExternalLinkPolicy.Settings())
  ContentRow.Hide()
  BoardCreationPanel.Hide()
  ClearInstanceFeatures()
  PasswordPolicyPanel.Hide()
  TransferLimitsPanel.Hide()
  PermanentDeletePanel.Hide()
  RecoveryPanel.Hide()
