Private Sub OpenCardPeople(boardId As Integer, cardId As Integer, Optional assignees As Boolean = False)
  $peopleBoard = boardId
  $peopleCard = cardId
  $peopleAssignees = assignees
  CardPeopleHeading.Text = If(assignees, "Assignee", "Members")
  RefreshCardPeople()
  CardPeoplePanel.Show()
End

Private Sub CloseStaleCardPeople()
  CardPeoplePanel.Hide()
  CardPeopleTree.Clear()
  CardPersonChoice.List = New String[]
  CardPeopleName.Text = ""
  $peopleCard = 0
  $peopleState = ""
End

Private Sub RefreshLiveCardPeople()
  Dim data As Collection
  If $peopleCard <= 0 Then Return
  If Not CardPeoplePanel.Visible Then Return
  If Not BoardLive.Visible($peopleBoard, $peopleCard, $archive) Then
    CloseStaleCardPeople()
    ValidateOpenCards()
    Return
  Endif
  data = PeopleLive.Card($peopleBoard, $peopleCard, $peopleAssignees)
  If JSON.Encode(data) <> $peopleState Then RefreshCardPeople(True, data)
Catch
  Notice.Text = "Card people refresh failed"
End

Private Sub RefreshCardPeople(Optional preserve As Boolean, Optional data As Collection)
  Dim names As String[]
  Dim choices As New String[]
  Dim displayed As New Collection
  Dim row As Collection
  Dim username As String
  Dim selected As String = CardPeopleTree.Key
  Dim choice As String = CardPersonChoice.Text
  Dim writable As Boolean
  Dim state As String
  If Not data Then data = PeopleLive.Card($peopleBoard, $peopleCard, $peopleAssignees)
  state = JSON.Encode(data)
  writable = data["write"]
  names = data["names"]
  $loadingPeople = True
  CardPeopleName.Text = data["title"]
  CardPeopleTree.Clear()
  For Each username In names
    If Not displayed.Exist(username) Then CardPeopleTree.Add(username, username)
    displayed[username] = True
  Next
  For Each row In data["roster"]["rows"]
    username = row["username"]
    If names.Find(username) < 0 Then choices.Add(username)
  Next
  CardPersonChoice.List = choices
  If preserve Then
    CardPersonChoice.Index = choices.Find(choice)
    If CardPeopleTree.Exist(selected) Then CardPeopleTree.Key = selected
  Else If choices.Count Then
    CardPersonChoice.Index = 0
  Endif
  CardPersonChoice.Enabled = writable And choices.Count > 0
  AddCardPerson.Visible = writable
  AddCardPerson.Enabled = writable And CardPersonChoice.Index >= 0
  RemoveCardPerson.Visible = writable
  RemoveCardPerson.Enabled = writable And Len(CardPeopleTree.Key) > 0
  $loadingPeople = False
  $peopleState = state
Catch
  $loadingPeople = False
  Error.Propagate()
End

Public Sub CardPersonChoice_Click()
  If $loadingPeople Then Return
  BoardAccess.RequireCard($peopleBoard, $peopleCard)
  AddCardPerson.Enabled = BoardAccess.Can($peopleBoard, "write") And CardPersonChoice.Index >= 0
Catch
  Notice.Text = Error.Text
End

Public Sub CardPeopleTree_Select()
  If $loadingPeople Then Return
  BoardAccess.RequireCard($peopleBoard, $peopleCard)
  RemoveCardPerson.Enabled = BoardAccess.Can($peopleBoard, "write") And Len(CardPeopleTree.Key) > 0
Catch
  Notice.Text = Error.Text
End

Public Sub AddCardPerson_Click()
  If $peopleAssignees Then
    BoardAccess.ChangeCardAssignee($peopleBoard, $peopleCard, CardPersonChoice.Text, True)
  Else
    BoardAccess.ChangeCardMember($peopleBoard, $peopleCard, CardPersonChoice.Text, True)
  Endif
  RefreshChangedCardPeople()
  Notice.Text = "Member saved"
Catch
  Notice.Text = Error.Text
End

Public Sub RemoveCardPerson_Click()
  If $peopleAssignees Then
    BoardAccess.ChangeCardAssignee($peopleBoard, $peopleCard, CardPeopleTree.Key, False)
  Else
    BoardAccess.ChangeCardMember($peopleBoard, $peopleCard, CardPeopleTree.Key, False)
  Endif
  RefreshChangedCardPeople()
  Notice.Text = "Member removed"
Catch
  Notice.Text = Error.Text
End

Private Sub RefreshChangedCardPeople()
  Dim r As Result
  Try BoardAccess.RequireCard($peopleBoard, $peopleCard)
  If Error Then
    CloseStaleCardPeople()
    ValidateOpenCards()
  Else
    RefreshCardPeople()
    If $peopleAssignees And $board = $peopleBoard And $card = $peopleCard Then
      r = WorkspaceStore.Record($peopleBoard, "card", $peopleCard)
      Assignee.Text = r!assignee
      CardDraft.SetValue($draft, "assignee", CStr(r!assignee))
    Endif
  Endif
  RefreshTree()
End

Public Sub CloseCardPeople_Click()
  CardPeoplePanel.Hide()
End

Private Sub CloseStaleMembers()
  MembersPanel.Hide()
  MembersTree.Clear()
  MemberUsername.Text = ""
  $memberFormUser = ""
  $membersState = ""
End

Private Sub RefreshLiveMembers()
  Dim data As Collection
  If $membersBoard <= 0 Then Return
  If Not MembersPanel.Visible Then Return
  If Not BoardAccess.Role($membersBoard) Then
    CloseStaleMembers()
    If $board = 0 Then RefreshTree()
    Return
  Endif
  data = PeopleLive.Roster($membersBoard)
  If JSON.Encode(data) <> $membersState Then RefreshMembers(True, data)
Catch
  Notice.Text = "Board members refresh failed"
End

Private Sub RefreshMembers(Optional preserve As Boolean, Optional data As Collection)
  Dim row As Collection
  Dim keys As String[] = MemberRoles()
  Dim selected As String = MembersTree.Key
  Dim target As String = MemberUsername.Text
  Dim roleIndex As Integer = MemberRole.Index
  Dim currentRole As Integer = -1
  Dim index As Integer
  Dim pristine As Boolean = target = $memberFormUser And roleIndex = $memberFormRole
  Dim state As String
  If Not data Then data = PeopleLive.Roster($membersBoard)
  state = JSON.Encode(data)
  $loadingMembers = True
  MemberBoardName.Text = data["title"]
  $memberOwner = data["owner"]
  MembersTree.Clear()
  For Each row In data["rows"]
    index = keys.Find(row["role"])
    If index < 0 Then Continue
    MembersTree.Add(row["username"], row["username"] & " · " & MemberRole.List[index])
    If row["username"] = target Then currentRole = index
  Next
  If preserve Then
    If MembersTree.Exist(selected) Then MembersTree.Key = selected
    If Len($memberFormUser) > 0 Then
      If target = $memberFormUser And currentRole < 0 Then
        MemberUsername.Text = ""
        MemberRole.Index = 1
        $memberFormUser = ""
        $memberFormRole = 1
      Else If pristine And currentRole >= 0 Then
        MemberRole.Index = currentRole
        $memberFormRole = currentRole
      Endif
    Endif
  Else
    If currentRole >= 0 Then
      MemberRole.Index = currentRole
      $memberFormUser = target
      $memberFormRole = currentRole
    Else
      MemberUsername.Text = ""
      MemberRole.Index = 1
      $memberFormUser = ""
      $memberFormRole = 1
    Endif
  Endif
  UpdateMemberEditor()
  $loadingMembers = False
  $membersState = state
Catch
  $loadingMembers = False
  Error.Propagate()
End

Private Sub UpdateMemberEditor()
  Dim manager As Boolean = BoardAccess.Can($membersBoard, "manageBoard")
  MemberUsername.ReadOnly = Not manager
  MemberRole.Enabled = manager
  SaveMember.Visible = manager
  RemoveMember.Visible = manager
  UpdateMemberButtons()
End

Private Sub UpdateMemberButtons()
  Dim manager As Boolean = BoardAccess.Can($membersBoard, "manageBoard")
  SaveMember.Enabled = manager And MemberUsername.Text <> $memberOwner And Len(MemberUsername.Text) > 0
  RemoveMember.Enabled = manager And MemberUsername.Text <> $memberOwner And Len(MemberUsername.Text) > 0
End

Public Sub MemberUsername_Change()
  UpdateMemberButtons()
End

Public Sub MembersTree_Select()
  Dim r As Result
  If $loadingMembers Then Return
  If Not MembersTree.Key Then Return
  MemberUsername.Text = MembersTree.Key
  r = BoardAccess.Members($membersBoard)
  For Each r
    If r!username = MembersTree.Key Then MemberRole.Index = MemberRoles().Find(r!role)
  Next
  $memberFormUser = MemberUsername.Text
  $memberFormRole = MemberRole.Index
  UpdateMemberEditor()
Catch
  Notice.Text = Error.Text
End

Public Sub SaveMember_Click()
  If MemberRole.Index < 0 Or MemberRole.Index > MemberRoles().Max Then Error.Raise("Choose a role")
  BoardAccess.SetMember($membersBoard, Trim(MemberUsername.Text), MemberRoles()[MemberRole.Index])
  RefreshMembers()
  RefreshTree()
  Notice.Text = "Member saved"
Catch
  Notice.Text = Error.Text
End

Public Sub RemoveMember_Click()
  BoardAccess.RemoveMember($membersBoard, MemberUsername.Text)
  If Not BoardAccess.Role($membersBoard) Then
    CloseStaleMembers()
  Else
    RefreshMembers()
  Endif
  RefreshTree()
  Notice.Text = "Member removed"
Catch
  Notice.Text = Error.Text
End

