Private Sub ValidateImportExportPolicy()
  Dim admin As Boolean = WebDatabase.GetIsAdmin(WebIdentity.Username)
  ImportExportSettings.Visible = admin
  If Not admin Then
    ImportExportPanel.Hide()
    MarkdownPanel.Hide()
    DisableAllImport.Value = False
    DisableAllExport.Value = False
    $exchangeImportBase = False
    $exchangeExportBase = False
  Endif
  If admin And ImportExportPanel.Visible Then
    If DisableAllImport.Value = $exchangeImportBase Then
      DisableAllImport.Value = Not ImportExportPolicy.ImportAllowed()
      $exchangeImportBase = DisableAllImport.Value
    Endif
    If DisableAllExport.Value = $exchangeExportBase Then
      DisableAllExport.Value = Not ImportExportPolicy.ExportAllowed()
      $exchangeExportBase = DisableAllExport.Value
    Endif
  Endif
  If ContextMenu.Visible Then ContextExport.Visible = ImportExportPolicy.ExportAllowed() And ($contextKind = "card" Or BoardAccess.Can($contextBoard, "seesAllCards"))
  UpdateAttachmentExportControl()
End

Public Sub MarkdownSettings_Click()
  Dim data As Collection = MarkdownPolicy.Settings()
  AlwaysShowCodeAsText.Value = data["alwaysShowCodeAsText"]
  $markdownRawBase = AlwaysShowCodeAsText.Value
  data = MarkdownPolicy.UrlSettings()
  MarkdownSchemes.Text = data["automaticLinkedUrlSchemes"]
  $markdownSchemesBase = MarkdownSchemes.Text
  LoadExternalLinks(ExternalLinkPolicy.Settings())
  ContentRow.Hide()
  BoardCreationPanel.Hide()
  PasswordPolicyPanel.Hide()
  TransferLimitsPanel.Hide()
  PermanentDeletePanel.Hide()
  RecoveryPanel.Hide()
