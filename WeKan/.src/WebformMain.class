Public Sub ArchiveSelectedBoards_Click()
  If Not IsOverview() Or $archive Then Error.Raise("Select active boards first")
  BoardSelection.ActionIds(SelectionState())
  $selectedArchiveRevision = BoardSelection.Revision(SelectionState())
  SelectedArchiveConfirmation.Value = False
