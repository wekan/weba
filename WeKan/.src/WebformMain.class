Private Sub LoadCopyOptions()
  ApplyCopyOptionButtons(BoardCopies.Options($selectedCopy), [CopySwimlanes, CopyLists, CopyCards, CopyLabels, CopyFields, CopyChecklists, CopyComments, CopyAttachments])
End

Private Sub ApplyCopyOptionButtons(options As Collection, buttons As WebButton[])
  Dim fields As String[] = ["swimlanes", "lists", "cards", "labels", "customFields", "checklists", "comments", "attachments"]
  Dim i As Integer
  Dim button As WebButton
  For i = 0 To fields.Max
    button = buttons[i]
    button.Class = "weba-copy-option fa " & If(options[fields[i]], "fa-check-square-o weba-active", "fa-square-o")
    WebForm.Exec("(function(){const el=document.getElementById(" & JS(button.Name) & ");if(el){el.setAttribute('role','checkbox');el.setAttribute('aria-checked'," & JS(If(options[fields[i]], "true", "false")) & ");}})();")
  Next
End

Private Sub ToggleCopyOption(field As String)
  BoardCopies.SetOptions($selectedCopy, SelectionState(), CopyOptions.Toggle(BoardCopies.Options($selectedCopy), field))
  LoadCopyOptions()
Catch
  Notice.Text = Error.Text
End

