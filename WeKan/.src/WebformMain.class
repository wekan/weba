  If BoardSelection.Active(SelectionState()) Then
    CloseMultiBoards_Click()
    Return
  Endif
  BoardSelection.SetActive(SelectionState(), True)
  $overviewSidebar = "selection"
  PageSidebar.Show()
  CloseHeaderMenus()
  RefreshCatalogVisual()
End

Public Sub CloseMultiBoards_Click()
  BoardSelection.SetActive(SelectionState(), False)
  $overviewSidebar = "search"
