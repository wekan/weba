Public Sub PasswordLength_Click()
  If Not WebDatabase.GetIsAdmin(Session["username"]) Then Error.Raise("Administrator required")
  PolicyEnforce.Value = WebDatabase.PasswordLengthEnforced()
  PolicyMinimum.Text = Str(WebDatabase.PasswordMinLength())
  ContentRow.Hide()
  PaneTitle.Text = "Password Length"
  PasswordPolicyPanel.Show()
Catch
  Notice.Text = Error.Text
End

Public Sub SavePasswordPolicy_Click()
  If Not IsInteger(PolicyMinimum.Text) Then Error.Raise("Enter a minimum from 1 to 256")
  WebDatabase.SetPasswordPolicy(PolicyEnforce.Value, CInt(PolicyMinimum.Text))
  Notice.Text = "Password length settings saved"
Catch
  Notice.Text = Error.Text
End

Private Sub UpdateHeader()
  Dim b As Result
  Dim overview As Boolean = Not $board And ($view = "Boards" Or $view = "Archive")
  ViewMenu.Visible = $view <> "Profile" And $view <> "Admin panel"
  AddBoard.Visible = ViewMenu.Visible
  HeaderSearch.Visible = ViewMenu.Visible
  Remaining.Class = If($view = "Boards", "weba-active", "")
  Archive.Class = If($view = "Archive", "weba-active", "")
  BoardNavigation.Visible = $view <> "Admin panel"
  AdminNavigation.Visible = $view = "Admin panel"
  OverviewActions.Visible = overview And Not $archive
  ContentRow.Expand = Not overview
  PaneTitle.Text = If($view = "Boards", "Remaining", $view)
  PageTitle.Text = If($view = "Boards", "All Boards", $view)
  If $board And $view <> "Profile" And $view <> "Admin panel" Then
    b = KanbanStore.Boards($archive)
    For Each b
      If b!id = $board Then PageTitle.Text = b!title
    Next
  Endif
  PageTitle.Tooltip = PageTitle.Text
  ViewMenu.Text = If($view = "Boards", "View", $view)
End

