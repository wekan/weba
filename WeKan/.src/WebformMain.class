Private Sub RunSelectedExport(format As String)
  Dim files As Variant[]
  If Not IsOverview() Or $archive Then Error.Raise("Select active boards first")
  ImportExportPolicy.RequireExport()
  BoardSelection.ActionIds(SelectionState())
  If $selectedExport Then
    If BoardBatchExport.Format($selectedExport) <> format Then $selectedExport = Null
  Endif
  If Not $selectedExport Then $selectedExport = BoardBatchExport.NewBatch(SelectionState(), format)
  BoardBatchExport.Run($selectedExport, SelectionState())
  files = BoardBatchExport.Files($selectedExport)
  If format = "excel" Then
    WebForm.Exec("webaBatchExport.downloadWorkbook('" & Base64(JSON.Encode(files)) & "');")
  Else
    WebForm.Exec("webaBatchExport.downloadPayload('" & Base64(JSON.Encode(files)) & "','wekan-boards-" & format & ".zip');")
  Endif
  ClearSelectedExport()
Catch
  Notice.Text = Error.Text
  SelectedExportPanel.Show()
  If $selectedExport Then SelectedExportProgress.Text = "Completed: " & Str(BoardBatchExport.Completed($selectedExport)) & "; remaining: " & Str(BoardBatchExport.Remaining($selectedExport))
End

