  MembersPanel.Hide()
End

Public Sub ContextAssignSelf_Click()
  Dim names As String[] = BoardAccess.Assignees($contextBoard, $contextId)
  Dim index As Integer = names.Find(WebIdentity.Username)
  If index < 0 Then
    names.Add(WebIdentity.Username)
  Else
    While names.Find(WebIdentity.Username) >= 0
      names.Remove(names.Find(WebIdentity.Username))
    Wend
  Endif
  BoardAccess.SetAssignees($contextBoard, $contextId, names)
  ContextMenu.Hide()
  Editor.Hide()
  RefreshTree()
Catch
  Notice.Text = Error.Text
End


' Personal workspace controls; raw names/icons stay text until sanitized viewer rendering.
Private Function RefreshSpaces() As Boolean
  Dim tree As Variant[] = BoardSpaces.Tree()
  Dim state As String
  Dim row As WebContainer
  $spaceCollapsed = BoardSpaces.Collapsed()
  $spaceCounts = BoardSpaces.Counts()
  state = CStr(HomeBoard.Saved()) & ":" & CStr(HomeBoard.Visible()) & ":" & JSON.Encode(tree) & JSON.Encode(BoardSpaces.Assignments()) & JSON.Encode($spaceCollapsed) & JSON.Encode($spaceCounts)
  If state = $spacesState Then Return False
  For Each row In $spaceRows
    row.Delete()
  Next
  $spaceRows.Clear()
  $spaceButtons.Clear()
  $spaceCarets.Clear()
  $spaceHandles.Clear()
  $spaceNames.Clear()
  IndexSpaceNames(tree)
  AddSpaceRows(tree, 0)
  If $spaceMenu > 0 And Not $spaceNames.Exist(CStr($spaceMenu)) Then
    $spaceMenu = -1
    $catalogPage = 1
  Endif
  If $workspaceEdit > 0 And Not $spaceNames.Exist(CStr($workspaceEdit)) Then WorkspacePanel.Hide()
  If $workspaceParent > 0 And Not $spaceNames.Exist(CStr($workspaceParent)) Then WorkspacePanel.Hide()
  UpdateSpaceSelection()
  $spacesState = state
  Return True
End

Private Sub IndexSpaceNames(nodes As Variant[])
  Dim node As Collection
  For Each node In nodes
    $spaceNames[node["id"]] = CStr(node["name"])
    IndexSpaceNames(node["children"])
  Next
End

Public Sub CollapsePersonalWorkspace_Click()
  Dim id As Integer = Last.Tag
  Dim caret As WebButton
  BoardSpaces.SetCollapsed(id, InStr(Last.Class, "fa-caret-down") > 0)
  RefreshSpaces()
  If $spaceCarets.Exist(CStr(id)) Then
    caret = $spaceCarets[CStr(id)]
    caret.SetFocus()
  Endif
Catch
  Notice.Text = Error.Text
End

Private Sub AddSpaceRows(nodes As Variant[], depth As Integer, Optional parentId As Integer)
  Dim node As Collection
  Dim row As WebContainer
  Dim indent As WebContainer
  Dim button As WebButton
  Dim menu As WebButton
  Dim caption As String
  Dim iconSource As WebLabel
  Dim caret As WebButton
  Dim count As WebLabel
  Dim handle As WebButton
  Dim folded As Boolean
  For Each node In nodes
    row = New WebContainer(WorkspaceRows)
    row.Arrangement = Arrange.Horizontal
    row.Class = "weba-space-row weba-space-id-" & CStr(node["id"]) & " weba-space-parent-" & Str(parentId)
    $spaceRows.Add(row)
    If depth > 0 Then
      indent = New WebContainer(row)
      indent.Width = Str(Min(depth, 8) * 12) & "px"
      indent.Class = "weba-space-indent"
    Endif
    folded = $spaceCollapsed.Exist(CStr(node["id"]))
    If node["children"].Count > 0 Then
      caret = New WebButton(row) As "CollapsePersonalWorkspace"
      caret.Tag = CInt(node["id"])
      caret.Class = "weba-icon-only weba-space-collapse fa fa-caret-" & If(folded, "right", "down")
      caret.Tooltip = If(folded, "Uncollapse", "Collapse")
      $spaceCarets[node["id"]] = caret
    Else
      indent = New WebContainer(row)
      indent.Class = "weba-space-collapse-spacer"
    Endif
    handle = New WebButton(row)
    handle.Class = "weba-drag-handle weba-space-drag fa fa-arrows"
    handle.Tooltip = "Move"
    handle.Visible = IsOverview()
    $spaceHandles[node["id"]] = handle
    caption = CStr(node["name"])
    iconSource = New WebLabel(row)
    iconSource.Text = CStr(node["icon"])
    iconSource.Class = "weba-space-icon-source weba-user-text"
    iconSource.Visible = False
    iconSource = New WebLabel(row)
    iconSource.Text = Replace(JSON.Encode(CStr(node["iconColor"])), " ", "\\u0020")
    iconSource.Class = "weba-space-icon-color weba-user-text"
    iconSource.Visible = False
    button = New WebButton(row) As "OpenPersonalWorkspace"
    button.Text = caption
    button.Tooltip = CStr(node["name"])
    button.Tag = CInt(node["id"])
    button.Class = "weba-space-open weba-user-text"
    button.Expand = True
    $spaceButtons[node["id"]] = button
    menu = New WebButton(row) As "PersonalWorkspaceMenu"
    menu.Tag = CInt(node["id"])
    menu.Class = "weba-icon-only fa fa-bars weba-space-menu"
    menu.Tooltip = "Workspace menu"
    count = New WebLabel(row)
    count.Text = Str($spaceCounts[CStr(node["id"])])
    count.Class = "weba-space-count"
    If Not folded Then AddSpaceRows(node["children"], depth + 1, CInt(node["id"]))
  Next
End

Private Sub UpdateSpaceSelection()
  Dim key As String
  Dim button As WebButton
  For Each key In $spaceHandles.Keys
    button = $spaceHandles[key]
    button.Visible = IsOverview()
  Next
  For Each key In $spaceButtons.Keys
    button = $spaceButtons[key]
    button.Class = "weba-space-open weba-user-text" & If(IsOverview() And $view = "Boards" And CInt(key) = $spaceMenu, " weba-active", "")
  Next
End

Public Sub OpenPersonalWorkspace_Click()
