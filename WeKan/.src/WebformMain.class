  ApplyCopyOptionButtons(SingleBoardCopy.Options($singleCopy, $contextBoard), [SingleCopySwimlanes, SingleCopyLists, SingleCopyCards, SingleCopyLabels, SingleCopyFields, SingleCopyChecklists, SingleCopyComments, SingleCopyAttachments])
