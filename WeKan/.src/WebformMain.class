Public Sub ImportBoard_Click()
  If $view = "Public" Then Error.Raise("Public boards are read-only")
  BoardCreation.Require()
  ImportExportPolicy.RequireImport()
  ImportBoard.Upload()
Catch
  Notice.Text = Error.Text
