Public Sub ClearBoardSearch_Click()
  BoardSearch.Text = ""
  $catalogPage = 1
  RefreshCatalogVisual()
End

Public Sub PreviousBoardPage_Click()
  If Not IsOverview() Then Return
  If $catalogPage > 1 Then Dec $catalogPage
  RefreshCatalogVisual()
End

Public Sub NextBoardPage_Click()
  If Not IsOverview() Then Return
  If $catalogPage < Max(1, Int(($catalogTotal + 24) / 25)) Then Inc $catalogPage
  RefreshCatalogVisual()
End

Public Sub Search_Click()
  Visual.Refresh()
End

