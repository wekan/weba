  If IsOverview() Then $catalogData = LoadBoardOverview()
  Visual.Refresh()
End

Public Sub BoardSearch_Change()
  If Not IsOverview() Then Return
  $catalogPage = 1
  RefreshCatalogVisual()
Catch
  Notice.Text = Error.Text
End

Public Sub ClearBoardSearch_Click()
  BoardSearch.Text = ""
  $catalogPage = 1
  RefreshCatalogVisual()
End

Public Sub PreviousBoardPage_Click()
  If Not IsOverview() Then Return
  If $catalogPage > 1 Then Dec $catalogPage
  RefreshCatalogVisual()
End

Public Sub NextBoardPage_Click()
  If Not IsOverview() Then Return
  If $catalogPage < Max(1, Int(($catalogTotal + 24) / 25)) Then Inc $catalogPage
  RefreshCatalogVisual()
End

Public Sub Search_Click()
  Visual.Refresh()
End

Private Sub CloseHeaderMenus()
  BoardSortMenu.Hide()
  Views.Hide()
  AccountMenu.Hide()
End

Private Sub ShowView(view As String)
  Dim key As String = BoardViewPreference.Canonical(view)
  If key Then
    If Not SaveViewPreference(key) Then Return
  Endif
  $dragHandleActor = ""
  $dragHandleGeneration = 0
  Inc $dragHandleRevision
  DragHandleAction.Text = ""
  If view = "Profile" Then
    $dragHandleActor = WebIdentity.Username
    $dragHandleGeneration = WebDatabase.SessionGeneration($dragHandleActor)
  Endif
  AccountPanel.Visible = view = "Profile"
  AdminPanel.Visible = False
  PasswordPolicyPanel.Hide()
  BoardCreationPanel.Hide()
  ClearInstanceFeatures()
  ImportExportPanel.Hide()
  MarkdownPanel.Hide()
  TransferLimitsPanel.Hide()
  PermanentDeletePanel.Hide()
  RecoveryPanel.Hide()
  If view = "Admin panel" Then AdminPanel.Visible = WebDatabase.GetIsAdmin(WebIdentity.Username)
  If view = "Profile" Then Fullname.Text = WebDatabase.GetFullname(WebIdentity.Username)
  $view = view
  DragHandleSettings.Refresh()
  ContentRow.Visible = view <> "Profile"
  PageActions.Visible = view <> "Profile" And view <> "Admin panel"
  Editor.Hide()
  CloseHeaderMenus()
  UpdateHeader()
  Visual.Refresh()
End

Private Sub ResetHome()
  CloseBoardArchive_Click()
  Editor.Hide()
  ContentRow.Show()
  PageActions.Show()
  CloseHeaderMenus()
  WorkspacePanel.Hide()
  BoardWorkspacePanel.Hide()
  AccountPanel.Hide()
  AdminPanel.Hide()
  PasswordPolicyPanel.Hide()
  BoardCreationPanel.Hide()
  ClearInstanceFeatures()
  ImportExportPanel.Hide()
  MarkdownPanel.Hide()
  TransferLimitsPanel.Hide()
  PermanentDeletePanel.Hide()
  RecoveryPanel.Hide()
  $archive = False
  $board = 0
  $view = "Boards"
  $spaceMenu = 0
  $catalogPage = 1
End

Public Sub Home_Click()
