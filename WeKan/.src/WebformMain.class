Private Sub ShowView(view As String)
  AccountPanel.Visible = view = "Profile"
  AdminPanel.Visible = False
  PasswordPolicyPanel.Hide()
  BoardCreationPanel.Hide()
  ImportExportPanel.Hide()
  MarkdownPanel.Hide()
  TransferLimitsPanel.Hide()
  PermanentDeletePanel.Hide()
  RecoveryPanel.Hide()
  If view = "Admin panel" Then AdminPanel.Visible = WebDatabase.GetIsAdmin(WebIdentity.Username)
  If view = "Profile" Then Fullname.Text = WebDatabase.GetFullname(WebIdentity.Username)
  $view = view
  ContentRow.Visible = view <> "Profile"
  PageActions.Visible = view <> "Profile" And view <> "Admin panel"
  Editor.Hide()
  CloseHeaderMenus()
  UpdateHeader()
  Visual.Refresh()
End

