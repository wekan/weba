  $browsingArchive = False
  BrowserTitle.Text = "History: " & ContextTitle.Text
  BrowserTree.Clear()
  r = WorkspaceStore.History($contextBoard, $contextKind, $contextId)
  For Each r
    BrowserTree.Add("event:" & CStr(r!id), Str(r!created_at) & " · " & r!actor & " · " & r!message)
