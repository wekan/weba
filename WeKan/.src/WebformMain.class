  ValidateMarkdownPolicy()
Catch
  Notice.Text = Error.Text
End

Private Sub ValidateMarkdownPolicy()
  Dim admin As Boolean = WebDatabase.GetIsAdmin(WebIdentity.Username)
  Dim value As Boolean = MarkdownPolicy.AlwaysRaw()
  ValidateExternalLinks(admin)
  MarkdownTitlesSnapshot.Text = Replace(JSON.Encode(BoardLive.CardTitles($archive)), " ", "\\u0020")
  MarkdownSettings.Visible = admin
  MarkdownPolicySnapshot.Text = If(value, "1", "0")
  MarkdownUrlSnapshot.Text = Replace(JSON.Encode(MarkdownPolicy.UrlSchemes()), " ", "\\u0020")
  If Not admin Then
    MarkdownSchemes.Text = ""
    $markdownSchemesBase = ""
  Else If MarkdownPanel.Visible And MarkdownSchemes.Text = $markdownSchemesBase Then
    MarkdownSchemes.Text = MarkdownPolicy.UrlSchemes()
    $markdownSchemesBase = MarkdownSchemes.Text
  Endif
  If Not admin Then
    MarkdownPanel.Hide()
    AlwaysShowCodeAsText.Value = False
    $markdownRawBase = False
  Else If MarkdownPanel.Visible And AlwaysShowCodeAsText.Value = $markdownRawBase Then
    AlwaysShowCodeAsText.Value = value
    $markdownRawBase = value
  Endif
End

Public Sub SaveMarkdownSchemes_Click()
  MarkdownPolicy.SaveUrlSchemes(MarkdownSchemes.Text)
  $markdownSchemesBase = MarkdownSchemes.Text
  Notice.Text = "Saved"
  ValidateMarkdownPolicy()
Catch
  Notice.Text = Error.Text
End

Private Function ExternalLinksDraft() As Collection
  Dim data As New Collection
  data.Add(ExternalPrefix.Text, "externalLinkPatternPrefix")
  data.Add(ExternalUrl.Text, "externalLinkPatternUrl")
  data.Add(ExternalRules.Text, "externalLinkRules")
  data.Add(ExternalAliases.Text, "externalLinkIdentifierAliases")
  Return data
End

Private Sub LoadExternalLinks(data As Collection)
  ExternalPrefix.Text = data["externalLinkPatternPrefix"]
  ExternalUrl.Text = data["externalLinkPatternUrl"]
  ExternalRules.Text = data["externalLinkRules"]
  ExternalAliases.Text = data["externalLinkIdentifierAliases"]
  $externalBase = JSON.Encode(ExternalLinksDraft())
End

Private Sub ValidateExternalLinks(admin As Boolean)
  Dim empty As New Collection
  Dim data As Collection = ExternalLinkPolicy.Snapshot()
  MarkdownExternalSnapshot.Text = Replace(JSON.Encode(data), " ", "\\u0020")
  If Not admin Then
    LoadExternalLinks(empty)
  Else If MarkdownPanel.Visible And JSON.Encode(ExternalLinksDraft()) = $externalBase Then
    LoadExternalLinks(data)
  Endif
End

Public Sub SaveExternalLinks_Click()
  Dim data As Collection = ExternalLinksDraft()
  Dim clean As New Collection
  Dim field As String
  For Each field In ["externalLinkPatternPrefix", "externalLinkPatternUrl", "externalLinkRules", "externalLinkIdentifierAliases"]
    clean.Add(WorkspaceNameTrim(data[field]), field)
  Next
  ExternalLinkPolicy.Save(clean)
  LoadExternalLinks(ExternalLinkPolicy.Snapshot())
  Notice.Text = "Saved"
  ValidateMarkdownPolicy()
Catch
  Notice.Text = Error.Text
End

Public Sub EntryRouteAction_Change()
  Dim fields As String[] = Split(EntryRouteAction.Text, "|")
  Dim section As String = EntryRouteAction.Text
  Dim workspaceId As Integer
  Dim boardData As Collection
  Dim boardEntryStarted As Boolean
  Dim cardEntry As Boolean
  Dim cardFailure As String
  Dim failure As String
  If Not WebIdentity.Username Then Error.Raise("Sign in required")
  If Not section Then Return
  ' Empty the command after capture; identical later entries must raise Change.
  EntryRouteAction.Text = ""
  If fields.Count < 2 Or fields.Count > 4 Then Error.Raise("Unknown overview entry")
  section = fields[0]
  If Not fields[1] Or Len(fields[1]) > 128 Then Error.Raise("Unknown overview entry")
  If ["public", "remaining", "starred", "archive", "home", "workspaces", "board"].Find(section) < 0 Then Error.Raise("Unknown overview entry")
  CloseBoardArchive_Click()
  If section = "board" Then
    If fields.Count <> 3 And fields.Count <> 4 Then Error.Raise("Unknown board entry")
    boardEntryStarted = True
    cardEntry = fields.Count = 4
    If cardEntry Then
      Try boardData = CardRoute.Resolve(fields[2], fields[3])
      If Error Then
        cardFailure = Error.Text
        ' An unreadable moved card must not disclose its destination. Keep a
        ' readable URL board mounted, as the source empty publication does.
        boardData = BoardRoute.Resolve(fields[2])
      Endif
    Else
      boardData = BoardRoute.Resolve(fields[2])
    Endif
    $landingConsumed = True
    If $board = boardData["id"] And $archive = boardData["archived"] And $view <> "Profile" And $view <> "Admin panel" Then
      $boardTitle = boardData["title"]
      $overviewRouteToken = fields[1]
      ApplyCardRoute(boardData, cardEntry)
      UpdateHeader()
      If cardFailure Then Notice.Text = cardFailure
      Return
    Endif
    ' Clear previous editors before selecting a different route. Its temporary
    ' overview acknowledgement retains the old token; only the final one wins.
    Home_Click()
    $overviewRouteToken = fields[1]
    $board = boardData["id"]
    $archive = boardData["archived"]
    $view = PreferredBoardView()
    $card = 0
    ApplyCardRoute(boardData, cardEntry)
    RefreshTree()
    If cardFailure Then Notice.Text = cardFailure
    Return
  Endif
  If section = "workspaces" Then
    If fields.Count <> 3 Then Error.Raise("Unknown overview entry")
    If fields[2] = "0" Then
      workspaceId = -1
    Else
      Try workspaceId = CInt(fields[2])
      If Error Then Error.Raise("Workspace not found")
      If workspaceId <= 0 Or CStr(workspaceId) <> fields[2] Then Error.Raise("Workspace not found")
      BoardSpaces.Record(workspaceId)
    Endif
  Else If fields.Count <> 2 Then
    Error.Raise("Unknown overview entry")
  Endif
  $landingConsumed = True
  $overviewRouteToken = fields[1]
  Select section
    Case "public"
      PublicBoards_Click()
    Case "remaining"
      Home_Click()
    Case "starred"
      Starred_Click()
    Case "home"
      HomeBoards_Click()
    Case "archive"
      Archive_Click()
    Case "workspaces"
      Home_Click()
      $spaceMenu = workspaceId
      $catalogPage = 1
      RefreshTree()
    Case Else
      Error.Raise("Unknown overview entry")
  End Select
Catch
  failure = Error.Text
  If boardEntryStarted Then
    $landingConsumed = True
    $overviewRouteToken = fields[1]
    Try Home_Click()
  Endif
  Notice.Text = failure
End


Private Sub ApplyCardRoute(data As Collection, requested As Boolean)
  Dim cardId As Integer
  If data.Exist("cardId") Then cardId = data["cardId"]
  If Not requested Or cardId <= 0 Then
    If $card > 0 Then ClearCardEditor()
    Return
  Endif
  If $card = cardId And Editor.Visible Then
    $routeCard = cardId
    $routeCardBoard = $board
    $routeCardArchived = data["cardArchived"]
    UpdateCardActions()
    Return
  Endif
  ClearCardEditor()
  $routeCard = cardId
  $routeCardBoard = $board
  $routeCardArchived = data["cardArchived"]
  $card = cardId
  LoadCardDraft()
  Editor.Show()
  UpdateCardActions()
End

Public Sub LoginLandingAction_Change()
  Dim command As String = LoginLandingAction.Text
  Dim boardId As Integer
  If Not WebIdentity.Username Then Error.Raise("Sign in required")
  If Not command Then Return
  LoginLandingAction.Text = ""
  If command <> "open" Then Error.Raise("Invalid login landing")
  If $landingConsumed Then Return
  $landingConsumed = True
  ' An ordinary navigation that already won the race must stay selected.
  If LandingContext() <> $landingContext Then
    UpdateHeader()
    Return
  Endif
  boardId = HomeBoard.Visible()
  If Not boardId Then
    If $board > 0 Then
      If Not BoardAccess.CanRead($board) Then
        Home_Click()
      Else If WorkspaceStore.Archived($board, "board", $board) <> $archive Then
        Home_Click()
      Endif
    Endif
    UpdateHeader()
    Return
  Endif
  Home_Click()
  $board = boardId
  $archive = False
  $view = PreferredBoardView()
  $card = 0
  RefreshTree()
Catch
  Notice.Text = Error.Text
End


Public Sub Reload()
  If NativeAuth.Bootstrapping Then Return
  Super.Reload()
End

Public Sub ContextVisibility_Click()
  Dim data As Collection
  If $contextKind <> "board" Or $contextId <> $contextBoard Then Error.Raise("Board not accessible")
  data = BoardVisibility.BoardSettings($contextBoard)
  CloseBoardVisibility_Click()
  CloseBoardViews_Click()
  $visibilityBoard = $contextBoard
  $visibilityActor = WebIdentity.Username
  $visibilityGeneration = WebDatabase.SessionGeneration($visibilityActor)
  $visibilityContext = LandingContext()
  BoardVisibilityName.Text = WorkspaceStore.Record($visibilityBoard, "board", $visibilityBoard)!title
  BoardPermission.List = ["Private", "Signed-in users", "Public"]
  BoardPermission.Index = ["private", "instance", "public"].Find(data["permission"])
  $visibilityBase = BoardPermission.Index
  ContextMenu.Hide()
  BoardVisibilityPanel.Show()
Catch
  Notice.Text = Error.Text
End

Public Sub CloseBoardVisibility_Click()
  BoardVisibilityPanel.Hide()
  BoardVisibilityName.Text = ""
  BoardPermission.Clear()
  $visibilityBoard = 0
  $visibilityActor = ""
  $visibilityContext = ""
  $visibilityGeneration = 0
  $visibilityBase = -1
End

Private Sub ValidateBoardVisibility()
  Dim data As Collection
  If ContextMenu.Visible Then ContextVisibility.Visible = $contextKind = "board" And (BoardAccess.Can($contextBoard, "manageBoard") Or WebDatabase.GetIsAdmin(WebIdentity.Username))
  If Not BoardVisibilityPanel.Visible Then Return
  If LandingContext() <> $visibilityContext Or $visibilityBoard <= 0 Or WebIdentity.Username <> $visibilityActor Or WebDatabase.SessionGeneration($visibilityActor) <> $visibilityGeneration Then Error.Raise("Sign in required")
  data = BoardVisibility.BoardSettings($visibilityBoard)
  BoardVisibilityName.Text = WorkspaceStore.Record($visibilityBoard, "board", $visibilityBoard)!title
  If BoardPermission.Index = $visibilityBase Then
    BoardPermission.Index = ["private", "instance", "public"].Find(data["permission"])
    $visibilityBase = BoardPermission.Index
  Endif
Catch
  CloseBoardVisibility_Click()
  CloseBoardViews_Click()
End

Public Sub SaveBoardVisibility_Click()
  Dim id As Integer = $visibilityBoard
  If Not BoardVisibilityPanel.Visible Or id <= 0 Then Error.Raise("Board not accessible")
  If LandingContext() <> $visibilityContext Or WebIdentity.Username <> $visibilityActor Or WebDatabase.SessionGeneration($visibilityActor) <> $visibilityGeneration Then Error.Raise("Sign in required")
  If BoardPermission.Index < 0 Or BoardPermission.Index > 2 Then Error.Raise("Unknown board permission")
  BoardVisibility.SavePermission(id, ["private", "instance", "public"][BoardPermission.Index])
  CloseBoardVisibility_Click()
  CloseBoardViews_Click()
  Notice.Text = "Saved"
  RefreshTree()
Catch
  Notice.Text = Error.Text
End

Public Sub PublicBoards_Click()
  ResetHome()
  CloseEditor_Click()
  ContextMenu.Hide()
  CloseAction_Click()
  CloseBoardVisibility_Click()
  CloseBoardViews_Click()
  CloseStaleMembers()
  CloseDeleteList_Click()
  CloseDeletedLists_Click()
  CloseBrowser_Click()
  CloseWorkspace_Click()
  CloseBoardWorkspace_Click()
  $contextBoard = 0
  $contextId = 0
  $contextKind = ""
  $detailsBoard = 0
  $membersBoard = 0
  $landingConsumed = True
  $view = "Public"
  $publicPage = 1
  $publicSearch = ""
  PublicSearch.Text = ""
  RefreshTree()
End

Private Sub RefreshPublic(force As Boolean)
  Dim params As New Collection
  Dim data As Collection
  Dim state As String
  params["search"] = $publicSearch
  params["page"] = $publicPage
  data = PublicBoardCatalog.Page(params)
  If $publicPage > data["pages"] Then
    $publicPage = data["pages"]
    params["page"] = $publicPage
    data = PublicBoardCatalog.Page(params)
  Endif
  state = JSON.Encode(data)
  If Not force And state = $publicState Then Return
  $publicState = state
  $publicData = data
  PublicPageLabel.Text = CStr($publicPage) & " / " & CStr(data["pages"]) & " (" & CStr(data["total"]) & ")"
  PreviousPublicPage.Enabled = $publicPage > 1
  NextPublicPage.Enabled = $publicPage < data["pages"]
  Visual.Refresh()
End

Private Sub RenderPublic()
  Dim row As Collection
  If Not $publicData Then Return
  Print "<section class='weba-public-content'><table class='weba-public-table'><thead><tr><th class='weba-public-board-caption'>Board</th><th class='weba-public-description-caption'>Description</th></tr></thead><tbody>"
  For Each row In $publicData["rows"]
    Print "<tr class='weba-public-board-row' data-board-id='" & CStr(row["id"]) & "' style='background-color:" & Html(row["color"]) & "'><td><a class='weba-public-board-link weba-user-text' data-board-key='b" & CStr(row["id"]) & "' href='/b/" & CStr(row["id"]) & "'><span class='board-list-item-name'>" & Html(row["title"]) & "</span></a></td><td class='weba-user-text'>" & Html(row["description"]) & "</td></tr>"
  Next
  If $publicData["rows"].Count = 0 Then Print "<tr><td colspan='2' class='weba-public-empty'>No results</td></tr>"
  Print "</tbody></table></section>"
End

Public Sub SearchPublic_Click()
  If $view <> "Public" Then Return
  $publicSearch = PublicSearch.Text
  $publicPage = 1
  RefreshPublic(True)
End

Public Sub PreviousPublicPage_Click()
  If $view <> "Public" Then Return
  If $publicPage > 1 Then Dec $publicPage
  RefreshPublic(True)
End

Public Sub NextPublicPage_Click()
  If $view <> "Public" Or Not $publicData Then Return
  If $publicPage < $publicData["pages"] Then Inc $publicPage
  RefreshPublic(True)
End

Private Function BoundBoardViews() As Collection
  If Not BoardViewsPanel.Visible Or $viewPolicyBoard <= 0 Or Not $viewPolicyDraft Then Error.Raise("Board not accessible")
  If LandingContext() <> $viewPolicyContext Or WebIdentity.Username <> $viewPolicyActor Or WebDatabase.SessionGeneration($viewPolicyActor) <> $viewPolicyGeneration Then Error.Raise("Sign in required")
  If Not BoardAccess.CanManageViewPolicy($viewPolicyBoard) Then Error.Raise("Board management required")
  Return BoardViewPolicy.Settings($viewPolicyBoard)
End

Private Sub FillBoardViews()
  Dim definitions As Collection = JSON.Decode(File.Load(".public/board-views.json"))
  Dim english As Collection = JSON.Decode(File.Load(".public/i18n/en.json"))
  Dim captions As New Collection
  Dim labels As New String[]
  Dim publicLabels As String[]
  Dim privateLabels As String[]
  Dim item As Collection
  Dim key As String
  $viewPolicyLoading = True
  $viewPolicyOrder = New String[]
  $viewPolicyAllowed = InstanceFeatures.AllowedViews(BoardViewPolicy.Keys())
  For Each item In definitions["views"]
    captions[item["view"]] = english[item["labelKey"]]
    If Not captions[item["view"]] Then captions[item["view"]] = item["view"]
  Next
  For Each key In $viewPolicyDraft["boardViewOrder"]
    If $viewPolicyAllowed.Find(key) < 0 Then Continue
    $viewPolicyOrder.Add(key)
    labels.Add(captions[key])
  Next
  $viewPolicyCaptions = captions
  If $viewPolicyOrder.Find($viewPolicySelected) < 0 Then $viewPolicySelected = $viewPolicyOrder[0]
  BoardViewChoice.List = labels
  publicLabels = labels.Copy()
  privateLabels = labels.Copy()
  $viewDefaultPublicKeys = $viewPolicyOrder.Copy()
  $viewDefaultPrivateKeys = $viewPolicyOrder.Copy()
  If $viewDefaultPublicKeys.Find($viewPolicyDraft["defaultPublicBoardView"]) < 0 Then
    $viewDefaultPublicKeys.Add("", 0)
    publicLabels.Add("—", 0)
  Endif
  If $viewDefaultPrivateKeys.Find($viewPolicyDraft["defaultPrivateBoardView"]) < 0 Then
    $viewDefaultPrivateKeys.Add("", 0)
    privateLabels.Add("—", 0)
  Endif
  BoardDefaultPublic.List = publicLabels
  BoardDefaultPrivate.List = privateLabels
  BoardViewChoice.Index = $viewPolicyOrder.Find($viewPolicySelected)
  BoardDefaultPublic.Index = Max(0, $viewDefaultPublicKeys.Find($viewPolicyDraft["defaultPublicBoardView"]))
  BoardDefaultPrivate.Index = Max(0, $viewDefaultPrivateKeys.Find($viewPolicyDraft["defaultPrivateBoardView"]))
  BoardShowPublic.Value = $viewPolicyDraft["boardViewSettings"][$viewPolicySelected]["showOnPublic"]
  BoardShowPrivate.Value = $viewPolicyDraft["boardViewSettings"][$viewPolicySelected]["showOnPrivate"]
  BoardViewUp.Enabled = BoardViewChoice.Index > 0
  BoardViewDown.Enabled = BoardViewChoice.Index < $viewPolicyOrder.Max
  RefreshBoardViewOrder()
  $viewPolicyLoading = False
Catch
  $viewPolicyLoading = False
  Error.Propagate()
End

Public Sub ContextBoardViews_Click()
  Dim id As Integer = $contextBoard
  Dim data As Collection
  If Not ContextMenu.Visible Or $contextKind <> "board" Or $contextId <> id Or Not BoardAccess.CanManageViewPolicy(id) Then Error.Raise("Board management required")
  data = BoardViewPolicy.Settings(id)
  CloseBoardVisibility_Click()
  CloseBoardViews_Click()
  $viewPolicyBoard = id
  $viewPolicyActor = WebIdentity.Username
  $viewPolicyGeneration = WebDatabase.SessionGeneration($viewPolicyActor)
  $viewPolicyContext = LandingContext()
  $viewPolicyBase = data
  $viewPolicyDraft = BoardViewPolicy.Snapshot(data)
  $viewPolicySelected = $viewPolicyDraft["boardViewOrder"][0]
  BoardViewsName.Text = WorkspaceStore.Record(id, "board", id)!title
  FillBoardViews()
  ContextMenu.Hide()
  BoardViewsPanel.Show()
Catch
  BoardViewsError(Error.Text)
End

Public Sub CloseBoardViews_Click()
  BoardViewsPanel.Hide()
  BoardViewsName.Text = ""
  BoardViewChoice.Clear()
  BoardDefaultPublic.Clear()
  BoardDefaultPrivate.Clear()
  BoardShowPublic.Value = False
  BoardShowPrivate.Value = False
  $viewPolicyBoard = 0
  $viewPolicyActor = ""
  $viewPolicyGeneration = 0
  $viewPolicyContext = ""
  $viewPolicyBase = Null
  $viewPolicyDraft = Null
  $viewPolicyOrder = Null
  $viewPolicyAllowed = Null
  $viewPolicyCaptions = Null
  $viewDefaultPublicKeys = Null
  $viewDefaultPrivateKeys = Null
  Inc $viewPolicyRevision
  BoardViewOrderAction.Text = ""
  BoardViewOrderList.Refresh()
  $viewPolicySelected = ""
End

Private Sub ValidateBoardViews()
  Dim data As Collection
  If ContextMenu.Visible Then ContextBoardViews.Visible = $contextKind = "board" And BoardAccess.CanManageViewPolicy($contextBoard)
  If Not BoardViewsPanel.Visible Then Return
  data = BoundBoardViews()
  If JSON.Encode(InstanceFeatures.AllowedViews(BoardViewPolicy.Keys())) <> JSON.Encode($viewPolicyAllowed) Then FillBoardViews()
  BoardViewsName.Text = WorkspaceStore.Record($viewPolicyBoard, "board", $viewPolicyBoard)!title
  If BoardViewPolicy.Difference($viewPolicyBase, $viewPolicyDraft).Count = 0 Then
    If JSON.Encode(data) <> JSON.Encode($viewPolicyBase) Then
      $viewPolicyBase = data
      $viewPolicyDraft = BoardViewPolicy.Snapshot(data)
      FillBoardViews()
    Endif
  Endif
Catch
  CloseBoardViews_Click()
End

Public Sub BoardViewChoice_Click()
  If $viewPolicyLoading Then Return
  CheckBoardViewOrder()
  If BoardViewChoice.Index < 0 Or BoardViewChoice.Index > $viewPolicyOrder.Max Then Error.Raise("Unknown board view")
  $viewPolicySelected = $viewPolicyOrder[BoardViewChoice.Index]
  FillBoardViews()
Catch
  BoardViewsError(Error.Text)
End

Private Sub StageBoardViewShown(side As String, shown As Boolean)
  CheckBoardViewOrder()
  If Not shown And $viewPolicyDraft["default" & side & "BoardView"] = $viewPolicySelected Then
    FillBoardViews()
    Return
  Endif
  $viewPolicyDraft["boardViewSettings"][$viewPolicySelected]["showOn" & side] = shown
  RefreshBoardViewOrder()
End

Public Sub BoardShowPublic_Click()
  If $viewPolicyLoading Then Return
  StageBoardViewShown("Public", BoardShowPublic.Value)
Catch
  BoardViewsError(Error.Text)
End

Public Sub BoardShowPrivate_Click()
  If $viewPolicyLoading Then Return
  StageBoardViewShown("Private", BoardShowPrivate.Value)
Catch
  BoardViewsError(Error.Text)
End

Private Sub StageBoardViewDefault(side As String, index As Integer)
  Dim key As String
  Dim keys As String[]
  CheckBoardViewOrder()
  keys = If(side = "Public", $viewDefaultPublicKeys, $viewDefaultPrivateKeys)
  If index < 0 Or index > keys.Max Then Error.Raise("Unknown board view")
  key = keys[index]
  If Not key Then Return
  $viewPolicyDraft["default" & side & "BoardView"] = key
  $viewPolicyDraft["boardViewSettings"][key]["showOn" & side] = True
  FillBoardViews()
End

Public Sub BoardDefaultPublic_Click()
  If $viewPolicyLoading Then Return
  StageBoardViewDefault("Public", BoardDefaultPublic.Index)
Catch
  BoardViewsError(Error.Text)
End

Public Sub BoardDefaultPrivate_Click()
  If $viewPolicyLoading Then Return
  StageBoardViewDefault("Private", BoardDefaultPrivate.Index)
Catch
  BoardViewsError(Error.Text)
End

Private Sub MoveBoardView(step As Integer)
  CheckBoardViewOrder()
  $viewPolicyDraft["boardViewOrder"] = BoardViewPolicy.Move($viewPolicyDraft["boardViewOrder"], $viewPolicySelected, If(step < 0, "up", "down"), $viewPolicyAllowed)
  FillBoardViews()
End

Public Sub BoardViewUp_Click()
  MoveBoardView(-1)
Catch
  BoardViewsError(Error.Text)
End

Public Sub BoardViewDown_Click()
  MoveBoardView(1)
Catch
  BoardViewsError(Error.Text)
End

Public Sub SaveBoardViews_Click()
  Dim changes As Collection
  BoundBoardViews()
  changes = BoardViewPolicy.Difference($viewPolicyBase, $viewPolicyDraft)
  If changes.Count > 0 Then BoardViewPolicy.Save($viewPolicyBoard, changes)
  CloseBoardViews_Click()
  Notice.Text = "Saved"
Catch
  BoardViewsError(Error.Text)
End

Private Sub BoardViewsError(message As String)
  If ["Board not accessible", "Sign in required", "Board management required", "Cannot hide the default board view", "Board owner changed", "Board view settings changed", "Unknown board view"].Find(message) >= 0 Then
    Notice.Text = message
  Else
    Notice.Text = "Error"
  Endif
End

Private Sub ApplyViewMenu(keys As String[])
  Dim controls As New Collection
  Dim name As String
  Dim key As String
  Dim button As WebButton
  Dim state As String = JSON.Encode(keys)
  If state = $viewMenuState Then Return
  $viewMenuState = state
  controls["Swimlanes"] = Swimlanes
  controls["Lists"] = Kanban
  controls["Table"] = TableView
  controls["Calendar"] = Calendar
  controls["Gantt"] = Gantt
  controls["Charts"] = Charts
  For Each name In controls.Keys
    button = controls[name]
    button.Visible = keys.Find(BoardViewPreference.Canonical(name)) >= 0
  Next
  For Each key In keys
    button = controls[BoardViewPreference.NativeName(key)]
    button.Raise()
  Next
End

Private Function PreferredBoardView() As String
  Dim key As String = BoardViewPreference.Stored($board)
  Dim data As Collection
  Dim keys As New String[]
  Dim name As String
  Dim state As String
  If $board > 0 Then
    data = BoardViewPolicy.Current($board, key)
  Else
    For Each name In BoardViewPreference.Names()
      keys.Add(BoardViewPreference.Canonical(name))
    Next
    keys = InstanceFeatures.AllowedViews(keys)
    data = New Collection
    data["views"] = keys
    data["view"] = key
    If keys.Find(key) < 0 Then data["view"] = "board-view-swimlanes"
  Endif
  state = CStr($board) & "|" & key & "|" & JSON.Encode(data)
  If state <> $viewPreferenceState Then ApplyViewMenu(data["views"])
  $viewPreferenceState = state
  Return BoardViewPreference.NativeName(data["view"])
End

Private Sub RefreshViewPreference()
  Dim before As String = $viewPreferenceState
  Dim view As String = PreferredBoardView()
  If before = $viewPreferenceState Then Return
  If Not BoardViewPreference.Canonical($view) Then Return
  $view = view
  UpdateHeader()
  Visual.Refresh()
End

Private Function SaveViewPreference(key As String) As Boolean
  Dim data As Collection
  If $board > 0 Then
    data = BoardViewPolicy.Current($board, key)
    If data["views"].Find(key) < 0 Then
      RefreshViewPreference()
      Return False
    Endif
  Else If InstanceFeatures.AllowedViews([key]).Count = 0 Then
    RefreshViewPreference()
    Return False
  Endif
  BoardViewPreference.Save($board, key)
  PreferredBoardView()
  Return True
Catch
  Notice.Text = "Error"
  Return False
End

Private Sub BindInstanceFeatures()
  If Not InstanceFeaturesPanel.Visible Or Not $featureDraft Then Error.Raise("Feature form changed")
  If WebIdentity.Username <> $featureActor Or WebDatabase.SessionGeneration($featureActor) <> $featureGeneration Then Error.Raise("Feature form changed")
  RecoveryStore.RequireAdmin()
End

Private Sub CaptureInstanceFeatures()
  If Not $featureDraft Then Return
  $featureDraft["approvalRequired"] = FeatureApprovalRequired.Value
  $featureDraft["previewAdmins"] = FeaturePreviewAdmins.Value
  $featureDraft["pilotUsernames"] = FeaturePilotUsernames.Text
End

Private Sub FillInstanceFeatures()
  Dim labels As New String[]
  Dim item As Collection
  $featureLoading = True
  For Each item In InstanceFeatures.Definition()["features"]
    labels.Add(InstanceFeatures.Definition()["captions"][item["labelKey"]])
  Next
  FeatureChoice.List = labels
  FeatureChoice.Index = $featureSelected
  item = InstanceFeatures.Definition()["features"][$featureSelected]
  FeatureDescription.Text = InstanceFeatures.Definition()["captions"][item["descKey"]]
  FeatureEnabled.Value = $featureDraft["states"][item["key"]]
  FeatureAwaiting.Visible = InstanceFeatures.Awaiting(InstanceFeatures.Setting(), item["key"])
  FeatureApprovalRequired.Value = $featureDraft["approvalRequired"]
  FeaturePreviewAdmins.Value = $featureDraft["previewAdmins"]
  FeaturePilotUsernames.Text = $featureDraft["pilotUsernames"]
  $featureLoading = False
Catch
  $featureLoading = False
  Error.Propagate()
End

Public Sub InstanceFeatureSettings_Click()
  Dim changes As Collection = InstanceFeatures.Settings()
  ContentRow.Hide()
  PasswordPolicyPanel.Hide()
  TransferLimitsPanel.Hide()
  PermanentDeletePanel.Hide()
  RecoveryPanel.Hide()
  ImportExportPanel.Hide()
  MarkdownPanel.Hide()
  BoardCreationPanel.Hide()
  ClearInstanceFeatures()
  $featureActor = WebIdentity.Username
  $featureGeneration = WebDatabase.SessionGeneration($featureActor)
  $featureBase = FeatureForm(changes)
  $featureDraft = FeatureForm(changes)
  $featureSelected = 0
  InstanceFeaturesPanel.Show()
  FillInstanceFeatures()
  PaneTitle.Text = "Features"
Catch
  Notice.Text = "Error"
End

Private Sub ClearInstanceFeatures()
  InstanceFeaturesPanel.Hide()
  FeatureChoice.Clear()
  FeatureDescription.Text = ""
  FeaturePilotUsernames.Text = ""
  FeatureUnknown.Text = ""
  FeatureUnknown.Hide()
  FeatureUnknownLabel.Hide()
  FeatureAwaiting.Hide()
  FeatureEnabled.Value = False
  FeatureApprovalRequired.Value = False
  FeaturePreviewAdmins.Value = False
  $featureBase = Null
  $featureDraft = Null
  $featureActor = ""
  $featureGeneration = 0
End

Public Sub FeatureChoice_Click()
  If $featureLoading Then Return
  BindInstanceFeatures()
  If FeatureChoice.Index < 0 Or FeatureChoice.Index >= InstanceFeatures.Keys().Count Then Error.Raise("Unknown feature")
  CaptureInstanceFeatures()
  $featureSelected = FeatureChoice.Index
  FillInstanceFeatures()
Catch
  ClearInstanceFeatures()
  Notice.Text = "Error"
End

Public Sub FeatureEnabled_Click()
  If $featureLoading Then Return
  BindInstanceFeatures()
  $featureDraft["states"][InstanceFeatures.Keys()[$featureSelected]] = FeatureEnabled.Value
Catch
  ClearInstanceFeatures()
  Notice.Text = "Error"
End

Public Sub SaveInstanceFeatures_Click()
  Dim unknown As String[]
  BindInstanceFeatures()
  CaptureInstanceFeatures()
  unknown = InstanceFeatures.Save($featureDraft, True)
  $featureBase = FeatureForm(InstanceFeatures.Settings())
  $featureDraft = FeatureForm($featureBase)
  FillInstanceFeatures()
  FeatureUnknownLabel.Visible = unknown.Count > 0
  FeatureUnknown.Visible = unknown.Count > 0
  FeatureUnknown.Text = unknown.Join(", ")
  Notice.Text = "Saved"
Catch
  Notice.Text = "Error"
End

Private Sub ValidateInstanceFeatures()
  Dim changes As Collection
  InstanceFeatureSettings.Visible = WebDatabase.GetIsAdmin(WebIdentity.Username)
  If Not InstanceFeaturesPanel.Visible Then Return
  BindInstanceFeatures()
  CaptureInstanceFeatures()
  If JSON.Encode($featureBase) <> JSON.Encode($featureDraft) Then Return
  changes = FeatureForm(InstanceFeatures.Settings())
  If JSON.Encode(changes) = JSON.Encode($featureBase) Then Return
  $featureBase = FeatureForm(changes)
  $featureDraft = FeatureForm(changes)
  FillInstanceFeatures()
Catch
  ClearInstanceFeatures()
End

Public Sub CloseInstanceFeatures_Click()
  ClearInstanceFeatures()
  ContentRow.Show()
  PaneTitle.Text = ""
  UpdateHeader()
End

Public Sub FeaturePilotUsernames_Change()
  If $featureLoading Then Return
  BindInstanceFeatures()
  CaptureInstanceFeatures()
Catch
  ClearInstanceFeatures()
End

Private Function FeatureForm(changes As Collection) As Collection
  Dim result As Collection = JSON.Decode(JSON.Encode(changes), True)
  ' Native textarea emptiness is Null; keep clean/draft comparisons canonical.
  If Not CStr(result["pilotUsernames"]) Then
    result.Remove("pilotUsernames")
    result.Add(Null, "pilotUsernames")
  Endif
  Return result
End

Private Sub RefreshBoardViewOrder()
  Inc $viewPolicyRevision
  BoardViewOrderList.Refresh()
End

Private Sub CheckBoardViewOrder()
  BoundBoardViews()
  If JSON.Encode(InstanceFeatures.AllowedViews(BoardViewPolicy.Keys())) <> JSON.Encode($viewPolicyAllowed) Then
    FillBoardViews()
    Error.Raise("Board view settings changed")
  Endif
End

Public Sub BoardViewOrderList_Render()
  Dim english As Collection
  Dim key As String
  If Not BoardViewsPanel.Visible Or Not $viewPolicyDraft Then Return
  BoundBoardViews()
  english = JSON.Decode(File.Load(".public/i18n/en.json"))
  Print "<div class='weba-view-order-list js-board-view-sortable' role='list' data-command='" & Html(BoardViewOrderAction.Name) & "' data-revision='" & CStr($viewPolicyRevision) & "'>"
  For Each key In $viewPolicyOrder
    Print "<div class='weba-view-order-row js-board-view-row' role='listitem' data-view='" & Html(key) & "'>"
    Print "<button type='button' class='weba-view-order-handle js-board-view-order-handle fa fa-arrows' data-caption='" & Html(english["drag-to-reorder"]) & "'></button>"
    Print "<button type='button' class='weba-view-order-label' data-caption='" & Html($viewPolicyCaptions[key]) & "'>" & Html($viewPolicyCaptions[key]) & "</button></div>"
  Next
  Print "</div>"
End

Public Sub BoardViewOrderAction_Change()
  Dim command As String = BoardViewOrderAction.Text
  Dim fields As String[]
  Dim key As String
  Dim values As Variant
  Dim before As String
  Dim afterOrder As String[]
  Dim failure As String
  If Not command Then Return
  BoardViewOrderAction.Text = ""
  CheckBoardViewOrder()
  If Len(command) > 8192 Then Error.Raise("Unknown board view")
  fields = Split(command, "|")
  If fields.Count < 3 Or fields.Count > 4 Then Error.Raise("Unknown board view")
  If fields[1] <> CStr($viewPolicyRevision) Then Error.Raise("Board view settings changed")
  before = JSON.Encode($viewPolicyDraft["boardViewOrder"])
  Select fields[0]
    Case "drag"
      If fields.Count <> 3 Then Error.Raise("Unknown board view")
      values = JSON.Decode(UnBase64(fields[2]), True)
      afterOrder = BoardViewPolicy.ReorderVisible($viewPolicyDraft["boardViewOrder"], values, $viewPolicyAllowed)
      $viewPolicyDraft["boardViewOrder"] = afterOrder
    Case "move", "select"
      key = UnBase64(fields[2])
      If $viewPolicyAllowed.Find(key) < 0 Then Error.Raise("Unknown board view")
      If fields[0] = "move" Then
        If fields.Count <> 4 Then Error.Raise("Unknown board view")
        If ["up", "down"].Find(fields[3]) < 0 Then Error.Raise("Unknown board view")
      Else If fields.Count <> 3 Then
        Error.Raise("Unknown board view")
      Endif
      $viewPolicySelected = key
      If fields[0] = "move" Then $viewPolicyDraft["boardViewOrder"] = BoardViewPolicy.Move($viewPolicyDraft["boardViewOrder"], key, fields[3], $viewPolicyAllowed)
    Case Else
      Error.Raise("Unknown board view")
  End Select
  FillBoardViews()
Catch
  failure = Error.Text
  Try BoundBoardViews()
  If Error Then
    CloseBoardViews_Click()
  Else
    RefreshBoardViewOrder()
  Endif
  BoardViewsError(failure)
End

