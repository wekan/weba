End
Public Sub ArchivedItems_Click()
  Dim r As Result
  $browsingArchive = True
  If Not $board Then Error.Raise("Select a board first")
  $contextBoard = $board
  BrowserTitle.Text = "Archived items"
  BrowserTree.Clear()
  r = KanbanStore.Lanes($board)
  For Each r
    If WorkspaceStore.Archived($board, "lane", r!id) Then BrowserTree.Add("lane:" & CStr(r!id), "Swimlane: " & r!title)
  Next
  r = WebDatabase.OpenConnection().Find("kb_lists", ListDeletion.LiveSql("list", "kb_lists") & " AND board_id = &1", $board)
  For Each r
    If WorkspaceStore.Archived($board, "list", r!id) Then BrowserTree.Add("list:" & CStr(r!id), "List: " & r!title)
  Next
  r = KanbanStore.Cards($board, True)
  For Each r
    BrowserTree.Add("card:" & CStr(r!id), "Card: " & r!title)
  Next
  ItemBrowser.Show()
Catch
  Notice.Text = Error.Text
End
Public Sub BrowserTree_Select()
