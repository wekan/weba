Public Sub DetailUpload_Finish()
  If Stat(DetailUpload.Path).Size > 10485760 Then Error.Raise("Choose a file up to 10 MiB")
  CardContent.AddFile($detailsBoard, $detailsCard, DetailUpload.File, File.Load(DetailUpload.Path))
  LoadDetails()
Catch
  Notice.Text = Error.Text
End
Public Sub DetailDownload_Click()
  Dim r As Result = CardContent.FileRecord($detailsBoard, $detailsCard, $fileId)
  Dim data As String = Base64(r!content.Data)
  WebForm.Exec("(function(){const bytes=Uint8Array.from(atob(" & JS(data) & "),c=>c.charCodeAt(0));const a=document.createElement('a');a.href=URL.createObjectURL(new Blob([bytes],{type:'application/octet-stream'}));a.download=" & JS(r!filename) & ";a.click();setTimeout(()=>URL.revokeObjectURL(a.href),1000);})();")
Catch
  Notice.Text = Error.Text
End
