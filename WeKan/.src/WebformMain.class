Private Sub ShowWorkspaceEditor(editId As Integer, parentId As Integer)
  Dim record As Collection
  CloseHeaderMenus()
  ContextMenu.Hide()
  BoardWorkspacePanel.Hide()
  Inc $workspaceRevision
  $workspaceActor = WebIdentity.Username
  $workspaceGeneration = WebDatabase.SessionGeneration($workspaceActor)
  $workspaceEdit = editId
  $workspaceParent = parentId
  WorkspaceName.Text = ""
  WorkspaceIcon.Text = ""
  SubworkspaceName.Text = ""
  If editId > 0 Then
    record = BoardSpaces.Record(editId)
    WorkspaceName.Text = record["name"]
    WorkspaceIcon.Text = record["icon"]
  Else If parentId > 0 Then
    BoardSpaces.Record(parentId)
  Endif
  WorkspaceHeading.Text = If(editId > 0, "Edit workspace", "Add Workspace")
  SaveWorkspace.Text = "Save"
  If editId = 0 Then SaveWorkspace.Text = If(parentId > 0, "Add Subworkspace", "Add Workspace")
  WorkspaceIcon.Visible = editId > 0
  WorkspaceIconLabel.Visible = editId > 0
  AddSubworkspace.Visible = False
  SubworkspaceNameLabel.Visible = editId > 0
  SubworkspaceName.Visible = editId > 0
  WorkspaceDeleteLabel.Visible = editId > 0
  ConfirmWorkspaceDelete.Visible = editId > 0
  ConfirmWorkspaceDelete.Value = False
  DeleteWorkspace.Visible = editId > 0
  WorkspacePanel.Class = "weba-action-panel weba-space-panel weba-workspace-revision-" & CStr($workspaceRevision) & If(editId = 0, " weba-workspace-create", " weba-workspace-edit weba-workspace-id-" & CStr(editId))
  SaveWorkspace.Visible = False
  WorkspacePanel.Show()
  WorkspaceName.SetFocus()
End

