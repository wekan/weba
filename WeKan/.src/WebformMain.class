  RefreshTree()
End

Public Sub Archive_Click()
  CloseBoardArchive_Click()
  Editor.Hide()
  ContentRow.Show()
  PageActions.Show()
  CloseHeaderMenus()
  WorkspacePanel.Hide()
  BoardWorkspacePanel.Hide()
  AccountPanel.Hide()
  AdminPanel.Hide()
  PasswordPolicyPanel.Hide()
  BoardCreationPanel.Hide()
  ClearInstanceFeatures()
  ImportExportPanel.Hide()
  MarkdownPanel.Hide()
  TransferLimitsPanel.Hide()
  PermanentDeletePanel.Hide()
  RecoveryPanel.Hide()
  $archive = True
  $board = 0
  $view = "Archive"
  $spaceMenu = 0
  $catalogPage = 1
  RefreshTree()
End

Public Sub Visual_Render()
  Dim b As Result
  Dim c As Result
  Dim a As Result
  Dim text As String
  Dim lane As Result
  Dim list As Result
  Dim tiles As New Collection
  Dim overviewId As Integer
  Dim overviewData As Collection
  Dim overviewIds As Integer[]
  Dim boardColor As String = "#2980b9"
  Dim homeId As Integer
  Dim presentation As Collection
  If Not WebIdentity.Username Then Return
  If $view = "Public" Then
    RenderPublic()
    Return
  Endif
  If $board > 0 And BoardViewPreference.Canonical($view) Then
    presentation = BoardViewPolicy.Current($board, BoardViewPreference.Canonical($view))
    $view = BoardViewPreference.NativeName(presentation["view"])
    ApplyViewMenu(presentation["views"])
  Else If $board = 0 And BoardViewPreference.Canonical($view) Then
    $view = PreferredBoardView()
  Endif
  homeId = HomeBoard.Saved()
  ' Capture before rendering: a concurrent mutation after this read must be
  ' noticed by the next tick, even if it races the render queries.
  $liveState = ""
  If $board Then $liveState = BoardLive.State($board, $archive)
  Print "<script>" & File.Load(".public/kanban.js") & "</script>"
  If $board Then boardColor = WorkspaceStore.Setting($board, "board", $board, "color", "#2980b9")
  Print "<section data-selection-ids=\"" & Html(JSON.Encode(BoardSelection.Ids(SelectionState()))) & "\" data-multi-active=\"" & If(IsOverview() And BoardSelection.Active(SelectionState()), "true", "false") & "\" data-selection-count=\"" & Str(BoardSelection.Count(SelectionState())) & "\" data-selection-revision=\"" & Str(BoardSelection.Revision(SelectionState())) & "\" data-selection-action=\"" & Html(BoardSelectionAction.Name) & "\" data-board-drop=\"" & If(IsOverview(), "true", "false") & "\" data-board-source=\"" & If($view = "Home", "home", If($archive, "archive", If($view = "Starred", "starred", If($spaceMenu > 0, "workspace", "remaining")))) & "\" data-workspace-reorder=\"" & If(IsOverview(), "true", "false") & "\" data-board-reorder=\"" & If(IsOverview() And $view <> "Home" And Not $archive And $catalogSort = "custom", "true", "false") & "\" data-board-color=\"" & Html(boardColor) & "\" data-context=\"" & Html(ContextAction.Name) & "\" data-drag=\"" & Html(DragAction.Name) & "\" data-board=\"" & Str($board) & "\" data-action=\"" & Html(BoardAction.Name) & "\" data-card-move=\"" & If($board > 0 And Not $archive And BoardAccess.Can($board, "moveCard"), "true", "false") & "\" data-editable=\"" & If($board > 0 And Not $archive And BoardAccess.Can($board, "write"), "true", "false") & "\" class=\"weba-content\" data-tree=\"" & Html(Boards.Name) & "\" data-view=\"" & Html($view) & "\">"
  If $view = "Profile" Then
    Print "<p>Signed in as " & Html(WebIdentity.Username) & "</p>"
  Else If $view = "Admin panel" Then
    If Not WebDatabase.GetIsAdmin(WebIdentity.Username) Then Error.Raise("Administrator required")
    a = WebDatabase.GetUsers()
    Print "<table><tr><th>Username</th><th>Full name</th><th>Administrator</th></tr>"
    For Each a
      Print "<tr><td>" & Html(a!username) & "</td><td>" & Html(a!fullname) & "</td><td>" & Html(If(a!admin, "Admin", "Normal")) & "</td></tr>"
    Next
    Print "</table>"
  Else If $view = "Activities" And $board Then
    a = KanbanStore.Activities($board)
    For Each a
      Print "<p>" & Html(Str(a!created_at)) & " · " & Html(a!actor) & " · " & Html(a!message) & "</p>"
    Next
  Else
    If IsOverview() Then
      overviewData = $catalogData
      overviewIds = overviewData["ids"]
    Endif
    If IsOverview() Then
      b = KanbanStore.BoardRows(overviewIds, $archive)
    Else
      b = KanbanStore.Boards($archive, False, $board, True)
    Endif
    If $board Then
      Print "<div class=\"weba-layout\" hidden>"
      lane = KanbanStore.Lanes($board)
      For Each lane
        If WorkspaceStore.Archived($board, "lane", lane!id) Then Continue
        Print "<section data-color=\"" & Html(WorkspaceStore.Setting($board, "lane", lane!id, "color")) & "\" data-lane-id=\"" & Str(lane!id) & "\" data-order=\"" & Str(KanbanStore.ItemOrder($board, "lane", lane!title, lane!id)) & "\" data-lane=\"" & Html(lane!title) & "\">"
        list = KanbanStore.Lists($board, lane!title)
        For Each list
          If WorkspaceStore.Archived($board, "list", list!id) Then Continue
          Print "<span data-count=\"" & Str(WorkspaceStore.ListCount($board, list!id)) & "\" data-wip=\"" & Html(WorkspaceStore.Setting($board, "list", list!id, "wip", "0")) & "\" data-color=\"" & Html(WorkspaceStore.Setting($board, "list", list!id, "color")) & "\" data-star=\"" & WorkspaceStore.Setting($board, "list", list!id, "star", "0") & "\" data-list-id=\"" & Str(list!id) & "\" data-list=\"" & Html(list!title) & "\"></span>"
        Next
        Print "</section>"
      Next
      Print "</div>"
    Endif
    Print If(IsOverview(), "<ul class=\"weba-data\" role=\"list\">", "<div class=\"weba-data\">")
    If IsOverview() And $view = "Home" Then
      Print "<li class=\"home-remove-target js-home-remove\" hidden><i class=\"fa fa-trash\" aria-hidden=\"true\"></i><span class=\"weba-home-remove-label\">Remove from Home</span></li>"
      If overviewIds.Count = 0 Then Print "<li class=\"board-list-item-empty weba-home-empty\">Drag only one board here to open it after login</li>"
    Endif
    For Each b
      If $board And b!id <> $board Then Continue
      If IsOverview() Then
        If overviewIds.Find(b!id) < 0 Then Continue
      Else If $view = "Starred" Then
        If WorkspaceStore.Setting(b!id, "board", b!id, "star") <> "1" Then Continue
      Endif
      If Not $board And ($view = "Boards" Or $view = "Archive" Or $view = "Starred" Or $view = "Home") Then
        tiles[CStr(b!id)] = "<li data-selected=\"" & If(BoardSelection.IsSelected(SelectionState(), b!id), "true", "false") & "\" draggable=\"true\" class=\"weba-board-tile-group js-board\" data-board-id=\"" & Str(b!id) & "\">" & If(IsOverview(), "<button type=\"button\" class=\"weba-drag-handle weba-board-drag fa fa-arrows\" data-drag-kind=\"board\" aria-label=\"Sort boards\"></button>", "") & "<a href=\"/b/" & Str(b!id) & "\" draggable=\"false\" style=\"background-color:" & Html(WorkspaceStore.Setting(b!id, "board", b!id, "color", "#2980b9")) & "\" class=\"weba-board-tile\" data-board-key=\"b" & Str(b!id) & "\"><strong class=\"board-list-item-name\">" & Html(b!title) & "</strong>" & If(b!id = homeId, "<span class=\"board-home-badge\" role=\"img\" title=\"Home board (opened after login)\" aria-label=\"Home board (opened after login)\"><i class=\"fa fa-home\" aria-hidden=\"true\"></i></span>", "") & "</a><button type=\"button\" class=\"weba-board-context fa fa-bars\" data-context-kind=\"board\" data-context-id=\"" & Str(b!id) & "\" aria-label=\"Board menu\"></button></li>"
        Continue
      Endif
      Print "<h3>" & Html(b!title) & "</h3>"
      c = KanbanStore.Cards(b!id, $archive)
      For Each c
        If Not $archive And WorkspaceStore.ListHidden(b!id, KanbanStore.CardListId(b!id, c!id)) Then Continue
        If $view = "My cards" Then
          If Not BoardAccess.IsAssigned(b!id, c!id, WebIdentity.Username) Then Continue
        Endif
        If $view = "Due cards" Then
          If Not c!due_day Then Continue
          If c!due_day > Format(Now, "yyyy-mm-dd") Then Continue
        Endif
        text = c!title & " " & c!description & " " & c!labels & " " & c!assignee
        If Filter.Text And InStr(LCase(text), LCase(Filter.Text)) = 0 Then Continue
        Print "<article data-color=\"" & Html(WorkspaceStore.Setting(b!id, "card", c!id, "color")) & "\" data-list-id=\"" & Str(KanbanStore.CardListId(b!id, c!id)) & "\" data-order=\"" & Str(KanbanStore.ItemOrder(b!id, "card", CStr(c!id), c!id)) & "\" data-card-id=\"" & Str(c!id) & "\" class=\"weba-card\" data-card-key=\"c" & Str(c!id) & ":" & Str(b!id) & "\" data-status=\"" & Html(c!status) & "\" data-lane=\"" & Html(c!lane) & "\" data-due=\"" & Html(c!due_day) & "\">"
        Print "<strong>" & Html(c!title) & "</strong><p>" & Html(c!description) & "</p><small>" & Html(c!status) & " · " & Html(c!assignee) & " · " & Html(c!labels) & " · " & Html(c!due_day) & "</small></article>"
      Next
    Next
    If IsOverview() Then
      For Each overviewId In overviewIds
        If tiles.Exist(CStr(overviewId)) Then Print tiles[CStr(overviewId)]
      Next
    Endif
    Print If(IsOverview(), "</ul>", "</div>") & "<div class=\"weba-report\"></div>"
  Endif
  Print "</section>"
  WebForm.Exec("window.webaRender && window.webaRender();gw.onFocus();window.webaAlignFocus && window.webaAlignFocus();")
Catch
  Print "<p role=\"alert\">" & Html(Error.Text) & "</p>"
End

Private Function Html(value As String) As String
  value = Replace(value, "&", "&amp;")
  value = Replace(value, "<", "&lt;")
  value = Replace(value, ">", "&gt;")
  value = Replace(value, "\"", "&quot;")
  Return Replace(value, "'", "&#39;")
End

