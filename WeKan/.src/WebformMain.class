Private Sub UpdateHeader()
  ValidateBoardVisibility()
  ValidateBoardViews()
  Dim routeSection As String
  Dim routeAck As New Collection
  Dim b As Result
  Dim overview As Boolean = Not $board And ($view = "Boards" Or $view = "Archive" Or $view = "Starred" Or $view = "Home")
  If overview Then
    If $view = "Archive" Then
      routeSection = "archive"
    Else If $view = "Home" Then
      routeSection = "home"
    Else If $view = "Starred" Then
      routeSection = "starred"
    Else If $spaceMenu = 0 Then
      routeSection = "remaining"
    Else
      routeSection = "workspaces"
    Endif
  Endif
  If $view = "Public" Then routeSection = "public"
  If $board > 0 And $view <> "Profile" And $view <> "Admin panel" Then routeSection = "board"
  routeAck["boardId"] = If(routeSection = "board", CStr($board), "")
  routeAck["cardId"] = If(routeSection = "board" And $card > 0 And Editor.Visible, CStr($card), "")
  routeAck["boardTitle"] = If(routeSection = "board", $boardTitle, "")
  routeAck["boardArchived"] = If(routeSection = "board", $archive, False)
  routeAck["navigationRevision"] = $navigationRevision
  routeAck["navigationHome"] = $navigationHome
  routeAck["landingReady"] = $landingConsumed
  routeAck.Add(routeSection, "section")
  routeAck.Add($overviewRouteToken, "token")
  routeAck.Add(If(routeSection = "workspaces" And $spaceMenu > 0, CStr($spaceMenu), ""), "workspaceId")
  If $view = "Public" Then
    routeAck["tree"] = New Variant[]
  Else
    routeAck["tree"] = BoardSpaces.Tree()
  Endif
  OverviewRouteState.Text = Replace(JSON.Encode(routeAck), " ", "\\u0020")
  ViewMenu.Visible = $view <> "Profile" And $view <> "Admin panel"
  AddBoard.Visible = ViewMenu.Visible And BoardCreation.Allowed() And $view <> "Home"
  HeaderSearch.Visible = ViewMenu.Visible
  Remaining.Class = If($view = "Boards" And $spaceMenu = 0, "weba-active", "")
  HomeBoards.Class = If($view = "Home", "weba-active", "")
  HomeBoardsCount.Text = If(HomeBoard.Visible(), "1", "0")
  Archive.Class = If($view = "Archive", "weba-active", "")
  BoardNavigation.Visible = $view <> "Admin panel"
  AdminNavigation.Visible = $view = "Admin panel"
  OverviewActions.Visible = overview And Not $archive
  SortBoards.Visible = overview
  BoardSearchPanel.Visible = overview And ($overviewSidebar <> "selection" Or Not BoardSelection.Active(SelectionState()))
  UpdateSelectionControls()
  DeletedLists.Visible = False
  If $board > 0 Then DeletedLists.Visible = BoardAccess.Can($board, "write")
  SearchTitle.Visible = Not overview
  Filter.Visible = Not overview
  Search.Visible = Not overview
  BoardPagination.Visible = overview And $catalogSort <> "custom"
  BoardPagination.Class = "weba-board-pagination" & If(BoardPagination.Visible, " boards-pagination", "")
  If Not overview Then BoardSortMenu.Hide()
  ContentRow.Expand = Not overview
  PaneTitle.Text = If($view = "Boards", If($spaceMenu < 0, "Workspaces", "Remaining"), $view)
  PaneTitle.Class = ""
  If overview And $view = "Boards" And $spaceMenu > 0 And $spaceNames.Exist(CStr($spaceMenu)) Then
    PaneTitle.Class = "weba-user-text"
    PaneTitle.Text = $spaceNames[CStr($spaceMenu)]
  Endif
  UpdateSpaceSelection()
  PageTitle.Text = If($view = "Boards", "All Boards", $view)
  If $board And $view <> "Profile" And $view <> "Admin panel" Then
    b = WorkspaceStore.Record($board, "board", $board)
    PageTitle.Text = b!title
  Endif
  PageTitle.Class = If($view = "Public", "weba-public-heading", "")
  PageTitle.Tooltip = PageTitle.Text
  ViewMenu.Text = If($view = "Boards", "View", $view)
  ValidateBoardCreation()
  ValidateInstanceFeatures()
  ValidateImportExportPolicy()
  ValidateMarkdownPolicy()
  PublicControls.Visible = $view = "Public"
  ToggleNavigation.Visible = $view <> "Public"
  SidebarToggle.Visible = $view <> "Public"
  If $view = "Public" Then
    LeftNavigation.Hide()
    BoardNavigation.Hide()
    AdminNavigation.Hide()
    PageSidebar.Hide()
    ViewMenu.Hide()
    AddBoard.Hide()
    HeaderSearch.Hide()
    PageActions.Hide()
    BoardPagination.Hide()
    OverviewActions.Hide()
    SearchTitle.Hide()
    Search.Hide()
    Filter.Hide()
    PaneTitle.Text = ""
  Endif
End

