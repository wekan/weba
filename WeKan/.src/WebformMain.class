Public Sub ImportBoard_Finish()
  Dim data As Collection
  BoardCreation.Require()
  ImportExportPolicy.RequireImport()
  If Not ImportBoard.Path Then Return
  If Stat(ImportBoard.Path).Size > 20 * 1024 * 1024 Then Error.Raise("Import JSON exceeds 20 MiB")
  ClearSingleCopy()
  $importText = File.Load(ImportBoard.Path)
  data = BoardTransfer.ReadData($importText)
  ColorChooser.Hide()
  $action = "Import"
  ActionTitle.Text = "Import as a new board: " & CStr(data["title"])
  ActionText.Text = CStr(data["title"])
  ActionText.Show()
  ActionFlag.Hide()
  DestinationBoard.Hide()
  DestinationBoardLabel.Hide()
  DestinationLane.Hide()
  DestinationLaneLabel.Hide()
  DestinationList.Hide()
  DestinationListLabel.Hide()
  ActionPanel.Show()
Catch
  $importText = ""
  Notice.Text = Error.Text
End

Private Sub BeginAction(action As String)
  Dim r As Result = WorkspaceStore.Record($contextBoard, $contextKind, $contextId)
  ClearSingleCopy()
  If action = "Copy" And $contextKind = "board" Then $singleCopy = SingleBoardCopy.NewState($contextBoard)
  $action = action
  ColorChooser.Visible = action = "Color"
  $loadingDestinations = True
  LoadDestinationBoards()
  DestinationBoard.Visible = action = "Move" And BoardAccess.Can($contextBoard, "write")
  DestinationBoardLabel.Visible = DestinationBoard.Visible
  ActionTitle.Text = action & ": " & r!title
  ActionText.Text = r!title
  ActionFlag.Visible = action = "WIP" Or action = "Allow attachments"
  ActionFlag.Text = If(action = "Allow attachments", "Attachments", "Prevent exceeding limit")
  ActionFlag.Value = False
  If action = "Allow attachments" Then
    If $contextKind <> "board" Then Error.Raise("Board setting required")
    BoardAccess.Require($contextBoard, "manageBoard")
    ActionFlag.Value = WorkspaceStore.Setting($contextBoard, "board", $contextBoard, "allowsAttachments", "1") = "1"
  Endif
  If action = "WIP" Then ActionFlag.Value = WorkspaceStore.Setting($contextBoard, $contextKind, $contextId, "wip_strict", "0") = "1"
  ActionText.Visible = action <> "Move" And action <> "Allow attachments"
  If action = "Add list" Or action = "Add swimlane" Then ActionText.Text = ""
  DestinationLane.Visible = action = "Move" Or action = "Add list" Or (action = "Copy" And $contextKind = "list")
  DestinationLaneLabel.Visible = DestinationLane.Visible
  DestinationList.Visible = action = "Move" And $contextKind = "card"
  DestinationListLabel.Visible = DestinationList.Visible
  LoadDestinationLanes()
  If $contextKind = "list" Or $contextKind = "card" Then
    DestinationLane.Index = DestinationLane.List.Find(r!lane)
  Else If $contextKind = "lane" Then
    DestinationLane.Index = DestinationLane.List.Find(r!title)
  Endif
  LoadDestinationLists()
  $loadingDestinations = False
  If action = "Delete" Then
    ActionText.Text = ""
    ActionTitle.Text = "Delete permanently — type the exact title: " & r!title
    DestinationLane.Visible = False
    DestinationLaneLabel.Visible = False
  Endif
  If action = "Copy" Then ActionText.Text = If($contextKind = "board", r!title, r!title & " copy")
  If action = "Color" Then
    ActionText.Text = WorkspaceStore.Setting($contextBoard, $contextKind, $contextId, "color", "#2980b9")
    LoadColorPresets()
    ColorWheel.Refresh()
  Endif
  If action = "WIP" Then ActionText.Text = WorkspaceStore.Setting($contextBoard, $contextKind, $contextId, "wip", "0")
  If action = "Description" Then ActionText.Text = WorkspaceStore.Setting($contextBoard, $contextKind, $contextId, "description")
  ContextMenu.Hide()
  ActionPanel.Show()
  If $singleCopy Then
    SingleCopyOptions.Show()
    LoadSingleCopyOptions()
  Endif
End

Private Sub LoadColorPresets()
  Dim data As Collection = JSON.Decode(File.Load(".public/color-presets.json"))
  Dim preset As Collection
  Dim button As WebButton
  Dim value As Integer
  For Each button In $colorButtons
    button.Delete()
  Next
  $colorButtons.Clear()
  For Each preset In data[If($contextKind = "board", "boards", "items")]
    If $contextKind = "card" And preset["name"] = "white" Then Continue
    button = New WebButton(ColorPresets) As "PresetColor"
    button.Tag = preset["hex"]
    button.Tooltip = preset["name"] & " " & preset["hex"]
    button.Class = "weba-color-swatch weba-icon-only"
    value = Val("&H" & Mid(preset["hex"], 2))
    button.Background = value
    If (Shr(value, 16) * 299 + (Shr(value, 8) And 255) * 587 + (value And 255) * 114) > 128000 Then
      button.Foreground = Color.Black
    Else
      button.Foreground = Color.White
    Endif
    $colorButtons.Add(button)
  Next
  UpdateColorSelection()
End

Private Sub UpdateColorSelection()
  Dim button As WebButton
  For Each button In $colorButtons
    button.Class = "weba-color-swatch weba-icon-only" & If(LCase(ActionText.Text) = button.Tag, " fa fa-check", "")
  Next
End

Public Sub PresetColor_Click()
  ActionText.Text = Last.Tag
  UpdateColorSelection()
  WebForm.Exec("window.webaUI?.syncColor()")
End

Public Sub ActionText_Change()
  If $action <> "Color" Then Return
