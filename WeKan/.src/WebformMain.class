Private Sub ReorderCatalog(boardId As Integer, beforeId As Integer)
  Dim data As Collection
  Dim ids As Integer[]
  Dim at As Integer
  If Not IsOverview() Then Error.Raise("Select Custom board sort first")
  If $archive Or $catalogSort <> "custom" Then Error.Raise("Select Custom board sort first")
  data = LoadBoardOverview()
  ids = data["ids"]
  at = ids.Find(boardId)
  If at < 0 Then Error.Raise("Invalid board order")
  If beforeId <> 0 Then
    If ids.Find(beforeId) < 0 Then Error.Raise("Invalid board order")
  Endif
  If boardId = beforeId Then Return
  ids.Remove(at)
  at = ids.Count
  If beforeId > 0 Then at = ids.Find(beforeId)
  ids.Add(boardId, at)
  BoardOrder.Save(ids)
  RefreshTree()
End

Private Sub DropCatalogBoard(boardId As Integer, target As String, spaceId As Integer)
  Dim data As Collection
  Dim ids As Integer[]
  Dim source As String
  If Not IsOverview() Then Error.Raise("Select All Boards first")
  data = LoadBoardOverview()
  ids = data["ids"]
  If ids.Find(boardId) < 0 Then Error.Raise("Invalid board drop")
  source = If($archive, "archive", If($view = "Starred", "starred", If($spaceMenu > 0, "workspace", "remaining")))
  If BoardSelection.Active(SelectionState()) And BoardSelection.IsSelected(SelectionState(), boardId) Then Error.Raise("Board selection changed")
  BoardSpaces.DropBoard(boardId, target, spaceId, source)
  RefreshTree()
End

Private Sub DropSelectedBoards(boardId As Integer, target As String, spaceId As Integer, revision As Long)
  Dim data As Collection
  Dim ids As Integer[]
  Dim visible As Integer[]
  Dim source As String
  If Not IsOverview() Then Error.Raise("Select All Boards first")
  data = LoadBoardOverview()
  visible = data["ids"]
  ids = BoardSelection.DropIds(SelectionState(), boardId, revision, visible)
  source = If($archive, "archive", If($view = "Starred", "starred", If($spaceMenu > 0, "workspace", "remaining")))
  BoardSpaces.DropBoards(ids, target, spaceId, source)
  If target = "remaining" Or target = "archive" Then BoardSelection.Clear(SelectionState())
  RefreshTree()
End

Public Sub DragAction_Change()
  Dim wire As String
  Dim fields As String[]
  If Not DragAction.Text Then Return
  wire = DragAction.Text
  DragAction.Text = ""
  fields = Split(wire, "|")
  If fields.Count <> 5 Then Error.Raise("Invalid drag action")
  If fields[0] = "board-multi-drop" Then
    DropSelectedBoards(CInt(UnBase64(fields[1])), UnBase64(fields[2]), CInt(UnBase64(fields[3])), CLong(UnBase64(fields[4])))
    Return
  Endif
  If fields[0] = "board-drop" Then
    If UnBase64(fields[4]) <> "" Then Error.Raise("Invalid board drop")
    DropCatalogBoard(CInt(UnBase64(fields[1])), UnBase64(fields[2]), CInt(UnBase64(fields[3])))
    Return
  Endif
  If fields[0] = "workspace" Then
    If Not IsOverview() Then Error.Raise("Select All Boards first")
    If UnBase64(fields[4]) <> "" Then Error.Raise("Invalid workspace drop")
    BoardSpaces.Drop(CInt(UnBase64(fields[1])), CInt(UnBase64(fields[2])), UnBase64(fields[3]))
    RefreshTree()
    Return
  Endif
  If fields[0] = "board" Then
    ReorderCatalog(CInt(UnBase64(fields[1])), CInt(UnBase64(fields[4])))
    Return
  Endif
  If $board = 0 Or $archive Then Error.Raise("Select an active board first")
  Select fields[0]
    Case "card"
      KanbanStore.MoveCard($board, CInt(UnBase64(fields[1])), UnBase64(fields[2]), UnBase64(fields[3]), CInt(UnBase64(fields[4])))
    Case "lane"
      KanbanStore.MoveLane($board, UnBase64(fields[1]), UnBase64(fields[4]))
    Case "list"
      KanbanStore.MoveList($board, UnBase64(fields[1]), UnBase64(fields[2]), UnBase64(fields[3]), UnBase64(fields[4]))
    Case Else
      Error.Raise("Invalid drag action")
  End Select
  RefreshTree()
Catch
  Notice.Text = Error.Text
  Visual.Refresh()
End

Public Sub ContextAction_Change()
  Dim wire As String
  Dim fields As String[]
  If Not ContextAction.Text Then Return
  wire = ContextAction.Text
  ContextAction.Text = ""
  fields = Split(wire, "|")
  If fields.Count < 2 Or fields.Count > 3 Then Error.Raise("Invalid menu context")
  OpenContext(fields[0], CInt(fields[1]), If(fields[0] = "board", CInt(fields[1]), $board))
  If fields.Count = 3 Then
    If fields[2] <> "Add list" And fields[2] <> "Add swimlane" Then Error.Raise("Unknown menu action")
    BeginAction(fields[2])
  Endif
Catch
  Notice.Text = Error.Text
End

Private Sub OpenContext(kind As String, itemId As Integer, boardId As Integer)
  Dim r As Result = WorkspaceStore.Record(boardId, kind, itemId)
  Dim archived As Boolean = WorkspaceStore.Archived(boardId, kind, itemId)
  Dim writable As Boolean = BoardAccess.Can(boardId, "write")
  Dim manager As Boolean = BoardAccess.Can(boardId, "manageBoard")
  Dim change As Boolean = If(kind = "board", manager, writable)
  If $singleCopy Then
    If kind <> "board" Or boardId <> $singleCopy["boardId"] Or itemId <> boardId Then
      ActionPanel.Hide()
      ActionText.Text = ""
      ClearSingleCopy()
    Endif
  Endif
  $contextBoard = boardId
  $contextKind = kind
  $contextId = itemId
  ContextTitle.Text = r!title
  ContextMenu.Show()
  ContextWorkspace.Visible = kind = "board"
  ContextMembers.Visible = kind = "board" Or kind = "card"
  ContextAssignees.Visible = kind = "card"
  ContextAssignSelf.Visible = kind = "card" And BoardAccess.Can(boardId, "moveCard")
  If kind = "card" Then ContextAssignSelf.Text = If(BoardAccess.IsAssigned(boardId, itemId, WebIdentity.Username), "Unassign myself", "Assign myself")
  ContextArchive.Visible = Not archived And change
  ContextRestore.Visible = archived And change
  ContextDelete.Visible = If(kind = "list", writable, archived And change And kind <> "board" And RecoveryStore.CanPurge())
  ContextRename.Visible = Not archived And change
  ContextCopy.Visible = (kind = "board" And manager And BoardCreation.Allowed() And ImportExportPolicy.ImportAllowed() And BoardAccess.Can(boardId, "seesAllCards")) Or (kind <> "board" And writable)
  ContextAddCard.Visible = writable And Not archived And kind <> "card"
  ContextAddList.Visible = writable And Not archived And kind <> "card"
  ContextAddLane.Visible = writable And Not archived And (kind = "lane" Or kind = "board")
  ContextMove.Visible = Not archived And kind <> "board" And (writable Or (kind = "card" And BoardAccess.Can(boardId, "moveCard")))
  ContextColor.Visible = change
  ContextExport.Visible = ImportExportPolicy.ExportAllowed() And (kind = "card" Or BoardAccess.Can(boardId, "seesAllCards"))
  ContextComments.Visible = kind = "card"
  ContextChecklists.Visible = kind = "card"
  ContextChecklistItems.Visible = kind = "card"
  ContextSubtasks.Visible = kind = "card"
  ContextDependencies.Visible = kind = "card"
  ContextFields.Visible = kind = "card"
  ContextTime.Visible = kind = "card"
  ContextAttachments.Visible = kind = "card"
  ContextWip.Visible = kind = "list" And writable
  ContextAllowsAttachments.Visible = kind = "board" And manager
  ContextDescription.Visible = kind = "board" And manager
  ContextStar.Class = If(WorkspaceStore.Setting(boardId, kind, itemId, "star") = "1", "weba-starred", "")
  ContextWatch.Class = If(WorkspaceStore.Setting(boardId, kind, itemId, "watch") = "1", "weba-watched", "")
  ContextStar.Text = If(WorkspaceStore.Setting(boardId, kind, itemId, "star") = "1", "Unstar", "Star")
  ContextWatch.Text = If(WorkspaceStore.Setting(boardId, kind, itemId, "watch") = "1", "Unwatch", "Watch")
End

