Public Sub ConfirmSelectedPurge_Click()
  Dim ids As Integer[]
  Dim dispatched As Boolean
  Dim failure As String
  If Not IsOverview() Or Not $archive Then Error.Raise("Select Archive first")
  RecoveryStore.RequirePurge()
  ids = BoardSelection.ActionIds(SelectionState())
  If $selectedPurgeRevision < 0 Or $selectedPurgeRevision <> BoardSelection.Revision(SelectionState()) Then Error.Raise("Board selection changed")
  If Not SelectedPurgeConfirmation.Value Then Error.Raise("Confirm permanent board deletion")
  dispatched = True
  BoardPurge.DeleteBoards(ids)
  BoardSelection.Clear(SelectionState())
  CancelSelectedPurge_Click()
  RefreshTree()
Catch
  failure = Error.Text
  If Not dispatched Then
    Try ids = BoardSelection.Ids(SelectionState())
    Try BoardPurge.RecordRejected(ids, failure)
  Endif
  Notice.Text = failure
  RefreshCatalogVisual()
End


