End

Public Sub BoardAction_Change()
  Dim fields As String[]
  Dim action As String
  Dim laneTitle As String
  Dim list As String
  Dim title As String
  Dim listRow As Result
  If Not BoardAction.Text Then Return
  action = BoardAction.Text
  BoardAction.Text = ""
  If $board = 0 Or $archive Then Error.Raise("Select an active board first")
  KanbanStore.RequireBoard($board)
  fields = Split(action, "|")
  If fields.Count <> 4 Then Error.Raise("Invalid board action")
  laneTitle = UnBase64(fields[1])
  list = UnBase64(fields[2])
  title = UnBase64(fields[3])
  Select fields[0]
    Case "card"
      NewCard_Click()
      Lane.Text = laneTitle
      listRow = KanbanStore.GetList($board, list, laneTitle)
      Status.Text = listRow!title
      $listId = listRow!id
      CardTitle.SetFocus()
    Case "lane"
      KanbanStore.AddLane($board, title)
      RefreshTree()
    Case "list"
      KanbanStore.AddList($board, laneTitle, title, list)
      RefreshTree()
    Case Else
      Error.Raise("Invalid board action")
  End Select
Catch
  Notice.Text = Error.Text
End

Public Sub CloseViews_Click()
  Views.Hide()
End

Public Sub CloseAccount_Click()
  AccountMenu.Hide()
End

Public Sub DragAction_Change()
  Dim wire As String
  Dim fields As String[]
  If Not DragAction.Text Then Return
  wire = DragAction.Text
  DragAction.Text = ""
  If $board = 0 Or $archive Then Error.Raise("Select an active board first")
  fields = Split(wire, "|")
  If fields.Count <> 5 Then Error.Raise("Invalid drag action")
  Select fields[0]
    Case "card"
      KanbanStore.MoveCard($board, CInt(UnBase64(fields[1])), UnBase64(fields[2]), UnBase64(fields[3]), CInt(UnBase64(fields[4])))
    Case "lane"
      KanbanStore.MoveLane($board, UnBase64(fields[1]), UnBase64(fields[4]))
    Case "list"
      KanbanStore.MoveList($board, UnBase64(fields[1]), UnBase64(fields[2]), UnBase64(fields[3]), UnBase64(fields[4]))
    Case Else
      Error.Raise("Invalid drag action")
  End Select
  RefreshTree()
Catch
  Notice.Text = Error.Text
  Visual.Refresh()
End
