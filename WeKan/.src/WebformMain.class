Private Sub UpdateHeader()
  Dim b As Result
  Dim overview As Boolean = Not $board And ($view = "Boards" Or $view = "Archive" Or $view = "Starred")
  ViewMenu.Visible = $view <> "Profile" And $view <> "Admin panel"
  AddBoard.Visible = ViewMenu.Visible And BoardCreation.Allowed()
  HeaderSearch.Visible = ViewMenu.Visible
  Remaining.Class = If($view = "Boards" And $spaceMenu = 0, "weba-active", "")
  Archive.Class = If($view = "Archive", "weba-active", "")
  BoardNavigation.Visible = $view <> "Admin panel"
  AdminNavigation.Visible = $view = "Admin panel"
  OverviewActions.Visible = overview And Not $archive
  SortBoards.Visible = overview
  BoardSearchPanel.Visible = overview And ($overviewSidebar <> "selection" Or Not BoardSelection.Active(SelectionState()))
  UpdateSelectionControls()
  DeletedLists.Visible = False
  If $board > 0 Then DeletedLists.Visible = BoardAccess.Can($board, "write")
  SearchTitle.Visible = Not overview
  Filter.Visible = Not overview
  Search.Visible = Not overview
  BoardPagination.Visible = overview And $catalogSort <> "custom"
  BoardPagination.Class = "weba-board-pagination" & If(BoardPagination.Visible, " boards-pagination", "")
  If Not overview Then BoardSortMenu.Hide()
  ContentRow.Expand = Not overview
  PaneTitle.Text = If($view = "Boards", "Remaining", $view)
  PaneTitle.Class = ""
  If overview And $view = "Boards" And $spaceMenu > 0 And $spaceNames.Exist(CStr($spaceMenu)) Then
    PaneTitle.Class = "weba-user-text"
    PaneTitle.Text = $spaceNames[CStr($spaceMenu)]
  Endif
  UpdateSpaceSelection()
  PageTitle.Text = If($view = "Boards", "All Boards", $view)
  If $board And $view <> "Profile" And $view <> "Admin panel" Then
    b = KanbanStore.Boards($archive)
    For Each b
      If b!id = $board Then PageTitle.Text = b!title
    Next
  Endif
  PageTitle.Tooltip = PageTitle.Text
  ViewMenu.Text = If($view = "Boards", "View", $view)
  ValidateBoardCreation()
  ValidateImportExportPolicy()
  ValidateMarkdownPolicy()
End

