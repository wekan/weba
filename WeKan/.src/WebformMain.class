Public Sub ColorWheel_Render()
  Dim value As String = ActionText.Text
  If Not IsHexColor(value) Then value = "#2980b9"
  Print "<input type=\"color\" class=\"weba-custom-color\" aria-labelledby=\"" & Html(CustomColorLabel.Name) & "\" value=\"" & Html(value) & "\" data-target=\"" & Html(ActionText.Name) & "\">"
End

Private Function IsHexColor(value As String) As Boolean
  Dim index As Integer
  If Len(value) <> 7 Or Left(value) <> "#" Then Return False
  For index = 2 To 7
    If InStr("0123456789abcdef", LCase(Mid(value, index, 1))) = 0 Then Return False
  Next
  Return True
End

Private Sub LoadDestinationBoards()
  Dim r As Result
  Dim values As New String[]
  Dim current As Integer
  r = KanbanStore.Boards(False)
  For Each r
    If r!id = $contextBoard Then current = values.Count
    values.Add(CStr(r!id) & " | " & r!title)
  Next
  DestinationBoard.List = values
  If values.Count Then DestinationBoard.Index = current
End

Private Function TargetBoard() As Integer
  If $action = "Move" And DestinationBoard.Text Then Return CInt(Split(DestinationBoard.Text, " | ")[0])
  Return $contextBoard
End

Public Sub DestinationBoard_Click()
  If $loadingDestinations Then Return
  LoadDestinationLanes()
Catch
  Notice.Text = Error.Text
End

Private Sub LoadDestinationLanes()
  Dim r As Result
  Dim values As New String[]
  r = KanbanStore.Lanes(TargetBoard())
  For Each r
    values.Add(r!title)
  Next
  DestinationLane.List = values
  If values.Count Then DestinationLane.Index = 0
  LoadDestinationLists()
End

Private Sub LoadDestinationLists()
  Dim r As Result
  Dim values As New String[]
  If DestinationLane.Text Then
    r = KanbanStore.Lists(TargetBoard(), DestinationLane.Text)
    For Each r
      values.Add(CStr(r!id) & " | " & r!title)
    Next
  Endif
  DestinationList.List = values
  If values.Count Then DestinationList.Index = 0
End

Public Sub DestinationLane_Click()
  LoadDestinationLists()
End

