Export
Private Function Whitespace(character As String) As Boolean
  Dim code As Integer = String.Code(character)
  Return (code >= 9 And code <= 13) Or code = 32 Or code = 160 Or code = 5760 Or (code >= 8192 And code <= 8202) Or code = 8232 Or code = 8233 Or code = 8239 Or code = 8287 Or code = 12288 Or code = 65279
End

Private Function TrimText(value As String) As String
  Dim first As Integer = 1
  Dim finish As Integer = String.Len(value)
  While first <= finish
    If Not Whitespace(String.Mid(value, first, 1)) Then Break
    Inc first
  Wend
  While finish >= first
    If Not Whitespace(String.Mid(value, finish, 1)) Then Break
    Dec finish
  Wend
  If finish < first Then Return ""
  Return String.Mid(value, first, finish - first + 1)
End

Public Function Parse(value As String) As Collection
  Dim result As New Collection
  Dim key As String
  Dim allowed As String[] = ["card-details", "board-header", "activities", "labels", "people", "board-info", "dates", "description", "custom-fields", "checklists", "subtasks", "comments", "attachments", "voting", "poker", "stickers", "locations", "dependencies", "sort", "scrum"]
  For Each key In Split(value, ",")
    key = TrimText(key)
    If allowed.Find(key) >= 0 Then result[key] = True
  Next
  If result.Count = 0 Then Return Null
  Return result
End

Public Function Wants(wanted As Collection, key As String) As Boolean
  If Not wanted Then Return True
  Return wanted.Exist(key)
End
