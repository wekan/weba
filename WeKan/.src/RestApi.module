' JSON REST entry point selected by the HTTP host; never trusts browser cookies.
Export

Public Sub Main()
  Dim payload As Collection
  Dim username As String
  Dim r As Result
  Dim rows As New Variant[]
  Dim item As Collection
  Dim fields As String[]
  Dim boardId As Integer
  Dim listId As Integer
  Dim cardId As Integer
  Dim ids As Integer[]
  Dim action As String
  Dim outcome As Collection
  Dim removed As Boolean
  If Env["WEBA_API_REQUEST"] <> "1" Then
    Reply(403, ErrorData("API host required"))
    Return
  Endif
  If LCase(Request.Path) Begins "/api" Then
    If Env["WITH_API"] <> "true" Then
      Reply(403, ErrorData("API is disabled; set WITH_API=true"))
      Return
    Endif
  Endif
  If Request.Path = "/users/login" Then
    If Request.Method <> "POST" Then
      Reply(405, ErrorData("Method not allowed"))
      Return
    Endif
    payload = JsonBody()
    If Not payload Then Return
    If Not payload.Exist("username") Or Not payload.Exist("password") Or payload.Count <> 2 Then
      Reply(400, ErrorData("Expected username and password"))
      Return
    Endif
    If TypeOf(payload["username"]) <> gb.String Or TypeOf(payload["password"]) <> gb.String Then
      Reply(400, ErrorData("Expected username and password strings"))
      Return
    Endif
    username = payload["username"]
    item = ApiTokens.Login(username, payload["password"])
    If Not item Then
      Reply(401, ErrorData("Invalid credentials"))
      Return
    Endif
    Reply(200, item)
    Return
  Endif
  username = ApiTokens.Authenticate()
  If Not username Then
    Reply(401, ErrorData("Invalid credentials"))
    Return
  Endif
  WebIdentity.AuthenticateApi(username)
  If Request.Path = "/users/logout" Then
    If Request.Method <> "POST" Then
      Reply(405, ErrorData("Method not allowed"))
      Return
    Endif
    payload = JsonBody()
    If Not payload Then Return
    If payload.Count > 1 Or (payload.Count = 1 And Not payload.Exist("all")) Then
      Reply(400, ErrorData("Expected optional all flag"))
      Return
    Endif
    If payload.Exist("all") Then
      If TypeOf(payload["all"]) <> gb.Boolean Then
        Reply(400, ErrorData("Expected boolean all flag"))
        Return
      Endif
    Endif
    ApiTokens.Revoke(payload["all"] = True)
    item = New Collection
    item["message"] = If(payload["all"] = True, "All login tokens have been invalidated.", "You've been logged out!")
    Reply(200, item)
    Return
  Endif
  If Env["WITH_API"] <> "true" Then
    Reply(403, ErrorData("API is disabled; set WITH_API=true"))
    Return
  Endif
  fields = Split(Request.Path, "/", "", True)
  If fields.Count = 4 Or fields.Count = 6 Then
    If fields[0] = "api" And fields[1] = "boards" Then
      action = ""
      listId = 0
      If fields.Count = 4 Then
        If fields[3] = "lists" Or fields[3] = "swimlanes" Or fields[3] = "cards_count" Then action = fields[3]
      Else If fields[3] = "lists" Then
        If fields[5] = "cards" Then action = "cards"
        If fields[5] = "cards_count" Then action = "list_cards_count"
      Endif
      If action Then
        If Request.Method <> "GET" Then
          Reply(405, ErrorData("Method not allowed"))
          Return
        Endif
        Try boardId = PositiveId(fields[2])
        If Error Then
          Reply(404, ErrorData("Board not found"))
          Return
        Endif
        If fields.Count = 6 Then
          Try listId = PositiveId(fields[4])
          If Error Then
            Reply(404, ErrorData("List not found"))
            Return
          Endif
        Endif
        outcome = BoardAccess.ReadApiBoard(boardId, action, listId)
        Reply(outcome["status"], outcome["data"])
        Return
      Endif
    Endif
  Endif
  If fields.Count = 7 Then
    If fields[0] = "api" And fields[1] = "boards" And fields[3] = "lists" And fields[5] = "cards" Then
      If Request.Method <> "PUT" Then
        Reply(405, ErrorData("Method not allowed"))
        Return
      Endif
      Try ids = [PositiveId(fields[2]), PositiveId(fields[4]), PositiveId(fields[6])]
      If Error Then
        Reply(404, ErrorData("Card not found"))
        Return
      Endif
      payload = JsonBody(True)
      If Not payload Then Return
      outcome = BoardAccess.UpdateApiCardPeople(ids[0], ids[1], ids[2], payload)
      Reply(outcome["status"], outcome["data"])
      Return
    Endif
  Endif
  If fields.Count = 9 Then
    If fields[0] = "api" And fields[1] = "boards" And fields[3] = "lists" And fields[5] = "cards" And (fields[7] = "members" Or fields[7] = "assignees") Then
      If Request.Method <> "POST" And Request.Method <> "DELETE" Then
        Reply(405, ErrorData("Method not allowed"))
        Return
      Endif
      Try ids = [PositiveId(fields[2]), PositiveId(fields[4]), PositiveId(fields[6])]
      If Error Then
        Reply(404, ErrorData("Card not found"))
        Return
      Endif
      boardId = ids[0]
      listId = ids[1]
      cardId = ids[2]
      outcome = BoardAccess.MutateApiCardPerson(boardId, listId, cardId, fields[7], fields[8], Request.Method = "POST")
      Reply(outcome["status"], outcome["data"])
      Return
    Endif
  Endif
  If fields.Count = 5 Or fields.Count = 6 Then
    If fields[0] = "api" And fields[1] = "boards" And fields[3] = "members" Then
      If Request.Method <> "POST" Then
        Reply(405, ErrorData("Method not allowed"))
        Return
      Endif
      Try boardId = PositiveId(fields[2])
      If Error Then
        Reply(404, ErrorData("Board not found"))
        Return
      Endif
      action = "set"
      If fields.Count = 6 Then
        action = fields[5]
        If action <> "add" And action <> "remove" Then
          Reply(404, ErrorData("API route not found"))
          Return
        Endif
      Endif
      payload = JsonBody()
      If Not payload Then Return
      outcome = BoardAccess.MutateApiMember(boardId, fields[4], action, payload)
      If outcome["empty"] = True Then
        ReplyEmpty(outcome["status"])
      Else
        Reply(outcome["status"], outcome["data"])
      Endif
      Return
    Endif
  Endif
  If fields.Count = 4 Then
    If fields[0] = "api" And fields[1] = "users" And fields[3] = "boards" And Request.Method = "GET" Then
      If fields[2] <> username Then
        Reply(403, ErrorData("User not accessible"))
        Return
      Endif
      r = KanbanStore.Boards(False)
      For Each r
        item = New Collection
        item["_id"] = CStr(r!id)
        item["title"] = r!title
        rows.Add(item)
      Next
      Reply(200, rows)
      Return
    Endif
  Endif
  If fields.Count = 3 Then
    If fields[0] = "api" And fields[1] = "users" Then
      If Request.Method <> "DELETE" Then
        Reply(405, ErrorData("Method not allowed"))
        Return
      Endif
      If Not WebDatabase.GetIsAdmin(username) Then
        Reply(403, ErrorData("Forbidden"))
        Return
      Endif
      If Not fields[2] Or Len(fields[2]) > 255 Then
        Reply(404, ErrorData("User not found"))
        Return
      Endif
      Try removed = WebDatabase.DeleteApiUser(fields[2])
      If Error Then
        Reply(500, ErrorData("User deletion failed"))
        Return
      Endif
      If Not removed Then
        Reply(404, ErrorData("User not found"))
        Return
      Endif
      item = New Collection
      item["_id"] = fields[2]
      Reply(200, item)
      Return
    Endif
    If fields[0] = "api" And fields[1] = "boards" And Request.Method = "GET" Then
      Try boardId = PositiveId(fields[2])
      If Error Then
        Reply(404, ErrorData("Board not found"))
        Return
      Endif
      outcome = BoardAccess.ReadApiBoard(boardId, "board")
      Reply(outcome["status"], outcome["data"])
      Return
    Endif
  Endif
  Reply(404, ErrorData("API route not found"))
Catch
  Reply(500, ErrorData("API request failed"))
End

Private Function PositiveId(value As String) As Integer
  Dim index As Integer
  Dim id As Integer
  If Not value Or Len(value) > 10 Then Error.Raise("Invalid ID")
  For index = 1 To Len(value)
    If InStr("0123456789", Mid(value, index, 1)) = 0 Then Error.Raise("Invalid ID")
  Next
  id = CInt(value)
  If id <= 0 Then Error.Raise("Invalid ID")
  Return id
End

Private Function JsonBody(Optional preserveNull As Boolean = False) As Collection
  Dim text As String
  Dim data As Variant
  Dim validated As Variant
  If LCase(Split(Request.ContentType, ";")[0]) <> "application/json" Then
    Reply(415, ErrorData("Expected application/json"))
    Return Null
  Endif
  If Request.ContentLength <= 0 Or Request.ContentLength > 1048576 Then
    Reply(400, ErrorData("Invalid JSON body length"))
    Return Null
  Endif
  text = Read Request.ContentLength
  If preserveNull Then
    ' Preserve first: a prior ordinary decode loses empty keys on Gambas 3.20.
    ' Separate ordinary validation rejects UseNull's undefined-only syntax.
    data = JSON.Decode(text, True)
    validated = JSON.Decode(text)
  Else
    data = JSON.Decode(text)
  Endif
  If Not (data Is Collection) Then
    Reply(400, ErrorData("Expected a JSON object"))
    Return Null
  Endif
  Return data
Catch
  Reply(400, ErrorData("Invalid JSON body"))
  Return Null
End

Private Function ErrorData(message As String) As Collection
  Dim data As New Collection
  data["error"] = message
  Return data
End

Private Sub Reply(status As Integer, data As Variant)
  Dim text As String = JSON.Encode(data)
  Print "Status: " & CStr(status)
  Print "Content-Type: application/json; charset=utf-8"
  Print "Cache-Control: no-store"
  Print
  Print text
End

Private Sub ReplyEmpty(status As Integer)
  Print "Status: " & CStr(status)
  Print "Cache-Control: no-store"
  Print
End
