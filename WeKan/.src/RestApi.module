' JSON REST entry point selected by the HTTP host; never trusts browser cookies.
Export

Public Sub Main()
  Dim payload As Collection
  Dim username As String
  Dim r As Result
  Dim rows As New Variant[]
  Dim item As Collection
  Dim fields As String[]
  Dim boardId As Integer
  Dim listId As Integer
  Dim cardId As Integer
  Dim ids As Integer[]
  Dim action As String
  Dim outcome As Collection
  Dim removed As Boolean
  If Env["WEBA_API_REQUEST"] <> "1" Then
    Reply(403, ErrorData("API host required"))
    Return
  Endif
  If LCase(Request.Path) Begins "/api" Then
    If Env["WITH_API"] <> "true" Then
      Reply(403, ErrorData("API is disabled; set WITH_API=true"))
      Return
    Endif
  Endif
  If Request.Path = "/users/login" Then
    If Request.Method <> "POST" Then
      Reply(405, ErrorData("Method not allowed"))
      Return
    Endif
    payload = JsonBody()
    If Not payload Then Return
    If Not payload.Exist("username") Or Not payload.Exist("password") Or payload.Count <> 2 Then
      Reply(400, ErrorData("Expected username and password"))
      Return
    Endif
    If TypeOf(payload["username"]) <> gb.String Or TypeOf(payload["password"]) <> gb.String Then
      Reply(400, ErrorData("Expected username and password strings"))
      Return
    Endif
    username = payload["username"]
    item = ApiTokens.Login(username, payload["password"])
    If Not item Then
      Reply(401, ErrorData("Invalid credentials"))
      Return
    Endif
    Reply(200, item)
    Return
  Endif
  fields = Split(Request.Path, "/", "", True)
  If IsAttachmentExport(fields) Then
    ExportAttachment(fields)
    Return
  Endif
  username = ApiTokens.Authenticate()
  If Not username Then
    Reply(401, ErrorData("Invalid credentials"))
    Return
  Endif
  WebIdentity.AuthenticateApi(username)
  If Request.Path = "/users/logout" Then
    If Request.Method <> "POST" Then
      Reply(405, ErrorData("Method not allowed"))
      Return
    Endif
    payload = JsonBody()
    If Not payload Then Return
    If payload.Count > 1 Or (payload.Count = 1 And Not payload.Exist("all")) Then
      Reply(400, ErrorData("Expected optional all flag"))
      Return
    Endif
    If payload.Exist("all") Then
      If TypeOf(payload["all"]) <> gb.Boolean Then
        Reply(400, ErrorData("Expected boolean all flag"))
        Return
      Endif
    Endif
    ApiTokens.Revoke(payload["all"] = True)
    item = New Collection
    item["message"] = If(payload["all"] = True, "All login tokens have been invalidated.", "You've been logged out!")
    Reply(200, item)
    Return
  Endif
  If Env["WITH_API"] <> "true" Then
    Reply(403, ErrorData("API is disabled; set WITH_API=true"))
    Return
  Endif
  If Request.Path = "/api/attachment/upload" Then
    If Request.Method <> "POST" Then
      Reply(405, AttachmentError("Method not allowed"))
    Else
      UploadAttachment()
    Endif
    Return
  Endif
  fields = Split(Request.Path, "/", "", True)
  If fields.Count >= 4 And fields.Count <= 7 Then
    If fields[0] = "api" And fields[1] = "attachment" And fields[2] = "list" Then
      If Request.Method <> "GET" Then
        Reply(405, AttachmentError("Method not allowed"))
        Return
      Endif
      While fields.Count < 7
        fields.Add("")
      Wend
      outcome = BoardAccess.ListApiAttachments(fields[3], fields[4], fields[5], fields[6])
      Reply(outcome["status"], outcome["data"])
      Return
    Endif
  Endif
  If fields.Count = 4 Then
    If fields[0] = "api" And fields[1] = "boards" And fields[3] = "attachments" Then
      If Request.Method <> "GET" Then
        Reply(405, AttachmentError("Method not allowed"))
        Return
      Endif
      outcome = BoardAccess.ListApiAttachments(fields[2], "", "", "")
      Reply(outcome["status"], outcome["data"])
      Return
    Endif
    If fields[0] = "api" And fields[1] = "attachment" And (fields[2] = "info" Or fields[2] = "download") Then
      If Request.Method <> "GET" Then
        Reply(405, AttachmentError("Method not allowed"))
        Return
      Endif
      outcome = BoardAccess.ReadApiAttachment(fields[3], fields[2] = "download", RawDownload())
      If outcome["raw"] = True Then
        ReplyAttachment(outcome)
      Else
        Reply(outcome["status"], outcome["data"])
      Endif
      Return
    Endif
    If fields[0] = "api" And fields[1] = "attachment" And fields[2] = "delete" Then
      If Request.Method <> "DELETE" Then
        Reply(405, ErrorData("Method not allowed"))
        Return
      Endif
      Try cardId = PositiveId(fields[3])
      If Error Then cardId = 0
      If cardId > 0 Then
        If Str(cardId) <> fields[3] Then cardId = 0
      Endif
      outcome = BoardAccess.DeleteApiAttachment(cardId, fields[3])
      Reply(outcome["status"], outcome["data"])
      Return
    Endif
  Endif
  If fields.Count = 5 Then
    If fields[0] = "api" And fields[1] = "boards" And fields[3] = "lists" Then
      If Request.Method <> "DELETE" Then
        Reply(405, ErrorData("Method not allowed"))
        Return
      Endif
      Try boardId = PositiveId(fields[2])
      If Error Then
        Reply(404, ErrorData("Board not found"))
        Return
      Endif
      Try listId = PositiveId(fields[4])
      If Error Then listId = 0
      If listId > 0 Then
        If Str(listId) <> fields[4] Then listId = 0
      Endif
      outcome = BoardAccess.DeleteApiList(boardId, listId, fields[4])
      Reply(outcome["status"], outcome["data"])
      Return
    Endif
  Endif
  If fields.Count = 4 Or fields.Count = 6 Then
    If fields[0] = "api" And fields[1] = "boards" Then
      action = ""
      listId = 0
      If fields.Count = 4 Then
        If fields[3] = "lists" Or fields[3] = "swimlanes" Or fields[3] = "cards_count" Then action = fields[3]
      Else If fields[3] = "lists" Then
        If fields[5] = "cards" Then action = "cards"
        If fields[5] = "cards_count" Then action = "list_cards_count"
      Endif
      If action Then
        If Request.Method <> "GET" Then
          Reply(405, ErrorData("Method not allowed"))
          Return
        Endif
        Try boardId = PositiveId(fields[2])
        If Error Then
          Reply(404, ErrorData("Board not found"))
          Return
        Endif
        If fields.Count = 6 Then
          Try listId = PositiveId(fields[4])
          If Error Then
            Reply(404, ErrorData("List not found"))
            Return
          Endif
        Endif
        outcome = BoardAccess.ReadApiBoard(boardId, action, listId)
        Reply(outcome["status"], outcome["data"])
        Return
      Endif
    Endif
  Endif
  If fields.Count = 8 Then
    If fields[0] = "api" And fields[1] = "boards" And fields[3] = "lists" And fields[5] = "cards" And (fields[7] = "archive" Or fields[7] = "unarchive") Then
      If Request.Method <> "POST" Then
        Reply(405, ErrorData("Method not allowed"))
        Return
      Endif
      Try boardId = PositiveId(fields[2])
      If Error Then
        Reply(404, ErrorData("Board not found"))
        Return
      Endif
      outcome = BoardAccess.ApiCardWriteAccess(boardId)
      If outcome["status"] <> 200 Then
        Reply(outcome["status"], outcome["data"])
        Return
      Endif
      Try ids = [boardId, PositiveId(fields[4]), PositiveId(fields[6])]
      If Error Then
        Reply(404, ErrorData("Card not found"))
        Return
      Endif
      outcome = BoardAccess.ArchiveApiCard(ids[0], ids[1], ids[2], fields[7] = "archive")
      Reply(outcome["status"], outcome["data"])
      Return
    Endif
  Endif
  If fields.Count = 7 Then
    If fields[0] = "api" And fields[1] = "boards" And fields[3] = "lists" And fields[5] = "cards" Then
      If Request.Method <> "PUT" And Request.Method <> "GET" Then
        Reply(405, ErrorData("Method not allowed"))
        Return
      Endif
      If Request.Method = "GET" Then
        Try boardId = PositiveId(fields[2])
        If Error Then
          Reply(404, ErrorData("Board not found"))
          Return
        Endif
        ' Authorize the board before interpreting the list/card identifiers.
        outcome = BoardAccess.ReadApiBoard(boardId, "access")
        If outcome["status"] <> 200 Then
          Reply(outcome["status"], outcome["data"])
          Return
        Endif
      Endif
      Try ids = [PositiveId(fields[2]), PositiveId(fields[4]), PositiveId(fields[6])]
      If Error Then
        Reply(404, ErrorData("Card not found"))
        Return
      Endif
      If Request.Method = "GET" Then
        outcome = BoardAccess.ReadApiBoard(ids[0], "card", ids[1], ids[2])
        Reply(outcome["status"], outcome["data"])
        Return
      Endif
      payload = JsonBody(True)
      If Not payload Then Return
      outcome = BoardAccess.UpdateApiCardPeople(ids[0], ids[1], ids[2], payload)
      Reply(outcome["status"], outcome["data"])
      Return
    Endif
  Endif
  If fields.Count = 9 Then
    If fields[0] = "api" And fields[1] = "boards" And fields[3] = "lists" And fields[5] = "cards" And (fields[7] = "members" Or fields[7] = "assignees") Then
      If Request.Method <> "POST" And Request.Method <> "DELETE" Then
        Reply(405, ErrorData("Method not allowed"))
        Return
      Endif
      Try ids = [PositiveId(fields[2]), PositiveId(fields[4]), PositiveId(fields[6])]
      If Error Then
        Reply(404, ErrorData("Card not found"))
        Return
      Endif
      boardId = ids[0]
      listId = ids[1]
      cardId = ids[2]
      outcome = BoardAccess.MutateApiCardPerson(boardId, listId, cardId, fields[7], fields[8], Request.Method = "POST")
      Reply(outcome["status"], outcome["data"])
      Return
    Endif
  Endif
  If fields.Count = 5 Or fields.Count = 6 Then
    If fields[0] = "api" And fields[1] = "boards" And fields[3] = "members" Then
      If Request.Method <> "POST" Then
        Reply(405, ErrorData("Method not allowed"))
        Return
      Endif
      Try boardId = PositiveId(fields[2])
      If Error Then
        Reply(404, ErrorData("Board not found"))
        Return
      Endif
      action = "set"
      If fields.Count = 6 Then
        action = fields[5]
        If action <> "add" And action <> "remove" Then
          Reply(404, ErrorData("API route not found"))
          Return
        Endif
      Endif
      payload = JsonBody()
      If Not payload Then Return
      outcome = BoardAccess.MutateApiMember(boardId, fields[4], action, payload)
      If outcome["empty"] = True Then
        ReplyEmpty(outcome["status"])
      Else
        Reply(outcome["status"], outcome["data"])
      Endif
      Return
    Endif
  Endif
  If fields.Count = 4 Then
    If fields[0] = "api" And fields[1] = "users" And fields[3] = "boards" And Request.Method = "GET" Then
      If fields[2] <> username Then
        Reply(403, ErrorData("User not accessible"))
        Return
      Endif
      r = KanbanStore.Boards(False)
      For Each r
        item = New Collection
        item["_id"] = CStr(r!id)
        item["title"] = r!title
        rows.Add(item)
      Next
      Reply(200, rows)
      Return
    Endif
  Endif
  If fields.Count = 3 Then
    If fields[0] = "api" And fields[1] = "cards" Then
      If Request.Method <> "GET" Then
        Reply(405, ErrorData("Method not allowed"))
        Return
      Endif
      Try cardId = PositiveId(fields[2])
      If Error Then
        Reply(404, ErrorData("Card not found"))
        Return
      Endif
      outcome = BoardAccess.ReadApiCard(cardId)
      Reply(outcome["status"], outcome["data"])
      Return
    Endif
    If fields[0] = "api" And fields[1] = "users" Then
      If Request.Method <> "DELETE" Then
        Reply(405, ErrorData("Method not allowed"))
        Return
      Endif
      If Not WebDatabase.GetIsAdmin(username) Then
        Reply(403, ErrorData("Forbidden"))
        Return
      Endif
      If Not fields[2] Or Len(fields[2]) > 255 Then
        Reply(404, ErrorData("User not found"))
        Return
      Endif
      Try removed = WebDatabase.DeleteApiUser(fields[2])
      If Error Then
        Reply(500, ErrorData("User deletion failed"))
        Return
      Endif
      If Not removed Then
        Reply(404, ErrorData("User not found"))
        Return
      Endif
      item = New Collection
      item["_id"] = fields[2]
      Reply(200, item)
      Return
    Endif
    If fields[0] = "api" And fields[1] = "boards" And Request.Method = "GET" Then
      Try boardId = PositiveId(fields[2])
      If Error Then
        Reply(404, ErrorData("Board not found"))
        Return
      Endif
      outcome = BoardAccess.ReadApiBoard(boardId, "board")
      Reply(outcome["status"], outcome["data"])
      Return
    Endif
  Endif
  Reply(404, ErrorData("API route not found"))
Catch
  Reply(500, ErrorData("API request failed"))
End

Private Function PositiveId(value As String) As Integer
  Dim index As Integer
  Dim id As Integer
  If Not value Or Len(value) > 10 Then Error.Raise("Invalid ID")
  For index = 1 To Len(value)
    If InStr("0123456789", Mid(value, index, 1)) = 0 Then Error.Raise("Invalid ID")
  Next
  id = CInt(value)
  If id <= 0 Then Error.Raise("Invalid ID")
  Return id
End

Private Function JsonBody(Optional preserveNull As Boolean = False) As Collection
  Dim text As String
  Dim data As Variant
  Dim validated As Variant
  If LCase(Split(Request.ContentType, ";")[0]) <> "application/json" Then
    Reply(415, ErrorData("Expected application/json"))
    Return Null
  Endif
  If Request.ContentLength <= 0 Or Request.ContentLength > 1048576 Then
    Reply(400, ErrorData("Invalid JSON body length"))
    Return Null
  Endif
  text = Read Request.ContentLength
  If preserveNull Then
    ' Preserve first: a prior ordinary decode loses empty keys on Gambas 3.20.
    ' Separate ordinary validation rejects UseNull's undefined-only syntax.
    data = JSON.Decode(text, True)
    validated = JSON.Decode(text)
  Else
    data = JSON.Decode(text)
  Endif
  If Not (data Is Collection) Then
    Reply(400, ErrorData("Expected a JSON object"))
    Return Null
  Endif
  Return data
Catch
  Reply(400, ErrorData("Invalid JSON body"))
  Return Null
End

Private Function ErrorData(message As String) As Collection
  Dim data As New Collection
  data["error"] = message
  Return data
End

Private Sub Reply(status As Integer, data As Variant)
  Dim text As String = JSON.Encode(data)
  Print "Status: " & CStr(status)
  Print "Content-Type: application/json; charset=utf-8"
  Print "Cache-Control: no-store"
  Print
  Print text
End

Private Sub ReplyEmpty(status As Integer)
  Print "Status: " & CStr(status)
  Print "Cache-Control: no-store"
  Print
End

Private Function AttachmentError(message As String) As Collection
  Dim data As New Collection
  data.Add(False, "success")
  data.Add(message, "error")
  Return data
End

Private Sub UploadAttachment()
  Dim data As New Collection
  Dim value As Variant
  Dim ids As New Integer[]
  Dim field As String
  Dim bytes As String
  Dim filename As String
  Dim mime As String
  Dim outcome As Collection
  Dim body As String
  Dim encoded As String
  If TransferPolicy.Blocked("apiUpload") Then
    Reply(403, AttachmentError("API uploads are disabled by administrator"))
    Return
  Endif
  If Request.ContentLength < 0 Or Request.ContentLength > 100663296 Then
    Reply(413, AttachmentError("Request payload exceeds server safety limit"))
    Return
  Endif
  If LCase(Split(Request.ContentType, ";")[0]) = "application/json" Then
    body = Read Request.ContentLength
    Try value = JSON.Decode(body)
    If Error Then
      Reply(400, AttachmentError("Invalid JSON body"))
      Return
    Endif
    If Not (value Is Collection) Then
      Reply(400, AttachmentError("Expected a JSON object"))
      Return
    Endif
    data = value
    If Not data.Exist("fileData") Then
      Reply(400, AttachmentError("Missing required parameters"))
      Return
    Endif
    If TypeOf(data["fileData"]) <> gb.String Then
      Reply(400, AttachmentError("Invalid fileData format"))
      Return
    Endif
    encoded = data["fileData"]
    If Not encoded Then
      Reply(400, AttachmentError("Missing required parameters"))
      Return
    Endif
    If Len(encoded) > Ceil(AttachmentData.ApiUploadLimit() * 4 / 3) + 4 Then
      Reply(413, AttachmentError("Attachment exceeds API upload limit"))
      Return
    Endif
    Try bytes = UnBase64(Replace(Replace(encoded, "-", "+"), "_", "/"))
    If Error Then
      Reply(400, AttachmentError("Invalid fileData format"))
      Return
    Endif
  Else
    For Each field In ["boardId", "swimlaneId", "listId", "cardId", "fileName", "fileType"]
      Try data.Add(UploadQuery(field), field)
      If Error Then
        Reply(400, AttachmentError("Invalid upload query"))
        Return
      Endif
    Next
    If Request.ContentLength > AttachmentData.ApiUploadLimit() Then
      Reply(413, AttachmentError("Attachment exceeds API upload limit"))
      Return
    Endif
    bytes = Read Request.ContentLength
    If Not data["fileType"] Then data["fileType"] = Request.ContentType
  Endif
  For Each field In ["boardId", "swimlaneId", "listId", "cardId", "fileName"]
    If Not data.Exist(field) Then
      Reply(400, AttachmentError("Missing required parameters"))
      Return
    Endif
    If TypeOf(data[field]) <> gb.String Or Not data[field] Then
      Reply(400, AttachmentError("Missing required parameters"))
      Return
    Endif
  Next
  For Each field In ["boardId", "swimlaneId", "listId", "cardId"]
    Try ids.Add(PositiveId(data[field]))
    If Error Then
      Reply(400, AttachmentError("Invalid attachment target"))
      Return
    Endif
    If Str(ids.Last) <> data[field] Then
      Reply(400, AttachmentError("Invalid attachment target"))
      Return
    Endif
  Next
  filename = String.Left(data["fileName"], 255)
  If Not File.Name(Replace(filename, "\\", "/")) Or InStr(filename, Chr(0)) Or InStr(filename, Chr(13)) Or InStr(filename, Chr(10)) Then
    Reply(400, AttachmentError("Invalid attachment name"))
    Return
  Endif
  mime = "application/octet-stream"
  If data.Exist("fileType") Then
    If TypeOf(data["fileType"]) <> gb.String Then
      Reply(400, AttachmentError("Invalid attachment type"))
      Return
    Endif
    If data["fileType"] Then mime = String.Left(data["fileType"], 255)
  Endif
  If InStr(mime, Chr(13)) Or InStr(mime, Chr(10)) Or InStr(mime, Chr(0)) Then
    Reply(400, AttachmentError("Invalid attachment type"))
    Return
  Endif
  outcome = BoardAccess.UploadApiAttachment(ids[0], ids[1], ids[2], ids[3], filename, bytes, mime)
  Reply(outcome["status"], outcome["data"])
Catch
  Reply(500, AttachmentError("Failed to upload attachment"))
End

Private Function UploadQuery(name As String) As String
  Dim pair As String
  Dim splitAt As Integer
  Dim found As Boolean
  Dim value As String
  Dim key As String
  For Each pair In Split(Env["QUERY_STRING"], "&")
    splitAt = InStr(pair, "=")
    If splitAt Then
      key = Cgi.Decode(Replace(Left(pair, splitAt - 1), "+", " "))
      If key <> name Then Continue
      If found Then Error.Raise("Duplicate upload parameter")
      found = True
      value = Cgi.Decode(Replace(Mid(pair, splitAt + 1), "+", " "))
    Endif
  Next
  Return value
End

Private Sub ReplyAttachment(outcome As Collection)
  Dim data As Collection = outcome["data"]
  Dim mime As String = data["fileType"]
  Dim i As Integer
  For i = 1 To Len(mime)
    If Asc(Mid(mime, i, 1)) < 32 Or Asc(Mid(mime, i, 1)) > 126 Then
      mime = "application/octet-stream"
      Break
    Endif
  Next
  Print "Status: 200"
  Print "Content-Type: " & mime
  Print "Cache-Control: no-store"
  Print "X-Content-Type-Options: nosniff"
  Print "Content-Security-Policy: default-src 'none'; sandbox"
  Print "X-WeBa-Download-Name: " & Base64(data["fileName"])
  Print
  Write outcome["bytes"]
End

Private Function RawDownload() As Boolean
  Dim pair As String
  Dim splitAt As Integer
  Dim count As Integer
  Dim key As String
  Dim value As String
  For Each pair In Split(Env["QUERY_STRING"], "&")
    splitAt = InStr(pair, "=")
    Try key = Cgi.Decode(Replace(If(splitAt > 0, Left(pair, splitAt - 1), pair), "+", " "))
    If Error Then Continue
    If key <> "raw" Then Continue
    count += 1
    ' The source's strict raw === '1' is false for a repeated query array.
    If count > 1 Then Return False
    value = ""
    If splitAt > 0 Then Try value = Cgi.Decode(Replace(Mid(pair, splitAt + 1), "+", " "))
    If Error Then Return False
  Next
  Return count = 1 And value = "1"
End

Private Function IsAttachmentExport(fields As String[]) As Boolean
  Dim path As String
  If fields.Count <> 6 Then Return False
  If fields[0] <> "api" Or fields[1] <> "boards" Or fields[3] <> "attachments" Or fields[5] <> "export" Then Return False
  path = "/api/boards/" & fields[2] & "/attachments/" & fields[4] & "/export"
  Return Request.Path = path Or Request.Path = path & "/"
End

Private Sub ExportAttachment(fields As String[])
  Dim boardId As Integer
  Dim actor As String
  Dim state As String = Env["WEBA_EXPORT_QUERY_STATE"]
  Dim outcome As Collection
  If Request.Method <> "GET" Then
    ReplyExport(405, ErrorData("Method not allowed"))
    Return
  Endif
  If Not ImportExportPolicy.ExportAllowed() Then
    ReplyPlain(403, "Export is disabled by the administrator.")
    Return
  Endif
  boardId = AttachmentExport.BoardId(fields[2])
  If boardId = 0 Then
    ReplyExport(404, ErrorData("Not found"))
    Return
  Endif
  If state = "too-long" Or state = "bad-query" Then
    ReplyExport(400, ErrorData("Bad request"))
    Return
  Endif
  actor = ApiTokens.Authenticate()
  If Not actor Then
    If state = "none" And Env["WEBA_EXPORT_HEADER_PRESENT"] <> "1" Then
      ReplyExport(403, ErrorData("Forbidden"))
    Else
      ReplyExport(401, ErrorData("Invalid token"))
    Endif
    Return
  Endif
  WebIdentity.AuthenticateApi(actor)
  outcome = AttachmentExport.Read(boardId, fields[4])
  If outcome["plain"] = True Then
    ReplyPlain(outcome["status"], outcome["data"]["error"])
  Else
    ReplyExport(outcome["status"], outcome["data"])
  Endif
End

Private Sub ReplyPlain(status As Integer, message As String)
  Print "Status: " & CStr(status)
  Print "Content-Type: text/plain; charset=utf-8"
  Print "Cache-Control: no-store"
  Print "X-Content-Type-Options: nosniff"
  Print
  Write message
End

Private Sub ReplyExport(status As Integer, data As Variant)
  Dim text As String = JSON.Encode(data)
  Print "Status: " & CStr(status)
  Print "Content-Type: application/json; charset=utf-8"
  Print "Cache-Control: no-store"
  Print "X-Content-Type-Options: nosniff"
  Print
  Print text
End
