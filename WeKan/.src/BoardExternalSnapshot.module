' Scoped native snapshots shared by validated external format renderers.
Export
Private $db As Connection
Private $boardId As Integer

Private Function TextValue(value As Variant) As String
  If IsNull(value) Then Return ""
  Return CStr(value)
End

Private Function Whitespace(character As String) As Boolean
  Dim code As Integer = String.Code(character)
  Return (code >= 9 And code <= 13) Or code = 32 Or code = 160 Or code = 5760 Or (code >= 8192 And code <= 8202) Or code = 8232 Or code = 8233 Or code = 8239 Or code = 8287 Or code = 12288 Or code = 65279
End

Private Function TrimText(value As String) As String
  Dim first As Integer = 1
  Dim finish As Integer = String.Len(value)
  While first <= finish
    If Not Whitespace(String.Mid(value, first, 1)) Then Break
    Inc first
  Wend
  While finish >= first
    If Not Whitespace(String.Mid(value, finish, 1)) Then Break
    Dec finish
  Wend
  If finish < first Then Return ""
  Return String.Mid(value, first, finish - first + 1)
End

Private Function CustomFields(cardId As Integer) As Collection
  Dim result As New Collection
  Dim rows As Result = $db.Find("kb_entries", "board_id=&1 AND card_id=&2 AND kind=&3 ORDER BY id", $boardId, cardId, "custom")
  Dim number As Float
  Dim value As Variant
  Dim numeric As Collection
  For Each rows
    If Not TextValue(rows!title) Then Continue
    Select TextValue(rows!value_type)
      Case "checkbox"
        value = CBool(rows!done)
      Case "number"
        If Not ExportNumber.ParseFinite(TextValue(rows!body), ByRef number) Then Error.Raise("Invalid numeric export field")
        ' Keep exact stored decimal text until JavaScript normalizes the value.
        numeric = New Collection
        numeric.Add(TextValue(rows!body), "number")
        value = numeric
      Case Else
        value = TextValue(rows!body)
    End Select
    result[TextValue(rows!title)] = value
  Next
  Return result
End


Private Function Checklists(cardId As Integer) As Variant[]
  Dim result As New Variant[]
  Dim rows As Result = $db.Find("kb_entries", "board_id=&1 AND card_id=&2 AND kind=&3 ORDER BY id", $boardId, cardId, "checklist")
  Dim entries As Result
  Dim checklist As Collection
  Dim item As Collection
  Dim items As Variant[]
  For Each rows
    checklist = New Collection
    checklist.Add(TextValue(rows!title), "title")
    items = New Variant[]
    entries = $db.Find("kb_entries", "board_id=&1 AND card_id=&2 AND kind=&3 AND parent_id=&4 ORDER BY id", $boardId, cardId, "checkitem", rows!id)
    For Each entries
      item = New Collection
      item.Add(TextValue(entries!title), "title")
      item.Add(CBool(entries!done), "done")
      items.Add(item)
    Next
    checklist.Add(items, "items")
    result.Add(checklist)
  Next
  Return result
End

Public Function Build(boardId As Integer, db As Connection, format As String) As String
  Dim output As New Collection
  Dim metadata As New Collection
  Dim items As New Variant[]
  Dim lists As New Variant[]
  Dim lanes As New Variant[]
  Dim board As Result
  Dim rows As Result
  Dim entries As Result
  Dim item As Collection
  Dim comment As Collection
  Dim comments As Variant[]
  Dim dates As Collection
  Dim key As String
  Dim people As String[]
  Dim members As String[]
  Dim person As String
  Dim labels As String[]
  Dim label As String
  Dim wip As String
  Dim limit As Float
  Dim folderNames As New Collection
  Dim laneName As String
  If format <> "taiga" And format <> "vikunja" And format <> "wrike" And format <> "teamwork" Then Error.Raise("Unknown snapshot export format")
  $db = db
  $boardId = boardId
  BoardAccess.RequireContainer(boardId, "board", boardId)
  board = db.Find("kb_boards", "id=&1", boardId)
  If Not board.Available Then Error.Raise("Board not found")
  If format = "wrike" Then
    entries = db.Exec("SELECT COUNT(*) AS total,COUNT(DISTINCT CASE WHEN c.lane IS NOT NULL AND c.lane<>&2 AND c.lane<>&3 THEN c.lane END) AS folders FROM kb_cards c WHERE " & ListDeletion.LiveSql("card", "c") & " AND c.board_id=&1 AND c.archived=&4", boardId, "", "Default", False)
    If CLong(entries!total) + CLong(entries!folders) + 1 > 65000 Then Error.Raise("Wrike export exceeds 65000 rows")
  Endif
  If format = "teamwork" Then
    entries = db.Exec("SELECT COUNT(*) AS total FROM kb_cards c WHERE " & ListDeletion.LiveSql("card", "c") & " AND c.board_id=&1 AND c.archived=&2", boardId, False)
    If CLong(entries!total) + 1 > 20000 Then Error.Raise("Teamwork export exceeds 20000 rows")
  Endif
  metadata.Add(TextValue(board!title), "title")
  metadata.Add(WorkspaceStore.Setting(boardId, "board", boardId, "description"), "description")
  rows = db.Find("kb_lists", ListDeletion.LiveSql("list", "kb_lists") & " AND board_id=&1 ORDER BY lane,sort_order,id", boardId)
  For Each rows
    item = New Collection
    item.Add(CStr(rows!id), "_id")
    item.Add(TextValue(rows!title), "title")
    item.Add(WorkspaceStore.Setting(boardId, "list", rows!id, "color"), "color")
    limit = 0
    If format = "taiga" Or format = "vikunja" Then
      wip = WorkspaceStore.Setting(boardId, "list", rows!id, "wip", "0")
      If Not ExportNumber.ParseFinite(wip, ByRef limit) Then Error.Raise("Invalid list WIP export value")
      If limit < 0 Then Error.Raise("Invalid list WIP export value")
    Endif
    comment = New Collection
    comment.Add(limit > 0, "enabled")
    comment.Add(limit, "value")
    item.Add(comment, "wipLimit")
    lists.Add(item)
  Next
  rows = db.Exec("SELECT l.title FROM kb_lanes l LEFT JOIN kb_order o ON o.board_id=l.board_id AND o.kind=&2 AND o.item=l.title WHERE " & ListDeletion.LiveSql("lane", "l") & " AND l.board_id=&1 ORDER BY COALESCE(o.sort_order,l.id),l.id", boardId, "lane")
  For Each rows
    item = New Collection
    item.Add(TextValue(rows!title), "title")
    lanes.Add(item)
  Next
  rows = db.Exec("SELECT c.*,l.title AS list_title,cl.list_id FROM kb_cards c LEFT JOIN kb_card_lists cl ON cl.board_id=c.board_id AND cl.card_id=c.id LEFT JOIN kb_lists l ON l.board_id=c.board_id AND l.id=cl.list_id LEFT JOIN kb_order o ON o.board_id=c.board_id AND o.kind=&2 AND o.item=CAST(c.id AS TEXT) WHERE " & ListDeletion.LiveSql("card", "c") & " AND c.board_id=&1 AND c.archived=&3 ORDER BY COALESCE(o.sort_order,c.id),c.id", boardId, "card", False)
  For Each rows
    item = New Collection
    item.Add(CStr(rows!id), "cardId")
    item.Add(TextValue(rows!title), "title")
    item.Add(TextValue(rows!description), "description")
    item.Add(TextValue(rows!lane), "swimlaneTitle")
    item.Add(TextValue(rows!list_id), "listId")
    item.Add(TextValue(rows!list_title), "listTitle")
    item.Add(WorkspaceStore.Setting(boardId, "card", rows!id, "color"), "color")
    item.Add(CustomFields(rows!id), "customFields")
    item.Add("", "creator")
    people = BoardAccess.Assignees(boardId, rows!id)
    members = BoardAccess.CardMembers(boardId, rows!id)
    For Each person In members
      people.Add(person)
    Next
    If people.Count Then
      item.Add(people[0], "owner")
      people.Remove(0)
    Else
      item.Add("", "owner")
    Endif
    item.Add(people, "assignees")
    labels = New String[]
    For Each label In Split(TextValue(rows!labels), ",")
      label = TrimText(label)
      If label Then labels.Add(label)
    Next
    item.Add(labels, "labels")
    dates = CardDates.ReadDates(boardId, rows!id)
    For Each key In ["dueAt", "endAt"]
      If dates.Exist(key) Then
        item.Add(CardDates.Iso(dates[key]), key)
      Else
        item.Add("", key)
      Endif
    Next
    If format = "vikunja" Or format = "wrike" Or format = "teamwork" Then
      If dates.Exist("startAt") Then
        item.Add(CardDates.Iso(dates["startAt"]), "startAt")
      Else
        item.Add("", "startAt")
      Endif
    Endif
    comments = New Variant[]
    entries = db.Find("kb_entries", "board_id=&1 AND card_id=&2 AND kind=&3 ORDER BY id", boardId, rows!id, "comment")
    For Each entries
      If Not TrimText(TextValue(entries!body)) Then Continue
      comment = New Collection
      comment.Add(TextValue(entries!body), "text")
      comment.Add(CardContent.AuthorName(boardId, rows!id, "entry", entries!id), "author")
      If Not IsNull(entries!created_at) Then
        comment.Add(CardDates.Iso(ItemChanges.Epoch(entries!created_at)), "date")
      Else
        comment.Add("", "date")
      Endif
      comments.Add(comment)
    Next
    item.Add(comments, "comments")
    item.Add(Checklists(rows!id), "checklists")
    entries = db.Find("kb_entries", "board_id=&1 AND kind=&2 AND amount=&3 ORDER BY id", boardId, "subtask", rows!id)
    If entries.Available Then
      item.Add(CStr(entries!card_id), "parentCardId")
    Else
      item.Add("", "parentCardId")
    Endif
    items.Add(item)
    If format = "wrike" Then
      laneName = TextValue(rows!lane)
      If laneName And laneName <> "Default" Then folderNames[laneName] = True
    Endif
  Next
  If format = "wrike" And items.Count + folderNames.Count + 1 > 65000 Then Error.Raise("Wrike export exceeds 65000 rows")
  If items.Count > If(format = "vikunja", 20000, If(format = "wrike", 65000, 50000)) Then Error.Raise("Too many cards for this export")
  output.Add(format, "format")
  output.Add(CardDates.Iso(ItemChanges.UtcNow()), "now")
  output.Add(metadata, "board")
  output.Add(lists, "lists")
  output.Add(lanes, "swimlanes")
  output.Add(items, "items")
  Return JSON.Encode(output)
End
