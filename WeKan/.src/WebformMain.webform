  }
  }
  }
  { AccountPanel WebContainer
    Visible = False
    Arrangement = Arrange.Horizontal
    Spacing = True
    { Fullname WebTextBox
      Tooltip = ("Full name")
    }
    { OldPassword WebTextBox
      Tooltip = ("Current password")
      Password = True
    }
    { NewPassword WebTextBox
      Tooltip = ("New password")
      Password = True
    }
    { SaveProfile WebButton
      Text = ("Save profile")
    }
    { ChangePassword WebButton
      Text = ("Change password")
    }
  }
  { AdminPanel WebContainer
    Visible = False
    Arrangement = Arrange.Horizontal
    Spacing = True
    { PasswordLength WebButton
      Text = ("Password Length")
    }
    { Username WebTextBox
      Tooltip = ("Username")
    }
    { UserPassword WebTextBox
      Tooltip = ("User password")
      Password = True
    }
    { CreateUser WebButton
      Text = ("Create Normal user")
    }
    { ResetPassword WebButton
      Text = ("Reset password")
    }
    { Promote WebButton
      Text = ("Set Admin")
    }
    { Demote WebButton
      Text = ("Set Normal")
    }
    { DeleteUser WebButton
      Text = ("Delete user")
    }
  }
  { PasswordPolicyPanel WebContainer
    Visible = False
    Arrangement = Arrange.Horizontal
    Spacing = True
    { PolicyTitle WebLabel
      Text = ("Admin Panel / Password Length")
    }
    { PolicyEnforce WebCheckBox
      Text = ("Enforce minimum password length")
    }
    { PolicyMinimum WebTextBox
      Text = "8"
      Tooltip = ("Minimum length, 1 to 256; only required when enforcement is enabled")
    }
    { SavePasswordPolicy WebButton
      Text = ("Save password length settings")
    }
  }
  { Notice WebLabel
    #MoveScaled(0,0,30,5)
