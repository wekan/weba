    Expand = True
    Class = "weba-visual"
  }
  }
  { Editor WebContainer
    Width = "300px"
    Arrangement = Arrange.Vertical
    Spacing = True
  { CardHeading WebLabel
    #MoveScaled(0,0,30,5)
    Text = ("Card details")
  }
  { Help WebLabel
    #MoveScaled(0,0,30,5)
    Text = ("Select a card in the tree, or create a new card.")
  }
  { CardTitleCaption WebLabel
    #MoveScaled(0,0,30,5)
    Text = ("Title")
  }
  { CardTitle WebTextBox
    #MoveScaled(0,0,30,5)
  }
  { DescriptionCaption WebLabel
    #MoveScaled(0,0,30,5)
    Text = ("Description")
  }
  { Description WebTextBox
    #MoveScaled(0,0,30,5)
  }
  { LaneCaption WebLabel
    #MoveScaled(0,0,30,5)
    Text = ("Swimlane")
  }
  { Lane WebTextBox
    #MoveScaled(0,0,30,5)
  }
