# Gambas Form File 3.0

{ WebForm WebForm
  Title = ("WeKan")
  Class = "weba-shell"
  Height = "100vh"
  Arrangement = Arrange.Vertical
  { Header WebContainer
    Class = "weba-topbar"
    Arrangement = Arrange.Horizontal
    { Home WebButton
      Class = "weba-icon-only fa fa-home"
      Tooltip = ("All Boards")
    }
    { ToggleNavigation WebButton
      Class = "weba-icon-only fa fa-bars"
      Tooltip = ("Show or hide navigation")
    }
    { PageTitle WebLabel
      Text = ("All Boards")
    }
    { Brand WebLabel
      Text = ("WeKan ®")
    }
    { HeaderSpace WebContainer
      Class = "weba-header-space"
      Arrangement = Arrange.Vertical
      Expand = True
    }
    { AddBoard WebButton
      Class = "weba-icon-only fa fa-plus"
      Tooltip = ("Add Board")
    }
    { HeaderSearch WebButton
      Class = "weba-icon-only fa fa-search"
      Tooltip = ("Search")
    }
    { ViewMenu WebButton
      Class = "weba-native-caret"
      Text = ("View")
    }
    { AccountToggle WebButton
      Class = "weba-native-caret"
      Text = ("Account")
    }
    { SidebarToggle WebButton
      Class = "weba-icon-only fa fa-bars"
      Tooltip = ("Show or hide page sidebar")
    }
  }
  { Views WebContainer
    Class = "weba-view-options"
    Arrangement = Arrange.Vertical
    Visible = False
    Ignore = True
    { Swimlanes WebButton
      Text = ("Swimlanes")
    }
    { Kanban WebButton
      Text = ("Lists")
    }
    { Calendar WebButton
      Text = ("Calendar")
    }
    { Gantt WebButton
      Text = ("Gantt")
    }
    { TableView WebButton
      Text = ("Table")
    }
    { Charts WebButton
      Text = ("Charts")
    }
  }
  { AccountMenu WebContainer
    Class = "weba-account-menu"
    Arrangement = Arrange.Vertical
    Visible = False
    Ignore = True
    { LanguageSelector WebContainer
      Height = "36px"
    }
    { MyCards WebButton
      Text = ("My cards")
    }
    { DueCards WebButton
      Text = ("Due cards")
    }
    { Profile WebButton
      Text = ("Profile")
    }
    { Admin WebButton
      Text = ("Admin panel")
    }
    { Logout WebButton
      Text = ("Logout")
    }
  }
  { BoardAction WebTextBox
    Visible = False
  }
  { Body WebContainer
    Class = "weba-body"
    Arrangement = Arrange.Horizontal
    Expand = True
    { LeftNavigation WebContainer
      Class = "weba-navigation"
      Arrangement = Arrange.Vertical
      Width = "210px"
      { BoardNavigation WebContainer
        Class = "weba-board-navigation"
        Arrangement = Arrange.Vertical
        Expand = True
        { Remaining WebButton
          Text = ("Remaining")
        }
        { Archive WebButton
          Text = ("Archive")
        }
        { TreeHeading WebLabel
          Text = ("Boards")
        }
        { Boards WebTree
          Expand = True
          Width = "100%"
        }
      }
      { AdminNavigation WebContainer
        Class = "weba-admin-navigation"
        Arrangement = Arrange.Vertical
        Visible = False
        { AdminPeopleTitle WebLabel
          Text = ("People")
        }
        { AdminUsers WebButton
          Text = ("People")
        }
        { AdminProblemsTitle WebLabel
          Text = ("Problems")
        }
        { PasswordLength WebButton
          Text = ("Password Length")
        }
      }
    }
    { Workspace WebContainer
      Class = "weba-workspace"
      Arrangement = Arrange.Vertical
      Expand = True
      { PaneTitle WebLabel
        Text = ("Remaining")
      }
      { ContentRow WebContainer
        Class = "weba-content-row"
        Arrangement = Arrange.Horizontal
        Expand = True
        { Visual WebContainer
          Expand = True
          Class = "weba-visual"
        }
        { Editor WebContainer
          Class = "weba-editor"
          Visible = False
          Ignore = True
          Arrangement = Arrange.Vertical
          Spacing = True
          Width = "340px"
          { CloseEditor WebButton
      Class = "weba-icon-only fa fa-times-thin"
            Tooltip = ("Close card details")
          }
          { CardHeading WebLabel
            Text = ("Card details")
          }
          { Help WebLabel
            Text = ("Select a card in the tree, or create a new card.")
          }
          { CardTitleCaption WebLabel
            Text = ("Title")
          }
          { CardTitle WebTextBox
          }
          { LabelsCaption WebLabel
            Text = ("Labels")
          }
          { Labels WebTextBox
          }
          { AssigneeCaption WebLabel
            Text = ("Assignee")
          }
          { Assignee WebTextBox
          }
          { DescriptionCaption WebLabel
            Text = ("Description")
          }
          { Description WebTextBox
          }
          { LaneCaption WebLabel
            Text = ("Swimlane")
          }
          { Lane WebTextBox
          }
          { StatusCaption WebLabel
            Text = ("List")
          }
          { Status WebTextBox
          }
          { DueDayCaption WebLabel
            Text = ("Due date: YYYY-MM-DD")
          }
          { DueDay WebTextBox
          }
          { SaveCard WebButton
            Text = ("Save card")
          }
          { ArchiveCard WebButton
            Text = ("Archive / restore card")
          }
        }
      }
      { OverviewActions WebContainer
        Class = "weba-overview-actions"
        Arrangement = Arrange.Vertical
        { AddBoardTile WebButton
          Text = ("Add Board")
          Class = "weba-with-plus"
        }
      }
      { AccountPanel WebContainer
        Visible = False
        Spacing = True
        Arrangement = Arrange.Vertical
        Class = "weba-settings-panel"
        { Fullname WebTextBox
          Tooltip = ("Full name")
        }
        { OldPassword WebTextBox
          Tooltip = ("Current password")
          Password = True
        }
        { NewPassword WebTextBox
          Tooltip = ("New password")
          Password = True
        }
        { SaveProfile WebButton
          Text = ("Save profile")
        }
        { ChangePassword WebButton
          Text = ("Change password")
        }
      }
      { PasswordPolicyPanel WebContainer
        Visible = False
        Spacing = True
        Arrangement = Arrange.Vertical
        Class = "weba-settings-panel"
        { PolicyTitle WebLabel
          Text = ("Admin Panel / Password Length")
        }
        { PolicyEnforce WebCheckBox
          Text = ("Enforce minimum password length")
        }
        { PolicyMinimum WebTextBox
          Text = "8"
          Tooltip = ("Minimum length, 1 to 256; only required when enforcement is enabled")
        }
        { SavePasswordPolicy WebButton
          Text = ("Save password length settings")
        }
      }
    }
    { PageSidebar WebContainer
      Class = "weba-page-sidebar"
      Arrangement = Arrange.Vertical
      Width = "300px"
      Visible = False
      { CloseSidebar WebButton
      Class = "weba-icon-only fa fa-times-thin"
        Tooltip = ("Close page sidebar")
      }
      { PageActions WebContainer
        Class = "weba-page-actions"
        Arrangement = Arrange.Vertical
        Spacing = True
        { ActionsTitle WebLabel
          Text = ("Board menu")
        }
        { BoardTitle WebTextBox
          Tooltip = ("Board title")
        }
        { NewBoard WebButton
          Text = ("Create board")
        }
        { ArchiveBoard WebButton
          Text = ("Archive board")
        }
        { NewCard WebButton
          Text = ("New card")
        }
        { SearchTitle WebLabel
          Text = ("Search")
        }
        { Filter WebTextBox
          Tooltip = ("Search cards")
        }
        { Search WebButton
          Text = ("Search")
        }
        { Activities WebButton
          Text = ("Activities")
        }
      }
      { AdminPanel WebContainer
        Visible = False
        Class = "weba-admin-actions"
        Arrangement = Arrange.Vertical
        Spacing = True
        { Username WebTextBox
          Tooltip = ("Username")
        }
        { UserPassword WebTextBox
          Tooltip = ("User password")
          Password = True
        }
        { CreateUser WebButton
          Text = ("Create Normal user")
        }
        { ResetPassword WebButton
          Text = ("Reset password")
        }
        { Promote WebButton
          Text = ("Set Admin")
        }
        { Demote WebButton
          Text = ("Set Normal")
        }
        { DeleteUser WebButton
          Text = ("Delete user")
        }
      }
    }
  }
  { Notice WebLabel
  }
}
