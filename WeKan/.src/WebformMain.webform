# Gambas Form File 3.0

{ WebForm WebForm
  #MoveScaled(0,0,180,110)
  Title = ("WeKan")
  Height = "100%"
  Arrangement = Arrange.Vertical
  Margin = True
  Spacing = True
  { Header WebContainer
    Arrangement = Arrange.Horizontal
    Spacing = True
  { Home WebButton
    #MoveScaled(0,0,30,5)
    Text = ("Boards")
  }
  { MyCards WebButton
    #MoveScaled(0,0,30,5)
    Text = ("My cards")
  }
  { DueCards WebButton
    #MoveScaled(0,0,30,5)
    Text = ("Due cards")
  }
  { Archive WebButton
    #MoveScaled(0,0,30,5)
    Text = ("Archive")
  }
  { Profile WebButton
    #MoveScaled(0,0,30,5)
    Text = ("Profile")
  }
  { Admin WebButton
    #MoveScaled(0,0,30,5)
    Text = ("Admin panel")
  }
  { Logout WebButton
    #MoveScaled(0,0,30,5)
    Text = ("Logout")
  }
  }
  { Toolbar WebContainer
    Arrangement = Arrange.Horizontal
    Spacing = True
  { BoardTitle WebTextBox
    #MoveScaled(0,0,30,5)
    Tooltip = ("Board title")
  }
  { Filter WebTextBox
    #MoveScaled(0,0,30,5)
