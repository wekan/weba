  }
  { NewBoard WebButton
    #MoveScaled(0,0,30,5)
    Text = ("Create board")
  }
  { ArchiveBoard WebButton
    #MoveScaled(0,0,30,5)
    Text = ("Archive board")
  }
  { Search WebButton
    #MoveScaled(0,0,30,5)
    Text = ("Search")
  }
  }
  { Body WebContainer
    Expand = True
    Arrangement = Arrange.Horizontal
    Spacing = True
  { Boards WebTree
    #MoveScaled(0,0,30,5)
    Width = "220px"
    Expand = True
  }
  { Workspace WebContainer
    Expand = True
    Arrangement = Arrange.Vertical
    Spacing = True
  { Views WebContainer
    Arrangement = Arrange.Horizontal
    Spacing = True
  { Kanban WebButton
    #MoveScaled(0,0,30,5)
    Text = ("Lists")
  }
  { Swimlanes WebButton
    #MoveScaled(0,0,30,5)
    Text = ("Swimlanes")
  }
  { TableView WebButton
    #MoveScaled(0,0,30,5)
    Text = ("Table")
  }
  { Calendar WebButton
    #MoveScaled(0,0,30,5)
    Text = ("Calendar")
  }
  { Gantt WebButton
