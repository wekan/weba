' Source tableVisibilityMode-boardCreationAdminOnly policy for working boards.
Export
Private $db As Connection

Public Sub OpenStore()
  Dim t As Table
  If $db Then Return
  $db = WebDatabase.OpenConnection()
  If Not $db.Tables.Exist("board_creation_settings") Then
    t = $db.Tables.Add("board_creation_settings")
    t.Fields.Add("id", db.Integer)
    t.Fields.Add("admin_only", db.Boolean)
    t.Fields.Add("actor", db.String, 255)
    t.Fields.Add("changed_ms", db.Long)
    t.PrimaryKey = ["id"]
    t.Update()
  Endif
  If Not $db.Find("board_creation_settings", "id=1").Available Then
    Try $db.Exec("INSERT INTO board_creation_settings (id) SELECT 1 WHERE NOT EXISTS (SELECT 1 FROM board_creation_settings WHERE id=1)")
    If Error Then
      If Not $db.Find("board_creation_settings", "id=1").Available Then Error.Propagate()
    Endif
  Endif
Catch
  $db = Null
  Error.Propagate()
End

Public Function Decision(adminOnly As Variant, isAdmin As Variant, kind As Variant) As Boolean
  If TypeOf(adminOnly) <> gb.Boolean Then Return True
  If Not CBool(adminOnly) Then Return True
  If TypeOf(isAdmin) = gb.Boolean Then
    If CBool(isAdmin) Then Return True
  Endif
  If TypeOf(kind) <> gb.String Then Return False
  Return kind = "template-board"
End

Public Function AdminOnly() As Boolean
  Dim r As Result
  OpenStore()
  r = $db.Find("board_creation_settings", "id=1")
  If IsNull(r!admin_only) Then Return False
  Return r!admin_only
End

Public Function Allowed() As Boolean
  Dim actor As String = WebIdentity.Username
  If Not actor Then Return False
  Return Decision(AdminOnly(), WebDatabase.GetIsAdmin(actor), "board")
End

Public Sub Require()
  If Not Allowed() Then Error.Raise("Board creation is restricted to admins.")
End

Public Sub Lock()
  OpenStore()
  $db.Exec("UPDATE board_creation_settings SET id=id WHERE id=1")
End

Public Function Settings() As Collection
  Dim data As New Collection
  Dim r As Result
  RecoveryStore.RequireAdmin()
  OpenStore()
  r = $db.Find("board_creation_settings", "id=1")
  data["adminOnly"] = AdminOnly()
  data.Add(r!actor, "actor")
  data.Add(r!changed_ms, "changedMs")
  Return data
End

Public Sub SetAdminOnly(value As Variant)
  Dim actor As String = WebIdentity.Username
  Dim r As Result
  Dim transaction As Boolean
  Dim failure As String
  RecoveryStore.RequireAdmin()
  If TypeOf(value) <> gb.Boolean Then Error.Raise("Expected a boolean setting")
  OpenStore()
  DatabaseTransactions.Begin($db)
  transaction = True
  $db.Exec("UPDATE users SET username=username WHERE username=&1", actor)
  Lock()
  If WebIdentity.Username <> actor Then Error.Raise("Administrator required")
  RecoveryStore.RequireAdmin()
  r = $db.Edit("board_creation_settings", "id=1")
  r["admin_only"] = value
  r["actor"] = actor
  r["changed_ms"] = ItemChanges.UtcNow()
  r.Update()
  If WebIdentity.Username <> actor Then Error.Raise("Administrator required")
  RecoveryStore.RequireAdmin()
  If AdminOnly() <> value Then Error.Raise("Board creation setting changed")
  DatabaseTransactions.Commit($db)
  transaction = False
Catch
  failure = Error.Text
  If transaction Then Try DatabaseTransactions.Rollback($db)
  Error.Raise(failure)
End
