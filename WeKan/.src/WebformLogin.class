' Gambas class file

Export

Private $registerMode As Boolean

Public Sub _new()

  WebForm.Debug = False
  WebLabelVersion.Text = "v" & Application.Version

End


Public Sub WebForm_Open()

  WebTextName.SetFocus()

End

Public Sub WebButtonLogin_Click()

  Login()

End


Public Sub WebTextName_Activate()

  WebTextPass.SetFocus()

End

Public Sub WebTextPass_Activate()

  If $registerMode Then
    Register_Click()
  Else
    Login()
  Endif

End

Private Sub Login()

  Dim sUsername As String
  Dim sPassword As String

  'Loading of the * .ini file if present
  'ModFunction.Load_File_Init()

  sUsername = Trim(WebTextName.Text)
  If Not sUsername Then
    WebNoticeText.Text = "Username is empty..."

    WebInfo.show()

    WebTimer1.Start()

    WebTextName.SetFocus(True)
    Return
  Endif

  sPassword = WebTextPass.Text
  If Not sPassword Then

    WebNoticeText.Text = "Password is empty..."

    WebInfo.show()

    WebTimer1.Start()

    WebTextPass.SetFocus(True)
    Return
  Endif

  If WebDatabase.Login(sUsername, sPassword) Then

    ' Create a new Session
    Session["username"] = sUsername
    Session.Timeout = ModVar.SessionTimeout

    ModVar.SessionStartTime = Timer

    WebForm.Goto(WebFormMain)

  Else

    WebNoticeText.Text = "Username or Password incorrect..."

    WebInfo.show()

    WebTimer1.Start()

    WebTextName.SetFocus(True)
  Endif

Catch
  WebNoticeText.Text = "Sign in could not be completed"
  WebInfo.Show()


End

Public Sub WebTimer1_Timer()

  WebTimer1.Stop()

  WebInfo.Hide()

End

Public Sub Register_Click()
  If Not $registerMode Then
    ShowRegistration_Click()
    Return
  Endif
  If WebTextPass.Text <> ConfirmPassword.Text Then
    WebNoticeText.Text = "Passwords do not match"
    WebInfo.Show()
    WebTimer1.Start()
    Return
  Endif
  Try WebDatabase.Register(Trim(WebTextName.Text), WebTextPass.Text)
  If Error Then
    WebNoticeText.Text = WebDatabase.RegistrationError
    WebInfo.Show()
    WebTimer1.Start()
    Return
  Endif
  Login()
End

Public Sub ShowRegistration_Click()
  $registerMode = True
  RegistrationPanel.Show()
  ShowRegistration.Hide()
  WebButtonLogin.Hide()
  WebForm.Title = "Register"
  ConfirmPassword.Text = ""
  ConfirmPassword.Password = True
  ShowConfirmPassword.Class = "weba-password-toggle fa-eye"
  ShowConfirmPassword.Tooltip = "Show password"
End

Public Sub ShowLogin_Click()
  $registerMode = False
  RegistrationPanel.Hide()
  ShowRegistration.Show()
  WebButtonLogin.Show()
  WebForm.Title = "Login"
  ConfirmPassword.Text = ""
End

Public Sub ShowPassword_Click()
  WebTextPass.Password = Not WebTextPass.Password
  ShowPassword.Class = "weba-password-toggle " & If(WebTextPass.Password, "fa-eye", "fa-eye-slash")
  ShowPassword.Tooltip = If(WebTextPass.Password, "Show password", "Hide password")
End

Public Sub ShowConfirmPassword_Click()
  ConfirmPassword.Password = Not ConfirmPassword.Password
  ShowConfirmPassword.Class = "weba-password-toggle " & If(ConfirmPassword.Password, "fa-eye", "fa-eye-slash")
  ShowConfirmPassword.Tooltip = If(ConfirmPassword.Password, "Show password", "Hide password")
End

Public Sub ConfirmPassword_Activate()
  Register_Click()
End

Public Sub LanguageSelector_Render()
  Print "<link rel=\"stylesheet\" href=\"fontawesome.css\">"
  Print "<script>" & File.Load(".public/i18n-catalog.js") & File.Load(".public/i18n.js") & File.Load(".public/ui.js") & "</script>"
  Print "<select data-weba-language aria-label=\"Language\" style=\"width:100%;height:32px;background:white;color:black\"></select>"
End
