 ' Gambas module file

Export

Private $db As Connection

Public Sub OpenDatabase()
  Dim t As Table
  If $db Then Return
  $db = WebDatabase.OpenConnection()
  ' The driver maps Gambas field types and primary keys to its SQL dialect.
  If Not $db.Tables.Exist("kb_boards") Then
    t = $db.Tables.Add("kb_boards")
    t.Fields.Add("id", db.Serial)
    t.Fields.Add("owner", db.String, 255)
    t.Fields.Add("title", db.String, 255)
    t.Fields.Add("archived", db.Boolean)
    t.PrimaryKey = ["id"]
    t.Update()
  Endif
  If Not $db.Tables.Exist("kb_cards") Then
    t = $db.Tables.Add("kb_cards")
    t.Fields.Add("id", db.Serial)
    t.Fields.Add("board_id", db.Integer)
    t.Fields.Add("title", db.String, 255)
    t.Fields.Add("description", db.String)
    t.Fields.Add("lane", db.String, 255)
    t.Fields.Add("status", db.String, 32)
    t.Fields.Add("assignee", db.String, 255)
    t.Fields.Add("labels", db.String, 255)
    t.Fields.Add("due_day", db.String, 10)
    t.Fields.Add("archived", db.Boolean)
    t.PrimaryKey = ["id"]
    t.Update()
  Endif
  If Not $db.Tables.Exist("kb_lanes") Then
    t = $db.Tables.Add("kb_lanes")
    t.Fields.Add("id", db.Serial)
    t.Fields.Add("board_id", db.Integer)
    t.Fields.Add("title", db.String, 255)
    t.PrimaryKey = ["id"]
    t.Update()
    t.Indexes.Add("kb_lane_title", ["board_id", "title"], True)
  Endif
  If Not $db.Tables.Exist("kb_lists") Then
    t = $db.Tables.Add("kb_lists")
    t.Fields.Add("id", db.Serial)
    t.Fields.Add("board_id", db.Integer)
    t.Fields.Add("lane", db.String, 255)
    t.Fields.Add("title", db.String, 32)
    t.Fields.Add("sort_order", db.Integer)
    t.PrimaryKey = ["id"]
    t.Update()
  Endif
  t = $db.Tables["kb_lists"]
  If t.Indexes.Exist("kb_list_title") Then t.Indexes.Remove("kb_list_title")
  If Not $db.Tables.Exist("kb_card_lists") Then
    t = $db.Tables.Add("kb_card_lists")
    t.Fields.Add("card_id", db.Integer)
    t.Fields.Add("board_id", db.Integer)
    t.Fields.Add("list_id", db.Integer)
    t.PrimaryKey = ["card_id"]
    t.Update()
  Endif
  If Not $db.Tables.Exist("kb_order") Then
    t = $db.Tables.Add("kb_order")
    t.Fields.Add("board_id", db.Integer)
    t.Fields.Add("kind", db.String, 16)
    t.Fields.Add("item", db.String, 255)
    t.Fields.Add("sort_order", db.Integer)
    t.PrimaryKey = ["board_id", "kind", "item"]
    t.Update()
  Endif
  If Not $db.Tables.Exist("kb_activity") Then
    t = $db.Tables.Add("kb_activity")
    t.Fields.Add("id", db.Serial)
    t.Fields.Add("board_id", db.Integer)
    t.Fields.Add("actor", db.String, 255)
    t.Fields.Add("message", db.String)
    t.Fields.Add("created_at", db.Date)
    t.PrimaryKey = ["id"]
    t.Update()
  Endif
End

Private Sub RequireUser()
  If Not WebIdentity.Username Then Error.Raise("Please sign in")
  If Not WebDatabase.UserExists(WebIdentity.Username) Then Error.Raise("Unknown user")
  OpenDatabase()
End

Public Function Boards(Optional archived As Boolean = False) As Result
  RequireUser()
  BoardAccess.OpenStore()
  Return $db.Find("kb_boards", "archived = &1 AND (owner = &2 OR id IN (SELECT board_id FROM kb_members WHERE username = &2 AND role IN ('board-admin','normal','no-comments','comment-only','read-only','normal-assigned-only','comment-assigned-only','read-assigned-only','worker'))) ORDER BY title", archived, WebIdentity.Username)
End

Public Sub RequireBoard(boardId As Integer)
  RequireUser()
  BoardAccess.RequireRead(boardId)
End

Public Function AddBoard(title As String) As Integer
  Dim r As Result
  RequireUser()
  If Not Trim(title) Then Error.Raise("Enter a board title")
  r = $db.Create("kb_boards")
  r["owner"] = WebIdentity.Username
  r["title"] = Trim(title)
  r["archived"] = False
  r.Update()
  Return $db.LastInsertId
End

Public Sub ArchiveBoard(boardId As Integer, archived As Boolean)
  Dim r As Result
  BoardAccess.Require(boardId, "manageBoard")
  r = $db.Edit("kb_boards", "id = &1", boardId)
  r["archived"] = archived
  r.Update()
  Activity(boardId, "Board archive state changed")
End

Public Function Cards(boardId As Integer, Optional archived As Boolean = False) As Result
  RequireBoard(boardId)
  Return BoardAccess.CardRows(boardId, True, archived)
End

Public Function SaveCard(boardId As Integer, cardId As Integer, title As String, description As String, lane As String, status As String, assignee As String, labels As String, dueDay As String, Optional listId As Integer) As Integer
  Dim r As Result
  Dim list As Result
  Dim previousAssignee As String
  BoardAccess.Require(boardId, "write")
  If cardId Then
    BoardAccess.RequireCard(boardId, cardId)
    r = $db.Find("kb_cards", "board_id = &1 AND id = &2", boardId, cardId)
    previousAssignee = r!assignee
  Endif
  If Not Trim(lane) Then lane = "Default"
  If Not Trim(title) Then Error.Raise("Enter a card title")
  If status <> "Todo" And status <> "Doing" And status <> "Done" Then
    list = $db.Find("kb_lists", "board_id = &1 AND lane = &2 AND title = &3", boardId, lane, status)
    If Not list.Available Then Error.Raise("Invalid status")
  Endif
  If dueDay Then
    If Len(dueDay) <> 10 Then Error.Raise("Use YYYY-MM-DD")
    If Mid(dueDay, 5, 1) <> "-" Or Mid(dueDay, 8, 1) <> "-" Then Error.Raise("Use YYYY-MM-DD")
    If Format(Date(CInt(Left(dueDay, 4)), CInt(Mid(dueDay, 6, 2)), CInt(Right(dueDay, 2))), "yyyy-mm-dd") <> dueDay Then Error.Raise("Invalid due date")
  Endif
  EnsureLane(boardId, lane)
  If listId Then
    list = $db.Find("kb_lists", "board_id = &1 AND id = &2 AND lane = &3 AND title = &4", boardId, listId, lane, status)
    If Not list.Available Then listId = 0
  Endif
  If Not listId Then list = $db.Find("kb_lists", "board_id = &1 AND lane = &2 AND title = &3 ORDER BY sort_order, id", boardId, lane, status)
  If Not list.Available Then Error.Raise("Invalid status")
  listId = list!id
  If WorkspaceStore.ListHidden(boardId, listId) Then Error.Raise("Restore the list or swimlane first")
  WorkspaceStore.RequireCapacity(boardId, listId, cardId)
  If cardId Then
    r = $db.Edit("kb_cards", "id = &1 AND board_id = &2", cardId, boardId)
    If Not r.Available Then Error.Raise("Card not accessible")
  Else
    r = $db.Create("kb_cards")
    r["board_id"] = boardId
    r["archived"] = False
  Endif
  r["title"] = Trim(title)
  r["description"] = description
  r["lane"] = lane
  r["status"] = status
  r["assignee"] = assignee
  r["labels"] = labels
  r["due_day"] = dueDay
  r.Update()
  If Not cardId Then cardId = $db.LastInsertId
  If previousAssignee <> assignee Then $db.Delete("kb_card_assignees", "board_id = &1 AND card_id = &2", boardId, cardId)
  PutCardList(boardId, cardId, listId)
  Activity(boardId, "Saved card: " & title, "card", cardId)
  Return cardId
End

Public Sub ArchiveCard(boardId As Integer, cardId As Integer, archived As Boolean)
  Dim r As Result
  BoardAccess.Require(boardId, "write")
  BoardAccess.RequireCard(boardId, cardId)
  r = $db.Edit("kb_cards", "id = &1 AND board_id = &2", cardId, boardId)
  If Not r.Available Then Error.Raise("Card not accessible")
  r["archived"] = archived
  r.Update()
  Activity(boardId, "Card archive state changed", "card", cardId)
End

Public Sub Activity(boardId As Integer, message As String, Optional kind As String = "board", Optional itemId As Integer)
  Dim r As Result
  BoardAccess.RequireActivity(boardId)
  r = $db.Create("kb_activity")
  r["board_id"] = boardId
  r["actor"] = WebIdentity.Username
  r["message"] = message
  r["created_at"] = Now
  r.Update()
  WorkspaceStore.Log(boardId, kind, itemId, message)
End

Public Function Activities(boardId As Integer) As Result
  RequireBoard(boardId)
  If Not BoardAccess.Can(boardId, "seesAllCards") Then
    WorkspaceStore.OpenStore()
    Return $db.Find("kb_history", "board_id = &1 AND kind = &2 AND item_id IN (SELECT id FROM kb_cards WHERE board_id = &1 AND (assignee = &3 OR id IN (SELECT card_id FROM kb_card_assignees WHERE board_id = &1 AND username = &3))) ORDER BY id DESC", boardId, "card", WebIdentity.Username)
  Endif
  Return $db.Find("kb_activity", "board_id = &1 ORDER BY id DESC", boardId)
End

' Preserve legacy card lanes while giving empty lanes/lists their own records.
Private Sub EnsureLane(boardId As Integer, title As String)
  Dim r As Result
  Dim name As String
  Dim index As Integer
  Dim failure As String
  r = $db.Find("kb_lanes", "board_id = &1 AND title = &2", boardId, title)
  If r.Available Then Return
  $db.Begin()
  r = $db.Create("kb_lanes")
  r["board_id"] = boardId
  r["title"] = title
  r.Update()
  For Each name In ["Todo", "Doing", "Done"]
    r = $db.Create("kb_lists")
    r["board_id"] = boardId
    r["lane"] = title
    r["title"] = name
    r["sort_order"] = index * 10
    r.Update()
    Inc index
  Next
  $db.Commit()
Catch
  failure = Error.Text
  Try $db.Rollback()
  r = $db.Find("kb_lanes", "board_id = &1 AND title = &2", boardId, title)
  If Not r.Available Then Error.Raise(failure)
End

Public Function Lanes(boardId As Integer) As Result
  Dim c As Result
  RequireBoard(boardId)
  c = $db.Find("kb_lanes", "board_id = &1", boardId)
  If Not c.Available Then EnsureLane(boardId, "Default")
  c = $db.Find("kb_cards", "board_id = &1", boardId)
  For Each c
    EnsureLane(boardId, If(Trim(c!lane), c!lane, "Default"))
  Next
  Return $db.Find("kb_lanes", "board_id = &1 ORDER BY id", boardId)
End

Public Function Lists(boardId As Integer, lane As String) As Result
  RequireBoard(boardId)
  Return $db.Find("kb_lists", "board_id = &1 AND lane = &2 ORDER BY sort_order, id", boardId, lane)
End

Public Sub AddLane(boardId As Integer, title As String)
  Dim r As Result
  BoardAccess.Require(boardId, "write")
  title = Trim(title)
  If Not title Or String.Len(title) > 255 Then Error.Raise("Enter a swimlane title (1-255 characters)")
  r = $db.Find("kb_lanes", "board_id = &1 AND title = &2", boardId, title)
  If r.Available Then Error.Raise("Swimlane already exists")
  EnsureLane(boardId, title)
  Activity(boardId, "Added swimlane: " & title)
End

Public Sub AddList(boardId As Integer, lane As String, title As String, afterTitle As String)
  Dim r As Result
  Dim position As Integer
  Dim failure As String
  BoardAccess.Require(boardId, "write")
  EnsureCardLinks(boardId)
  title = Trim(title)
  If Not title Or String.Len(title) > 32 Then Error.Raise("Enter a list title (1-32 characters)")
  r = $db.Find("kb_lanes", "board_id = &1 AND title = &2", boardId, lane)
  If Not r.Available Then Error.Raise("Swimlane not accessible")
  If afterTitle Then
    r = GetList(boardId, afterTitle, lane)
    position = r!sort_order + 1
  Else
    r = $db.Find("kb_lists", "board_id = &1 AND lane = &2 ORDER BY sort_order DESC", boardId, lane)
    position = 0
    If r.Available Then position = r!sort_order + 1
  Endif
  $db.Begin()
  r = $db.Edit("kb_lists", "board_id = &1 AND lane = &2 AND sort_order >= &3", boardId, lane, position)
  For Each r
    r["sort_order"] = r!sort_order + 1
    r.Update()
  Next
  r = $db.Create("kb_lists")
  r["board_id"] = boardId
  r["lane"] = lane
  r["title"] = title
  r["sort_order"] = position
  r.Update()
  $db.Commit()
  Activity(boardId, "Added list: " & title)
Catch
  failure = Error.Text
  If $db Then Try $db.Rollback()
  Error.Raise(failure)
End

Public Function ItemOrder(boardId As Integer, kind As String, item As String, fallback As Integer) As Integer
  Dim r As Result
  RequireBoard(boardId)
  r = $db.Find("kb_order", "board_id = &1 AND kind = &2 AND item = &3", boardId, kind, item)
  If r.Available Then Return r!sort_order
  Return fallback
End

Private Sub PutOrder(boardId As Integer, kind As String, item As String, rank As Integer)
  Dim r As Result
  r = $db.Edit("kb_order", "board_id = &1 AND kind = &2 AND item = &3", boardId, kind, item)
  If Not r.Available Then
    r = $db.Create("kb_order")
    r["board_id"] = boardId
    r["kind"] = kind
    r["item"] = item
  Endif
  r["sort_order"] = rank
  r.Update()
End

Private Sub RequireActiveBoard(boardId As Integer, Optional capability As String = "write")
  Dim r As Result
  BoardAccess.Require(boardId, capability)
  WorkspaceStore.OpenStore()
  r = $db.Find("kb_boards", "id = &1", boardId)
  If r!archived Then Error.Raise("Archived board cannot be reordered")
End

' The same deterministic order is used by the browser and the mutation methods.
Public Function CardOrder(boardId As Integer, laneTitle As String, listTitle As String) As String[]
  Dim r As Result
  Dim sorted As New String[]
  Dim ids As New String[]
  Dim value As String
  Dim list As Result
  Dim listId As Integer
  RequireBoard(boardId)
  list = GetList(boardId, listTitle, laneTitle)
  listId = list!id
  r = Cards(boardId)
  For Each r
    If CardListId(boardId, r!id) <> listId Then Continue
    sorted.Add(Format(ItemOrder(boardId, "card", CStr(r!id), r!id), "0000000000") & ":" & Format(r!id, "0000000000"))
  Next
  sorted.Sort()
  For Each value In sorted
    ids.Add(CStr(CInt(Split(value, ":")[1])))
  Next
  Return ids
End

Public Sub MoveCard(boardId As Integer, cardId As Integer, laneTitle As String, listTitle As String, beforeId As Integer)
  Dim r As Result
  Dim ids As String[]
  Dim index As Integer
  Dim failure As String
  Dim listId As Integer
  RequireActiveBoard(boardId, "moveCard")
  BoardAccess.RequireCard(boardId, cardId)
  r = $db.Find("kb_cards", "id = &1 AND board_id = &2 AND archived = &3", cardId, boardId, False)
  If Not r.Available Then Error.Raise("Card not accessible")
  r = GetList(boardId, listTitle, laneTitle)
  listId = r!id
  listTitle = r!title
  If WorkspaceStore.ListHidden(boardId, listId) Then Error.Raise("Destination is archived")
  WorkspaceStore.RequireCapacity(boardId, listId, cardId)
  If beforeId = cardId Then Return
  $db.Begin()
  ids = CardOrder(boardId, laneTitle, "#" & CStr(listId))
  index = ids.Find(CStr(cardId))
  If index >= 0 Then ids.Remove(index)
  index = ids.Count
  If beforeId Then
    index = ids.Find(CStr(beforeId))
    If index < 0 Then Error.Raise("Destination card not accessible")
  Endif
  ids.Add(CStr(cardId), index)
  r = $db.Edit("kb_cards", "id = &1 AND board_id = &2", cardId, boardId)
  r["lane"] = laneTitle
  r["status"] = listTitle
  r.Update()
  PutCardList(boardId, cardId, listId)
  For index = 0 To ids.Max
    PutOrder(boardId, "card", ids[index], index)
  Next
  Activity(boardId, "Moved card: " & CStr(cardId), "card", cardId)
  $db.Commit()
Catch
  failure = Error.Text
  Try $db.Rollback()
  Error.Raise(failure)
End

Public Sub MoveLane(boardId As Integer, laneTitle As String, beforeTitle As String)
  Dim r As Result
  Dim sorted As New String[]
  Dim names As New String[]
  Dim value As String
  Dim index As Integer
  Dim failure As String
  RequireActiveBoard(boardId)
  r = Lanes(boardId)
  For Each r
    sorted.Add(Format(ItemOrder(boardId, "lane", r!title, r!id), "0000000000") & ":" & CStr(r!id))
  Next
  sorted.Sort()
  For Each value In sorted
    r = $db.Find("kb_lanes", "id = &1 AND board_id = &2", CInt(Split(value, ":")[1]), boardId)
    names.Add(r!title)
  Next
  index = names.Find(laneTitle)
  If index < 0 Then Error.Raise("Swimlane not accessible")
  If laneTitle = beforeTitle Then Return
  names.Remove(index)
  index = names.Count
  If beforeTitle Then
    index = names.Find(beforeTitle)
    If index < 0 Then Error.Raise("Destination swimlane not accessible")
  Endif
  names.Add(laneTitle, index)
  $db.Begin()
  For index = 0 To names.Max
    PutOrder(boardId, "lane", names[index], index)
  Next
  Activity(boardId, "Moved swimlane: " & laneTitle)
  $db.Commit()
Catch
  failure = Error.Text
  Try $db.Rollback()
  Error.Raise(failure)
End

Public Sub MoveList(boardId As Integer, sourceLane As String, listTitle As String, targetLane As String, beforeTitle As String)
  Dim r As Result
  Dim links As Result
  Dim ids As New Integer[]
  Dim index As Integer
  Dim listId As Integer
  Dim beforeId As Integer
  Dim failure As String
  RequireActiveBoard(boardId)
  EnsureCardLinks(boardId)
  r = GetList(boardId, listTitle, sourceLane)
  listId = r!id
  listTitle = r!title
  r = $db.Find("kb_lanes", "board_id = &1 AND title = &2", boardId, targetLane)
  If Not r.Available Then Error.Raise("Destination swimlane not accessible")
  If beforeTitle Then
    r = GetList(boardId, beforeTitle, targetLane)
    beforeId = r!id
    If listId = beforeId Then Return
  Endif
  r = Lists(boardId, targetLane)
  For Each r
    If r!id <> listId Then ids.Add(r!id)
  Next
  index = ids.Count
  If beforeId Then
    index = ids.Find(beforeId)
    If index < 0 Then Error.Raise("Destination list not accessible")
  Endif
  ids.Add(listId, index)
  $db.Begin()
  r = $db.Edit("kb_lists", "id = &1 AND board_id = &2", listId, boardId)
  r["lane"] = targetLane
  r.Update()
  If sourceLane <> targetLane Then
    links = $db.Find("kb_card_lists", "board_id = &1 AND list_id = &2", boardId, listId)
    For Each links
      r = $db.Edit("kb_cards", "board_id = &1 AND id = &2", boardId, links!card_id)
      If Not r.Available Then Continue
      r["lane"] = targetLane
      r.Update()
    Next
  Endif
  For index = 0 To ids.Max
    r = $db.Edit("kb_lists", "board_id = &1 AND id = &2", boardId, ids[index])
    r["sort_order"] = index
    r.Update()
  Next
  Activity(boardId, "Moved list: " & listTitle, "list", listId)
  $db.Commit()
Catch
  failure = Error.Text
  Try $db.Rollback()
  Error.Raise(failure)
End

Public Function GetList(boardId As Integer, reference As String, laneTitle As String) As Result
  Dim r As Result
  RequireBoard(boardId)
  If Left(reference, 1) = "#" Then
    r = $db.Find("kb_lists", "board_id = &1 AND id = &2 AND lane = &3", boardId, CInt(Mid(reference, 2)), laneTitle)
  Else
    r = $db.Find("kb_lists", "board_id = &1 AND title = &2 AND lane = &3 ORDER BY sort_order, id", boardId, reference, laneTitle)
  Endif
  If Not r.Available Then Error.Raise("List not accessible")
  Return r
End

Private Sub PutCardList(boardId As Integer, cardId As Integer, listId As Integer)
  Dim r As Result
  r = $db.Edit("kb_card_lists", "card_id = &1", cardId)
  If Not r.Available Then
    r = $db.Create("kb_card_lists")
    r["card_id"] = cardId
  Endif
  r["board_id"] = boardId
  r["list_id"] = listId
  r.Update()
End

Public Function CardListId(boardId As Integer, cardId As Integer) As Integer
  BoardAccess.RequireCard(boardId, cardId)
  Return ResolveCardList(boardId, cardId)
End

Private Function ResolveCardList(boardId As Integer, cardId As Integer) As Integer
  Dim r As Result
  Dim c As Result
  Dim laneTitle As String
  RequireBoard(boardId)
  c = $db.Find("kb_cards", "board_id = &1 AND id = &2", boardId, cardId)
  If Not c.Available Then Error.Raise("Card not accessible")
  r = $db.Find("kb_card_lists", "card_id = &1 AND board_id = &2", cardId, boardId)
  If r.Available Then Return r!list_id
  laneTitle = If(Trim(c!lane), c!lane, "Default")
  r = $db.Find("kb_lists", "board_id = &1 AND lane = &2 AND title = &3 ORDER BY sort_order, id", boardId, laneTitle, c!status)
  If Not r.Available Then Return 0
  PutCardList(boardId, cardId, r!id)
  Return r!id
End

Private Sub EnsureCardLinks(boardId As Integer)
  Dim r As Result
  r = $db.Find("kb_cards", "board_id = &1", boardId)
  For Each r
    ResolveCardList(boardId, r!id)
  Next
End

Public Sub PrimeCardLinks(boardId As Integer)
  RequireBoard(boardId)
  Lanes(boardId)
  EnsureCardLinks(boardId)
End
