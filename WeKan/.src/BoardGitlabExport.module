' Native GitLab Issues API v4 export; unavailable native identity/planning fields stay absent.
Export
Private Function TextValue(value As Variant) As String
  If IsNull(value) Then Return ""
  Return CStr(value)
End

Private Function Whitespace(character As String) As Boolean
  Dim code As Integer = String.Code(character)
  Return (code >= 9 And code <= 13) Or code = 32 Or code = 160 Or code = 5760 Or (code >= 8192 And code <= 8202) Or code = 8232 Or code = 8233 Or code = 8239 Or code = 8287 Or code = 12288 Or code = 65279
End

Private Function TrimText(value As String) As String
  Dim first As Integer = 1
  Dim finish As Integer = ExportText.Length(value)
  While first <= finish
    If Not Whitespace(String.Mid(value, first, 1)) Then Break
    Inc first
  Wend
  While finish >= first
    If Not Whitespace(String.Mid(value, finish, 1)) Then Break
    Dec finish
  Wend
  If finish < first Then Return ""
  Return String.Mid(value, first, finish - first + 1)
End

Private Function ClosedList(title As String) As Boolean
  Dim code As Integer
  Dim word As String
  ' JavaScript's non-Unicode /i matches these ASCII literals only.
  For code = 65 To 90
    title = Replace(title, Chr(code), Chr(code + 32))
  Next
  For Each word In ["done", "closed", "complete", "archiv", "finished"]
    If InStr(title, word) Then Return True
  Next
  Return False
End

Public Function Build(boardId As Integer, db As Connection, Optional wanted As Collection) As String
  Dim output As New Variant[]
  Dim rows As Result
  Dim entries As Result
  Dim item As Collection
  Dim labels As String[]
  Dim label As String
  Dim people As String[]
  Dim person As String
  Dim assigned As Variant[]
  Dim entry As Collection
  Dim author As Collection
  Dim notes As Variant[]
  Dim dates As Collection
  Dim closed As Boolean
  BoardAccess.RequireContainer(boardId, "board", boardId)
  rows = db.Exec(ExportText.Preserve(db, "SELECT c.*,l.title AS list_title FROM kb_cards c LEFT JOIN kb_card_lists cl ON cl.board_id=c.board_id AND cl.card_id=c.id LEFT JOIN kb_lists l ON l.board_id=c.board_id AND l.id=cl.list_id AND " & ListDeletion.LiveSql("list", "l") & " LEFT JOIN kb_order o ON o.board_id=c.board_id AND o.kind=&2 AND o.item=CAST(c.id AS TEXT) WHERE " & ListDeletion.LiveSql("card", "c") & " AND c.board_id=&1 AND c.archived=&3 ORDER BY COALESCE(o.sort_order,c.id),c.id"), boardId, "card", False)
  For Each rows
    closed = ClosedList(ExportText.ReadValue(rows, "list_title"))
    item = New Collection
    item.Add(ExportText.ReadValue(rows, "title"), "title")
    item.Add(If(ExternalExportFields.Wants(wanted, "description"), ExportText.ReadValue(rows, "description"), ""), "description")
    item.Add(If(closed, "closed", "opened"), "state")
    labels = New String[]
    If ExternalExportFields.Wants(wanted, "labels") Then
      For Each label In Split(ExportText.ReadValue(rows, "labels"), ",")
        label = TrimText(label)
        If label Then labels.Add(label)
      Next
    Endif
    item.Add(labels, "labels")
    If ExternalExportFields.Wants(wanted, "dates") Then
      dates = CardDates.ReadDates(boardId, rows!id)
      If dates.Exist("dueAt") Then item.Add(CardDates.Iso(dates["dueAt"]), "due_date")
      If closed And dates.Exist("endAt") Then item.Add(CardDates.Iso(dates["endAt"]), "closed_at")
    Endif
    If ExternalExportFields.Wants(wanted, "people") Then
      people = BoardAccess.Assignees(boardId, rows!id)
      For Each person In BoardAccess.CardMembers(boardId, rows!id)
        people.Add(person)
      Next
      assigned = New Variant[]
      For Each person In people
        entry = New Collection
        entry.Add(person, "username")
        assigned.Add(entry)
      Next
      If assigned.Count Then item.Add(assigned, "assignees")
    Endif
    notes = New Variant[]
    If ExternalExportFields.Wants(wanted, "comments") Then
      entries = db.Exec(ExportText.SelectRows(db, "kb_entries") & " WHERE " & "board_id=&1 AND card_id=&2 AND kind=&3 ORDER BY id", boardId, rows!id, "comment")
      For Each entries
        entry = New Collection
        entry.Add(ExportText.ReadValue(entries, "body"), "body")
        author = New Collection
        BoardAccess.RequireCard(boardId, rows!id)
        author.Add(RetiredAuthors.DisplayName("entry", entries!id, ExportText.ReadValue(entries, "author")), "username")
        entry.Add(author, "author")
        If Not IsNull(entries!created_at) Then entry.Add(CardDates.Iso(ItemChanges.Epoch(entries!created_at)), "created_at")
        entry.Add(False, "system")
        notes.Add(entry)
      Next
      If notes.Count Then item.Add(notes, "notes")
    Endif
    output.Add(item)
  Next
  Return JSON.Encode(output) & Chr(10)
End
