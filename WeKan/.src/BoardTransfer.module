' Versioned weba JSON exchange; importing always creates a new owner-scoped board.
Export
Private $db As Connection

Private Function Row(r As Result, fields As String[]) As Collection
  Dim item As New Collection
  Dim field As String
  For Each field In fields
    item.Add(r[field], field)
  Next
  Return item
End

Public Function ExportData(boardId As Integer, kind As String, itemId As Integer) As String
  Return ExportChecked(boardId, kind, itemId, False, "weba")
End

Public Function ExportActiveBoard(boardId As Integer) As String
  Return ExportChecked(boardId, "board", boardId, True, "weba")
End

