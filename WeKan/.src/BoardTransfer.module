Private Sub RequireActiveBoard(boardId As Integer)
  Dim r As Result = $db.Find("kb_boards", "id=&1 AND archived=&2", boardId, False)
  If Not r.Available Then Error.Raise("Select active boards first")
End

Private Function ExportChecked(boardId As Integer, kind As String, itemId As Integer, requireActive As Boolean, format As String) As String
  Dim actor As String = WebIdentity.Username
  Dim generation As Long
  Dim text As String
  Dim viewPolicy As Collection
  Dim transaction As Boolean
  Dim failure As String
  ImportExportPolicy.RequireExport()
  BoardAccess.RequireContainer(boardId, kind, itemId)
  generation = WebDatabase.SessionGeneration(actor)
  CardContent.OpenStore()
  $db = WebDatabase.OpenConnection()
  DatabaseTransactions.Begin($db)
  transaction = True
  $db.Exec("UPDATE users SET username=username WHERE username=&1", actor)
  ImportExportPolicy.Lock()
  ImportExportPolicy.RequireExport()
  $db.Exec("UPDATE kb_boards SET title=title WHERE id=&1", boardId)
  BoardAccess.RequireContainer(boardId, kind, itemId)
  If requireActive Then RequireActiveBoard(boardId)
  If kind = "board" Then viewPolicy = BoardViewPolicy.Transfer(boardId)
  If format = "weba" Then
    text = BuildExport(boardId, kind, itemId)
  Else If format = "csv" And kind = "board" Then
    text = BoardCsvExport.Build(boardId, $db)
  Else If format = "scsv" And kind = "board" Then
    text = BoardCsvExport.Build(boardId, $db, ";")
  Else If format = "tsv" And kind = "board" Then
    text = BoardCsvExport.Build(boardId, $db, Chr(9))
  Else If format = "excel" And kind = "board" Then
    text = BoardExcelExport.Build(boardId, $db)
  Else If format = "kanboard" And kind = "board" Then
    text = BoardKanboardExport.Build(boardId, $db)
  Else If format = "markdown" And kind = "board" Then
    text = BoardMarkdownExport.Build(boardId, $db)
  Else If format = "leo" And kind = "board" Then
    text = BoardLeoExport.Build(boardId, $db)
  Else If format = "opml" And kind = "board" Then
    text = BoardOpmlExport.Build(boardId, $db)
  Else If format = "orgmode" And kind = "board" Then
    text = BoardOrgModeExport.Build(boardId, $db)
  Else If format = "todotxt" And kind = "board" Then
    text = BoardTodoTxtExport.Build(boardId, $db)
  Else If format = "taskwarrior" And kind = "board" Then
    text = BoardTaskwarriorExport.Build(boardId, $db)
  Else If format = "focalboard" And kind = "board" Then
    text = BoardFocalboardExport.Build(boardId, $db)
  Else If format = "todoist" And kind = "board" Then
    text = BoardTodoistExport.Build(boardId, $db)
  Else If format = "planner" And kind = "board" Then
    text = BoardPlannerExport.Build(boardId, $db)
  Else If format = "meistertask" And kind = "board" Then
    text = BoardMeisterTaskExport.Build(boardId, $db)
  Else If format = "obsidian" And kind = "board" Then
    text = BoardObsidianExport.Build(boardId, $db)
  Else If format = "linear" And kind = "board" Then
    text = BoardLinearExport.Build(boardId, $db)
  Else If format = "ticktick" And kind = "board" Then
    text = BoardTickTickExport.Build(boardId, $db)
  Else If format = "clickup" And kind = "board" Then
    text = BoardClickUpExport.Build(boardId, $db)
  Else If format = "nullboard" And kind = "board" Then
    text = BoardNullboardExport.Build(boardId, $db)
  Else If format = "openproject" And kind = "board" Then
    text = BoardOpenProjectExport.Build(boardId, $db)
  Else If format = "jira" And kind = "board" Then
    text = BoardJiraExport.Build(boardId, $db)
  Else If format = "trello" And kind = "board" Then
    text = BoardTrelloExport.Build(boardId, $db)
  Else If format = "gitlab" And kind = "board" Then
    text = BoardGitlabExport.Build(boardId, $db)
  Else If (format = "github" Or format = "gitea" Or format = "forgejo") And kind = "board" Then
    text = BoardGithubExport.Build(boardId, $db)
  Else If format = "deck" And kind = "board" Then
    text = BoardDeckExport.Build(boardId, $db)
  Else If format = "kanri" And kind = "board" Then
    text = BoardKanriExport.Build(boardId, $db)
  Else If format = "pivotal" And kind = "board" Then
    text = BoardPivotalExport.Build(boardId, $db)
  Else If format = "redmine" And kind = "board" Then
    text = BoardRedmineExport.Build(boardId, $db)
  Else If format = "tasksorg" And kind = "board" Then
    text = BoardTasksOrgExport.Build(boardId, $db)
  Else If format = "notion" And kind = "board" Then
    text = BoardNotionExport.Build(boardId, $db)
  Else If format = "quire" And kind = "board" Then
    text = BoardQuireExport.Build(boardId, $db)
  Else If format = "teamwork" And kind = "board" Then
    text = BoardTeamworkExport.Build(boardId, $db)
  Else If format = "wrike" And kind = "board" Then
    text = BoardWrikeExport.Build(boardId, $db)
  Else If format = "wrikeworkflow" And kind = "board" Then
    text = BoardWrikeWorkflowExport.Build(boardId, $db)
  Else If format = "vikunja" And kind = "board" Then
    text = BoardVikunjaExport.Build(boardId, $db)
  Else If format = "taiga" And kind = "board" Then
    text = BoardTaigaExport.Build(boardId, $db)
  Else If format = "superproductivity" And kind = "board" Then
    text = BoardSuperProductivityExport.Build(boardId, $db)
  Else If format = "businessmap" And kind = "board" Then
    text = BoardBusinessmapExport.Build(boardId, $db)
  Else If format = "monday" And kind = "board" Then
    text = BoardMondayExport.Build(boardId, $db)
  Else
    Error.Raise("Unknown export format")
  Endif
  If kind = "board" Then
    If JSON.Encode(BoardViewPolicy.Transfer(boardId)) <> JSON.Encode(viewPolicy) Then Error.Raise("Board policy changed during export")
  Endif
  If WebIdentity.Username <> actor Or WebDatabase.SessionGeneration(actor) <> generation Then Error.Raise("Sign in required")
  BoardAccess.RequireContainer(boardId, kind, itemId)
  If requireActive Then RequireActiveBoard(boardId)
  ImportExportPolicy.RequireExport()
  DatabaseTransactions.Commit($db)
  transaction = False
  Return text
Catch
  failure = Error.Text
  If transaction Then Try DatabaseTransactions.Rollback($db)
  Error.Raise(failure)
End

Private Function BuildExport(boardId As Integer, kind As String, itemId As Integer) As String
  Dim data As New Collection
  Dim lanes As New Variant[]
  Dim lists As New Variant[]
  Dim cards As New Variant[]
  Dim metadata As New Variant[]
  Dim entries As New Variant[]
  Dim files As New Variant[]
  Dim cardIds As New Integer[]
  Dim listIds As New Integer[]
  Dim laneIds As New Integer[]
  Dim source As Result
  Dim r As Result
  Dim bytesRow As Result
  Dim item As Collection
  Dim listId As Integer
  Dim cover As Integer
  Dim include As Boolean
  Dim viewPolicy As Collection
  Dim policyKey As String
  BoardAccess.RequireContainer(boardId, kind, itemId)
  source = WorkspaceStore.Record(boardId, kind, itemId)
  CardContent.OpenStore()
  $db = WebDatabase.OpenConnection()
  KanbanStore.PrimeCardLinks(boardId)
  data["format"] = "weba-2"
  data["kind"] = kind
  data["title"] = source!title
  If kind = "board" Then
    viewPolicy = BoardViewPolicy.Transfer(boardId)
    For Each policyKey In viewPolicy.Keys
      data[policyKey] = viewPolicy[policyKey]
    Next
  Endif
  r = BoardAccess.CardRows(boardId)
  For Each r
    listId = KanbanStore.CardListId(boardId, r!id)
    If kind = "card" And r!id <> itemId Then Continue
    If kind = "list" And listId <> itemId Then Continue
    If kind = "lane" And r!lane <> source!title And Not (source!title = "Default" And Not r!lane) Then Continue
    item = Row(r, ["id", "title", "description", "lane", "status", "assignee", "labels", "due_day", "archived"])
    item["assignees"] = BoardAccess.Assignees(boardId, r!id)
    item["members"] = BoardAccess.CardMembers(boardId, r!id)
    item["dates"] = CardDates.ReadDates(boardId, r!id)
    cover = AttachmentLifecycle.CoverId(boardId, r!id)
    If cover > 0 Then item["coverFile"] = cover
    If CardArchive.Timestamp(boardId, r!id) Then item["archivedAt"] = CardArchive.Timestamp(boardId, r!id)
    item["list_id"] = listId
    item["sort_order"] = KanbanStore.ItemOrder(boardId, "card", CStr(r!id), r!id)
    cards.Add(item)
    cardIds.Add(r!id)
    If listIds.Find(listId) < 0 Then listIds.Add(listId)
  Next
  r = $db.Find("kb_lists", ListDeletion.LiveSql("list", "kb_lists") & " AND board_id = &1 ORDER BY lane, sort_order, id", boardId)
  For Each r
    include = kind = "board" Or (kind = "lane" And r!lane = source!title) Or (kind = "list" And r!id = itemId) Or listIds.Find(r!id) >= 0
    If Not include Then Continue
    lists.Add(Row(r, ["id", "lane", "title", "sort_order"]))
    If listIds.Find(r!id) < 0 Then listIds.Add(r!id)
  Next
  r = $db.Find("kb_lanes", "board_id = &1 ORDER BY id", boardId)
  For Each r
    include = kind = "board" Or (kind = "lane" And r!id = itemId)
    For Each item In lists
      If item["lane"] = r!title Then include = True
    Next
    If Not include Then Continue
    item = Row(r, ["id", "title"])
    item["sort_order"] = KanbanStore.ItemOrder(boardId, "lane", r!title, r!id)
    lanes.Add(item)
    laneIds.Add(r!id)
  Next
  r = $db.Find("kb_meta", "board_id = &1", boardId)
  For Each r
    If r!setting = "star" Or r!setting = "watch" Or r!setting = "cover" Then Continue
    include = False
    Select r!kind
      Case "board"
        include = kind = "board"
      Case "lane"
        include = laneIds.Find(r!item_id) >= 0
      Case "list"
        include = listIds.Find(r!item_id) >= 0
      Case "card"
        include = cardIds.Find(r!item_id) >= 0
    End Select
    If include Then metadata.Add(Row(r, ["kind", "item_id", "setting", "value"]))
  Next
  r = $db.Find("kb_entries", "board_id = &1 ORDER BY id", boardId)
  For Each r
    If cardIds.Find(r!card_id) < 0 Then Continue
    If (r!kind = "subtask" Or r!kind = "dependency") And cardIds.Find(CInt(r!amount)) < 0 Then Continue
    item = Row(r, ["id", "card_id", "kind", "parent_id", "title", "body", "value_type", "done", "amount"])
    item["author_name"] = CardContent.AuthorName(boardId, r!card_id, "entry", r!id)
    entries.Add(item)
  Next
  r = $db.Exec("SELECT id,card_id,filename,COALESCE(LENGTH(content),0) AS file_size FROM kb_files WHERE " & AttachmentLifecycle.LiveSql("kb_files") & " AND board_id=&1 ORDER BY id", boardId)
  For Each r
    If cardIds.Find(r!card_id) < 0 Then Continue
    item = Row(r, ["id", "card_id", "filename"])
    TransferPolicy.RequireTransfer("attachmentsDownload", r!file_size)
    bytesRow = CardContent.FileRecord(boardId, r!card_id, r!id)
    TransferPolicy.RequireTransfer("attachmentsDownload", Len(bytesRow!content.Data))
    item["mime"] = AttachmentData.Mime(boardId, r!card_id, r!id)
    item["base64"] = Base64(bytesRow!content.Data)
    item["author_name"] = CardContent.AuthorName(boardId, r!card_id, "file", r!id)
    files.Add(item)
  Next
  data["lanes"] = lanes
  data["lists"] = lists
  data["cards"] = cards
  data["metadata"] = metadata
  data["entries"] = entries
  data["files"] = files
  Return JSON.Encode(data)
End

Public Function ReadData(text As String) As Collection
  Dim data As Collection
  If Len(text) > 20 * 1024 * 1024 Then Error.Raise("Import JSON exceeds 20 MiB")
  data = JSON.Decode(text)
  If data["format"] <> "weba-2" Then Error.Raise("Choose a weba-2 JSON export")
  If Not data.Exist("lanes") Or Not data.Exist("lists") Or Not data.Exist("cards") Or Not data.Exist("entries") Or Not data.Exist("files") Or Not data.Exist("metadata") Then Error.Raise("Incomplete weba export")
  Return data
End

Public Function ImportData(text As String, title As String) As Integer
  Dim data As Collection
  Dim viewPolicy As Collection
  Dim generation As Long
  Dim laneMap As New Collection
  Dim listMap As New Collection
  Dim cardMap As New Collection
  Dim entryMap As New Collection
  Dim fileMap As New Collection
  Dim item As Collection
  Dim r As Result
  Dim boardId As Integer
  Dim id As Integer
  Dim parentId As Integer
  Dim oldId As String
  Dim kind As String
  Dim titleValue As String
  Dim failure As String
  Dim actor As String = WebIdentity.Username
  Dim fileBytes As String
  Dim maxFileBytes As Long
  Dim transaction As Boolean
  BoardCreation.Require()
  ImportExportPolicy.RequireImport()
  generation = WebDatabase.SessionGeneration(actor)
  data = ReadData(text)
  If BoardViewPolicy.HasTransfer(data) Then
    If data["kind"] <> "board" Then Error.Raise("Board policy requires a whole-board export")
    viewPolicy = BoardViewPolicy.Snapshot(data)
    viewPolicy.Remove("keys")
    BoardViewPolicy.InitializeTransfer()
  Endif
  If Not Trim(title) Or String.Len(title) > 255 Then Error.Raise("Enter a valid board title")
  CardContent.OpenStore()
  $db = WebDatabase.OpenConnection()
  DatabaseTransactions.Begin($db)
  transaction = True
  $db.Exec("UPDATE users SET username=username WHERE username=&1", actor)
  BoardCreation.Lock()
  BoardCreation.Require()
  ImportExportPolicy.Lock()
  ImportExportPolicy.RequireImport()
  TransferPolicy.Lock()
  boardId = KanbanStore.AddBoard(title)
  If viewPolicy Then BoardViewPolicy.InstallTransfer(boardId, viewPolicy)
  For Each item In data["lanes"]
    oldId = CStr(item["id"])
    titleValue = item["title"]
    If laneMap.Exist(oldId) Or Not Trim(titleValue) Or String.Len(titleValue) > 255 Then Error.Raise("Invalid exported swimlane")
    r = $db.Create("kb_lanes")
    r["board_id"] = boardId
    r["title"] = titleValue
    r.Update()
    laneMap[oldId] = $db.LastInsertId
    r = $db.Create("kb_order")
    r["board_id"] = boardId
    r["kind"] = "lane"
    r["item"] = titleValue
    r["sort_order"] = CInt(item["sort_order"])
    r.Update()
  Next
  For Each item In data["lists"]
    oldId = CStr(item["id"])
    If listMap.Exist(oldId) Or Not Trim(item["title"]) Or String.Len(item["title"]) > 32 Then Error.Raise("Invalid exported list")
    r = $db.Find("kb_lanes", "board_id = &1 AND title = &2", boardId, item["lane"])
    If Not r.Available Then Error.Raise("Exported list has no swimlane")
    r = $db.Create("kb_lists")
    r["board_id"] = boardId
    r["title"] = item["title"]
    r["lane"] = item["lane"]
    r["sort_order"] = CInt(item["sort_order"])
    r.Update()
    id = $db.LastInsertId
    listMap[oldId] = id
    ItemChanges.Mark(boardId, "list", id)
  Next
  For Each item In data["cards"]
    oldId = CStr(item["id"])
    If cardMap.Exist(oldId) Or Not listMap.Exist(CStr(item["list_id"])) Then Error.Raise("Invalid exported card identity")
    r = WorkspaceStore.Record(boardId, "list", listMap[CStr(item["list_id"])])
    If r!lane <> item["lane"] Or r!title <> item["status"] Then Error.Raise("Exported card/list mismatch")
    If String.Len(item["title"]) > 255 Then Error.Raise("Invalid exported card title")
    id = KanbanStore.SaveCard(boardId, 0, item["title"], item["description"], item["lane"], item["status"], "", item["labels"], item["due_day"], listMap[CStr(item["list_id"])])
    If item.Exist("assignees") Then
      BoardAccess.RestoreAssignees(boardId, id, item["assignees"])
    Else If item["assignee"] Then
      BoardAccess.RestoreAssignees(boardId, id, [CStr(item["assignee"])])
    Endif
    If item.Exist("members") Then BoardAccess.RestoreCardMembers(boardId, id, item["members"])
    If item.Exist("dates") Then CardDates.RestoreDates(boardId, id, item["dates"])
    cardMap[oldId] = id
    r = $db.Create("kb_order")
    r["board_id"] = boardId
    r["kind"] = "card"
    r["item"] = CStr(id)
    r["sort_order"] = CInt(item["sort_order"])
    r.Update()
    If item["archived"] Then KanbanStore.ArchiveCard(boardId, id, True)
    If item.Exist("archivedAt") Then
      CardArchive.RestoreStamp(boardId, id, item["archivedAt"])
    Else
      CardArchive.RestoreStamp(boardId, id, Null)
    Endif
  Next
  ' Checklists must exist before their children, regardless of JSON array order.
  For Each kind In ["checklist", "comment", "custom", "time", "checkitem", "subtask", "dependency"]
    For Each item In data["entries"]
      If item["kind"] <> kind Then Continue
      oldId = CStr(item["id"])
      If entryMap.Exist(oldId) Or Not cardMap.Exist(CStr(item["card_id"])) Then Error.Raise("Invalid exported detail identity")
      parentId = 0
      If kind = "checkitem" Then
        If Not entryMap.Exist(CStr(item["parent_id"])) Then Error.Raise("Exported checklist item has no checklist")
        parentId = entryMap[CStr(item["parent_id"])]
      Endif
      id = CInt(item["amount"])
      If kind = "dependency" Or kind = "subtask" Then
        If Not cardMap.Exist(CStr(id)) Then Error.Raise("Exported relationship has no target")
        id = cardMap[CStr(id)]
        entryMap[oldId] = CardContent.Save(boardId, cardMap[CStr(item["card_id"])], 0, kind, "", "", 0, False, id)
      Else
        entryMap[oldId] = CardContent.Save(boardId, cardMap[CStr(item["card_id"])], 0, kind, item["title"], item["body"], parentId, item["done"], item["amount"], item["value_type"])
      Endif
      If item.Exist("author_name") Then
        If TypeOf(item["author_name"]) <> gb.String Then Error.Raise("Invalid author name")
        CardContent.RetainAuthorName(boardId, cardMap[CStr(item["card_id"])], "entry", entryMap[oldId], item["author_name"])
      Endif
    Next
  Next
  If entryMap.Count <> data["entries"].Count Then Error.Raise("Unknown exported detail kind")
  For Each item In data["files"]
    If Not cardMap.Exist(CStr(item["card_id"])) Then Error.Raise("Exported attachment has no card")
    fileBytes = UnBase64(item["base64"])
    maxFileBytes = Max(maxFileBytes, Len(fileBytes))
    id = CardContent.UploadFile(boardId, cardMap[CStr(item["card_id"])], item["filename"], fileBytes, If(item.Exist("mime"), CStr(item["mime"]), "application/octet-stream"))
    If item.Exist("id") Then
      oldId = CStr(item["id"])
      If fileMap.Exist(oldId) Then Error.Raise("Duplicate attachment ID")
      fileMap[oldId] = id
    Endif
    If item.Exist("author_name") Then
      If TypeOf(item["author_name"]) <> gb.String Then Error.Raise("Invalid author name")
      CardContent.RetainAuthorName(boardId, cardMap[CStr(item["card_id"])], "file", id, item["author_name"])
    Endif
  Next
  For Each item In data["cards"]
    If Not item.Exist("coverFile") Then Continue
    oldId = CStr(item["coverFile"])
    If Not fileMap.Exist(oldId) Then Error.Raise("Unknown attachment cover")
    AttachmentLifecycle.SetCover(boardId, cardMap[CStr(item["id"])], fileMap[oldId])
  Next
  For Each item In data["metadata"]
    oldId = CStr(item["item_id"])
    Select item["kind"]
      Case "board"
        id = boardId
      Case "lane"
        If Not laneMap.Exist(oldId) Then Error.Raise("Unknown metadata swimlane")
        id = laneMap[oldId]
      Case "list"
        If Not listMap.Exist(oldId) Then Error.Raise("Unknown metadata list")
        id = listMap[oldId]
      Case "card"
        If Not cardMap.Exist(oldId) Then Error.Raise("Unknown metadata card")
        id = cardMap[oldId]
      Case Else
        Error.Raise("Unknown metadata kind")
    End Select
    WorkspaceStore.SetSetting(boardId, item["kind"], id, item["setting"], item["value"])
  Next
  KanbanStore.Activity(boardId, "Imported weba JSON")
  If data["files"].Count > 0 Then TransferPolicy.RequireTransfer("attachmentsUpload", maxFileBytes)
  If WebIdentity.Username <> actor Or WebDatabase.SessionGeneration(actor) <> generation Then Error.Raise("Sign in required")
  If viewPolicy Then
    If JSON.Encode(BoardViewPolicy.Transfer(boardId)) <> JSON.Encode(viewPolicy) Then Error.Raise("Imported board policy changed")
  Endif
  BoardAccess.Require(boardId, "write")
  BoardCreation.Require()
  ImportExportPolicy.RequireImport()
  DatabaseTransactions.Commit($db)
  transaction = False
  Return boardId
Catch
  failure = Error.Text
  If transaction Then Try DatabaseTransactions.Rollback($db)
  Error.Raise(failure)
End
