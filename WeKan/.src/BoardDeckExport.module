' Native Nextcloud Deck formatter; match source stack titles exactly.
Export
Private Function TextValue(value As Variant) As String
  If IsNull(value) Then Return ""
  Return CStr(value)
End

Private Function Whitespace(character As String) As Boolean
  Dim code As Integer = String.Code(character)
  Return (code >= 9 And code <= 13) Or code = 32 Or code = 160 Or code = 5760 Or (code >= 8192 And code <= 8202) Or code = 8232 Or code = 8233 Or code = 8239 Or code = 8287 Or code = 12288 Or code = 65279
End

Private Function TrimText(value As String) As String
  Dim first As Integer = 1
  Dim finish As Integer = ExportText.Length(value)
  While first <= finish
    If Not Whitespace(String.Mid(value, first, 1)) Then Break
    Inc first
  Wend
  While finish >= first
    If Not Whitespace(String.Mid(value, finish, 1)) Then Break
    Dec finish
  Wend
  If finish < first Then Return ""
  Return String.Mid(value, first, finish - first + 1)
End

Public Function Build(boardId As Integer, db As Connection, Optional wanted As Collection) As String
  Dim output As New Collection
  Dim stacks As New Variant[]
  Dim cards As New Variant[]
  Dim board As Result
  Dim lists As Result
  Dim rows As Result
  Dim entries As Result
  Dim stack As Collection
  Dim card As Collection
  Dim label As String
  Dim labels As Variant[]
  Dim item As Collection
  Dim comments As Variant[]
  Dim people As String[]
  Dim person As String
  Dim assigned As Variant[]
  Dim participant As Collection
  Dim dates As Collection
  BoardAccess.RequireContainer(boardId, "board", boardId)
  board = db.Exec(ExportText.SelectRows(db, "kb_boards") & " WHERE " & "id=&1", boardId)
  If Not board.Available Then Error.Raise("Board not found")
  output.Add(ExportText.ReadValue(board, "title"), "title")
  lists = db.Exec(ExportText.SelectRows(db, "kb_lists") & " WHERE " & ListDeletion.LiveSql("list", "kb_lists") & " AND board_id=&1 ORDER BY lane,sort_order,id", boardId)
  For Each lists
    cards = New Variant[]
    rows = db.Exec(ExportText.Preserve(db, "SELECT c.* FROM kb_cards c LEFT JOIN kb_card_lists cl ON cl.board_id=c.board_id AND cl.card_id=c.id LEFT JOIN kb_lists l ON l.board_id=c.board_id AND l.id=cl.list_id AND " & ListDeletion.LiveSql("list", "l") & " LEFT JOIN kb_order o ON o.board_id=c.board_id AND o.kind=&2 AND o.item=CAST(c.id AS TEXT) WHERE " & ListDeletion.LiveSql("card", "c") & " AND c.board_id=&1 AND c.archived=&3 AND " & ExportText.MatchText(db, "COALESCE(l.title,'')", 4, ExportText.ReadValue(lists, "title")) & " ORDER BY COALESCE(o.sort_order,c.id),c.id"), boardId, "card", False, ExportText.BindText(db, ExportText.ReadValue(lists, "title")))
    For Each rows
      card = New Collection
      card.Add(ExportText.ReadValue(rows, "title"), "title")
      card.Add(If(ExternalExportFields.Wants(wanted, "description"), ExportText.ReadValue(rows, "description"), ""), "description")
      If ExternalExportFields.Wants(wanted, "dates") Then
        dates = CardDates.ReadDates(boardId, rows!id)
        If dates.Exist("dueAt") Then card.Add(CardDates.Iso(dates["dueAt"]), "duedate")
        If dates.Exist("endAt") Then card.Add(CardDates.Iso(dates["endAt"]), "done")
      Endif
      labels = New Variant[]
      If ExternalExportFields.Wants(wanted, "labels") Then
        For Each label In Split(ExportText.ReadValue(rows, "labels"), ",")
          label = TrimText(label)
          If Not label Then Continue
          item = New Collection
          item.Add(label, "title")
          labels.Add(item)
        Next
      Endif
      card.Add(labels, "labels")
      If ExternalExportFields.Wants(wanted, "people") Then
        people = BoardAccess.Assignees(boardId, rows!id)
        For Each person In BoardAccess.CardMembers(boardId, rows!id)
          people.Add(person)
        Next
        assigned = New Variant[]
        For Each person In people
          participant = New Collection
          participant.Add(person, "uid")
          item = New Collection
          item.Add(participant, "participant")
          assigned.Add(item)
        Next
        If assigned.Count Then card.Add(assigned, "assignedUsers")
      Endif
      comments = New Variant[]
      If ExternalExportFields.Wants(wanted, "comments") Then
        entries = db.Exec(ExportText.SelectRows(db, "kb_entries") & " WHERE " & "board_id=&1 AND card_id=&2 AND kind=&3 ORDER BY id", boardId, rows!id, "comment")
        For Each entries
          item = New Collection
          item.Add(ExportText.ReadValue(entries, "body"), "message")
          BoardAccess.RequireCard(boardId, rows!id)
          item.Add(RetiredAuthors.DisplayName("entry", entries!id, ExportText.ReadValue(entries, "author")), "actorId")
          If Not IsNull(entries!created_at) Then
            item.Add(CardDates.Iso(ItemChanges.Epoch(entries!created_at)), "creationDateTime")
          Endif
          comments.Add(item)
        Next
        If comments.Count Then card.Add(comments, "comments")
      Endif
      cards.Add(card)
    Next
    stack = New Collection
    stack.Add(ExportText.ReadValue(lists, "title"), "title")
    stack.Add(cards, "cards")
    stacks.Add(stack)
  Next
  output.Add(stacks, "stacks")
  Return JSON.Encode(output) & Chr(10)
End
